# ============================================================================
# DigiPOSE Enterprise B2B/Retail ERP & Cyber HUD Platform
# Tech Stack: .NET 10 (ASP.NET Core API / MVC CMS) + SQL Server + Next.JS (React)
# Official Monorepo Security & Clean Workspace .gitignore Blueprint
# ============================================================================

# ── Build & Compilation Artifacts (.NET Engine) ──
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
build/
bld/
[Pp]ublish/
publish/

# ── Database Files & Snapshots & EF Core Migrations ──
*.mdf
*.ldf
*.ndf
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal
[Mm]igrations/
**/Migrations/

# ── User File Uploads & Runtime Media Isolation ──
backend/DigiPOSE/wwwroot/uploads/*
!backend/DigiPOSE/wwwroot/uploads/.gitkeep
demo/tmp/*

# ── Zero-Trust Secret Isolation & Credentials ──
*.env
*.env.*
!*.env.example
!.env.example
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
backend/DigiPOSE/appsettings.json
backend/DigiPOSE/appsettings.*.json
backend/DigiPOSE/gg-app-password.jpg
!backend/DigiPOSE/appsettings.example.json
appsettings.Development.Secret.json
gg-app-password.jpg
ModelBuilderExtensions.cs
docs/pos
docs/store
docs/walkthought.md
docs/implementation_plan.md
docs/Design.docx

# ── Cryptographic Secrets & SSL Certificates ──
*.pfx
*.p12
*.key
*.pem
*.cer
*.crt

# ── Frontend SPA & Next.JS Build Environments ──
**/node_modules/
**/.next/
**/out/
**/dist/
**/.vercel/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
tsconfig.tsbuildinfo

# ── NuGet Packages & Lock Files ──
*.nupkg
*.snupkg
**/packages/
project.lock.json
project.fragment.lock.json
artifacts/

# ── IDE & Editor Configuration (VS / VS Code / JetBrains / WebStorm) ──
.vs/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates
*.rsuser
*.DotSettings.user
launchSettings.json

# ── MSBuild & Terminal Telemetry Logs ──
*.log
msbuild*.wrn
msbuild*.err
msbuild*.svclog
*.debug-0.log

# ── Test Results & Code Coverage ──
[Tt]est[Rr]esult*/
[Dd]ebug[Pp]ublic/
TestResults/
coverage*/
coverage*.xml
coverage*.json
*.coverage
