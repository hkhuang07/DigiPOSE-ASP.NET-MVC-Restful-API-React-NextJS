@model IEnumerable<DigiPOSE.Models.Subscription>
@{ ViewData["Title"] = "SaaS Subscriptions"; }

<div class="cyber-panel">
    <div class="cyber-panel-header">
        <div class="cyber-panel-title"><i class="fa-solid fa-key"></i> SAAS SUBSCRIPTIONS & LICENSE REGISTRY</div>
        <div class="cyber-panel-sub">[B2B ENTERPRISE MODULE] // CUSTOMER LICENSE KEYS & RECURRING CONTRACTS</div>
    </div>
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn-cyber-success btn-show-modal" data-url="@Url.Action("Create", "Subscriptions")">
                <i class="fa-solid fa-plus me-1"></i> REGISTER SUBSCRIPTION
            </button>
            <a href="@Url.Action("ExportExcel", "Subscriptions")" class="btn-cyber-info btn-export-excel" style="text-decoration:none;">
                <i class="fa-solid fa-file-excel me-1"></i> EXPORT EXCEL
            </a>
        </div>
        <div style="font-family:'Roboto Mono'; font-size:0.85rem; color:#00E5FF; white-space:nowrap;">
            TOTAL LICENSES: <strong id="totalRecordsCount" style="color:#FFF; font-family:'VT323'; font-size:1.3rem;">--</strong>
        </div>
    </div>
    <div class="table-responsive">
        <table id="datatable" class="table-cyber w-100">
            <thead>
                <tr>
                    <th style="width:5%; text-align:center; white-space:nowrap;">#</th>
                    <th style="white-space:nowrap;">LICENSE KEY / TOKEN</th>
                    <th style="white-space:nowrap;">CUSTOMER</th>
                    <th style="white-space:nowrap;">SAAS PACKAGE</th>
                    <th style="white-space:nowrap;">START DATE</th>
                    <th style="white-space:nowrap;">END DATE</th>
                    <th style="white-space:nowrap;">STATUS</th>
                    <th style="width:120px; text-align:center; white-space:nowrap;">ACTIONS</th>
                </tr>
            </thead>
        </table>
    </div>
</div>
<div class="modal fade modal-cyber" id="globalModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" style="max-width:680px;" id="globalModalContainer"></div>
</div>
@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script src="~/lib/datatables/js/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(document).ready(function(){
            var table = $('#datatable').DataTable({
                serverSide: true,
                processing: true,
                filter: true,
                ajax: {
                    url: '@Url.Action("Index_LoadData", "Subscriptions")',
                    type: "POST",
                    dataType: "JSON"
                },
                columns: [
                    { data: null, name: null, sortable: false, render: (d, t, r, meta) => meta.row + meta.settings._iDisplayStart + 1 },
                    { data: 'licenseKey', name: 'LicenseKey', render: d => `<span style="font-family:'VT323',monospace; font-size:1.05rem; color:#00FF66; letter-spacing:1px; white-space:nowrap;"><i class="fa-solid fa-key me-2 text-cyan"></i>${d}</span>` },
                    { data: 'customerName', name: 'CustomerName', render: d => `<span style="color:#FFF; font-weight:600; font-family:'Rajdhani'; font-size:1.05rem;">${d}</span>` },
                    { data: 'productName', name: 'ProductName', render: d => `<span style="color:#00E5FF;">${d}</span>` },
                    { data: 'startDate', name: 'StartDate', render: d => `<span style="color:#A0C0CE; font-family:'Roboto Mono'; font-size:0.85rem;">${d}</span>` },
                    { data: 'endDate', name: 'EndDate', render: d => `<span style="color:#A0C0CE; font-family:'Roboto Mono'; font-size:0.85rem;">${d}</span>` },
                    { data: 'status', name: 'Status', render: d => {
                        let color = '#FFB000';
                        if (d === 'ACTIVE') color = '#00FF66';
                        else if (d === 'EXPIRED' || d === 'CANCELED') color = '#FF3333';
                        return `<span style="border:1px solid ${color}; color:${color}; padding:2px 8px; font-size:0.75rem; font-family:'VT323'; letter-spacing:1px; text-transform:uppercase;">${d}</span>`;
                    }},
                    { 
                        data: null, 
                        searchable: false, 
                        orderable: false, 
                        render: function (d, t, r) { 
                            var detailsUrl = '@Url.Action("Details", "Subscriptions")/' + r.subscriptionId;
                            var editUrl = '@Url.Action("Edit", "Subscriptions")/' + r.subscriptionId;
                            var deleteUrl = '@Url.Action("Delete", "Subscriptions")/' + r.subscriptionId;
                            return '<div style="text-align:center;">'
                                 + '<button type="button" class="btn-cyber-info btn-show-modal" data-url="' + detailsUrl + '" style="padding:4px 8px; font-size:0.75rem;"><i class="fa-solid fa-circle-info"></i></button> '
                                 + '<button type="button" class="btn-cyber-primary btn-show-modal" data-url="' + editUrl + '" style="padding:4px 8px; font-size:0.75rem;"><i class="fa-solid fa-pen-to-square"></i></button> ' 
                                 + '<button type="button" class="btn-cyber-danger btn-show-modal" data-url="' + deleteUrl + '" style="padding:4px 8px; font-size:0.75rem;"><i class="fa-solid fa-trash"></i></button>'
                                 + '</div>'; 
                        } 
                    }                        
                ],
                drawCallback: function (settings) {
                    var api = this.api();
                    var json = api.ajax.json();
                    if (json && json.recordsTotal !== undefined) {
                        $('#totalRecordsCount').text(json.recordsTotal);
                    }
                }
            });   
        });
    </script>
}
