@model DigiPOSE.Models.Subscription
<div class="modal-content">
    <div class="modal-header">
        <h5 class="modal-title"><i class="fa-solid fa-key text-cyan me-2"></i> SAAS SUBSCRIPTION DETAILS</h5>
        <button type="button" class="btn-close-cyber" data-bs-dismiss="modal"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <div class="modal-body">
        <div style="background: rgba(0, 0, 0, 0.6); border: 1px solid rgba(0, 229, 255, 0.3); padding: 1.25rem;">
            <div class="row mb-3 align-items-center">
                <div class="col-4" style="color:#00E5FF; font-family:'Orbitron'; font-size:0.75rem; text-transform:uppercase;">LICENSE KEY:</div>
                <div class="col-8" style="font-family:'VT323'; font-size:1.4rem; color:#00FF66;">@(Model.LicenseKey ?? "N/A")</div>
            </div>
            <div class="row mb-3 align-items-center">
                <div class="col-4" style="color:#00E5FF; font-family:'Orbitron'; font-size:0.75rem; text-transform:uppercase;">TENANT / CUSTOMER:</div>
                <div class="col-8" style="font-family:'Rajdhani'; font-size:1.1rem; font-weight:bold; color:#FFF;">@(Model.Customer?.FullName ?? "N/A")</div>
            </div>
            <div class="row mb-3 align-items-center">
                <div class="col-4" style="color:#00E5FF; font-family:'Orbitron'; font-size:0.75rem; text-transform:uppercase;">PACKAGE:</div>
                <div class="col-8" style="font-family:'Rajdhani'; font-size:1.1rem; color:#00E5FF;">@(Model.Product?.ProductName ?? "N/A") (Order #@Model.OrderId)</div>
            </div>
            <div class="row mb-3 align-items-center">
                <div class="col-4" style="color:#00E5FF; font-family:'Orbitron'; font-size:0.75rem; text-transform:uppercase;">CONTRACT PERIOD:</div>
                <div class="col-8" style="font-family:'Roboto Mono'; font-size:0.9rem; color:#D8F8FF;">
                    @Model.StartDate.ToString("yyyy-MM-dd") <i class="fa-solid fa-arrow-right-long text-info mx-1"></i> @Model.EndDate.ToString("yyyy-MM-dd")
                </div>
            </div>
            <div class="row align-items-center">
                <div class="col-4" style="color:#00E5FF; font-family:'Orbitron'; font-size:0.75rem; text-transform:uppercase;">STATUS:</div>
                <div class="col-8">
                    <span style="border:1px solid #00FF66; color:#00FF66; padding:2px 8px; font-size:0.8rem; font-family:'VT323';">@Model.Status</span>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn-cyber-cancel" data-bs-dismiss="modal">
            <i class="fa-solid fa-xmark me-1"></i> CLOSE
        </button>
    </div>
</div>
