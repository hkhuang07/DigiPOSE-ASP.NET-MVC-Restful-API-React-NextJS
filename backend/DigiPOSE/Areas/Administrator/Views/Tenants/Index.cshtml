@model IEnumerable<DigiPOSE.Models.Tenant>
@{
    ViewData["Title"] = "Tenant Management";
}

@Html.AntiForgeryToken()

<div class="cyber-panel">
    <div class="cyber-panel-header">
        <div class="cyber-panel-title">
            <i class="fa-solid fa-building"></i> TENANT MANAGEMENT
        </div>
        <div class="cyber-panel-sub">[ORGANIZATION MODULE] // TENANT REGISTRY</div>
    </div>
    <div class="cyber-panel-toolbar">
        <div class="cyber-panel-actions">
            <button type="button" class="btn-cyber-success btn-show-modal" data-url="@Url.Action("Create", "Tenants")">
                <i class="fa-solid fa-plus me-1"></i> ADD NEW TENANT
            </button>
            <a href="@Url.Action("ExportExcel", "Tenants")" class="btn-cyber-info btn-export-excel btn-export-link">
                <i class="fa-solid fa-file-excel me-1"></i> EXPORT EXCEL
            </a>
        </div>
        <div class="cyber-records-counter">
            TOTAL RECORDS: <strong id="totalRecordsCount" class="font-data-large">--</strong>
        </div>
    </div>
    <div class="table-responsive">
        <table id="datatable" class="table-cyber w-100">
            <thead>
                <tr>
                    <th class="th-num">#</th>
                    <th style="white-space:nowrap;">@Html.DisplayNameFor(model => model.TenantName)</th>
                    <th style="white-space:nowrap;">@Html.DisplayNameFor(model => model.Slug)</th>
                    <th style="white-space:nowrap;">@Html.DisplayNameFor(model => model.Address)</th>
                    <th style="white-space:nowrap;">@Html.DisplayNameFor(model => model.ContactPhone)</th>
                    <th style="white-space:nowrap;">@Html.DisplayNameFor(model => model.IsActive)</th>
                    <th class="th-actions">ACTIONS</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<div class="modal fade modal-cyber" id="globalModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-dialog-md" id="globalModalContainer"></div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script src="~/lib/datatables/js/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(document).ready(function(){
            var table = $('#datatable').DataTable({
                serverSide: true,
                processing: true,
                filter: true,
                ajax: {
                    url: '@Url.Action("Index_LoadData", "Tenants")',
                    type: "POST",
                    dataType: "JSON"
                },
                columns: [
                    { data: null, name: null, sortable: false, render: (d, t, r, meta) => meta.row + meta.settings._iDisplayStart + 1 },
                    { data: 'tenantName', name: 'TenantName', render: d => `<span class="font-header-title">${d}</span>` },
                    { data: 'slug', name: 'Slug', render: d => d ? d : 'N/A' },
                    { data: 'address', name: 'Address', render: d => d ? `<div class="text-ellipsis-box" title="${d}">${d}</div>` : '' },
                    { data: 'contactPhone', name: 'ContactPhone' },
                    { 
                        data: 'isActive', 
                        name: 'IsActive',
                        render: (d, t, r) => {
                            var antiForgery = $('input[name="__RequestVerificationToken"]').val() || '';
                            return `<form class="toggle-active-form" action="/Administrator/Tenants/ToggleActive/${r.tenantId || r.TenantId}" method="post" style="display:inline;">
                                        <input name="__RequestVerificationToken" type="hidden" value="${antiForgery}" />
                                        <button type="submit" class="badge ${d ? "bg-success" : "bg-secondary"} badge-status-toggle" title="Click to toggle status">
                                            ${d ? "ACTIVE" : "INACTIVE"}
                                        </button>
                                    </form>`;
                        }
                    },                            
                    { 
                        data: null, 
                        searchable: false, 
                        orderable: false, 
                        render: function (d, t, r) { 
                            var detailsUrl = '@Url.Action("Details", "Tenants")/' + r.tenantId;
                            var editUrl = '@Url.Action("Edit", "Tenants")/' + r.tenantId;
                            var deleteUrl = '@Url.Action("Delete", "Tenants")/' + r.tenantId;
                            return `<button type="button" class="btn-cyber-info btn-show-modal btn-action-dt btn-action-info" data-url="${detailsUrl}"><i class="fa-solid fa-circle-info"></i></button> `
                                 + `<button type="button" class="btn-cyber-primary btn-show-modal btn-action-dt btn-action-edit" data-url="${editUrl}"><i class="fa-solid fa-pen-to-square"></i></button> `
                                 + `<button type="button" class="btn-cyber-danger btn-show-modal btn-action-dt btn-action-delete" data-url="${deleteUrl}"><i class="fa-solid fa-trash"></i></button>`; 
                        } 
                    }                        
                ],
                drawCallback: function (settings) {
                    var api = this.api();
                    var json = api.ajax.json();
                    if (json && json.recordsTotal !== undefined) {
                        $('#totalRecordsCount').text(json.recordsTotal);
                    }
                }
            });   
        });
    </script>
}

