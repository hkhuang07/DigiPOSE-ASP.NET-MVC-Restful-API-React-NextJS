@model DigiPOSE.Controllers.StorefrontIndexViewModel
@{
    Layout = "~/Views/Shared/_StorefrontLayout.cshtml";
    ViewData["Title"] = "Digital Retail Storefront & POS Catalog";
}

<!-- Styled via high-performance cached wwwroot/css/cyber-storefront.css -->

<div class="container-fluid px-4 px-xl-5 my-4" style="max-width: 1800px;">
    <!-- Storefront Title Bar -->
    <div class="d-flex flex-wrap justify-content-between align-items-center pb-4 mb-0" style="border-bottom: 2px solid var(--cyber-cyan); background: rgba(0,229,255,0.04); padding: 25px;">
        <div>
            <div style="font-family:'VT323'; color:var(--cyber-emerald); font-size:1.3rem;">> ONLINE_RETAIL_MARKETPLACE // 100% REAL_DB_CONNECTION [ ONLINE ] _</div>
            <h1 style="font-family:'Orbitron'; font-weight:900; font-size:2.5rem; color:#FFFFFF; margin: 5px 0 0 0; text-shadow:0 0 15px rgba(0,229,255,0.5);">
                <i class="fa-solid fa-microchip text-cyan me-3"></i> DIGIPOSE OFFICIAL STOREFRONT
            </h1>
        </div>
        <div class="mt-3 mt-md-0">
            <span style="font-family:'VT323'; color:var(--cyber-muted); font-size:1.1rem;">
                > CATALOG ASSETS: <span style="color:var(--cyber-emerald);">@Model.Products.Count</span> // CATEGORIES: <span style="color:var(--cyber-cyan);">@Model.Categories.Count</span> _
            </span>
        </div>
    </div>

    <!-- HERO ROTATING CAROUSEL WIDGET (Every 3 Seconds) -->
    @if (Model.FeaturedProducts != null && Model.FeaturedProducts.Any())
    {
        <div id="cyberHeroCarousel" class="carousel slide mb-0" data-bs-ride="carousel" data-bs-interval="3000" style="border: 1px solid var(--cyber-cyan); border-top:none; background: var(--cyber-surface); box-shadow: 0 0 25px rgba(0, 229, 255, 0.2);">
            <div class="carousel-indicators" style="margin-bottom: 10px;">
                @for (int i = 0; i < Model.FeaturedProducts.Count; i++)
                {
                    <button type="button" data-bs-target="#cyberHeroCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" style="width: 35px; height: 4px; background: var(--cyber-cyan);"></button>
                }
            </div>
            <div class="carousel-inner">
                @for (int i = 0; i < Model.FeaturedProducts.Count; i++)
                {
                    var feat = Model.FeaturedProducts[i];
                    var featImg = !string.IsNullOrEmpty(feat.ImageUrl) ? feat.ImageUrl : "/demo/products/default_cyber_product.png";
                    <div class="carousel-item @(i == 0 ? "active" : "")" style="padding: 40px 50px; min-height: 300px; background: linear-gradient(90deg, rgba(10,10,10,0.95) 45%, rgba(0,229,255,0.05) 100%);">
                        <div class="row align-items-center g-4">
                            <div class="col-lg-8 text-start">
                                <span class="badge mb-2" style="background:var(--cyber-emerald); color:#000; font-family:'VT323'; font-size:1.2rem; padding: 5px 15px;">
                                    > FEATURED // @feat.Category?.CategoryName?.ToUpper() _
                                </span>
                                <div style="font-family:'VT323'; color:var(--cyber-amber); font-size:1.3rem; letter-spacing:2px; margin-top:5px;">
                                    [ SKU: @feat.SKU ] // MFR: @(feat.Manufacturer?.ManufacturerName ?? "Original Architecture")
                                </div>
                                <h2 style="font-family:'Orbitron'; font-weight:900; font-size:2.2rem; color:#FFF; margin: 10px 0; text-shadow:0 0 10px rgba(0,255,102,0.4);">
                                    @feat.ProductName
                                </h2>
                                <p style="color:var(--cyber-muted); font-size:0.95rem; max-width: 700px; line-height:1.6; margin-bottom: 22px;">
                                    @(string.IsNullOrWhiteSpace(feat.Description) ? "Authentic POS & ERP compute node asset designed for mission-critical retail environments. Low-latency I/O optimized." : feat.Description)
                                </p>
                                <div class="d-flex align-items-center gap-4">
                                    <div style="font-family:'VT323'; font-size:2.8rem; font-weight:bold; color:var(--cyber-cyan); text-shadow:0 0 12px rgba(0,229,255,0.6);">
                                        @feat.BasePrice.ToString("N0") VND
                                    </div>
                                    <button class="btn btn-lg px-5 py-3" style="background:var(--cyber-cyan); color:#000; font-family:'Orbitron'; font-weight:900; border-radius:0; font-size:1rem; text-transform:uppercase;" onclick="addToStorefrontCart(@feat.ProductId, @(feat.BasePrice.ToString(System.Globalization.CultureInfo.InvariantCulture)), '@(feat.Unit?.UnitName ?? "Unit")')">
                                        <i class="fa-solid fa-cart-plus me-2"></i> [ ACQUIRE ASSET ]
                                    </button>
                                </div>
                            </div>
                            <div class="col-lg-4 text-center d-none d-lg-flex align-items-center justify-content-center">
                                <div style="width: 230px; height: 230px; border: 1px dashed var(--cyber-border); display: flex; align-items: center; justify-content: center; background:#000; box-shadow: 0 0 30px rgba(0,229,255,0.15);">
                                    @if (featImg.StartsWith("/") || featImg.StartsWith("http"))
                                    {
                                        <img src="@featImg" alt="@feat.ProductName" style="max-height: 210px; max-width: 210px; object-fit: contain;" />
                                    }
                                    else
                                    {
                                        <i class="fa-solid fa-desktop" style="font-size:6rem; color:var(--cyber-cyan); opacity:0.8;"></i>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- ================================================================
         SEARCH + FILTER TOOLBAR
         {[⊞ toggle]} [Search Input __________][SEARCH] [CATEGORIES▾][MANUFACTURERS▾][PRODUCT TYPE▾][ITEM NATURE▾] [↺]
    ================================================================ -->
    <div class="sf-toolbar mb-4">
        <!-- Toggle Filter Matrix Sidebar -->
        <button class="sf-toggle-filter" id="btnToggleFilter" onclick="toggleFilterMatrix()" title="Show / Hide Filter Matrix">
            <i class="fa-solid fa-sliders"></i>
        </button>

        <!-- Live Search bar -->
        <div class="sf-search-group">
            <input type="text" id="searchInput" placeholder="Search name, SKU, slug, spec..." oninput="triggerDebouncedSearch(this.value)" onkeypress="if(event.key==='Enter') triggerLiveSearch()" />
            <button class="sf-search-btn" type="button" onclick="triggerLiveSearch()">
                <i class="fa-solid fa-magnifying-glass me-1"></i> SEARCH
            </button>
        </div>

        <!-- 4 Dropdown Filter buttons -->
        <div class="position-relative" id="ddWrap-cat">
            <button class="sf-filter-btn" id="btnCat" onclick="toggleDropdown('cat')">
                <i class="fa-solid fa-folder-tree me-1"></i> CATEGORIES <i class="fa-solid fa-chevron-down ms-1" style="font-size:0.55rem;"></i>
            </button>
            <div class="sf-dropdown-panel" id="ddPanel-cat">
                <div class="sf-opt" onclick="filterByDropdown('all', 0, 'cat')">
                    <span>> [ ALL CATEGORIES ]</span><span class="badge bg-secondary">@Model.Products.Count</span>
                </div>
                @foreach (var c in Model.Categories)
                {
                    <div class="sf-opt" onclick="filterByDropdown('cat', @c.CategoryId, 'cat')">
                        <span>> @c.CategoryName</span>
                        <span class="badge" style="background:var(--cyber-cyan); color:#000;">@Model.Products.Count(p => p.CategoryId == c.CategoryId)</span>
                    </div>
                }
            </div>
        </div>

        <div class="position-relative" id="ddWrap-mfr">
            <button class="sf-filter-btn" id="btnMfr" onclick="toggleDropdown('mfr')">
                <i class="fa-solid fa-industry me-1"></i> MANUFACTURERS <i class="fa-solid fa-chevron-down ms-1" style="font-size:0.55rem;"></i>
            </button>
            <div class="sf-dropdown-panel" id="ddPanel-mfr">
                <div class="sf-opt" onclick="filterByDropdown('all', 0, 'mfr')"><span>> [ ALL MANUFACTURERS ]</span></div>
                @foreach (var m in Model.Manufacturers)
                {
                    <div class="sf-opt" onclick="filterByDropdown('mfr', @m.ManufacturerId, 'mfr')">
                        <span>> @m.ManufacturerName</span>
                        <span class="badge" style="background:var(--cyber-amber); color:#000;">@Model.Products.Count(p => p.ManufacturerId == m.ManufacturerId)</span>
                    </div>
                }
            </div>
        </div>

        <div class="position-relative" id="ddWrap-type">
            <button class="sf-filter-btn" id="btnType" onclick="toggleDropdown('type')">
                <i class="fa-solid fa-bars-staggered me-1"></i> PRODUCT TYPE <i class="fa-solid fa-chevron-down ms-1" style="font-size:0.55rem;"></i>
            </button>
            <div class="sf-dropdown-panel" id="ddPanel-type">
                <div class="sf-opt" onclick="filterByDropdown('all', 0, 'type')"><span>> [ ALL TYPES ]</span></div>
                @foreach (var t in Model.ProductTypes)
                {
                    <div class="sf-opt" onclick="filterByDropdown('type', @t.ProductTypeId, 'type')">
                        <span>> @t.TypeName</span>
                        <span class="badge bg-info text-dark">@Model.Products.Count(p => p.ProductTypeId == t.ProductTypeId)</span>
                    </div>
                }
            </div>
        </div>

        <div class="position-relative" id="ddWrap-nature">
            <button class="sf-filter-btn" id="btnNature" onclick="toggleDropdown('nature')">
                <i class="fa-solid fa-compact-disc me-1"></i> ITEM NATURE <i class="fa-solid fa-chevron-down ms-1" style="font-size:0.55rem;"></i>
            </button>
            <div class="sf-dropdown-panel" id="ddPanel-nature">
                <div class="sf-opt" onclick="filterByDropdown('all', 0, 'nature')"><span>> [ ALL NATURES ]</span></div>
                @foreach (var n in Model.ItemNatures)
                {
                    <div class="sf-opt" onclick="filterByDropdown('nature', @n.NatureId, 'nature')">
                        <span>> @n.NatureName</span>
                        <span class="badge" style="background:var(--cyber-emerald); color:#000;">@Model.Products.Count(p => p.ItemNatureId == n.NatureId)</span>
                    </div>
                }
            </div>
        </div>

        <!-- Reset button -->
        <button class="sf-filter-btn" type="button" onclick="resetAllFilters()" title="Reset All Filters" style="border-color:var(--cyber-amber); color:var(--cyber-amber);">
            <i class="fa-solid fa-rotate-left"></i>
        </button>
    </div>

    <!-- MAIN GRID MATRIX -->
    <div class="row g-4">
        <!-- Left Sidebar Filter Matrix — hidden by default, toggled by ⊞ button -->
        <div id="filterMatrixPanel" class="col-lg-3">
            <div class="p-3" style="background: var(--cyber-surface); border: 1px solid var(--cyber-cyan); position: sticky; top: 90px; box-shadow: 0 0 20px rgba(0, 229, 255, 0.15);">
                <div class="d-flex justify-content-between align-items-center mb-3 pb-2" style="border-bottom: 2px solid var(--cyber-cyan);">
                    <h5 style="font-family:'Orbitron'; font-weight:900; color:#FFF; margin:0; font-size:0.85rem;">
                        <i class="fa-solid fa-filter text-cyan me-2"></i> FILTER MATRIX
                    </h5>
                    <span class="badge" style="background:var(--cyber-emerald); color:#000; font-family:'VT323'; font-size:0.95rem;">LIVE</span>
                </div>
                <div class="accordion cyber-accordion" id="filterAccordion">
                    <!-- Category -->
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="headingCat">
                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCat" aria-expanded="true">
                                <i class="fa-solid fa-folder-tree me-2"></i> CATEGORIES
                            </button>
                        </h2>
                        <div id="collapseCat" class="accordion-collapse collapse show">
                            <div class="accordion-body p-1">
                                <ul class="filter-tree-list">
                                    <li onclick="filterByDropdown('all', 0, null)">
                                        <span>> [ ALL ]</span> <span class="badge bg-secondary">@Model.Products.Count</span>
                                    </li>
                                    @foreach (var c in Model.Categories)
                                    {
                                        <li onclick="filterByDropdown('cat', @c.CategoryId, null)">
                                            <span>> @c.CategoryName</span>
                                            <span class="badge" style="background:var(--cyber-cyan); color:#000;">@Model.Products.Count(p => p.CategoryId == c.CategoryId)</span>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                    <!-- Manufacturer -->
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseMfr">
                                <i class="fa-solid fa-industry me-2"></i> MANUFACTURERS
                            </button>
                        </h2>
                        <div id="collapseMfr" class="accordion-collapse collapse">
                            <div class="accordion-body p-1">
                                <ul class="filter-tree-list">
                                    @foreach (var m in Model.Manufacturers)
                                    {
                                        <li onclick="filterByDropdown('mfr', @m.ManufacturerId, null)">
                                            <span>> @m.ManufacturerName</span>
                                            <span class="badge" style="background:var(--cyber-amber); color:#000;">@Model.Products.Count(p => p.ManufacturerId == m.ManufacturerId)</span>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                    <!-- Product Type -->
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseType">
                                <i class="fa-solid fa-bars-staggered me-2"></i> PRODUCT TYPES
                            </button>
                        </h2>
                        <div id="collapseType" class="accordion-collapse collapse">
                            <div class="accordion-body p-1">
                                <ul class="filter-tree-list">
                                    @foreach (var t in Model.ProductTypes)
                                    {
                                        <li onclick="filterByDropdown('type', @t.ProductTypeId, null)">
                                            <span>> @t.TypeName</span>
                                            <span class="badge bg-info text-dark">@Model.Products.Count(p => p.ProductTypeId == t.ProductTypeId)</span>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                    <!-- Item Nature -->
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseNature">
                                <i class="fa-solid fa-compact-disc me-2"></i> ITEM NATURE
                            </button>
                        </h2>
                        <div id="collapseNature" class="accordion-collapse collapse">
                            <div class="accordion-body p-1">
                                <ul class="filter-tree-list">
                                    @foreach (var n in Model.ItemNatures)
                                    {
                                        <li onclick="filterByDropdown('nature', @n.NatureId, null)">
                                            <span>> @n.NatureName</span>
                                            <span class="badge" style="background:var(--cyber-emerald); color:#000;">@Model.Products.Count(p => p.ItemNatureId == n.NatureId)</span>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Main Content -->
        <div id="mainContentCol" class="col-12">
            <!-- Filtered Results (hidden by default) -->
            <div id="filteredResultsContainer" style="display: none;">
                <div class="d-flex justify-content-between align-items-center mb-4 pb-2" style="border-bottom: 2px solid var(--cyber-cyan);">
                    <h3 style="font-family:'Orbitron'; font-weight:900; color:#FFF; margin:0;">
                        <i class="fa-solid fa-crosshairs text-cyan me-2"></i> FILTERED ASSET MATRIX
                    </h3>
                    <span style="font-family:'VT323'; font-size:1.4rem; color:var(--cyber-emerald);" id="filteredCountText">FOUND 0 ASSETS</span>
                </div>
                <!-- 4-column minimum grid for filtered results -->
                <div class="row row-cols-2 row-cols-md-4 g-3 mb-5" id="filteredProductsGrid"></div>
            </div>

            <!-- Category Batch Sections -->
            <div id="categoryBatchesContainer">
                @foreach (var cat in Model.Categories)
                {
                    var catProducts = Model.Products.Where(p => p.CategoryId == cat.CategoryId).Take(8).ToList();
                    if (!catProducts.Any()) continue;

                    <div class="mb-5 pb-3">
                        <div class="d-flex justify-content-between align-items-center mb-4 pb-2" style="border-bottom: 2px solid var(--cyber-cyan);">
                            <h3 style="font-family:'Orbitron'; font-weight:900; color:#FFF; margin:0; text-shadow:0 0 10px rgba(0,229,255,0.4);">
                                <i class="fa-solid fa-layer-group text-cyan me-2"></i> @cat.CategoryName.ToUpper()
                            </h3>
                            <button class="btn btn-sm btn-outline-info" style="border-radius:0; font-family:'Orbitron'; font-weight:bold;" onclick="filterByDropdown('cat', @cat.CategoryId, null)">
                                [ VIEW ALL ] <i class="fa-solid fa-chevron-right ms-1"></i>
                            </button>
                        </div>
                        <!-- 4 columns minimum grid -->
                        <div class="row row-cols-2 row-cols-md-4 g-3">
                            @foreach (var prod in catProducts)
                            {
                                var pImg = !string.IsNullOrEmpty(prod.ImageUrl) ? prod.ImageUrl : "/demo/products/default_cyber_product.png";
                                <div class="col">
                                    <div class="card cyber-card h-100 d-flex flex-column justify-content-between">
                                        <div>
                                            <div class="cyber-card-img-box">
                                                @if (pImg.StartsWith("/") || pImg.StartsWith("http"))
                                                {
                                                    <img src="@pImg" alt="@prod.ProductName" style="max-height: 170px; max-width: 90%; object-fit: contain;" />
                                                }
                                                else
                                                {
                                                    <i class="fa-solid fa-desktop" style="font-size:4.5rem; color:var(--cyber-cyan); opacity:0.8;"></i>
                                                }
                                                <span class="badge" style="position:absolute; top:10px; left:10px; background:var(--cyber-emerald); color:#000; font-family:'VT323'; font-size:1rem; font-weight:bold; border-radius:0;">
                                                    @(prod.ItemNature?.NatureName ?? "IN STOCK")
                                                </span>
                                            </div>
                                            <div class="card-body p-3">
                                                <div style="font-family:'VT323'; color:var(--cyber-amber); font-size:0.95rem; letter-spacing:1px;">
                                                    SKU: @prod.SKU // @(prod.Manufacturer?.ManufacturerName ?? "GENERIC")
                                                </div>
                                                <h5 style="font-family:'Orbitron'; color:#FFF; font-size:1rem; font-weight:700; margin:6px 0;">
                                                    @prod.ProductName
                                                </h5>
                                                <p style="color:var(--cyber-muted); font-size:0.8rem; line-height:1.5; margin-bottom:10px; height:44px; overflow:hidden; text-overflow:ellipsis;">
                                                    @(string.IsNullOrWhiteSpace(prod.Description) ? $"Authentic POS system node asset ({prod.ProductType?.TypeName}). Verified enterprise SLA." : prod.Description)
                                                </p>
                                            </div>
                                        </div>
                                        <div class="p-3 pt-0 mt-auto">
                                            <div class="pt-2" style="border-top:1px dashed var(--cyber-border);">
                                                <div class="d-flex justify-content-between align-items-end mb-2">
                                                    <span style="font-family:'Roboto Mono'; font-size:0.68rem; color:var(--cyber-muted);">LIST PRICE:</span>
                                                    <span style="font-family:'VT323'; font-size:1.7rem; color:var(--cyber-cyan); font-weight:bold; line-height:1;">@prod.BasePrice.ToString("N0") VND</span>
                                                </div>
                                                <button class="btn w-100 py-2" style="background:var(--cyber-cyan); color:#000; font-family:'Orbitron'; font-weight:900; border-radius:0; font-size:0.82rem; text-transform:uppercase;" onclick="addToStorefrontCart(@prod.ProductId, @(prod.BasePrice.ToString(System.Globalization.CultureInfo.InvariantCulture)), '@(prod.Unit?.UnitName ?? "Unit")')">
                                                    <i class="fa-solid fa-cart-plus me-2"></i> [ ADD TO STAGING CART ]
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ====================================================================
        // FILTER MATRIX SIDEBAR TOGGLE
        // ====================================================================
        function toggleFilterMatrix() {
            const panel = document.getElementById('filterMatrixPanel');
            const mainCol = document.getElementById('mainContentCol');
            const btn = document.getElementById('btnToggleFilter');
            const isOpen = panel.classList.toggle('open');
            btn.classList.toggle('active', isOpen);
            if (isOpen) {
                mainCol.classList.remove('col-12');
                mainCol.classList.add('col-lg-9');
            } else {
                mainCol.classList.add('col-12');
                mainCol.classList.remove('col-lg-9');
            }
        }

        // ====================================================================
        // DROPDOWN FILTER PANELS
        // ====================================================================
        const dropdownKeys = ['cat', 'mfr', 'type', 'nature'];

        function toggleDropdown(key) {
            dropdownKeys.forEach(k => {
                const panel = document.getElementById('ddPanel-' + k);
                const btn = document.getElementById('btn' + k.charAt(0).toUpperCase() + k.slice(1));
                if (k === key) {
                    const nowOpen = panel.classList.toggle('open');
                    if (btn) btn.classList.toggle('active', nowOpen);
                } else {
                    panel.classList.remove('open');
                    if (btn) btn.classList.remove('active');
                }
            });
        }

        // Close dropdowns on outside click
        document.addEventListener('click', function (e) {
            dropdownKeys.forEach(k => {
                const wrap = document.getElementById('ddWrap-' + k);
                if (wrap && !wrap.contains(e.target)) {
                    document.getElementById('ddPanel-' + k)?.classList.remove('open');
                    const btn = document.getElementById('btn' + k.charAt(0).toUpperCase() + k.slice(1));
                    if (btn) btn.classList.remove('active');
                }
            });
        });

        // ====================================================================
        // UNIFIED MULTI-FILTER & REAL-TIME DEBOUNCED SEARCH MATRIX
        // ====================================================================
        const unifiedMatrixState = {
            Query: '',
            CategoryId: null,
            ManufacturerId: null,
            ProductTypeId: null,
            ItemNatureId: null,
            SortBy: 'name',
            PageNumber: 1,
            PageSize: 100
        };

        let liveSearchDebounceTimer = null;

        function triggerDebouncedSearch(val) {
            unifiedMatrixState.Query = val ? val.trim() : '';
            clearTimeout(liveSearchDebounceTimer);
            liveSearchDebounceTimer = setTimeout(() => {
                evaluateAndExecuteMatrix();
            }, 300);
        }

        function filterByDropdown(type, id, sourceKey) {
            if (sourceKey) {
                document.getElementById('ddPanel-' + sourceKey)?.classList.remove('open');
                const srcBtn = document.getElementById('btn' + sourceKey.charAt(0).toUpperCase() + sourceKey.slice(1));
                if (srcBtn) srcBtn.classList.remove('active');
            }
            if (type === 'all' || id === 0) {
                if (type === 'all' && !sourceKey) {
                    resetAllFilters();
                    return;
                }
                if (sourceKey === 'cat' || type === 'cat') unifiedMatrixState.CategoryId = null;
                if (sourceKey === 'mfr' || type === 'mfr') unifiedMatrixState.ManufacturerId = null;
                if (sourceKey === 'type' || type === 'type') unifiedMatrixState.ProductTypeId = null;
                if (sourceKey === 'nature' || type === 'nature') unifiedMatrixState.ItemNatureId = null;
            } else {
                if (type === 'cat' || sourceKey === 'cat') unifiedMatrixState.CategoryId = id;
                if (type === 'mfr' || sourceKey === 'mfr') unifiedMatrixState.ManufacturerId = id;
                if (type === 'type' || sourceKey === 'type') unifiedMatrixState.ProductTypeId = id;
                if (type === 'nature' || sourceKey === 'nature') unifiedMatrixState.ItemNatureId = id;
                if (sourceKey) {
                    const srcBtn = document.getElementById('btn' + sourceKey.charAt(0).toUpperCase() + sourceKey.slice(1));
                    if (srcBtn) srcBtn.classList.add('active');
                }
            }
            evaluateAndExecuteMatrix();
        }

        function triggerLiveSearch() {
            unifiedMatrixState.Query = document.getElementById('searchInput').value.trim();
            evaluateAndExecuteMatrix();
        }

        function evaluateAndExecuteMatrix() {
            const hasQuery = Boolean(unifiedMatrixState.Query && unifiedMatrixState.Query.length > 0);
            const hasFilter = unifiedMatrixState.CategoryId || unifiedMatrixState.ManufacturerId || unifiedMatrixState.ProductTypeId || unifiedMatrixState.ItemNatureId;
            
            if (!hasQuery && !hasFilter) {
                document.getElementById('filteredResultsContainer').style.display = 'none';
                document.getElementById('categoryBatchesContainer').style.display = 'block';
                return;
            }

            let descParts = [];
            if (hasQuery) descParts.push(`QUERY '${unifiedMatrixState.Query}'`);
            if (unifiedMatrixState.CategoryId) descParts.push(`CAT #${unifiedMatrixState.CategoryId}`);
            if (unifiedMatrixState.ManufacturerId) descParts.push(`MFR #${unifiedMatrixState.ManufacturerId}`);
            if (unifiedMatrixState.ProductTypeId) descParts.push(`TYPE #${unifiedMatrixState.ProductTypeId}`);
            if (unifiedMatrixState.ItemNatureId) descParts.push(`NATURE #${unifiedMatrixState.ItemNatureId}`);

            executeSearchApi({ ...unifiedMatrixState }, descParts.join(' + '));
        }

        function resetAllFilters() {
            document.getElementById('searchInput').value = '';
            unifiedMatrixState.Query = '';
            unifiedMatrixState.CategoryId = null;
            unifiedMatrixState.ManufacturerId = null;
            unifiedMatrixState.ProductTypeId = null;
            unifiedMatrixState.ItemNatureId = null;
            document.getElementById('filteredResultsContainer').style.display = 'none';
            document.getElementById('categoryBatchesContainer').style.display = 'block';
            dropdownKeys.forEach(k => {
                document.getElementById('ddPanel-' + k)?.classList.remove('open');
                const b = document.getElementById('btn' + k.charAt(0).toUpperCase() + k.slice(1));
                if (b) b.classList.remove('active');
            });
        }

        function executeSearchApi(payload, titleInfo) {
            document.getElementById('categoryBatchesContainer').style.display = 'none';
            const container = document.getElementById('filteredResultsContainer');
            container.style.display = 'block';
            document.getElementById('filteredCountText').innerText = titleInfo;
            document.getElementById('filteredProductsGrid').innerHTML = `
                <div class="col-12 text-center py-5">
                    <i class="fa-solid fa-circle-notch fa-spin text-cyan" style="font-size:3rem;"></i>
                    <p style="font-family:'VT323'; font-size:1.5rem; color:var(--cyber-emerald); margin-top:15px;">> QUERYING CATALOG LEDGER // _</p>
                </div>`;

            fetch('/api/v1/Storefront/catalog/search', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
            .then(res => res.json())
            .then(data => {
                document.getElementById('filteredCountText').innerText = `FOUND ${data.totalRecords || 0} ASSETS`;
                if (!data.products || data.products.length === 0) {
                    document.getElementById('filteredProductsGrid').innerHTML = `
                        <div class="col-12 text-center py-5">
                            <i class="fa-solid fa-folder-open text-warning mb-3" style="font-size:3.5rem;"></i>
                            <h4 style="font-family:'Orbitron'; color:#FFF;">NO ASSETS MATCHED</h4>
                            <p style="color:var(--cyber-muted);">Recalibrate search parameters or reset filter.</p>
                            <button class="btn btn-outline-info px-4 mt-3" style="border-radius:0; font-family:'Orbitron'; font-weight:bold;" onclick="resetAllFilters()">[ RESET MATRIX ]</button>
                        </div>`;
                    return;
                }
                let html = '';
                data.products.forEach(p => {
                    const priceFormatted = new Intl.NumberFormat('vi-VN').format(p.basePrice) + ' VND';
                    const img = p.imageUrl || '/demo/products/default_cyber_product.png';
                    const imgTag = (img.startsWith('/') || img.startsWith('http'))
                        ? `<img src="${img}" style="max-height:170px; max-width:90%; object-fit:contain;" alt="${p.productName}"/>`
                        : `<i class="fa-solid fa-desktop" style="font-size:4.5rem; color:var(--cyber-cyan); opacity:0.8;"></i>`;
                    html += `
                    <div class="col">
                        <div class="card cyber-card h-100 d-flex flex-column justify-content-between">
                            <div>
                                <div class="cyber-card-img-box">
                                    ${imgTag}
                                    <span class="badge" style="position:absolute; top:10px; left:10px; background:var(--cyber-emerald); color:#000; font-family:'VT323'; font-size:1rem; font-weight:bold; border-radius:0;">
                                        ${p.isDigitalSaaS ? "SAAS LICENSE" : "HARDWARE"}
                                    </span>
                                </div>
                                <div class="card-body p-3">
                                    <div style="font-family:'VT323'; color:var(--cyber-amber); font-size:0.95rem; letter-spacing:1px;">
                                        SKU: ${p.sku} // ${p.manufacturerName}
                                    </div>
                                    <h5 style="font-family:'Orbitron'; color:#FFF; font-size:1rem; font-weight:700; margin:6px 0;">
                                        ${p.productName}
                                    </h5>
                                    <p style="color:var(--cyber-muted); font-size:0.8rem; line-height:1.5; margin-bottom:10px; height:44px; overflow:hidden; text-overflow:ellipsis;">
                                        ${p.metaDescription || "Authentic POS system compute asset. Verified enterprise SLA."}
                                    </p>
                                </div>
                            </div>
                            <div class="p-3 pt-0 mt-auto">
                                <div class="pt-2" style="border-top:1px dashed var(--cyber-border);">
                                    <div class="d-flex justify-content-between align-items-end mb-2">
                                        <span style="font-family:'Roboto Mono'; font-size:0.68rem; color:var(--cyber-muted);">LIST PRICE:</span>
                                        <span style="font-family:'VT323'; font-size:1.7rem; color:var(--cyber-cyan); font-weight:bold; line-height:1;">${priceFormatted}</span>
                                    </div>
                                    <button class="btn w-100 py-2" style="background:var(--cyber-cyan); color:#000; font-family:'Orbitron'; font-weight:900; border-radius:0; font-size:0.82rem; text-transform:uppercase;" onclick="addToStorefrontCart(${p.productId}, ${p.basePrice}, 'Unit')">
                                        <i class="fa-solid fa-cart-plus me-2"></i> [ ADD TO STAGING CART ]
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>`;
                });
                document.getElementById('filteredProductsGrid').innerHTML = html;
            })
            .catch(err => {
                console.error('>>> [SEARCH_MATRIX_ERR]:', err);
                document.getElementById('filteredProductsGrid').innerHTML = `
                    <div class="col-12 text-center py-5 text-danger">
                        <i class="fa-solid fa-triangle-exclamation mb-3" style="font-size:3rem;"></i>
                        <h4>>> CATALOG API FAULT // CHECK CONSOLE _</h4>
                    </div>`;
            });
        }
    </script>
}
