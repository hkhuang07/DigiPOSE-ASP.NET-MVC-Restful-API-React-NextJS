@model DigiPOSE.Models.User
@{
    ViewData["Title"] = "Modify Operator Telemetry & Avatar";
    string? currentAvatar = string.IsNullOrEmpty(Model.ImageUrl)
        ? null
        : Url.Content("~/uploads/avatars/" + Model.ImageUrl);
}

<div class="hud-content-wrapper" style="padding: 25px;">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4" style="border-bottom: 2px solid #00E5FF; padding-bottom: 12px; background: rgba(0, 229, 255, 0.05); padding: 15px;">
        <div>
            <div style="font-family: 'VT323', monospace; font-size: 1.1rem; color: #00FF66;">> SYSTEM_IAM_MODIFY // TARGET: @Model.UserName _</div>
            <h2 style="font-family: 'Orbitron', sans-serif; color: #FFFFFF; font-weight: 700; margin: 0; text-shadow: 0 0 12px rgba(0, 229, 255, 0.5);">
                <i class="fa-solid fa-user-pen text-cyan me-2"></i> UPDATE PERSONNEL ATTRIBUTES & AVATAR
            </h2>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary" style="font-family: 'Orbitron', sans-serif; border-color: #A0C0CE; color: #FFFFFF; text-transform: uppercase; font-weight: bold; border-radius: 0;">
                <i class="fa-solid fa-arrow-left me-2"></i> ABORT & RETURN
            </a>
        </div>
    </div>

    <!-- Edit Form with enctype="multipart/form-data" -->
    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="background: rgba(255, 51, 51, 0.1); border: 1px solid #FF3333; color: #FF3333; border-radius: 0; font-family: 'Roboto Mono';"></div>
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="UserName" />
        <input type="hidden" asp-for="PasswordHash" />
        <input type="hidden" asp-for="RoleId" />
        <input type="hidden" asp-for="TenantId" />
        <input type="hidden" asp-for="IsActive" />
        <input type="hidden" asp-for="ImageUrl" />

        <div class="row g-4">
            <!-- Left: Avatar Live Preview Panel -->
            <div class="col-lg-4 col-md-5">
                <div class="card h-100" style="background: #0A0A0A; border: 1px solid #00E5FF; border-radius: 0; padding: 20px; text-align: center; box-shadow: 0 0 20px rgba(0, 229, 255, 0.15);">
                    <h5 style="font-family: 'Orbitron', sans-serif; color: #00E5FF; text-transform: uppercase; font-size: 1rem; margin-bottom: 20px;">
                        <i class="fa-solid fa-camera-viewfinder me-2"></i> BIOMETRIC AVATAR PREVIEW
                    </h5>

                    <div style="width: 240px; height: 240px; margin: 0 auto 20px auto; border: 2px dashed #00E5FF; padding: 5px; background: #000; position: relative; overflow: hidden;">
                        <img id="avatarPreview" src="@(currentAvatar ?? "")" alt="Avatar Preview" style="width: 100%; height: 100%; object-fit: cover; @(currentAvatar == null ? "display: none;" : "")" />
                        
                        <div id="noAvatarPlaceholder" style="width: 100%; height: 100%; display: @(currentAvatar != null ? "none" : "flex"); flex-direction: column; align-items: center; justify-content: center; color: rgba(0, 229, 255, 0.4);">
                            <i class="fa-solid fa-user-circle" style="font-size: 5rem;"></i>
                            <span style="font-family: 'VT323'; font-size: 1.2rem; margin-top: 10px; color: #FFB000;">[ SELECT IMAGE FILE ]</span>
                        </div>
                    </div>

                    <div class="text-start" style="font-family: 'Roboto Mono'; font-size: 0.85rem;">
                        <label asp-for="ImageUpload" class="form-label text-cyan fw-bold" style="color: #00FF66;">UPLOAD NEW AVATAR (JPG/PNG/WEBP):</label>
                        <input type="file" asp-for="ImageUpload" class="form-control" id="imageInput" accept=".jpg,.jpeg,.png,.webp,.gif" style="background: #000; border: 1px solid #00E5FF; color: #FFF; border-radius: 0;" />
                        <span asp-validation-for="ImageUpload" class="text-danger"></span>
                        <div style="color: #A0C0CE; font-size: 0.75rem; margin-top: 8px;">
                            <i class="fa-solid fa-shield-halved text-success me-1"></i> File names are automatically anonymized via cryptographic GUIDs upon storage to prevent traversal vulnerabilities.
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right: Editable Credential Attributes -->
            <div class="col-lg-8 col-md-7">
                <div class="card h-100" style="background: #0A0A0A; border: 1px solid rgba(0, 229, 255, 0.6); border-radius: 0;">
                    <div class="card-header" style="background: rgba(0, 229, 255, 0.1); border-bottom: 1px solid #00E5FF; padding: 12px 20px;">
                        <h4 style="font-family: 'Orbitron', sans-serif; color: #00E5FF; margin: 0; font-size: 1.1rem;">
                            <i class="fa-solid fa-terminal me-2"></i> OPERATOR TELEMETRY PARAMETERS
                        </h4>
                    </div>

                    <div class="card-body p-4" style="font-family: 'Roboto Mono', monospace;">
                        <div class="mb-4">
                            <label class="form-label" style="color: #00E5FF; font-family: 'Orbitron'; text-transform: uppercase; font-size: 0.8rem;">Username [ IMMUTABLE IAM KEY ]</label>
                            <input type="text" class="form-control" value="@Model.UserName" disabled style="background: rgba(255,255,255,0.05); border: 1px solid #333; color: #FFB000; border-radius: 0; font-family: 'VT323'; font-size: 1.3rem; font-weight: bold;" />
                            <small style="color: #666;">Username is locked to prevent foreign system identifier discrepancies.</small>
                        </div>

                        <div class="mb-4">
                            <label asp-for="FullName" class="form-label" style="color: #00FF66; font-family: 'Orbitron'; text-transform: uppercase; font-size: 0.8rem;">Full Name (Operator Designation)</label>
                            <input asp-for="FullName" class="form-control" placeholder="Enter full administrative name..." style="background: #000; border: 1px solid #00FF66; color: #FFF; border-radius: 0; font-size: 1.1rem; padding: 10px;" />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label" style="color: #00E5FF; font-family: 'Orbitron'; text-transform: uppercase; font-size: 0.8rem;">Contact Email Line</label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background: #000; border: 1px solid #00E5FF; color: #FFB000; border-radius: 0;"><i class="fa-solid fa-envelope"></i></span>
                                    <input asp-for="Email" type="email" class="form-control" placeholder="operator@digipose.com" style="background: #000; border: 1px solid #00E5FF; color: #FFF; border-radius: 0; font-size: 1rem;" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                            
                            <div class="col-md-6">
                                <label asp-for="PhoneNumber" class="form-label" style="color: #00E5FF; font-family: 'Orbitron'; text-transform: uppercase; font-size: 0.8rem;">Contact Phone (0xxxxxxxxx)</label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background: #000; border: 1px solid #00E5FF; color: #00FF66; border-radius: 0;"><i class="fa-solid fa-phone"></i></span>
                                    <input asp-for="PhoneNumber" type="text" class="form-control" placeholder="09xxxxxxxx" style="background: #000; border: 1px solid #00E5FF; color: #FFF; border-radius: 0; font-size: 1rem;" />
                                </div>
                                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end mt-5" style="border-top: 1px dashed rgba(0, 229, 255, 0.3); padding-top: 20px;">
                            <button type="submit" class="btn btn-success px-5 py-3" style="background: #00FF66; border: 1px solid #00FF66; color: #000; font-family: 'Orbitron'; font-weight: bold; text-transform: uppercase; border-radius: 0; box-shadow: 0 0 15px rgba(0, 255, 102, 0.4); font-size: 1.1rem;">
                                <i class="fa-solid fa-floppy-disk me-2"></i> [ PERSIST TELEMETRY CHANGES ]
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.getElementById('imageInput').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(event) {
                    const preview = document.getElementById('avatarPreview');
                    const placeholder = document.getElementById('noAvatarPlaceholder');
                    preview.src = event.target.result;
                    preview.style.display = 'block';
                    placeholder.style.display = 'none';
                }
                reader.readAsDataURL(file);
            }
        });
    </script>
}
