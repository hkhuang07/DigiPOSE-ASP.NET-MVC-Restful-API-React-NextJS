@model DigiPOSE.Models.User
@{
    ViewData["Title"] = "My Orders";
}

<div class="hud-content-wrapper" style="padding: 25px;">
    <!-- Orders Title Header & Action Toolbar -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4" style="border-bottom: 2px solid var(--cyber-cyan, #00E5FF); padding-bottom: 12px; background: rgba(0, 229, 255, 0.05); padding: 15px;">
        <div>
            <div style="font-family: 'VT323', monospace; font-size: 1.1rem; color: var(--cyber-emerald, #00FF66);">> TRANSACTION HISTORY // USER ACCOUNT: @Model.UserName _</div>
            <h2 style="font-family: 'Orbitron', sans-serif; color: #FFFFFF; font-weight: 700; margin: 0; text-shadow: 0 0 12px rgba(0, 229, 255, 0.5);">
                <i class="fa-solid fa-boxes-stacked text-cyan me-2"></i> My Orders & Purchase History
            </h2>
        </div>
        <div class="d-flex align-items-center gap-2 mt-2 mt-md-0">
            <span class="badge me-2" style="background: #000; border: 1px solid #FFB000; color: #FFB000; padding: 6px 12px; font-family: 'VT323'; font-size: 1.1rem; border-radius: 0;">
                TOTAL ORDERS: @((ViewBag.UserOrders as IEnumerable<DigiPOSE.Models.Order>)?.Count() ?? 0)
            </span>
            <a asp-action="Index" class="btn btn-sm btn-outline-info" style="font-family: 'Orbitron', sans-serif; border-radius: 0; font-weight: bold; white-space: nowrap;">
                <i class="fa-solid fa-user me-1"></i> Personal Profile
            </a>
            <a href="/Storefront/Index" class="btn btn-sm btn-outline-success" style="font-family: 'Orbitron', sans-serif; border-radius: 0; font-weight: bold; white-space: nowrap;">
                <i class="fa-solid fa-store me-1"></i> Browse Storefront
            </a>
        </div>
    </div>

    <div class="card" style="background: #0A0A0A; border: 1px solid rgba(0, 229, 255, 0.4); border-radius: 0;">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0" style="font-family: 'Roboto Mono', monospace; border-color: rgba(0, 229, 255, 0.2);">
                    <thead style="background: rgba(0, 229, 255, 0.1); font-family: 'Orbitron', sans-serif; font-size: 0.85rem; color: #00E5FF; text-transform: uppercase;">
                        <tr>
                            <th class="p-3"><i class="fa-solid fa-hashtag me-1"></i> INVOICE NO / ID</th>
                            <th class="p-3">ORDER DATE</th>
                            <th class="p-3">RECIPIENT</th>
                            <th class="p-3 text-end">TOTAL AMOUNT</th>
                            <th class="p-3 text-center">STATUS</th>
                            <th class="p-3 text-end">ACTION</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.UserOrders != null && ((IEnumerable<DigiPOSE.Models.Order>)ViewBag.UserOrders).Any())
                        {
                            foreach (var ord in (IEnumerable<DigiPOSE.Models.Order>)ViewBag.UserOrders)
                            {
                                <tr>
                                    <td class="p-3 font-monospace" style="color: #FFF; font-weight: bold;">
                                        @(ord.InvoiceNumber ?? $"ORD-{ord.OrderId:D6}")
                                    </td>
                                    <td class="p-3" style="color: #A0C0CE;">
                                        @ord.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                                    </td>
                                    <td class="p-3">
                                        <span style="color: #00E5FF;">@(ord.SnapshotCustomerName ?? Model.FullName ?? Model.UserName)</span>
                                        @if (!string.IsNullOrEmpty(ord.SnapshotCustomerPhone))
                                        {
                                            <div style="font-size: 0.75rem; color: #6C7A89;">Phone: @ord.SnapshotCustomerPhone</div>
                                        }
                                    </td>
                                    <td class="p-3 text-end" style="color: #00FF66; font-family: 'VT323', monospace; font-size: 1.4rem; font-weight: bold;">
                                        @ord.TotalAmount.ToString("N0") <span style="font-size: 0.8rem; color: #A0C0CE;">VND</span>
                                    </td>
                                    <td class="p-3 text-center">
                                        @{
                                            string badgeColor = ord.OrderStatus?.BadgeColor ?? (ord.StatusId == 3 ? "#00FF66" : ord.StatusId == 4 ? "#FF3333" : "#FFB000");
                                            string statusText = ord.OrderStatus?.StatusName ?? (ord.StatusId == 1 ? "PENDING" : ord.StatusId == 2 ? "PROCESSING" : ord.StatusId == 3 ? "COMPLETED" : "CANCELLED");
                                        }
                                        <span class="badge" style="background: #000; border: 1px solid @badgeColor; color: @badgeColor; font-family: 'Orbitron'; padding: 6px 12px; border-radius: 0; font-size: 0.75rem;">
                                            @statusText.ToUpper()
                                        </span>
                                    </td>
                                    <td class="p-3 text-end">
                                        <a href="/Profile/OrderDetail/@ord.OrderId" class="btn btn-sm btn-outline-info" style="font-family: 'Orbitron'; font-size: 0.75rem; border-radius: 0; text-transform: uppercase;">
                                            <i class="fa-solid fa-eye me-1"></i> View Details
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center p-5">
                                    <i class="fa-solid fa-box-open text-warning mb-3" style="font-size: 3.5rem; opacity: 0.6;"></i>
                                    <h5 style="font-family: 'Orbitron'; color: #FFF; font-size: 1.2rem;">YOU HAVE NO RECENT ORDERS</h5>
                                    <p style="color: #6C7A89; font-size: 0.95rem; margin-bottom: 20px;">We could not find any orders placed with your account credentials.</p>
                                    <a href="/Storefront/Index" class="btn btn-sm px-4 py-2" style="background: #00E5FF; color: #000; font-family: 'Orbitron'; font-weight: bold; border-radius: 0;">
                                        <i class="fa-solid fa-cart-plus me-2"></i> START SHOPPING
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
