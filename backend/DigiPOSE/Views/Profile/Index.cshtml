@model DigiPOSE.Models.User
@{
    ViewData["Title"] = "Operator Profile Telemetry";
    string? avatarPath = string.IsNullOrEmpty(Model.ImageUrl) 
        ? null 
        : Url.Content("~/uploads/avatars/" + Model.ImageUrl);
}

<!-- Cyber-Cinematic Profile HUD Interface -->
<div class="hud-content-wrapper" style="padding: 25px;">
    <!-- Technical HUD Title Header -->
    <div class="d-flex justify-content-between align-items-center mb-4" style="border-bottom: 2px solid #00E5FF; padding-bottom: 12px; background: rgba(0, 229, 255, 0.05); padding: 15px;">
        <div>
            <div style="font-family: 'VT323', monospace; font-size: 1.1rem; color: #00FF66;">> SYSTEM_IAM_IDENTITY_VERIFIED // SESSION_NODE: @(Model.Tenant?.TenantName ?? "CORE_CLUSTER") _</div>
            <h2 style="font-family: 'Orbitron', sans-serif; color: #FFFFFF; font-weight: 700; margin: 0; text-shadow: 0 0 12px rgba(0, 229, 255, 0.5);">
                <i class="fa-solid fa-id-card-clip text-cyan me-2"></i> @Model.UserName.ToUpper() [ PERSONNEL FILE ]
            </h2>
        </div>
        <div>
            <a asp-action="Edit" class="btn btn-outline-info" style="font-family: 'Orbitron', sans-serif; border-color: #00E5FF; color: #00E5FF; text-transform: uppercase; font-weight: bold; border-radius: 0; box-shadow: 0 0 10px rgba(0, 229, 255, 0.3);">
                <i class="fa-solid fa-sliders me-2"></i> MODIFY PARAMETERS
            </a>
            <a asp-controller="Auth" asp-action="ChangePassword" class="btn btn-outline-warning ms-2" style="font-family: 'Orbitron', sans-serif; border-color: #FFB000; color: #FFB000; text-transform: uppercase; font-weight: bold; border-radius: 0;">
                <i class="fa-solid fa-key me-2"></i> KEY RE-ENCRYPTION
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success d-flex align-items-center mb-4" style="background: rgba(0, 255, 102, 0.1); border: 1px solid #00FF66; color: #00FF66; font-family: 'Roboto Mono', monospace; border-radius: 0;">
            <i class="fa-solid fa-check-circle me-3" style="font-size: 1.5rem;"></i>
            <div>
                <strong>>>> [TELEMETRY_SUCCESS]:</strong> @TempData["SuccessMessage"]
            </div>
        </div>
    }

    <div class="row g-4">
        <!-- Avatar & Visual Biometric ID Column -->
        <div class="col-lg-4 col-md-5">
            <div class="card h-100" style="background: #0A0A0A; border: 1px solid #00E5FF; border-radius: 0; box-shadow: 0 0 20px rgba(0, 229, 255, 0.15); position: relative; overflow: hidden;">
                <!-- Corner Reticles -->
                <div style="position: absolute; top: 5px; left: 5px; color: #FFB000; font-weight: bold; font-family: 'Roboto Mono';">+</div>
                <div style="position: absolute; top: 5px; right: 5px; color: #FFB000; font-weight: bold; font-family: 'Roboto Mono';">+</div>
                <div style="position: absolute; bottom: 5px; left: 5px; color: #FFB000; font-weight: bold; font-family: 'Roboto Mono';">+</div>
                <div style="position: absolute; bottom: 5px; right: 5px; color: #FFB000; font-weight: bold; font-family: 'Roboto Mono';">+</div>

                <div class="card-body text-center p-4">
                    <div style="margin-top: 10px; margin-bottom: 25px;">
                        <div style="width: 220px; height: 220px; margin: 0 auto; border: 2px solid #00E5FF; padding: 5px; background: rgba(0,0,0,0.8); position: relative; box-shadow: 0 0 15px rgba(0, 229, 255, 0.4);">
                            @if (avatarPath != null)
                            {
                                <img src="@avatarPath" alt="User Avatar" style="width: 100%; height: 100%; object-fit: cover; filter: contrast(1.05);" />
                            }
                            else
                            {
                                <div style="width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; background: #050505; color: #00E5FF;">
                                    <i class="fa-solid fa-user-astronaut" style="font-size: 5rem; color: rgba(0, 229, 255, 0.4);"></i>
                                    <span style="font-family: 'VT323'; font-size: 1.2rem; margin-top: 10px; color: #FFB000;">[ NO AVATAR CONFIGURED ]</span>
                                </div>
                            }
                            <div style="position: absolute; bottom: -10px; right: -10px; background: #00FF66; color: #000; font-family: 'VT323'; font-size: 0.9rem; padding: 2px 8px; font-weight: bold;">
                                LIVE
                            </div>
                        </div>
                    </div>

                    <h3 style="font-family: 'Orbitron', sans-serif; color: #FFFFFF; font-size: 1.6rem; margin-bottom: 5px;">
                        @(string.IsNullOrWhiteSpace(Model.FullName) ? Model.UserName : Model.FullName)
                    </h3>
                    <div style="font-family: 'VT323', monospace; font-size: 1.4rem; color: #00E5FF; letter-spacing: 2px; margin-bottom: 15px;">
                        // @(Model.Role?.RoleName ?? "UNASSIGNED ROLE")
                    </div>
                    
                    <div style="border-top: 1px dashed rgba(0, 229, 255, 0.3); padding-top: 15px; margin-top: 15px; text-align: left; font-family: 'Roboto Mono', monospace; font-size: 0.85rem; color: #A0C0CE;">
                        <div class="d-flex justify-content-between mb-2">
                            <span>SECURITY STATUS:</span>
                            <span style="color: #00FF66; font-weight: bold;">[ NOMINAL / ZERO-TRUST ]</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>CLUSTER ASSIGNMENT:</span>
                            <span style="color: #FFF; font-weight: bold;">@(Model.Tenant?.TenantName ?? "HQ")</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>BIOMETRIC HASH:</span>
                            <span style="color: #FFB000;">@(Model.PasswordHash != null && Model.PasswordHash.Length > 8 ? Model.PasswordHash.Substring(0, 8) + "..." : "ENCRYPTED")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Identity & Technical Specifications Column -->
        <div class="col-lg-8 col-md-7">
            <div class="card h-100" style="background: #0A0A0A; border: 1px solid rgba(0, 229, 255, 0.6); border-radius: 0; position: relative;">
                <div class="card-header" style="background: rgba(0, 229, 255, 0.1); border-bottom: 1px solid #00E5FF; padding: 12px 20px;">
                    <h4 style="font-family: 'Orbitron', sans-serif; color: #00E5FF; margin: 0; font-size: 1.1rem; letter-spacing: 1px;">
                        <i class="fa-solid fa-microchip me-2"></i> CORE IDENTITY REGISTER & AUTHORITIES
                    </h4>
                </div>
                
                <div class="card-body p-4" style="font-family: 'Roboto Mono', monospace;">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label style="color: #00E5FF; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 5px; font-family: 'Orbitron';">System User Name</label>
                            <div style="background: rgba(0, 0, 0, 0.8); border: 1px solid rgba(255,255,255,0.2); padding: 10px 15px; color: #FFFFFF; font-size: 1.1rem; font-family: 'VT323', monospace; letter-spacing: 1px;">
                                @Model.UserName
                            </div>
                        </div>
                        
                        <div class="col-md-6">
                            <label style="color: #00E5FF; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 5px; font-family: 'Orbitron';">Assigned Full Name</label>
                            <div style="background: rgba(0, 0, 0, 0.8); border: 1px solid rgba(255,255,255,0.2); padding: 10px 15px; color: #FFFFFF; font-size: 1.1rem; font-family: 'VT323', monospace; letter-spacing: 1px;">
                                @(string.IsNullOrWhiteSpace(Model.FullName) ? "[ NOT CONFIGURED ]" : Model.FullName)
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label style="color: #00E5FF; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 5px; font-family: 'Orbitron';">Secure Email Contact</label>
                            <div style="background: rgba(0, 0, 0, 0.8); border: 1px solid rgba(255,255,255,0.2); padding: 10px 15px; color: #00FF66; font-size: 1.1rem; font-family: 'VT323', monospace; letter-spacing: 1px;">
                                <i class="fa-solid fa-envelope me-2" style="color: #FFB000;"></i>@(string.IsNullOrWhiteSpace(Model.Email) ? "[ NO EMAIL LINK ]" : Model.Email)
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label style="color: #00E5FF; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 5px; font-family: 'Orbitron';">Telemetry Phone Line</label>
                            <div style="background: rgba(0, 0, 0, 0.8); border: 1px solid rgba(255,255,255,0.2); padding: 10px 15px; color: #FFFFFF; font-size: 1.1rem; font-family: 'VT323', monospace; letter-spacing: 1px;">
                                <i class="fa-solid fa-phone me-2" style="color: #00E5FF;"></i>@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "[ UNLINKED ]" : Model.PhoneNumber)
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label style="color: #00E5FF; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 5px; font-family: 'Orbitron';">Operational Role Matrix</label>
                            <div style="background: rgba(0, 0, 0, 0.8); border: 1px solid #FFB000; padding: 10px 15px; color: #FFB000; font-size: 1.2rem; font-family: 'VT323', monospace; letter-spacing: 2px; font-weight: bold;">
                                <i class="fa-solid fa-user-shield me-2"></i>@(Model.Role?.RoleName ?? "RESTRICTED")
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label style="color: #00E5FF; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 5px; font-family: 'Orbitron';">Account Active State</label>
                            <div style="background: rgba(0, 255, 102, 0.1); border: 1px solid #00FF66; padding: 10px 15px; color: #00FF66; font-size: 1.2rem; font-family: 'VT323', monospace; letter-spacing: 2px; font-weight: bold;">
                                <i class="fa-solid fa-check-double me-2"></i>@(Model.IsActive ? "ONLINE [ AUTHORIZED ]" : "SUSPENDED [ PENDING ]")
                            </div>
                        </div>
                    </div>

                    <!-- Permissions Matrix Overview -->
                    <div style="margin-top: 35px; border-top: 1px solid rgba(0, 229, 255, 0.3); padding-top: 20px;">
                        <h5 style="font-family: 'Orbitron', sans-serif; color: #FFFFFF; font-size: 0.95rem; text-transform: uppercase; margin-bottom: 15px;">
                            <i class="fa-solid fa-terminal text-success me-2"></i> ACTIVE PERMISSION SCOPES & TERMINAL ACCESS:
                        </h5>
                        <div class="d-flex flex-wrap gap-2">
                            <span class="badge" style="background: #000; border: 1px solid #00FF66; color: #00FF66; padding: 8px 12px; font-size: 0.8rem; border-radius: 0;">POS.Session.Execute</span>
                            <span class="badge" style="background: #000; border: 1px solid #00E5FF; color: #00E5FF; padding: 8px 12px; font-size: 0.8rem; border-radius: 0;">Inventory.Query.FastRAM</span>
                            <span class="badge" style="background: #000; border: 1px solid #FFB000; color: #FFB000; padding: 8px 12px; font-size: 0.8rem; border-radius: 0;">Profile.Avatar.Update</span>
                            <span class="badge" style="background: #000; border: 1px solid rgba(255,255,255,0.4); color: #FFF; padding: 8px 12px; font-size: 0.8rem; border-radius: 0;">Telemetry.Analytics.Read</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Section: My Orders & Transaction Telemetry (id="orders-tab") -->
    <div id="orders-tab" class="mt-5" style="border-top: 2px solid #00E5FF; padding-top: 30px;">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <div style="font-family: 'VT323', monospace; font-size: 1.2rem; color: #00FF66;">> TRANSACTION_LEDGER // TELEMETRY: RECENT_B2C_ORDER_STREAM _</div>
                <h3 style="font-family: 'Orbitron', sans-serif; color: #FFFFFF; font-weight: 700; margin: 5px 0 0 0;">
                    <i class="fa-solid fa-boxes-stacked text-cyan me-2"></i> MY ORDERS & RETAIL TRANSACTIONS
                </h3>
            </div>
            <div>
                <span class="badge" style="background: #000; border: 1px solid #FFB000; color: #FFB000; padding: 8px 15px; font-family: 'VT323'; font-size: 1.1rem; border-radius: 0;">
                    TOTAL COUNT: @((ViewBag.UserOrders as IEnumerable<DigiPOSE.Models.Order>)?.Count() ?? 0) RECORD(S)
                </span>
            </div>
        </div>

        <div class="card" style="background: #0A0A0A; border: 1px solid rgba(0, 229, 255, 0.4); border-radius: 0;">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-dark table-hover mb-0" style="font-family: 'Roboto Mono', monospace; border-color: rgba(0, 229, 255, 0.2);">
                        <thead style="background: rgba(0, 229, 255, 0.1); font-family: 'Orbitron', sans-serif; font-size: 0.85rem; color: #00E5FF; text-transform: uppercase;">
                            <tr>
                                <th class="p-3"><i class="fa-solid fa-hashtag me-1"></i> INVOICE NO / ID</th>
                                <th class="p-3">DATE / TIMESTAMP</th>
                                <th class="p-3">CUSTOMER RECIPIENT</th>
                                <th class="p-3 text-end">TOTAL AMOUNT</th>
                                <th class="p-3 text-center">ORDER STATUS</th>
                                <th class="p-3 text-end">ACTION / TRACE</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.UserOrders != null && ((IEnumerable<DigiPOSE.Models.Order>)ViewBag.UserOrders).Any())
                            {
                                foreach (var ord in (IEnumerable<DigiPOSE.Models.Order>)ViewBag.UserOrders)
                                {
                                    <tr>
                                        <td class="p-3 font-monospace" style="color: #FFF; font-weight: bold;">
                                            @(ord.InvoiceNumber ?? $"ORD-{ord.OrderId:D6}")
                                        </td>
                                        <td class="p-3" style="color: #A0C0CE;">
                                            @ord.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")
                                        </td>
                                        <td class="p-3">
                                            <span style="color: #00E5FF;">@(ord.SnapshotCustomerName ?? Model.FullName ?? Model.UserName)</span>
                                            @if (!string.IsNullOrEmpty(ord.SnapshotCustomerPhone))
                                            {
                                                <div style="font-size: 0.75rem; color: #6C7A89;">TEL: @ord.SnapshotCustomerPhone</div>
                                            }
                                        </td>
                                        <td class="p-3 text-end" style="color: #00FF66; font-family: 'VT323', monospace; font-size: 1.4rem; font-weight: bold;">
                                            @ord.TotalAmount.ToString("N2") <span style="font-size: 0.8rem; color: #A0C0CE;">USD</span>
                                        </td>
                                        <td class="p-3 text-center">
                                            @{
                                                string badgeColor = ord.StatusId == 3 ? "#00FF66" : ord.StatusId == 4 ? "#FF3333" : "#FFB000";
                                                string statusText = ord.OrderStatus?.StatusName ?? (ord.StatusId == 1 ? "PENDING" : ord.StatusId == 2 ? "PROCESSING" : ord.StatusId == 3 ? "COMPLETED" : "CANCELLED");
                                            }
                                            <span class="badge" style="background: #000; border: 1px solid @badgeColor; color: @badgeColor; font-family: 'Orbitron'; padding: 6px 12px; border-radius: 0; font-size: 0.75rem;">
                                                @statusText.ToUpper()
                                            </span>
                                        </td>
                                        <td class="p-3 text-end">
                                            <a href="/Storefront/Index" class="btn btn-sm btn-outline-info" style="font-family: 'Orbitron'; font-size: 0.75rem; border-radius: 0; text-transform: uppercase;">
                                                <i class="fa-solid fa-microscope me-1"></i> [ TRACE ]
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center p-5">
                                        <i class="fa-solid fa-receipt text-warning mb-3" style="font-size: 3rem; opacity: 0.6;"></i>
                                        <h5 style="font-family: 'Orbitron'; color: #FFF; font-size: 1.1rem;">[ ZERO TRANSACTION RECORDS LOCATED ]</h5>
                                        <p style="color: #6C7A89; font-size: 0.9rem; margin-bottom: 20px;">No historical retail POS settlements or storefront purchases associated with your active credentials.</p>
                                        <a href="/Storefront/Index" class="btn btn-sm" style="background: #00E5FF; color: #000; font-family: 'Orbitron'; font-weight: bold; border-radius: 0; padding: 10px 20px;">
                                            <i class="fa-solid fa-cart-plus me-2"></i> [ EXPLORE RETAIL CATALOG ]
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
