@model DigiPOSE.Models.User
@{
    ViewData["Title"] = "Personal Profile";
    string? avatarPath = string.IsNullOrEmpty(Model.ImageUrl) 
        ? null 
        : Url.Content("~/uploads/avatars/" + Model.ImageUrl);
}

<!-- Cyber Profile HUD Interface -->
<div class="hud-content-wrapper" style="padding: 25px;">
    <!-- Profile Header & Minimal Action Toolbar -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4" style="border-bottom: 2px solid var(--cyber-cyan, #00E5FF); padding-bottom: 12px; background: rgba(0, 229, 255, 0.05); padding: 15px;">
        <div>
            <div style="font-family: 'VT323', monospace; font-size: 1.1rem; color: var(--cyber-emerald, #00FF66);">> ACCOUNT VERIFIED // BRANCH: @(Model.Tenant?.TenantName ?? "Headquarters") _</div>
            <h2 style="font-family: 'Orbitron', sans-serif; color: #FFFFFF; font-weight: 700; margin: 0; text-shadow: 0 0 12px rgba(0, 229, 255, 0.5);">
                <i class="fa-solid fa-id-card-clip text-cyan me-2"></i> Personal Profile
            </h2>
        </div>
        <div class="d-flex align-items-center gap-2 mt-2 mt-md-0">
            <a asp-action="Edit" class="btn btn-sm btn-outline-info" style="font-family: 'Orbitron', sans-serif; border-radius: 0; font-weight: bold; white-space: nowrap;">
                <i class="fa-solid fa-pen-to-square me-1"></i> Edit Profile
            </a>
            <a asp-controller="Auth" asp-action="ChangePassword" class="btn btn-sm btn-outline-warning" style="font-family: 'Orbitron', sans-serif; border-radius: 0; font-weight: bold; white-space: nowrap;">
                <i class="fa-solid fa-key me-1"></i> Change Password
            </a>
            <a asp-action="Orders" class="btn btn-sm btn-outline-success" style="font-family: 'Orbitron', sans-serif; border-radius: 0; font-weight: bold; white-space: nowrap;">
                <i class="fa-solid fa-boxes-stacked me-1"></i> My Orders
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success d-flex align-items-center mb-4" style="background: rgba(0, 255, 102, 0.1); border: 1px solid #00FF66; color: #00FF66; font-family: 'Roboto Mono', monospace; border-radius: 0;">
            <i class="fa-solid fa-check-circle me-3" style="font-size: 1.5rem;"></i>
            <div>
                <strong>>>> [SUCCESS]:</strong> @TempData["SuccessMessage"]
            </div>
        </div>
    }

    <div class="row g-4">
        <!-- Avatar & ID Column -->
        <div class="col-lg-4 col-md-5">
            <div class="card h-100" style="background: #0A0A0A; border: 1px solid var(--cyber-cyan, #00E5FF); border-radius: 0; box-shadow: 0 0 20px rgba(0, 229, 255, 0.15); position: relative; overflow: hidden;">
                <!-- Corner Reticles -->
                <div style="position: absolute; top: 5px; left: 5px; color: #FFB000; font-weight: bold; font-family: 'Roboto Mono';">+</div>
                <div style="position: absolute; top: 5px; right: 5px; color: #FFB000; font-weight: bold; font-family: 'Roboto Mono';">+</div>
                <div style="position: absolute; bottom: 5px; left: 5px; color: #FFB000; font-weight: bold; font-family: 'Roboto Mono';">+</div>
                <div style="position: absolute; bottom: 5px; right: 5px; color: #FFB000; font-weight: bold; font-family: 'Roboto Mono';">+</div>

                <div class="card-body text-center p-4">
                    <div style="margin-top: 10px; margin-bottom: 25px;">
                        <div style="width: 220px; height: 220px; margin: 0 auto; border: 2px solid var(--cyber-cyan, #00E5FF); padding: 5px; background: rgba(0,0,0,0.8); position: relative; box-shadow: 0 0 15px rgba(0, 229, 255, 0.4);">
                            @if (avatarPath != null)
                            {
                                <img src="@avatarPath" alt="User Avatar" style="width: 100%; height: 100%; object-fit: cover;" />
                            }
                            else
                            {
                                <div style="width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; background: #050505; color: #00E5FF;">
                                    <i class="fa-solid fa-user" style="font-size: 4.5rem; color: rgba(0, 229, 255, 0.4);"></i>
                                    <span style="font-family: 'VT323'; font-size: 1.2rem; margin-top: 10px; color: #FFB000;">[ NO AVATAR ]</span>
                                </div>
                            }
                            <div style="position: absolute; bottom: -10px; right: -10px; background: #00FF66; color: #000; font-family: 'VT323'; font-size: 0.9rem; padding: 2px 8px; font-weight: bold;">
                                ACTIVE
                            </div>
                        </div>
                    </div>

                    <h3 style="font-family: 'Orbitron', sans-serif; color: #FFFFFF; font-size: 1.6rem; margin-bottom: 5px;">
                        @(string.IsNullOrWhiteSpace(Model.FullName) ? Model.UserName : Model.FullName)
                    </h3>
                    <div style="font-family: 'VT323', monospace; font-size: 1.4rem; color: #00E5FF; letter-spacing: 2px; margin-bottom: 15px;">
                        // @(Model.Role?.RoleName ?? "MEMBER")
                    </div>
                    
                    <div style="border-top: 1px dashed rgba(0, 229, 255, 0.3); padding-top: 15px; margin-top: 15px; text-align: left; font-family: 'Roboto Mono', monospace; font-size: 0.85rem; color: #A0C0CE;">
                        <div class="d-flex justify-content-between mb-2">
                            <span>ACCOUNT STATUS:</span>
                            <span style="color: #00FF66; font-weight: bold;">Verified & Active</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>BRANCH LOCATION:</span>
                            <span style="color: #FFF; font-weight: bold;">@(Model.Tenant?.TenantName ?? "Headquarters")</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>SECURITY:</span>
                            <span style="color: #FFB000;">Encrypted Password</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Identity & Technical Specifications Column -->
        <div class="col-lg-8 col-md-7">
            <div class="card h-100" style="background: #0A0A0A; border: 1px solid rgba(0, 229, 255, 0.6); border-radius: 0; position: relative;">
                <div class="card-header" style="background: rgba(0, 229, 255, 0.1); border-bottom: 1px solid #00E5FF; padding: 12px 20px;">
                    <h4 style="font-family: 'Orbitron', sans-serif; color: #00E5FF; margin: 0; font-size: 1.1rem; letter-spacing: 1px;">
                        <i class="fa-solid fa-circle-info me-2"></i> ACCOUNT DETAILS & INFORMATION
                    </h4>
                </div>
                
                <div class="card-body p-4" style="font-family: 'Roboto Mono', monospace;">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label style="color: #00E5FF; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 5px; font-family: 'Orbitron';">Username</label>
                            <div style="background: rgba(0, 0, 0, 0.8); border: 1px solid rgba(255,255,255,0.2); padding: 10px 15px; color: #FFFFFF; font-size: 1.1rem; font-family: 'VT323', monospace; letter-spacing: 1px;">
                                @Model.UserName
                            </div>
                        </div>
                        
                        <div class="col-md-6">
                            <label style="color: #00E5FF; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 5px; font-family: 'Orbitron';">Full Name</label>
                            <div style="background: rgba(0, 0, 0, 0.8); border: 1px solid rgba(255,255,255,0.2); padding: 10px 15px; color: #FFFFFF; font-size: 1.1rem; font-family: 'VT323', monospace; letter-spacing: 1px;">
                                @(string.IsNullOrWhiteSpace(Model.FullName) ? "[ Not Configured ]" : Model.FullName)
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label style="color: #00E5FF; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 5px; font-family: 'Orbitron';">Email Address</label>
                            <div style="background: rgba(0, 0, 0, 0.8); border: 1px solid rgba(255,255,255,0.2); padding: 10px 15px; color: #00FF66; font-size: 1.1rem; font-family: 'VT323', monospace; letter-spacing: 1px;">
                                <i class="fa-solid fa-envelope me-2" style="color: #FFB000;"></i>@(string.IsNullOrWhiteSpace(Model.Email) ? "[ No Email Linked ]" : Model.Email)
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label style="color: #00E5FF; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 5px; font-family: 'Orbitron';">Phone Number</label>
                            <div style="background: rgba(0, 0, 0, 0.8); border: 1px solid rgba(255,255,255,0.2); padding: 10px 15px; color: #FFFFFF; font-size: 1.1rem; font-family: 'VT323', monospace; letter-spacing: 1px;">
                                <i class="fa-solid fa-phone me-2" style="color: #00E5FF;"></i>@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "[ No Phone Linked ]" : Model.PhoneNumber)
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label style="color: #00E5FF; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 5px; font-family: 'Orbitron';">Assigned Role</label>
                            <div style="background: rgba(0, 0, 0, 0.8); border: 1px solid #FFB000; padding: 10px 15px; color: #FFB000; font-size: 1.2rem; font-family: 'VT323', monospace; letter-spacing: 2px; font-weight: bold;">
                                <i class="fa-solid fa-user-shield me-2"></i>@(Model.Role?.RoleName ?? "Standard User")
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label style="color: #00E5FF; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 5px; font-family: 'Orbitron';">Account Status</label>
                            <div style="background: rgba(0, 255, 102, 0.1); border: 1px solid #00FF66; padding: 10px 15px; color: #00FF66; font-size: 1.2rem; font-family: 'VT323', monospace; letter-spacing: 2px; font-weight: bold;">
                                <i class="fa-solid fa-check-double me-2"></i>@(Model.IsActive ? "ONLINE [ ACTIVE ]" : "SUSPENDED [ PENDING ]")
                            </div>
                        </div>
                    </div>

                    <!-- Actual Permissions From Database (No Mock Data) -->
                    @if (Model.Role?.PermissionRoles != null && Model.Role.PermissionRoles.Any())
                    {
                        <div style="margin-top: 35px; border-top: 1px solid rgba(0, 229, 255, 0.3); padding-top: 20px;">
                            <h5 style="font-family: 'Orbitron', sans-serif; color: #FFFFFF; font-size: 0.95rem; text-transform: uppercase; margin-bottom: 15px;">
                                <i class="fa-solid fa-key text-success me-2"></i> ASSIGNED PERMISSIONS:
                            </h5>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var pr in Model.Role.PermissionRoles.Where(p => p.Permission != null))
                                {
                                    <span class="badge" style="background: #000; border: 1px solid #00E5FF; color: #00E5FF; padding: 8px 12px; font-size: 0.8rem; border-radius: 0;">
                                        @pr.Permission!.PermissionName
                                    </span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
