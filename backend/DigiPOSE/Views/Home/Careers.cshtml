@{
    Layout = "~/Views/Shared/_StorefrontLayout.cshtml";
    ViewData["Title"] = "Careers — Engineering & Business Openings";
}

<div class="container-fluid px-5 my-5" style="max-width: 1700px;">
    <!-- Careers Header Banner -->
    <div style="background: linear-gradient(90deg, rgba(0,255,102,0.1) 0%, rgba(0,0,0,0) 100%); border-left: 5px solid var(--cyber-emerald); padding: 40px; margin-bottom: 60px;">
        <div style="font-family:'VT323'; color:var(--cyber-emerald); font-size:1.3rem; letter-spacing:2px;">> CAREERS // TALENT ACQUISITION _</div>
        <h1 style="font-family:'Orbitron'; font-weight:900; font-size:3.2rem; color:#FFFFFF; margin: 10px 0 15px 0; text-shadow:0 0 15px rgba(0,255,102,0.5);">
            <i class="fa-solid fa-users-gear text-success me-3"></i> JOIN THE DIGIPOSE TEAM
        </h1>
        <p style="color:var(--cyber-muted); font-size:1.15rem; max-width:1000px; line-height:1.7;">
            We are seeking experienced software architects, developers, and product specialists to help build the next generation of cloud POS solutions and high-speed point-of-sale systems.
        </p>
    </div>

    <!-- Culture & Benefits Summary -->
    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div style="background:var(--cyber-surface); border:1px solid var(--cyber-border); padding:30px; height:100%;">
                <i class="fa-solid fa-laptop-code text-cyan mb-3" style="font-size:2.5rem;"></i>
                <h4 style="font-family:'Orbitron'; color:#FFF; font-size:1.1rem; font-weight:700;">HYBRID WORK MODEL</h4>
                <p style="color:var(--cyber-muted); font-size:0.9rem; margin-top:10px;">Work remotely or coordinate directly from our office headquarters with modern work environment standards.</p>
            </div>
        </div>
        <div class="col-md-3">
            <div style="background:var(--cyber-surface); border:1px solid var(--cyber-border); padding:30px; height:100%;">
                <i class="fa-solid fa-coins text-amber mb-3" style="font-size:2.5rem; color:var(--cyber-amber);"></i>
                <h4 style="font-family:'Orbitron'; color:#FFF; font-size:1.1rem; font-weight:700;">COMPETITIVE COMPENSATION</h4>
                <p style="color:var(--cyber-muted); font-size:0.9rem; margin-top:10px;">Top-tier salary packages with annual performance bonuses and comprehensive company benefits.</p>
            </div>
        </div>
        <div class="col-md-3">
            <div style="background:var(--cyber-surface); border:1px solid var(--cyber-border); padding:30px; height:100%;">
                <i class="fa-solid fa-heart-pulse text-danger mb-3" style="font-size:2.5rem; color:var(--cyber-danger);"></i>
                <h4 style="font-family:'Orbitron'; color:#FFF; font-size:1.1rem; font-weight:700;">COMPREHENSIVE HEALTHCARE</h4>
                <p style="color:var(--cyber-muted); font-size:0.9rem; margin-top:10px;">Premium healthcare coverage for employees and family members at accredited hospital centers.</p>
            </div>
        </div>
        <div class="col-md-3">
            <div style="background:var(--cyber-surface); border:1px solid var(--cyber-border); padding:30px; height:100%;">
                <i class="fa-solid fa-rocket text-success mb-3" style="font-size:2.5rem;"></i>
                <h4 style="font-family:'Orbitron'; color:#FFF; font-size:1.1rem; font-weight:700;">PROFESSIONAL GROWTH</h4>
                <p style="color:var(--cyber-muted); font-size:0.9rem; margin-top:10px;">Annual training and skill development allowance for industry certifications, technical courses, and seminars.</p>
            </div>
        </div>
    </div>

    <!-- Open Positions Matrix -->
    <h2 style="font-family:'Rajdhani'; font-weight:700; color:var(--cyber-cyan); font-size:2.4rem; letter-spacing:3px; margin: 60px 0 30px 0; text-transform:uppercase;">
        // CURRENT OPEN POSITIONS //
    </h2>

    <div class="table-responsive">
        <table class="table table-dark table-hover" style="background: var(--cyber-surface); border: 1px solid var(--cyber-cyan); font-family:'Roboto Mono';">
            <thead style="background: rgba(0, 229, 255, 0.15); border-bottom: 2px solid var(--cyber-cyan);">
                <tr>
                    <th class="py-4 px-4" style="font-family:'Orbitron'; color:var(--cyber-cyan); text-transform:uppercase;">JOB CODE / ROLE TITLE</th>
                    <th class="py-4 px-4" style="font-family:'Orbitron'; color:var(--cyber-cyan); text-transform:uppercase;">DEPARTMENT</th>
                    <th class="py-4 px-4" style="font-family:'Orbitron'; color:var(--cyber-cyan); text-transform:uppercase;">LOCATION</th>
                    <th class="py-4 px-4 text-center" style="font-family:'Orbitron'; color:var(--cyber-cyan); text-transform:uppercase;">STATUS</th>
                    <th class="py-4 px-4 text-end" style="font-family:'Orbitron'; color:var(--cyber-cyan); text-transform:uppercase;">ACTION</th>
                </tr>
            </thead>
            <tbody>
                <!-- Job 1 -->
                <tr style="border-bottom: 1px solid var(--cyber-border);">
                    <td class="p-4">
                        <div style="font-family:'VT323'; color:var(--cyber-amber); font-size:1.1rem;">ENG-REQ-801</div>
                        <strong style="font-family:'Orbitron'; font-size:1.25rem; color:#FFF;">Senior .NET Core Backend Engineer</strong>
                    </td>
                    <td class="p-4 align-middle" style="color:var(--cyber-emerald); font-weight:bold;">Cloud ERP / Backend Engineering</td>
                    <td class="p-4 align-middle">Headquarters / Hybrid</td>
                    <td class="p-4 align-middle text-center">
                        <span class="badge" style="background:#000; border:1px solid var(--cyber-emerald); color:var(--cyber-emerald); padding:6px 12px; font-family:'VT323'; font-size:1.1rem; border-radius:0;">HIRING NOW</span>
                    </td>
                    <td class="p-4 align-middle text-end">
                        <button onclick="applyJob('ENG-REQ-801')" class="btn btn-sm btn-outline-info px-4 py-2" style="font-family:'Orbitron'; font-weight:bold; border-radius:0; border-color:var(--cyber-cyan); color:var(--cyber-cyan);">
                            [ APPLY NOW ] <i class="fa-solid fa-arrow-right ms-1"></i>
                        </button>
                    </td>
                </tr>
                <!-- Job 2 -->
                <tr style="border-bottom: 1px solid var(--cyber-border);">
                    <td class="p-4">
                        <div style="font-family:'VT323'; color:var(--cyber-amber); font-size:1.1rem;">UIX-REQ-305</div>
                        <strong style="font-family:'Orbitron'; font-size:1.25rem; color:#FFF;">Senior Frontend Engineer (Vue / Blazor)</strong>
                    </td>
                    <td class="p-4 align-middle" style="color:var(--cyber-cyan); font-weight:bold;">Frontend UI / UX Engineering</td>
                    <td class="p-4 align-middle">Headquarters / Hybrid</td>
                    <td class="p-4 align-middle text-center">
                        <span class="badge" style="background:#000; border:1px solid var(--cyber-emerald); color:var(--cyber-emerald); padding:6px 12px; font-family:'VT323'; font-size:1.1rem; border-radius:0;">HIRING NOW</span>
                    </td>
                    <td class="p-4 align-middle text-end">
                        <button onclick="applyJob('UIX-REQ-305')" class="btn btn-sm btn-outline-info px-4 py-2" style="font-family:'Orbitron'; font-weight:bold; border-radius:0; border-color:var(--cyber-cyan); color:var(--cyber-cyan);">
                            [ APPLY NOW ] <i class="fa-solid fa-arrow-right ms-1"></i>
                        </button>
                    </td>
                </tr>
                <!-- Job 3 -->
                <tr style="border-bottom: 1px solid var(--cyber-border);">
                    <td class="p-4">
                        <div style="font-family:'VT323'; color:var(--cyber-amber); font-size:1.1rem;">IOT-REQ-412</div>
                        <strong style="font-family:'Orbitron'; font-size:1.25rem; color:#FFF;">Embedded Systems Engineer (POS Printers / Scanners)</strong>
                    </td>
                    <td class="p-4 align-middle" style="color:var(--cyber-amber); font-weight:bold;">Hardware / IoT Integration</td>
                    <td class="p-4 align-middle">On-site Lab / Office</td>
                    <td class="p-4 align-middle text-center">
                        <span class="badge" style="background:#000; border:1px solid var(--cyber-emerald); color:var(--cyber-emerald); padding:6px 12px; font-family:'VT323'; font-size:1.1rem; border-radius:0;">HIRING NOW</span>
                    </td>
                    <td class="p-4 align-middle text-end">
                        <button onclick="applyJob('IOT-REQ-412')" class="btn btn-sm btn-outline-info px-4 py-2" style="font-family:'Orbitron'; font-weight:bold; border-radius:0; border-color:var(--cyber-cyan); color:var(--cyber-cyan);">
                            [ APPLY NOW ] <i class="fa-solid fa-arrow-right ms-1"></i>
                        </button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        function applyJob(code) {
            const email = prompt("Please enter your contact email or LinkedIn/GitHub link to apply for position code: " + code);
            if (email && email.trim() !== "") {
                alert("Thank you for your interest! Your details for application code " + code + " have been recorded. Our recruitment team will get in touch with you shortly.");
            }
        }
    </script>
}
