@{
    Layout = "~/Views/Shared/_StorefrontLayout.cshtml";
    ViewData["Title"] = "About — Enterprise POS & Retail ERP Solution";
}

<div class="container-fluid px-5 my-5" style="max-width: 1700px;">
    <!-- Architecture Title Banner -->
    <div style="border: 2px solid var(--cyber-cyan); background: rgba(0,229,255,0.05); padding: 50px; position: relative; margin-bottom: 70px;">
        <div style="font-family:'VT323'; color:var(--cyber-emerald); font-size:1.3rem; letter-spacing:2px;">> ABOUT DIGIPOSE // SYSTEM OVERVIEW _</div>
        <h1 style="font-family:'Orbitron'; font-weight:900; font-size:3.5rem; color:#FFFFFF; margin: 10px 0 20px 0; text-shadow:0 0 20px rgba(0,229,255,0.5);">
            <i class="fa-solid fa-network-wired text-cyan me-3"></i> INTELLIGENT RETAIL POS & CLOUD ERP
        </h1>
        <p style="color:var(--cyber-muted); font-size:1.15rem; max-width:1100px; line-height:1.8;">
            DigiPOSE is engineered as a comprehensive, reliable Enterprise Point of Sale and Inventory Management ecosystem. Built upon high-performance architectural standards, our platform delivers stable transaction processing and seamless inventory tracking for retail networks.
        </p>
    </div>

    <!-- 3 Core Design Principles -->
    <div class="row g-5 mb-5">
        <div class="col-lg-4">
            <div style="background:var(--cyber-surface); border:1px solid var(--cyber-emerald); padding:40px; height:100%; position:relative; box-shadow:0 0 20px rgba(0,255,102,0.1);">
                <div style="font-size:3rem; color:var(--cyber-emerald); margin-bottom:20px;"><i class="fa-solid fa-bolt-lightning"></i></div>
                <h3 style="font-family:'Orbitron'; font-size:1.5rem; color:#FFF; font-weight:700; margin-bottom:15px;">HIGH-SPEED CHECKOUT</h3>
                <p style="color:var(--cyber-muted); font-size:1rem; line-height:1.7;">
                    Retail checkout speed directly impacts store productivity. By utilizing advanced performance optimization and efficient data retrieval, DigiPOSE delivers instantaneous barcode scanning and responsive item checkout.
                </p>
            </div>
        </div>

        <div class="col-lg-4">
            <div style="background:var(--cyber-surface); border:1px solid var(--cyber-cyan); padding:40px; height:100%; position:relative; box-shadow:0 0 20px rgba(0,229,255,0.1);">
                <div style="font-size:3rem; color:var(--cyber-cyan); margin-bottom:20px;"><i class="fa-solid fa-shield-virus"></i></div>
                <h3 style="font-family:'Orbitron'; font-size:1.5rem; color:#FFF; font-weight:700; margin-bottom:15px;">REAL-TIME SYNCHRONIZATION</h3>
                <p style="color:var(--cyber-muted); font-size:1rem; line-height:1.7;">
                    To prevent inventory conflicts across multiple checkout lanes, stock quantities are synchronized in real-time. Simultaneous sales across different store registers update stock levels accurately without delays or errors.
                </p>
            </div>
        </div>

        <div class="col-lg-4">
            <div style="background:var(--cyber-surface); border:1px solid var(--cyber-amber); padding:40px; height:100%; position:relative; box-shadow:0 0 20px rgba(255,176,0,0.1);">
                <div style="font-size:3rem; color:var(--cyber-amber); margin-bottom:20px;"><i class="fa-solid fa-layer-group"></i></div>
                <h3 style="font-family:'Orbitron'; font-size:1.5rem; color:#FFF; font-weight:700; margin-bottom:15px;">ROLE-BASED ACCESS CONTROL</h3>
                <p style="color:var(--cyber-muted); font-size:1rem; line-height:1.7;">
                    Adhering to standard business security guidelines, our multi-tier permission control isolates cashier terminals from sensitive corporate financial records, inventory purchasing, and staff management functions.
                </p>
            </div>
        </div>
    </div>

    <!-- System Topology -->
    <div style="background: #0A0A0A; border: 1px solid var(--cyber-border); padding: 50px; margin: 70px 0;">
        <div style="font-family:'Orbitron'; font-size:1.8rem; font-weight:700; color:var(--cyber-cyan); margin-bottom:30px;">
            <i class="fa-solid fa-sitemap me-3"></i> ENTERPRISE SYSTEM ARCHITECTURE
        </div>
        <div class="row g-4 align-items-center">
            <div class="col-md-6">
                <ul class="list-unstyled" style="font-family:'Roboto Mono'; font-size:1.05rem; color:var(--cyber-text); line-height:2.2;">
                    <li><i class="fa-solid fa-square-check text-success me-3"></i> <strong>Backend Architecture:</strong> ASP.NET Core MVC 8 & RESTful Web API</li>
                    <li><i class="fa-solid fa-square-check text-success me-3"></i> <strong>Data Layer:</strong> Entity Framework Core / High-Availability SQL Engine</li>
                    <li><i class="fa-solid fa-square-check text-success me-3"></i> <strong>Interactive Frontend:</strong> Responsive UI Architecture & Real-time Analytics Dashboards</li>
                    <li><i class="fa-solid fa-square-check text-success me-3"></i> <strong>Session Security:</strong> Cookie Authentication with Granular Permission Enforcement</li>
                    <li><i class="fa-solid fa-square-check text-success me-3"></i> <strong>File Storage Engine:</strong> Secure image validation and formatting for uploads</li>
                </ul>
            </div>
            <div class="col-md-6 text-center">
                <div style="border: 2px dashed var(--cyber-cyan); padding: 40px; background: #000;">
                    <i class="fa-solid fa-server" style="font-size:5rem; color:var(--cyber-emerald); margin-bottom:15px;"></i>
                    <div style="font-family:'VT323'; color:#FFFFFF; font-size:1.6rem; letter-spacing:3px;">
                        [ SCALABLE CLOUD & ENTERPRISE RETAIL READY ]
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
