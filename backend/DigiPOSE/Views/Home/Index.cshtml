@{
    Layout = "~/Views/Shared/_StorefrontLayout.cshtml";
    ViewData["Title"] = "Enterprise POS & Retail Management Solution";
}

<!-- Styles served via cyber-storefront.css -->

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div style="font-family:'VT323'; color:var(--cyber-cyan); font-size:1.4rem; margin-bottom:15px;">> ENTERPRISE RETAIL PLATFORM // SYSTEM STATUS: ONLINE _</div>
        <h1 class="hero-title">INTELLIGENT POS<br/>ARCHITECTURE</h1>
        <div class="hero-subtitle">NEXT-GENERATION CLOUD RETAIL & POINT OF SALE SYSTEM</div>
        
        <div class="d-flex justify-content-center gap-4 mt-5">
            <a href="/Home/Product" class="cta-btn-primary">
                <i class="fa-solid fa-rocket me-2"></i> [ EXPLORE POS PACKAGES ]
            </a>
            <a href="/Home/Introduce" class="cta-btn-outline">
                <i class="fa-solid fa-circle-info me-2"></i> [ ABOUT DIGIPOSE ]
            </a>
        </div>
        
        <div style="margin-top: 70px; font-size: 0.85rem; color: var(--cyber-muted); letter-spacing: 3px; text-transform: uppercase;">
            <i class="fa-solid fa-shield-halved text-success me-2"></i> POWERED BY ASP.NET CORE 8 | REAL-TIME INVENTORY SYNC | HIGH-SPEED TRANSACTION PROCESSING
        </div>
    </div>
</section>

<!-- Core Ecosystem Modules -->
<div class="container-fluid px-5" style="max-width: 1700px;">
    <h2 class="section-header">// CORE ENTERPRISE MODULES //</h2>
    
    <div class="row g-4">
        <div class="col-lg-3 col-md-6">
            <div class="feature-card">
                <i class="fa-solid fa-cash-register feature-icon" style="color: var(--cyber-cyan);"></i>
                <h3 class="feature-title">SMART POS TERMINAL</h3>
                <p class="feature-desc">High-speed point of sale workspace with an ergonomic 3-column layout. Designed for instant barcode scanning and automated thermal bill printing.</p>
                <div style="margin-top: 20px; font-family:'VT323'; color:var(--cyber-cyan); font-size:1.1rem;">> CHECKOUT: INSTANT_</div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="feature-card">
                <i class="fa-solid fa-cloud-arrow-up feature-icon" style="color: var(--cyber-emerald);"></i>
                <h3 class="feature-title">CLOUD POS LICENSES</h3>
                <p class="feature-desc">Flexible software subscription packages tailored for single boutique retail stores up to multitenant national retail chain networks.</p>
                <div style="margin-top: 20px; font-family:'VT323'; color:var(--cyber-emerald); font-size:1.1rem;">> DEPLOYMENT: CLOUD READY_</div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="feature-card">
                <i class="fa-solid fa-warehouse feature-icon" style="color: var(--cyber-amber);"></i>
                <h3 class="feature-title">REAL-TIME WAREHOUSE</h3>
                <p class="feature-desc">Accurate inventory accounting with real-time stock synchronization. Automate inventory transfers, stock adjustments, and supplier purchase orders.</p>
                <div style="margin-top: 20px; font-family:'VT323'; color:var(--cyber-amber); font-size:1.1rem;">> TRACKING: REAL-TIME_</div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="feature-card">
                <i class="fa-solid fa-user-lock feature-icon" style="color: var(--cyber-danger);"></i>
                <h3 class="feature-title">ACCESS CONTROL</h3>
                <p class="feature-desc">Granular role-based access control separating store operators from sensitive business financials. Secure employee profile management with audit logging.</p>
                <div style="margin-top: 20px; font-family:'VT323'; color:var(--cyber-danger); font-size:1.1rem;">> SECURITY: ENTERPRISE GRADE_</div>
            </div>
        </div>
    </div>
</div>

<!-- SaaS Digital Package Showcase Banner -->
<div class="container-fluid px-5" style="max-width: 1700px;">
    <div class="digital-banner">
        <span class="reticle" style="top:15px; left:15px;">[ ]</span>
        <span class="reticle" style="top:15px; right:15px;">[ ]</span>
        <span class="reticle" style="bottom:15px; left:15px;">[ ]</span>
        <span class="reticle" style="bottom:15px; right:15px;">[ ]</span>

        <div class="row align-items-center g-5">
            <div class="col-lg-8">
                <div style="font-family:'VT323'; color:var(--cyber-emerald); font-size:1.3rem;">> NEW RELEASE: DIGIPOSE COMMERCIAL SOFTWARE LICENSES _</div>
                <h2 style="font-family:'Orbitron'; font-weight:900; font-size:2.8rem; color:#FFFFFF; margin: 15px 0;">
                    SCALE YOUR RETAIL CHAIN WITH CUSTOM DIGITAL POS LICENSES
                </h2>
                <p style="color:var(--cyber-muted); font-size:1.1rem; line-height:1.8;">
                    Transition from legacy offline registers to cloud-native retail management systems. Our Digital POS software subscriptions include instant store replication, real-time interactive dashboards, customer loyalty tracking, and shift cash reconciliation.
                </p>
                <div class="d-flex gap-3 mt-4">
                    <span class="badge" style="background:#000; border:1px solid var(--cyber-emerald); color:var(--cyber-emerald); padding:10px 15px; font-size:0.9rem; border-radius:0;">
                        <i class="fa-solid fa-check me-2"></i> Instant Activation
                    </span>
                    <span class="badge" style="background:#000; border:1px solid var(--cyber-cyan); color:var(--cyber-cyan); padding:10px 15px; font-size:0.9rem; border-radius:0;">
                        <i class="fa-solid fa-network-wired me-2"></i> Multi-branch Sync
                    </span>
                </div>
            </div>
            <div class="col-lg-4 text-lg-end text-start">
                <a href="/Home/Product" class="cta-btn-primary w-100 text-center py-4" style="font-size:1.25rem;">
                    [ VIEW PRICING & LICENSES ] <i class="fa-solid fa-arrow-right-long ms-2"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<!-- B2B & B2C Channels: Storefront Catalog | Tech Support | Careers -->
<div class="container-fluid px-5 my-5" style="max-width: 1700px;">
    <h2 class="section-header">// CUSTOMER PORTAL & ENTERPRISE CHANNELS //</h2>
    
    <div class="row g-4">
        <!-- Pillar 1: Online Retail Storefront -->
        <div class="col-lg-4">
            <div class="feature-card" style="border-top: 3px solid var(--cyber-cyan); display:flex; flex-direction:column; justify-content:space-between;">
                <div>
                    <div style="font-family:'VT323'; color:var(--cyber-cyan); font-size:1.2rem; margin-bottom:10px;">> RETAIL CATALOG HUB _</div>
                    <h3 style="font-family:'Orbitron'; font-size:1.5rem; color:#FFF; font-weight:900; margin-bottom:15px;">
                        <i class="fa-solid fa-cart-shopping text-cyan me-2"></i> POS HARDWARE STORE
                    </h3>
                    <p class="feature-desc">
                        Direct purchasing for commercial retail grade hardware: Dual-Screen Touch Terminals, High-Speed Barcode Scanners, Thermal Receipt Printers, and Cash Drawers.
                    </p>
                </div>
                <a href="/Storefront/Index" class="btn w-100 py-3 mt-3" style="background:transparent; border:1px solid var(--cyber-cyan); color:var(--cyber-cyan); font-family:'Orbitron'; font-weight:bold; letter-spacing:1px; text-decoration:none; text-align:center;">
                    [ ENTER STOREFRONT ] <i class="fa-solid fa-arrow-up-right-from-square ms-1"></i>
                </a>
            </div>
        </div>

        <!-- Pillar 2: Technical Support & Contact -->
        <div class="col-lg-4">
            <div class="feature-card" style="border-top: 3px solid var(--cyber-emerald); display:flex; flex-direction:column; justify-content:space-between;">
                <div>
                    <div style="font-family:'VT323'; color:var(--cyber-emerald); font-size:1.2rem; margin-bottom:10px;">> TECHNICAL SUPPORT 24/7 _</div>
                    <h3 style="font-family:'Orbitron'; font-size:1.5rem; color:#FFF; font-weight:900; margin-bottom:15px;">
                        <i class="fa-solid fa-headset text-success me-2"></i> CLIENT SUPPORT
                    </h3>
                    <p class="feature-desc">
                        Dedicated B2B SLA assistance, Hardware warranty support, enterprise system integration guidance, and 24/7 operational assistance for retail networks.
                    </p>
                    <ul class="list-unstyled my-4" style="color:var(--cyber-muted); font-size:0.9rem;">
                        <li class="mb-2"><i class="fa-solid fa-phone text-success me-2"></i> Hotline: <strong style="color:#FFF;">+84 0123 456 888</strong> (Sales & Support)</li>
                        <li class="mb-2"><i class="fa-solid fa-envelope text-success me-2"></i> Support Email: <strong style="color:#FFF;">support@digipose-erp.tech</strong></li>
                        <li><i class="fa-solid fa-clock text-success me-2"></i> Response SLA: <strong style="color:#FFF;">&lt; 15 Minutes</strong></li>
                    </ul>
                </div>
                <a href="/Home/Contact" class="btn w-100 py-3 mt-3" style="background:transparent; border:1px solid var(--cyber-emerald); color:var(--cyber-emerald); font-family:'Orbitron'; font-weight:bold; letter-spacing:1px; text-decoration:none; text-align:center;">
                    [ CONTACT SUPPORT ] <i class="fa-solid fa-paper-plane ms-1"></i>
                </a>
            </div>
        </div>

        <!-- Pillar 3: Careers & Talent -->
        <div class="col-lg-4">
            <div class="feature-card" style="border-top: 3px solid var(--cyber-amber); display:flex; flex-direction:column; justify-content:space-between;">
                <div>
                    <div style="font-family:'VT323'; color:var(--cyber-amber); font-size:1.2rem; margin-bottom:10px;">> CAREER OPPORTUNITIES _</div>
                    <h3 style="font-family:'Orbitron'; font-size:1.5rem; color:#FFF; font-weight:900; margin-bottom:15px;">
                        <i class="fa-solid fa-briefcase text-warning me-2"></i> JOIN OUR TEAM
                    </h3>
                    <p class="feature-desc">
                        We are looking for passionate software engineers, cloud architects, and product designers to help build the future of connected retail solutions.
                    </p>
                </div>
                <a href="/Home/Careers" class="btn w-100 py-3 mt-3" style="background:transparent; border:1px solid var(--cyber-amber); color:var(--cyber-amber); font-family:'Orbitron'; font-weight:bold; letter-spacing:1px; text-decoration:none; text-align:center;">
                    [ EXPLORE CAREER ROLES ] <i class="fa-solid fa-briefcase ms-1"></i>
                </a>
            </div>
        </div>
    </div>
</div>
