                    <span class="badge" style="background:#000; border:1px solid var(--cyber-cyan); color:var(--cyber-cyan); padding:10px 15px; font-size:0.9rem; border-radius:0;">
                        <i class="fa-solid fa-network-wired me-2"></i> Multi-tenant Synchronization
                    </span>
                </div>
            </div>
            <div class="col-lg-4 text-lg-end text-start">
                <a href="/Home/Product" class="cta-btn-primary w-100 text-center py-4" style="font-size:1.25rem;">
                    [ VIEW PRICING & LICENSES ] <i class="fa-solid fa-arrow-right-long ms-2"></i>
                </a>
