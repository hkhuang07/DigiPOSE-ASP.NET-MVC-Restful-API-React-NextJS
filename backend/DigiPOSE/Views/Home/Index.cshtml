        <span class="reticle" style="top:15px; right:15px;">[ ]</span>
        <span class="reticle" style="bottom:15px; left:15px;">[ ]</span>
        <span class="reticle" style="bottom:15px; right:15px;">[ ]</span>

        <div class="row align-items-center g-5">
            <div class="col-lg-8">
                <div style="font-family:'VT323'; color:var(--cyber-emerald); font-size:1.3rem;">> NEW RELEASE: DIGIPOSE CORPORATE DIGITAL PACKAGES _</div>
                <h2 style="font-family:'Orbitron'; font-weight:900; font-size:2.8rem; color:#FFFFFF; margin: 15px 0;">
                    SCALE YOUR RETAIL CHAIN WITH CUSTOM DIGITAL POS LICENSES
                </h2>
                <p style="color:var(--cyber-muted); font-size:1.1rem; line-height:1.8;">
