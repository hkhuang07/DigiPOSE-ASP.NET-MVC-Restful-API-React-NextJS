}

<!-- Styles served via cyber-storefront.css -->

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div style="font-family:'VT323'; color:var(--cyber-cyan); font-size:1.4rem; margin-bottom:15px;">> DIGIPOSE_MASTER_GRID // NODE: NOMINAL_ONLINE_STATE _</div>
        <h1 class="hero-title">CYBER POS<br/>ARCHITECTURE</h1>
        <div class="hero-subtitle">NEXT-GEN RETAIL CLOUD & LOW-LATENCY EDGE COMPUTING</div>
        
        <div class="d-flex justify-content-center gap-4 mt-5">
            <a href="/Home/Product" class="cta-btn-primary">
                <i class="fa-solid fa-rocket me-2"></i> [ EXPLORE DIGITAL POS PACKAGES ]
            </a>
            <a href="/Home/Introduce" class="cta-btn-outline">
                <i class="fa-solid fa-microchip me-2"></i> [ ARCHITECTURE GUIDELINES ]
            </a>
        </div>
        
        <div style="margin-top: 70px; font-size: 0.85rem; color: var(--cyber-muted); letter-spacing: 3px; text-transform: uppercase;">
            <i class="fa-solid fa-shield-halved text-success me-2"></i> POWERED BY ASP.NET CORE 8 | OPTIMISTIC CONCURRENCY ROW-VERSIONING | O(1) RAM CACHE
