<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DigiPOSE Cyber HUD ERP</title>
    
    <!-- SEO Meta Tags -->
    <meta name="description" content="DigiPOSE - Next-Generation High-Density Cyber-Cinematic B2B/Retail Point of Sale and E-Commerce Web Storefront. Engineered for production scalability and real-time operations." />
    <meta name="keywords" content="POS, ERP, E-Commerce, Retail Portal, SaaS Subscriptions, Shopping Cart, Cyber HUD" />
    <meta name="author" content="DigiPOSE Systems Architecture Team" />
    
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <!-- FontAwesome 6 Local Icons -->
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />
    <!-- Cyber-Cinematic Military HUD Custom CSS -->
    <link rel="stylesheet" href="~/css/cyber-hud.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div id="app-wrapper">
        <!-- ====================================================================
             TOP NAVBAR
             - Left Navbar: 3-bar hamburger icon (toggle sidebar), logo_main, Logoname
             - Right Navbar: Language, Dark/Light Mode, Notification, Profile
             ==================================================================== -->
        <header class="hud-navbar">
            <!-- Left Navbar -->
            <div class="hud-navbar-left">
                <button type="button" class="hud-toggle-btn" id="sidebarToggle" title="Toggle Sidebar Navigation">
                    <i class="fa-solid fa-bars"></i>
                </button>
                <a class="hud-brand" asp-area="" asp-controller="Home" asp-action="Index" title="System Home">
                    <!-- logo_main SVG HUD Icon -->
                    <svg class="hud-logo-icon" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <polygon points="50,5 95,27 95,73 50,95 5,73 5,27" stroke="#00E5FF" stroke-width="4" fill="rgba(0, 229, 255, 0.1)"/>
                        <circle cx="50" cy="50" r="24" stroke="#00E5FF" stroke-width="3" stroke-dasharray="6 4"/>
                        <circle cx="50" cy="50" r="8" fill="#00FF66"/>
                        <line x1="50" y1="15" x2="50" y2="35" stroke="#00E5FF" stroke-width="3"/>
                        <line x1="50" y1="65" x2="50" y2="85" stroke="#00E5FF" stroke-width="3"/>
                        <line x1="15" y1="50" x2="35" y2="50" stroke="#00E5FF" stroke-width="3"/>
                        <line x1="65" y1="50" x2="85" y2="50" stroke="#00E5FF" stroke-width="3"/>
                    </svg>
                    <div class="hud-brand-title">
                        Digi<span>POSE</span> HUD <span class="hud-badge-ver">v1.0</span>
                    </div>
                </a>
            </div>

            <!-- Right Navbar Actions -->
            <div class="hud-navbar-right d-flex align-items-center">
                <!-- Language Selector (Icon + Dropdown VI/EN) -->
                <div class="dropdown d-inline-block">
                    <button class="hud-lang-btn cyber-parallelogram-btn dropdown-toggle px-3" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Switch Interface Language (VI/EN)">
                        <i class="fa-solid fa-globe me-1" style="font-size:1.0rem; color: #00E5FF;"></i>
                        <span id="langShortCode" style="font-family:'VT323'; font-size:1.1rem; font-weight:bold;">VI</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end hud-dropdown-menu">
                        <li><h6 class="dropdown-header text-cyan" style="font-family:'Orbitron'; color:#00E5FF;">LOCALIZATION CODES</h6></li>
                        <li><a class="dropdown-item" href="javascript:switchLanguage('VI')"><i class="fa-solid fa-check text-success me-2" id="iconVI"></i> Tiếng Việt [ VI / VN ]</a></li>
                        <li><a class="dropdown-item" href="javascript:switchLanguage('EN')"><i class="fa-solid fa-minus text-muted me-2" id="iconEN"></i> English [ EN / US ]</a></li>
                    </ul>
                </div>

                <!-- Dark / Light Mode Switcher (Icon Only) -->
                <button type="button" class="hud-nav-icon-btn cyber-parallelogram-btn px-3" id="themeToggleBtn" title="Toggle Dark (Void) / Light (Holo) Mode">
                    <i class="fa-solid fa-sun" id="themeIcon" style="font-size:1.0rem; color: #FFB000;"></i>
                </button>

                <!-- Notification Dropdown (Icon Only + Red Badge Outside Border) -->
                <div class="dropdown hud-notif-wrapper position-relative d-inline-block me-3" style="z-index: 10;">
                    <button class="hud-notif-btn cyber-parallelogram-btn px-3" type="button" id="notifDropdown" data-bs-toggle="dropdown" aria-expanded="false" title="Notifications">
                        <i class="fa-solid fa-bell" style="font-size: 1.0rem; color: #FFFFFF;"></i>
                    </button>
                    <span class="hud-notif-badge position-absolute top-0 start-100 translate-middle badge rounded-pill" style="background:#FF3333; color:#FFF; font-family:'VT323'; font-size:0.75rem; font-weight:bold; z-index: 15; pointer-events: none;" id="hudNotifBadge">3</span>
                    <ul class="dropdown-menu dropdown-menu-end hud-dropdown-menu" aria-labelledby="notifDropdown" id="hudNotifMenu">
                        <li><h6 class="dropdown-header text-cyan" style="color:#00E5FF; font-family:'Orbitron';">NOTIFICATIONS</h6></li>
                        <li><a class="dropdown-item" href="#"><i class="fa-solid fa-triangle-exclamation text-warning me-2"></i> SKU-109 inventory below minimum threshold</a></li>
                        <li><a class="dropdown-item" href="#"><i class="fa-solid fa-circle-check text-success me-2"></i> Work shift #8812 closed successfully</a></li>
                        <li><a class="dropdown-item" href="#"><i class="fa-solid fa-file-invoice text-info me-2"></i> 5 new tax invoices generated in session</a></li>
                    </ul>
                </div>

                <!-- Profile Dropdown -->
                @{
                    string? userAvatar = User.FindFirst("AvatarUrl")?.Value;
                    var currentPath = Context.Request.Path.Value?.ToLower() ?? "";
                }
                <div class="dropdown">
                    <div class="hud-profile-trigger" id="profileDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="hud-avatar-box" style="overflow: hidden; padding: 0;">
                            @if (!string.IsNullOrEmpty(userAvatar))
                            {
                                <img src="~/uploads/avatars/@userAvatar" alt="Avatar" style="width: 100%; height: 100%; object-fit: cover;" />
                            }
                            else
                            {
                                <span>@(User.Identity?.Name != null && User.Identity.Name.Length >= 2 ? User.Identity.Name.Substring(0, 2).ToUpper() : "ADM")</span>
                            }
                        </div>
                        <div class="hud-user-info">
                            <span class="hud-user-name">@(User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "COMMANDER")</span>
                            <span class="hud-user-role">@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "SYSTEM ADMIN")</span>
                        </div>
                        <i class="fa-solid fa-caret-down text-cyan ms-2 caret-indicator" id="hudProfileCaret" style="font-size: 0.75rem;"></i>
                    </div>
                    <ul class="dropdown-menu dropdown-menu-end hud-dropdown-menu" aria-labelledby="profileDropdown">
                        @if (!currentPath.StartsWith("/administrator") && !currentPath.StartsWith("/home/dashboardrouter"))
                        {
                            <li><a class="dropdown-item" href="/Home/DashboardRouter"><i class="fa-solid fa-user-shield me-2" style="color: #FFB000;"></i> Role Portal Home</a></li>
                        }
                        @if (!currentPath.StartsWith("/pos"))
                        {
                            <li><a class="dropdown-item" href="/POS/Index"><i class="fa-solid fa-cash-register me-2" style="color: #00FF66;"></i> Access POS Cluster</a></li>
                        }
                        @if (!currentPath.StartsWith("/home/storefront") && !currentPath.StartsWith("/storefront"))
                        {
                            <li><a class="dropdown-item" href="/Home/Storefront/Index"><i class="fa-solid fa-store me-2" style="color: #0088FF;"></i> Corporate Storefront</a></li>
                        }
                        <li><hr class="dropdown-divider" style="border-color: rgba(0, 229, 255, 0.2);"></li>
                        <li><a class="dropdown-item" asp-area="" asp-controller="Profile" asp-action="Index"><i class="fa-solid fa-id-card me-2" style="color: #00E5FF;"></i> View Profile</a></li>
                        <li><a class="dropdown-item" asp-area="" asp-controller="Profile" asp-action="Orders"><i class="fa-solid fa-boxes-stacked me-2" style="color: #00FF66;"></i> My Orders</a></li>
                        <li><a class="dropdown-item" asp-area="" asp-controller="Auth" asp-action="ChangePassword"><i class="fa-solid fa-key me-2" style="color: #FFB000;"></i> Change Password</a></li>
                        <li><hr class="dropdown-divider" style="border-color: rgba(0, 229, 255, 0.2);"></li>
                        <li><a class="dropdown-item text-danger" asp-area="" asp-controller="Auth" asp-action="Logout"><i class="fa-solid fa-power-off me-2"></i> Log Out</a></li>
                    </ul>
                </div>
            </div>
        </header>

        <!-- ====================================================================
             MAIN CONTAINER (LEFT SIDEBAR + MAIN CONTENT)
             Sidebar contains management links for all 26 tables categorized by module
             ==================================================================== -->
        <div class="hud-main-container">
            <!-- Left Sidebar (Shared HUD Component) -->
            @await Html.PartialAsync("~/Views/Shared/_CyberSidebar.cshtml")

            <!-- Main Content Container -->
            <main role="main" class="hud-main-content">
                @RenderBody()
            </main>
        </div>

        <!-- ====================================================================
             FOOTER TELEMETRY STRIP (REAL-DATA ZERO-MOCK STANDARD)
             ==================================================================== -->
        <footer class="hud-footer">
            <div class="hud-footer-status" style="display:flex; align-items:center; gap:10px; flex-wrap:wrap; font-size:0.75rem;">
                <div style="display:flex; align-items:center; gap:4px;">
                    <div class="hud-ping-dot" id="globalPingDot"></div>
                    <span style="color:#D8F8FF;">SYSTEM STATUS: <strong id="globalStatusLabel" style="color:var(--bio-emerald, #00FF66);">CHECKING...</strong></span>
                </div>
                <span style="color:rgba(255,255,255,0.2);">|</span>
                <div style="display:flex; align-items:center; gap:4px;">
                    <span style="color:#D8F8FF;">LAN SYN: <strong class="ping-val" id="globalPingVal" style="color:var(--holo-cyan, #00E5FF);">--ms</strong></span>
                </div>
                <span style="color:rgba(255,255,255,0.2);">|</span>
                <span class="footer-meta" style="color:#D8F8FF;">TENANT: <strong id="globalTenantVal" style="color:var(--holo-cyan, #00E5FF);">@(User.FindFirst("TenantName")?.Value ?? "Enterprise HQ")</strong></span>
            </div>
            <div class="hud-footer-time">
                <i class="fa-solid fa-microchip me-1" style="color:var(--holo-cyan, #00E5FF);"></i>
                <span id="hudFooterClock" style="font-family:var(--font-mono, 'Roboto Mono', monospace); font-size:0.8rem; color:#E0E0E0;">2026-07-27 00:00:00.000 UTC+7</span>
            </div>
        </footer>
    </div>

    <!-- Global AntiForgeryToken Provider -->
    <div style="display:none;" id="globalAntiforgeryContainer">
        @Html.AntiForgeryToken()
    </div>

    <!-- Shared Global Notification Modal -->
    @await Html.PartialAsync("_CyberNotificationModal")

    <!-- Scripts --> 
    <script src="~/lib/ckeditor5/ckeditor.js"></script>
    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/cyber-hud.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>