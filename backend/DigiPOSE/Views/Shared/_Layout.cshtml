<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DigiPOSE Cyber HUD ERP</title>
    
    <!-- SEO Meta Tags -->
    <meta name="description" content="DigiPOSE - Next-Generation High-Density Cyber-Cinematic B2B/Retail Point of Sale and E-Commerce Web Storefront. Engineered for production scalability and real-time operations." />
    <meta name="keywords" content="POS, ERP, E-Commerce, Retail Portal, SaaS Subscriptions, Shopping Cart, Cyber HUD" />
    <meta name="author" content="DigiPOSE Systems Architecture Team" />
    
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <!-- FontAwesome 6 Local Icons -->
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />
    <!-- Cyber-Cinematic Military HUD Custom CSS -->
    <link rel="stylesheet" href="~/css/cyber-hud.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div id="app-wrapper">
        <!-- ====================================================================
             TOP NAVBAR
             - Left Navbar: 3-bar hamburger icon (toggle sidebar), logo_main, Logoname
             - Right Navbar: Language, Dark/Light Mode, Notification, Profile
             ==================================================================== -->
        <header class="hud-navbar">
            <!-- Left Navbar -->
            <div class="hud-navbar-left">
                <button type="button" class="hud-toggle-btn" id="sidebarToggle" title="Toggle Sidebar Navigation">
                    <i class="fa-solid fa-bars"></i>
                </button>
                <a class="hud-brand" asp-area="" asp-controller="Home" asp-action="Index" title="System Home">
                    <!-- logo_main SVG HUD Icon -->
                    <svg class="hud-logo-icon" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <polygon points="50,5 95,27 95,73 50,95 5,73 5,27" stroke="#00E5FF" stroke-width="4" fill="rgba(0, 229, 255, 0.1)"/>
                        <circle cx="50" cy="50" r="24" stroke="#00E5FF" stroke-width="3" stroke-dasharray="6 4"/>
                        <circle cx="50" cy="50" r="8" fill="#00FF66"/>
                        <line x1="50" y1="15" x2="50" y2="35" stroke="#00E5FF" stroke-width="3"/>
                        <line x1="50" y1="65" x2="50" y2="85" stroke="#00E5FF" stroke-width="3"/>
                        <line x1="15" y1="50" x2="35" y2="50" stroke="#00E5FF" stroke-width="3"/>
                        <line x1="65" y1="50" x2="85" y2="50" stroke="#00E5FF" stroke-width="3"/>
                    </svg>
                    <div class="hud-brand-title">
                        Digi<span>POSE</span> HUD <span class="hud-badge-ver">v1.0</span>
                    </div>
                </a>
            </div>

            <!-- Right Navbar Actions -->
            <div class="hud-navbar-right">
                <!-- Language Selector (Icon + Text) -->
                <button type="button" class="hud-lang-btn cyber-parallelogram-btn" id="langToggleBtn" title="Switch Language (English / Tiếng Việt)">
                    <i class="fa-solid fa-globe me-1"></i>
                    <span id="langText">English</span>
                </button>

                <!-- Dark / Light Mode Switcher (Icon Only) -->
                <button type="button" class="hud-nav-icon-btn cyber-parallelogram-btn" id="themeToggleBtn" title="Toggle Dark (Void) / Light (Holo) Mode">
                    <i class="fa-solid fa-sun" id="themeIcon"></i>
                </button>

                <!-- Notification Dropdown (Icon Only + Red Badge Outside) -->
                <div class="dropdown hud-notif-wrapper">
                    <button class="hud-notif-btn cyber-parallelogram-btn" type="button" id="notifDropdown" data-bs-toggle="dropdown" aria-expanded="false" title="Notifications">
                        <i class="fa-solid fa-bell" style="font-size: 1.1rem; color: #FFFFFF;"></i>
                        <span class="hud-notif-badge" id="hudNotifBadge">3</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end hud-dropdown-menu" aria-labelledby="notifDropdown" id="hudNotifMenu">
                        <li><h6 class="dropdown-header text-cyan" style="color:#00E5FF; font-family:'Orbitron';">TELEMETRY ALERTS</h6></li>
                        <li><a class="dropdown-item" href="#"><i class="fa-solid fa-triangle-exclamation text-warning me-2"></i> SKU-109 inventory below minimum threshold</a></li>
                        <li><a class="dropdown-item" href="#"><i class="fa-solid fa-circle-check text-success me-2"></i> Work shift #8812 closed successfully</a></li>
                        <li><a class="dropdown-item" href="#"><i class="fa-solid fa-file-invoice text-info me-2"></i> 5 new tax invoices generated in session</a></li>
                    </ul>
                </div>

                <!-- Profile Dropdown -->
                @{
                    string? userAvatar = User.FindFirst("AvatarUrl")?.Value;
                    var currentPath = Context.Request.Path.Value?.ToLower() ?? "";
                }
                <div class="dropdown">
                    <div class="hud-profile-trigger dropdown-toggle" id="profileDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="hud-avatar-box" style="overflow: hidden; padding: 0;">
                            @if (!string.IsNullOrEmpty(userAvatar))
                            {
                                <img src="~/uploads/avatars/@userAvatar" alt="Avatar" style="width: 100%; height: 100%; object-fit: cover;" />
                            }
                            else
                            {
                                <span>@(User.Identity?.Name != null && User.Identity.Name.Length >= 2 ? User.Identity.Name.Substring(0, 2).ToUpper() : "ADM")</span>
                            }
                        </div>
                        <div class="hud-user-info">
                            <span class="hud-user-name">@(User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "COMMANDER")</span>
                            <span class="hud-user-role">@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "SYSTEM ADMIN")</span>
                        </div>
                        <i class="fa-solid fa-caret-down text-cyan ms-2 caret-indicator" id="hudProfileCaret" style="font-size: 0.75rem;"></i>
                    </div>
                    <ul class="dropdown-menu dropdown-menu-end hud-dropdown-menu" aria-labelledby="profileDropdown">
                        @if (!currentPath.StartsWith("/administrator") && !currentPath.StartsWith("/home/dashboardrouter"))
                        {
                            <li><a class="dropdown-item" href="/Home/DashboardRouter"><i class="fa-solid fa-user-shield me-2" style="color: #FFB000;"></i> Role Portal Home</a></li>
                        }
                        @if (!currentPath.StartsWith("/pos"))
                        {
                            <li><a class="dropdown-item" href="/POS/Index"><i class="fa-solid fa-cash-register me-2" style="color: #00FF66;"></i> Access POS Cluster</a></li>
                        }
                        @if (!currentPath.StartsWith("/home/storefront") && !currentPath.StartsWith("/storefront"))
                        {
                            <li><a class="dropdown-item" href="/Home/Storefront/Index"><i class="fa-solid fa-store me-2" style="color: #0088FF;"></i> Corporate Storefront</a></li>
                        }
                        <li><hr class="dropdown-divider" style="border-color: rgba(0, 229, 255, 0.2);"></li>
                        <li><a class="dropdown-item" asp-area="" asp-controller="Profile" asp-action="Index"><i class="fa-solid fa-id-card me-2" style="color: #00E5FF;"></i> View Profile</a></li>
                        <li><a class="dropdown-item" asp-area="" asp-controller="Profile" asp-action="Index" asp-fragment="orders-tab"><i class="fa-solid fa-boxes-stacked me-2" style="color: #00FF66;"></i> My Orders</a></li>
                        <li><a class="dropdown-item" asp-area="" asp-controller="Auth" asp-action="ChangePassword"><i class="fa-solid fa-key me-2" style="color: #FFB000;"></i> Change Password</a></li>
                        <li><hr class="dropdown-divider" style="border-color: rgba(0, 229, 255, 0.2);"></li>
                        <li><a class="dropdown-item text-danger" asp-area="" asp-controller="Auth" asp-action="Logout"><i class="fa-solid fa-power-off me-2"></i> Log Out</a></li>
                    </ul>
                </div>
            </div>
        </header>

        <!-- ====================================================================
             MAIN CONTAINER (LEFT SIDEBAR + MAIN CONTENT)
             Sidebar contains management links for all 26 tables categorized by module
             ==================================================================== -->
        <div class="hud-main-container">
            <!-- Left Sidebar -->
            <aside class="hud-sidebar" id="hudSidebar">
                <!-- MODULE 5: LINKS & TERMINALS -->
                <div class="hud-menu-group">
                    <div class="hud-menu-category-title text-success" style="border-color: rgba(0, 255, 102, 0.3);">
                        <span><i class="fa-solid fa-link me-1"></i> Links & Terminals</span>
                        <i class="fa-solid fa-chevron-down text-success" style="font-size:0.6rem;"></i>
                    </div>
                    <ul class="hud-menu-list">
                        @if (User.IsInRole("Super Admin") || User.IsInRole("Tenant Manager") || User.IsInRole("POS Operator") || User.HasClaim("Permission", "POS.Order.Create"))
                        {
                        <li class="hud-menu-item">
                            <a class="hud-menu-link border border-success mb-1" asp-area="" asp-controller="POS" asp-action="Index" style="box-shadow: 0 0 10px rgba(0, 255, 102, 0.15); background: rgba(0, 255, 102, 0.03);">
                                <i class="fa-solid fa-cash-register text-success"></i>
                                <span class="hud-menu-text text-success" style="font-weight: bold; letter-spacing: 1px;">Launch POS Machine</span>
                                <span class="hud-menu-badge" style="background-color: #00FF66; color: #000; border-color: #00FF66; font-weight: bold;">POS</span>
                            </a>
                        </li>
                        }
                        <li class="hud-menu-item">
                            <a class="hud-menu-link border" asp-area="" asp-controller="Storefront" asp-action="Index" style="border-color: var(--primary-cyan) !important; box-shadow: 0 0 10px rgba(0, 229, 255, 0.15); background: rgba(0, 229, 255, 0.03);">
                                <i class="fa-solid fa-cart-shopping" style="color: var(--primary-cyan);"></i>
                                <span class="hud-menu-text" style="color: var(--primary-cyan); font-weight: bold; letter-spacing: 1px;">Online Storefront</span>
                                <span class="hud-menu-badge" style="background-color: #00E5FF; color: #000; border-color: #00E5FF; font-weight: bold;">WEB</span>
                            </a>
                        </li>
                    </ul>
                </div>

                @if (User.Identity?.IsAuthenticated == true && (User.IsInRole("Super Admin") || User.IsInRole("Tenant Manager") || User.IsInRole("POS Operator") || User.IsInRole("Warehouse Operator") || User.IsInRole("Catalog Specialist") || User.IsInRole("Accountant") || User.Claims.Any(c => c.Type == "Permission")))
                {
                <!-- MODULE 1: SYSTEM & IAM -->
                <div class="hud-menu-group">
                    <div class="hud-menu-category-title">
                        <span><i class="fa-solid fa-shield-halved me-1"></i> System & IAM</span>
                        <i class="fa-solid fa-chevron-down text-cyan" style="font-size:0.6rem;"></i>
                    </div>
                    <ul class="hud-menu-list">
                        <li class="hud-menu-item">
                            <a class="hud-menu-link" asp-area="Administrator" asp-controller="Tenants" asp-action="Index">
                                <i class="fa-solid fa-code-tenant"></i>
                                <span class="hud-menu-text">Tenants</span>
                                <span class="hud-menu-badge">TBL-01</span>
                            </a>
                        </li>
                        <li class="hud-menu-item">
                            <a class="hud-menu-link" asp-area="Administrator" asp-controller="Roles" asp-action="Index">
                                <i class="fa-solid fa-user-shield"></i>
                                <span class="hud-menu-text">Roles & Permissions</span>
                                <span class="hud-menu-badge">TBL-02</span>
                            </a>
                        </li>
                        <li class="hud-menu-item">
                            <a class="hud-menu-link" asp-area="Administrator" asp-controller="Users" asp-action="Index">
                                <i class="fa-solid fa-users-gear"></i>
                                <span class="hud-menu-text">User Accounts</span>
                                <span class="hud-menu-badge">TBL-03</span>
                            </a>
                        </li>
                        <li class="hud-menu-item">
                            <a class="hud-menu-link" asp-area="Administrator" asp-controller="Counters" asp-action="Index">
                                <i class="fa-solid fa-desktop"></i>
                                <span class="hud-menu-text">Counters</span>
                                <span class="hud-menu-badge">TBL-04</span>
                            </a>
                        </li>
                        <li class="hud-menu-item">
                            <a class="hud-menu-link" asp-area="Administrator" asp-controller="Shifts" asp-action="Index">
                                <i class="fa-solid fa-clock-rotate-left"></i>
                                <span class="hud-menu-text">Work Shifts</span>
                                <span class="hud-menu-badge">TBL-05</span>
                            </a>
                        </li>
                        <li class="hud-menu-item">
                            <a class="hud-menu-link" asp-area="Administrator" asp-controller="ShiftStatuses" asp-action="Index">
                                <i class="fa-solid fa-list-check"></i>
                                <span class="hud-menu-text">Shift Statuses</span>
                                <span class="hud-menu-badge">TBL-06</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- MODULE 2: PARTNERS & CRM -->
                <div class="hud-menu-group">
                    <div class="hud-menu-category-title">
                        <span><i class="fa-solid fa-handshake me-1"></i> Partners & CRM</span>
                        <i class="fa-solid fa-chevron-down text-cyan" style="font-size:0.6rem;"></i>
                    </div>
                    <ul class="hud-menu-list">
                        <li class="hud-menu-item">
                            <a class="hud-menu-link" asp-area="Administrator" asp-controller="CustomerTypes" asp-action="Index">
                                <i class="fa-solid fa-layer-group"></i>
                                <span class="hud-menu-text">Customer Types</span>
                                <span class="hud-menu-badge">TBL-07</span>
                            </a>
                        </li>
                        <li class="hud-menu-item">
                            <a class="hud-menu-link" asp-area="Administrator" asp-controller="Customers" asp-action="Index">
                                <i class="fa-solid fa-address-book"></i>
                                <span class="hud-menu-text">Customers</span>
                                <span class="hud-menu-badge">TBL-08</span>
                            </a>
                        </li>
                        <li class="hud-menu-item">
                            <a class="hud-menu-link" asp-area="Administrator" asp-controller="Suppliers" asp-action="Index">
                                <i class="fa-solid fa-truck-field"></i>
                                <span class="hud-menu-text">Suppliers</span>
                                <span class="hud-menu-badge">TBL-09</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- MODULE 3: INVENTORY & CATALOG -->
                <div class="hud-menu-group">
                    <div class="hud-menu-category-title">
                        <span><i class="fa-solid fa-boxes-stacked me-1"></i> Inventory & Catalog</span>
                        <i class="fa-solid fa-chevron-down text-cyan" style="font-size:0.6rem;"></i>
                    </div>
                    <ul class="hud-menu-list">
                        <li class="hud-menu-item">
                            <a class="hud-menu-link" asp-area="Administrator" asp-controller="Categories" asp-action="Index">
                                <i class="fa-solid fa-folder-tree"></i>
                                <span class="hud-menu-text">Categories</span>
                                <span class="hud-menu-badge">TBL-10</span>
                            </a>
                        </li>
                        <li class="hud-menu-item">
                            <a class="hud-menu-link" asp-area="Administrator" asp-controller="Units" asp-action="Index">
                                <i class="fa-solid fa-scale-balanced"></i>
                                <span class="hud-menu-text">Units</span>
                                <span class="hud-menu-badge">TBL-11</span>
                            </a>
                        </li>
                        <li class="hud-menu-item">
                            <a class="hud-menu-link" asp-area="Administrator" asp-controller="Manufacturers" asp-action="Index">
                                <i class="fa-solid fa-industry"></i>
                                <span class="hud-menu-text">Manufacturers</span>
                                <span class="hud-menu-badge">TBL-12</span>
                            </a>
                        </li>
                        <li class="hud-menu-item">
                            <a class="hud-menu-link" asp-area="Administrator" asp-controller="TaxTypes" asp-action="Index">
                                <i class="fa-solid fa-percent"></i>
                                <span class="hud-menu-text">Tax Types</span>
                                <span class="hud-menu-badge">TBL-13</span>
                            </a>
                        </li>
                        <li class="hud-menu-item">
                            <a class="hud-menu-link" asp-area="Administrator" asp-controller="ProductTypes" asp-action="Index">
                                <i class="fa-solid fa-tags"></i>
                                <span class="hud-menu-text">Product Types</span>
                                <span class="hud-menu-badge">TBL-14</span>
                            </a>
                        </li>
                        <li class="hud-menu-item">
                            <a class="hud-menu-link" asp-area="Administrator" asp-controller="ItemNatures" asp-action="Index">
                                <i class="fa-solid fa-dna"></i>
                                <span class="hud-menu-text">Item Natures</span>
                                <span class="hud-menu-badge">TBL-15</span>
                            </a>
                        </li>
                        <li class="hud-menu-item">
                            <a class="hud-menu-link" asp-area="Administrator" asp-controller="Products" asp-action="Index">
                                <i class="fa-solid fa-box-open"></i>
                                <span class="hud-menu-text">Products</span>
                                <span class="hud-menu-badge">TBL-16</span>
                            </a>
                        </li>
                        <li class="hud-menu-item">
                            <a class="hud-menu-link" asp-area="Administrator" asp-controller="ProductInventories" asp-action="Index">
                                <i class="fa-solid fa-warehouse"></i>
                                <span class="hud-menu-text">Product Inventories</span>
                                <span class="hud-menu-badge">TBL-17</span>
                            </a>
                        </li>
                        <li class="hud-menu-item">
                            <a class="hud-menu-link" asp-area="Administrator" asp-controller="StockVouchers" asp-action="Index">
                                <i class="fa-solid fa-file-export"></i>
                                <span class="hud-menu-text">Stock Vouchers</span>
                                <span class="hud-menu-badge">TBL-18</span>
                            </a>
                        </li>
                        <li class="hud-menu-item">
                            <a class="hud-menu-link" asp-area="Administrator" asp-controller="StockVoucherDetails" asp-action="Index">
                                <i class="fa-solid fa-file-lines"></i>
                                <span class="hud-menu-text">Stock Voucher Details</span>
                                <span class="hud-menu-badge">TBL-19</span>
                            </a>
                        </li>
                        <li class="hud-menu-item">
                            <a class="hud-menu-link" asp-area="Administrator" asp-controller="StockAudits" asp-action="Index">
                                <i class="fa-solid fa-clipboard-check"></i>
                                <span class="hud-menu-text">Stock Audits</span>
                                <span class="hud-menu-badge">TBL-27</span>
                            </a>
                        </li>
                        <li class="hud-menu-item">
                            <a class="hud-menu-link" asp-area="Administrator" asp-controller="StockTransfers" asp-action="Index">
                                <i class="fa-solid fa-truck-moving"></i>
                                <span class="hud-menu-text">Stock Transfers</span>
                                <span class="hud-menu-badge">TBL-28</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- MODULE 4: SALES & BILLING -->
                <div class="hud-menu-group">
                    <div class="hud-menu-category-title">
                        <span><i class="fa-solid fa-cart-shopping me-1"></i> Sales & Billing</span>
                        <i class="fa-solid fa-chevron-down text-cyan" style="font-size:0.6rem;"></i>
                    </div>
                    <ul class="hud-menu-list">
                        <li class="hud-menu-item">
                            <a class="hud-menu-link" asp-area="Administrator" asp-controller="OrderStatuses" asp-action="Index">
                                <i class="fa-solid fa-flag"></i>
                                <span class="hud-menu-text">Order Statuses</span>
                                <span class="hud-menu-badge">TBL-20</span>
                            </a>
                        </li>
                        <li class="hud-menu-item">
                            <a class="hud-menu-link" asp-area="Administrator" asp-controller="PaymentMethods" asp-action="Index">
                                <i class="fa-solid fa-credit-card"></i>
                                <span class="hud-menu-text">Payment Methods</span>
                                <span class="hud-menu-badge">TBL-21</span>
                            </a>
                        </li>
                        <li class="hud-menu-item">
                            <a class="hud-menu-link" asp-area="Administrator" asp-controller="Orders" asp-action="Index">
                                <i class="fa-solid fa-receipt"></i>
                                <span class="hud-menu-text">Sales Orders</span>
                                <span class="hud-menu-badge">TBL-22</span>
                            </a>
                        </li>
                        <li class="hud-menu-item">
                            <a class="hud-menu-link" asp-area="Administrator" asp-controller="OrderDetails" asp-action="Index">
                                <i class="fa-solid fa-list-ol"></i>
                                <span class="hud-menu-text">Order Details</span>
                                <span class="hud-menu-badge">TBL-23</span>
                            </a>
                        </li>
                        <li class="hud-menu-item">
                            <a class="hud-menu-link" asp-area="Administrator" asp-controller="InvoiceStatuses" asp-action="Index">
                                <i class="fa-solid fa-square-check"></i>
                                <span class="hud-menu-text">Invoice Statuses</span>
                                <span class="hud-menu-badge">TBL-24</span>
                            </a>
                        </li>
                        <li class="hud-menu-item">
                            <a class="hud-menu-link" asp-area="Administrator" asp-controller="InvoiceTypes" asp-action="Index">
                                <i class="fa-solid fa-file-invoice-dollar"></i>
                                <span class="hud-menu-text">Invoice Types</span>
                                <span class="hud-menu-badge">TBL-25</span>
                            </a>
                        </li>
                        <li class="hud-menu-item">
                            <a class="hud-menu-link" asp-area="Administrator" asp-controller="Invoices" asp-action="Index">
                                <i class="fa-solid fa-file-signature"></i>
                                <span class="hud-menu-text">Financial Invoices</span>
                                <span class="hud-menu-badge">TBL-26</span>
                            </a>
                        </li>
                        <li class="hud-menu-item">
                            <a class="hud-menu-link" asp-area="Administrator" asp-controller="Subscriptions" asp-action="Index">
                                <i class="fa-solid fa-repeat"></i>
                                <span class="hud-menu-text">SaaS Subscriptions</span>
                                <span class="hud-menu-badge">TBL-29</span>
                            </a>
                        </li>
                        @if (User.IsInRole("Super Admin") || User.IsInRole("Tenant Manager") || User.IsInRole("Accountant"))
                        {
                        <li class="hud-menu-item">
                            <a class="hud-menu-link" asp-area="Administrator" asp-controller="Retails" asp-action="Index">
                                <i class="fa-solid fa-cash-register"></i>
                                <span class="hud-menu-text">Retail Documents</span>
                                <span class="hud-menu-badge" style="background:#00FF6633; color:#00FF66; border-color:#00FF66;">POS</span>
                            </a>
                        </li>
                        }
                    </ul>
                </div>
                }
            </aside>

            <!-- Main Content Container -->
            <main role="main" class="hud-main-content">
                @RenderBody()
            </main>
        </div>

        <!-- ====================================================================
             FOOTER TELEMETRY STRIP (REAL-DATA ZERO-MOCK STANDARD)
             ==================================================================== -->
        <footer class="hud-footer">
            <div class="hud-footer-status" style="display:flex; align-items:center; gap:10px; flex-wrap:wrap; font-size:0.75rem;">
                <div style="display:flex; align-items:center; gap:4px;">
                    <div class="hud-ping-dot" id="globalPingDot"></div>
                    <span style="color:#D8F8FF;">SYSTEM STATUS: <strong id="globalStatusLabel" style="color:var(--bio-emerald, #00FF66);">CHECKING...</strong></span>
                </div>
                <span style="color:rgba(255,255,255,0.2);">|</span>
                <div style="display:flex; align-items:center; gap:4px;">
                    <span style="color:#D8F8FF;">LAN SYN: <strong class="ping-val" id="globalPingVal" style="color:var(--holo-cyan, #00E5FF);">--ms</strong></span>
                </div>
                <span style="color:rgba(255,255,255,0.2);">|</span>
                <span class="footer-meta" style="color:#D8F8FF;">TENANT: <strong id="globalTenantVal" style="color:var(--holo-cyan, #00E5FF);">@(User.FindFirst("TenantName")?.Value ?? "Enterprise HQ")</strong></span>
            </div>
            <div class="hud-footer-time">
                <i class="fa-solid fa-microchip me-1" style="color:var(--holo-cyan, #00E5FF);"></i>
                <span id="hudFooterClock" style="font-family:var(--font-mono, 'Roboto Mono', monospace); font-size:0.8rem; color:#E0E0E0;">2026-07-27 00:00:00.000 UTC+7</span>
            </div>
        </footer>
    </div>

    <!-- Global AntiForgeryToken Provider -->
    <div style="display:none;" id="globalAntiforgeryContainer">
        @Html.AntiForgeryToken()
    </div>

    <!-- Shared Global Notification Modal -->
    @await Html.PartialAsync("_CyberNotificationModal")

    <!-- Scripts --> 
    <script src="~/lib/ckeditor5/ckeditor.js"></script>
    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/cyber-hud.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>