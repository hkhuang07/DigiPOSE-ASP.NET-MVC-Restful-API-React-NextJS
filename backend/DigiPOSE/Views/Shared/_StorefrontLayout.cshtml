<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DigiPOSE Enterprise Ecosystem</title>
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="~/images/brand/logo_dark.jpg" />
    
    <!-- CSS Dependencies -->
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700;900&family=Rajdhani:wght@500;700&family=VT323&family=Roboto+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>

    <link rel="stylesheet" href="~/css/cyber-storefront.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cyber-components.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Corporate Storefront Cyber Navbar -->
    <nav class="cyber-store-nav">
        <!-- Left: Brand Logo Synced with Administrator HUD (Without Hamburger) -->
        <div class="nav-brand-group">
            <a href="/Home/Index" title="System Home" class="text-decoration-none">
                @await Html.PartialAsync("~/Views/Shared/_NavbarBrand.cshtml")
            </a>
        </div>

        <!-- Center: Standardized Navigation Matrix -->
        <ul class="nav-center-menu">
            <li><a href="/Home/Introduce" class="nav-link-cyber @(ViewContext.RouteData.Values["Action"]?.ToString() == "Introduce" ? "active" : "")">Introduce</a></li>
            <li><span class="nav-divider">|</span></li>
            <li><a href="/Home/Product" class="nav-link-cyber @(ViewContext.RouteData.Values["Action"]?.ToString() == "Product" ? "active" : "")">Product</a></li>
            <li><span class="nav-divider">|</span></li>
            <li><a href="/Home/Storefront/Index" class="nav-link-cyber @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Storefront" ? "active" : "")">Store</a></li>
            <li><span class="nav-divider">|</span></li>
            <li><a href="/Home/Contact" class="nav-link-cyber @(ViewContext.RouteData.Values["Action"]?.ToString() == "Contact" ? "active" : "")">Contact</a></li>
            <li><span class="nav-divider">|</span></li>
            <li><a href="/Home/Careers" class="nav-link-cyber @(ViewContext.RouteData.Values["Action"]?.ToString() == "Careers" ? "active" : "")">Careers</a></li>
        </ul>

        <!-- Right: Action Utility Controls -> Language - Dark/light - [Login][Sign up] -->
        <div class="nav-right-actions d-flex align-items-center">
            <!-- Language Selection (Icon + Shortcode) -->
            <div class="dropdown">
                <button class="cyber-utility-btn dropdown-toggle px-3" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Switch Interface Language (VI/EN)">
                    <i class="fa-solid fa-globe me-1" style="font-size:1.0rem; color: var(--cyber-cyan);"></i><span id="langShortCode" style="font-family:'VT323'; font-size:1.05rem; font-weight:bold;">VI</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end cyber-dropdown-menu">
                    <li><h6 class="dropdown-header text-cyan" style="font-family:'Orbitron';">LOCALIZATION CODES</h6></li>
                    <li><a class="dropdown-item" href="javascript:switchLanguage('VI')"><i class="fa-solid fa-check text-success me-2" id="iconVI"></i> Tiếng Việt [ VI / VN ]</a></li>
                    <li><a class="dropdown-item" href="javascript:switchLanguage('EN')"><i class="fa-solid fa-minus text-muted me-2" id="iconEN"></i> English [ EN / US ]</a></li>
                </ul>
            </div>

            <!-- Dark / Light Mode Switcher (ICON ONLY) -->
            <button class="cyber-utility-btn px-3" type="button" onclick="toggleStorefrontTheme()" title="Toggle Dark Void / Light Holo Theme">
                <i class="fa-solid fa-sun" id="themeIcon" style="font-size:1.0rem; color: var(--cyber-amber);"></i>
            </button>

            <!-- Notification Icon Dropdown (Unclipped Badge) -->
            <div class="dropdown hud-notif-wrapper position-relative me-3" style="z-index: 10;">
                <button class="cyber-utility-btn px-3" type="button" id="storeNotifDropdown" data-bs-toggle="dropdown" aria-expanded="false" title="Ecosystem Notifications">
                    <i class="fa-solid fa-bell" style="font-size: 1.0rem; color: #FFFFFF;"></i>
                </button>
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill" style="background:var(--cyber-danger); color:#FFF; font-family:'VT323'; font-size:0.75rem; font-weight:bold; z-index: 15; pointer-events: none;">2</span>
                <ul class="dropdown-menu dropdown-menu-end cyber-dropdown-menu" aria-labelledby="storeNotifDropdown">
                    <li><h6 class="dropdown-header text-cyan" style="color:var(--cyber-cyan); font-family:'Orbitron';">NOTIFICATIONS & DEALS</h6></li>
                    <li><a class="dropdown-item" href="#"><i class="fa-solid fa-circle-check text-success me-2"></i> System online and operational</a></li>
                    <li><a class="dropdown-item" href="#"><i class="fa-solid fa-truck-fast text-warning me-2"></i> Free shipping applied for orders > 500k VND</a></li>
                </ul>
            </div>

            <!-- Off-canvas Cart Trigger (Unclipped Badge) -->
            <div class="position-relative d-inline-block me-3" style="z-index: 10;">
                <button class="cyber-utility-btn px-3" type="button" data-bs-toggle="offcanvas" data-bs-target="#cartOffcanvas" aria-controls="cartOffcanvas" title="Open Shopping Cart">
                    <i class="fa-solid fa-cart-shopping" style="font-size: 1.0rem; color: #00FF66;"></i>
                </button>
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill" style="background:#00E5FF; color:#000; font-family:'VT323'; font-size:0.85rem; font-weight:bold; box-shadow:0 0 8px rgba(0,229,255,0.8); z-index: 15;" id="navCartBadgeCount">0</span>
            </div>

            <!-- Auth Buttons OR Profile Dropdown when authenticated -->
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                string? userAvatar = User.FindFirst("AvatarUrl")?.Value;
                var currentPath = Context.Request.Path.Value?.ToLower() ?? "";
                <div class="dropdown">
                    <div class="hud-profile-trigger" id="profileDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="cursor:pointer;">
                        <div class="hud-avatar-box">
                            @if (!string.IsNullOrEmpty(userAvatar))
                            {
                                <img src="~/uploads/avatars/@userAvatar" alt="Avatar" style="width: 100%; height: 100%; object-fit: cover;" />
                            }
                            else
                            {
                                <span>@(User.Identity.Name != null && User.Identity.Name.Length >= 2 ? User.Identity.Name.Substring(0, 2).ToUpper() : "US")</span>
                            }
                        </div>
                        <div class="hud-user-info">
                            <span class="hud-user-name">@(User.FindFirst("FullName")?.Value ?? User.Identity.Name)</span>
                            <span class="hud-user-role">@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "VERIFIED MEMBER")</span>
                        </div>
                        <i class="fa-solid fa-caret-down text-cyan ms-2 caret-indicator" id="hudProfileCaret" style="font-size: 0.75rem; transition: transform 0.2s ease;"></i>
                    </div>
                    <ul class="dropdown-menu dropdown-menu-end cyber-dropdown-menu" aria-labelledby="profileDropdown">
                        <li><a class="dropdown-item" href="/Home/DashboardRouter"><i class="fa-solid fa-user-shield me-2" style="color: #FFB000;"></i> Role Portal Home</a></li>
                        @if (!currentPath.StartsWith("/home/index") && currentPath != "/")
                        {
                            <li><a class="dropdown-item" href="/Home/Index"><i class="fa-solid fa-house-user me-2" style="color: var(--cyber-cyan);"></i> User Portal Home</a></li>
                        }
                        @if (!currentPath.StartsWith("/pos"))
                        {
                            <li><a class="dropdown-item" href="/POS/Index"><i class="fa-solid fa-cash-register me-2" style="color: #00FF66;"></i> Access POS Cluster</a></li>
                        }
                        @if (!currentPath.StartsWith("/home/storefront") && !currentPath.StartsWith("/storefront"))
                        {
                            <li><a class="dropdown-item" href="/Home/Storefront/Index"><i class="fa-solid fa-store me-2" style="color: #0088FF;"></i> Corporate Storefront</a></li>
                        }
                        <li><hr class="dropdown-divider" style="border-color: var(--cyber-border);"></li>
                        <li><a class="dropdown-item" asp-area="" asp-controller="Profile" asp-action="Index"><i class="fa-solid fa-id-card me-2" style="color: var(--cyber-cyan);"></i> View Profile</a></li>
                        <li><a class="dropdown-item" asp-area="" asp-controller="Profile" asp-action="Orders"><i class="fa-solid fa-boxes-stacked me-2" style="color: #00FF66;"></i> My Orders</a></li>
                        <li><a class="dropdown-item" asp-area="" asp-controller="Auth" asp-action="ChangePassword"><i class="fa-solid fa-key me-2" style="color: #FFB000;"></i> Change Password</a></li>
                        <li><hr class="dropdown-divider" style="border-color: var(--cyber-border);"></li>
                        <li><a class="dropdown-item text-danger" asp-area="" asp-controller="Auth" asp-action="Logout"><i class="fa-solid fa-power-off me-2"></i> Log Out</a></li>
                    </ul>
                </div>
            }
            else
            {
                <a href="/Auth/Login" class="btn-action-login" title="Access Authentication Terminal">[ LOGIN ]</a>
                <a href="/Auth/Register" class="btn-action-signup" title="Register New Operator">[ SIGN UP ]</a>
            }
        </div>
    </nav>

    <!-- Main Content Container -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Cyber Corporate Footer -->
    <footer class="cyber-footer">
        <div class="container-fluid">
            <div class="row g-5">
                <div class="col-lg-4 col-md-6">
                    <div style="font-family:'Orbitron'; font-size:1.5rem; font-weight:900; color:var(--cyber-cyan); margin-bottom:15px;">
                        <i class="fa-solid fa-microchip me-2"></i> DigiPOSE ECOSYSTEM
                    </div>
                    <p style="color:var(--cyber-muted); line-height:1.7;">
                        Next-generation Enterprise Resource Planning & Point of Sale platform. Engineered for seamless B2B retail management and high-reliability operations.
                    </p>
                    <div style="color:var(--cyber-emerald); font-family:'VT323'; font-size:1.2rem; margin-top:20px;">
                        > SYSTEM STATUS: ONLINE [ OPERATIONAL ] _
                    </div>
                </div>

                <div class="col-lg-2 col-md-3">
                    <h5 class="footer-title">Navigation</h5>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a href="/Home/Introduce" class="footer-link">> About Us</a></li>
                        <li class="mb-2"><a href="/Home/Product" class="footer-link">> POS Software Packages</a></li>
                        <li class="mb-2"><a href="/Storefront/Index" class="footer-link">> Retail Storefront</a></li>
                        <li class="mb-2"><a href="/Home/Contact" class="footer-link">> Contact Support</a></li>
                        <li class="mb-2"><a href="/Home/Careers" class="footer-link">> Careers & Opportunities</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-3">
                    <h5 class="footer-title">Key Features</h5>
                    <ul class="list-unstyled">
                        <li class="mb-2"><span class="text-white"><i class="fa-solid fa-check text-success me-2"></i> Smart POS Terminal</span></li>
                        <li class="mb-2"><span class="text-white"><i class="fa-solid fa-check text-success me-2"></i> Real-time Inventory Sync</span></li>
                        <li class="mb-2"><span class="text-white"><i class="fa-solid fa-check text-success me-2"></i> High-Speed Checkout</span></li>
                        <li class="mb-2"><span class="text-white"><i class="fa-solid fa-check text-success me-2"></i> Customer & Order Management</span></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-12">
                    <h5 class="footer-title">Contact Headquarters</h5>
                    <div style="font-family:'Roboto Mono'; font-size:0.95rem; color:var(--cyber-text);">
                        <div class="mb-2"><i class="fa-solid fa-location-dot text-cyan me-2"></i> Floor 24, Cyber-Tech Tower, Silicon Quad</div>
                        <div class="mb-2"><i class="fa-solid fa-phone-volume text-success me-2"></i> +84 (24) 8888-9999 [ Emergency Switch ]</div>
                        <div class="mb-4"><i class="fa-solid fa-envelope-open-text text-warning me-2"></i> enterprise-noc@digipose.io</div>
                        <div style="font-size:0.8rem; color:var(--cyber-muted); border-top:1px dashed var(--cyber-border); padding-top:12px;">
                            &copy; 2026 DIGIPOSE CORP. STRICT MILITARY/MEDICAL HUD PROTOCOL ENFORCED.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <!-- Off-canvas Shopping Cart (Real Database Cart Synchronization) -->
    <div class="offcanvas offcanvas-end offcanvas-cyber" tabindex="-1" id="cartOffcanvas" aria-labelledby="cartOffcanvasLabel" style="width: 450px;">
        <div class="offcanvas-header d-flex justify-content-between align-items-center">
            <h5 class="offcanvas-title" id="cartOffcanvasLabel"><i class="fa-solid fa-cart-shopping text-cyan me-2"></i> YOUR SHOPPING CART</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body d-flex flex-column justify-content-between p-4">
            <div id="cartItemsContainer" class="flex-grow-1 overflow-auto pe-2">
                <div class="text-center py-5 text-muted">
                    <i class="fa-solid fa-box-open mb-3" style="font-size:3rem; opacity:0.5;"></i>
                    <p style="font-family:'VT323'; font-size:1.4rem;">> YOUR CART IS EMPTY // _</p>
                </div>
            </div>

            <div class="pt-3 mt-3" style="border-top: 2px dashed var(--cyber-border);">
                <div class="d-flex justify-content-between mb-2">
                    <span style="color:var(--cyber-muted);">GROSS SUBTOTAL:</span>
                    <span style="font-family:'VT323'; font-size:1.4rem; color:#FFF;" id="cartGrossAmount">$0.00</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span style="color:var(--cyber-muted);">ESTIMATED TAX (VAT):</span>
                    <span style="font-family:'VT323'; font-size:1.4rem; color:var(--cyber-amber);" id="cartTaxAmount">$0.00</span>
                </div>
                <div class="d-flex justify-content-between mb-4 pb-2" style="border-bottom:1px solid var(--cyber-border);">
                    <span style="font-family:'Orbitron'; font-weight:700; color:var(--cyber-cyan);">MASTER TOTAL:</span>
                    <span style="font-family:'VT323'; font-size:2rem; font-weight:bold; color:var(--cyber-emerald);" id="cartTotalAmount">$0.00</span>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-danger py-2 w-50" style="font-family:'Orbitron'; font-weight:bold; border-radius:0; font-size:0.85rem;" onclick="clearStorefrontCart()">
                        <i class="fa-solid fa-trash me-2"></i> [ CLEAR ]
                    </button>
                    <button class="btn py-3 w-100" style="background:#00FF66; color:#000000; font-family:'Orbitron'; font-weight:900; border-radius:0; font-size:1.05rem; text-transform:uppercase; box-shadow:0 0 15px rgba(0, 255, 102, 0.5); border: 2px solid #00FF66;" id="btnProceedCheckout" onclick="proceedToCheckout()">
                        <i class="fa-solid fa-credit-card me-2"></i> [ PROCEED TO CHECKOUT ]
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Universal High-performance theme switcher with zero visual layout shifts
        function toggleStorefrontTheme() {
            const html = document.documentElement;
            const currentTheme = html.getAttribute('data-theme') || 'dark';
            const newTheme = (currentTheme === 'dark') ? 'light' : 'dark';
            html.setAttribute('data-theme', newTheme);
            if (newTheme === 'light') document.body.classList.add('light-theme');
            else document.body.classList.remove('light-theme');
            localStorage.setItem('digipose_global_theme', newTheme);
            localStorage.setItem('digipose_theme', newTheme);
            localStorage.setItem('digipose_store_theme', newTheme);
            const icon = document.getElementById('themeIcon');
            if (icon) {
                icon.className = newTheme === 'dark' ? 'fa-solid fa-sun' : 'fa-solid fa-moon';
            }
        }

        function switchLanguage(lang) {
            const el = document.getElementById('langShortCode');
            if(el) el.innerText = lang;
            if (lang === 'VI') {
                if(document.getElementById('iconVI')) document.getElementById('iconVI').className = "fa-solid fa-check text-success me-2";
                if(document.getElementById('iconEN')) document.getElementById('iconEN').className = "fa-solid fa-minus text-muted me-2";
            } else {
                if(document.getElementById('iconEN')) document.getElementById('iconEN').className = "fa-solid fa-check text-success me-2";
                if(document.getElementById('iconVI')) document.getElementById('iconVI').className = "fa-solid fa-minus text-muted me-2";
            }
            localStorage.setItem('digipose_global_lang', lang);
            localStorage.setItem('digipose_lang', lang);
            localStorage.setItem('digipose_store_lang', lang);
        }

        // ====================================================================
        // REAL DATABASE CART MANAGEMENT (0% MOCK DATA PROTOCOL)
        // ====================================================================
        function getActiveCartId() {
            return parseInt(localStorage.getItem('digipose_cart_id') || '0', 10);
        }

        async function loadStorefrontCart() {
            const isAuth = @(User.Identity?.IsAuthenticated == true ? "true" : "false");
            if (!isAuth) {
                renderEmptyCart();
                return;
            }

            let cartId = getActiveCartId();
            if (cartId === 0 && isAuth) {
                try {
                    const sessionRes = await fetch('/api/v1/Storefront/cart/active-session');
                    if (sessionRes.ok) {
                        const sData = await sessionRes.json();
                        if (sData && sData.cartId > 0) {
                            cartId = sData.cartId;
                            localStorage.setItem('digipose_cart_id', cartId.toString());
                        }
                    }
                } catch(e) { console.warn(">>> [SESSION_RECOVERY_FAULT]:", e); }
            }

            if (cartId === 0) {
                renderEmptyCart();
                return;
            }

            fetch(`/api/v1/Storefront/cart/${cartId}`)
                .then(async res => {
                    if (!res.ok) {
                        localStorage.removeItem('digipose_cart_id');
                        renderEmptyCart();
                        throw new Error('Cart session expired or invalid in database.');
                    }
                    return res.json();
                })
                .then(data => {
                    if (data.cartState === "CardEmpty" || !data.items || data.items.length === 0) {
                        renderEmptyCart();
                    } else {
                        renderCartData(data);
                    }
                })
                .catch(err => {
                    console.error(">>> [CART_SYNC_ERROR]:", err);
                    renderEmptyCart();
                });
        }

        function renderEmptyCart() {
            document.getElementById('navCartBadgeCount').innerText = '0';
            document.getElementById('cartGrossAmount').innerText = '0 VND';
            document.getElementById('cartTaxAmount').innerText = '0 VND';
            document.getElementById('cartTotalAmount').innerText = '0 VND';
            document.getElementById('cartItemsContainer').innerHTML = `
                <div class="text-center py-5 text-muted">
                    <i class="fa-solid fa-box-open mb-3" style="font-size:3rem; opacity:0.5;"></i>
                    <p style="font-family:'VT323'; font-size:1.4rem;">> YOUR CART IS EMPTY // _</p>
                </div>`;
        }

        function renderCartData(data) {
            document.getElementById('navCartBadgeCount').innerText = data.totalQuantity || (data.items ? data.items.length : 0);
            const gross = data.grossAmount ?? data.grossPrice ?? data.GrossAmount ?? 0;
            const tax = data.taxAmount ?? data.totalTaxAmount ?? data.TaxAmount ?? 0;
            const total = data.totalAmount ?? data.totalPrice ?? data.TotalAmount ?? 0;
            document.getElementById('cartGrossAmount').innerText = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(gross);
            document.getElementById('cartTaxAmount').innerText = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(tax);
            document.getElementById('cartTotalAmount').innerText = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(total);

            let html = '';
            data.items.forEach(item => {
                const img = item.imageUrl || '/demo/products/default_cyber_product.png';
                const itemTotal = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(item.lineTotal || item.subtotal || (item.unitPrice * item.quantity));
                html += `
                <div class="d-flex align-items-center mb-3 p-2" style="background: rgba(0, 229, 255, 0.03); border: 1px solid rgba(0, 229, 255, 0.2);">
                    <div style="width: 60px; height: 60px; background:#000; border:1px solid var(--cyber-border); flex-shrink:0; display:flex; align-items:center; justify-content:center; overflow:hidden;">
                        ${img.startsWith('/') || img.startsWith('http') ? `<img src="${img}" style="max-width:100%; max-height:100%; object-fit:cover;" alt="product"/>` : `<i class="fa-solid fa-box text-cyan"></i>`}
                    </div>
                    <div class="ms-3 flex-grow-1 min-w-0">
                        <div style="font-family:'Orbitron'; font-size:0.85rem; font-weight:700; color:#FFF; text-overflow:ellipsis; overflow:hidden; white-space:nowrap;">${item.productName}</div>
                        <div style="font-family:'VT323'; color:var(--cyber-cyan); font-size:1.1rem;">${itemTotal} (${item.quantity} ${item.unitName})</div>
                        <div class="d-flex align-items-center gap-2 mt-1">
                            <button class="btn btn-sm btn-outline-info px-2 py-0" style="border-radius:0; font-weight:bold;" onclick="adjustCartQty(${item.productId}, -1)">-</button>
                            <span style="font-family:'Roboto Mono'; font-size:0.85rem;" data-pid="${item.productId}">${item.quantity}</span>
                            <button class="btn btn-sm btn-outline-info px-2 py-0" style="border-radius:0; font-weight:bold;" onclick="adjustCartQty(${item.productId}, 1)">+</button>
                            <button class="btn btn-sm text-danger px-2 py-0 ms-auto" title="Remove" onclick="removeCartItem(${item.productId})"><i class="fa-solid fa-trash-can"></i></button>
                        </div>
                    </div>
                </div>`;
            });
            document.getElementById('cartItemsContainer').innerHTML = html;
        }

        function addToStorefrontCart(productId, price, unitName) {
            const isAuth = @(User.Identity?.IsAuthenticated == true ? "true" : "false");
            if (!isAuth) {
                if (typeof showCyberConfirm === 'function') {
                    showCyberConfirm("AUTHENTICATION REQUIRED", "Please log in to your account before adding items to your cart.", "warning", () => {
                        window.location.href = '/Auth/Login?returnUrl=' + encodeURIComponent(window.location.pathname);
                    }, "LOG IN NOW", "CANCEL");
                } else {
                    alert("Please log in to add items to your cart.");
                    window.location.href = '/Auth/Login';
                }
                return;
            }

            const cartId = getActiveCartId();
            const payload = {
                CartId: cartId,
                ProductId: productId,
                Quantity: 1,
                UnitPrice: Number(price) || 0,
                UnitName: unitName || 'Unit'
            };

            fetch('/api/v1/Storefront/cart/add', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
            .then(async res => {
                const data = await res.json();
                if (!res.ok) {
                    if (res.status === 401 || data.Error === 'AUTHENTICATED_REQUIRED' || data.Error === 'AUTHENTICATION_REQUIRED') {
                        if (typeof showCyberConfirm === 'function') {
                            showCyberConfirm("AUTHENTICATION REQUIRED", "Please log in to add items to cart and save to DB.", "warning", () => {
                                window.location.href = '/Auth/Login?returnUrl=' + encodeURIComponent(window.location.pathname);
                            }, "LOG IN NOW", "CANCEL");
                        } else {
                            window.location.href = '/Auth/Login';
                        }
                        throw new Error('Authentication required');
                    }
                    if (data && (data.Error || data.error)) {
                        let msg = data.Error || data.error;
                        if (data.Error === 'OUT_OF_STOCK') {
                            msg = `Item [${data.ProductName || productId}] exceeds available stock. (Available stock: ${data.AvailableStock || 0})`;
                        }
                        if (typeof showCyberNotify === 'function') {
                            showCyberNotify("INSUFFICIENT STOCK", msg, "warning");
                        } else {
                            alert("> " + msg);
                        }
                    } else {
                        if (typeof showCyberNotify === 'function') showCyberNotify("ADD TO CART ERROR", "Could not add item to cart. Please try again.", "error");
                    }
                    throw new Error(data ? (data.Error || data.error) : 'Failed to add item to cart');
                }
                return data;
            })
            .then(data => {
                if (data && data.cartId && (cartId === 0 || cartId !== data.cartId)) {
                    localStorage.setItem('digipose_cart_id', data.cartId.toString());
                }
                loadStorefrontCart();
                // Open offcanvas automatically for immediate feedback
                const cartEl = document.getElementById('cartOffcanvas');
                if (cartEl) {
                    const bsOffcanvas = new bootstrap.Offcanvas(cartEl);
                    bsOffcanvas.show();
                }
            })
            .catch(err => console.error(">>> [ADD_CART_ERR]:", err));
        }

        function adjustCartQty(productId, delta) {
            const cartId = getActiveCartId();
            if (cartId === 0) return;

            // Must read current qty from DOM to calculate new qty for PUT update-quantity
            const cartContainer = document.getElementById('cartItemsContainer');
            const qtySpans = cartContainer ? cartContainer.querySelectorAll('[data-pid="' + productId + '"]') : [];
            let currentQty = 1;
            if (qtySpans.length > 0) currentQty = parseInt(qtySpans[0].innerText || '1', 10);
            const newQty = Math.max(0, currentQty + delta);

            fetch('/api/v1/Storefront/cart/update-quantity', {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ CartId: cartId, ProductId: productId, NewQuantity: newQty })
            })
            .then(() => loadStorefrontCart())
            .catch(err => console.error('>>> [ADJUST_QTY_ERR]:', err));
        }

        function removeCartItem(productId) {
            const cartId = getActiveCartId();
            if (cartId === 0) return;

            fetch('/api/v1/Storefront/cart/remove', {
                method: 'DELETE',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ CartId: cartId, ProductId: productId })
            })
            .then(() => loadStorefrontCart())
            .catch(err => console.error('>>> [REMOVE_ITEM_ERR]:', err));
        }

        function clearStorefrontCart() {
            const cartId = getActiveCartId();
            if (cartId === 0) return;

            fetch(`/api/v1/Storefront/cart/clear/${cartId}`, { method: 'POST' })
                .then(() => {
                    localStorage.removeItem('digipose_cart_id');
                    renderEmptyCart();
                })
                .catch(err => console.error('>>> [CLEAR_CART_ERR]:', err));
        }

        function proceedToCheckout() {
            const cartId = getActiveCartId();
            if (cartId === 0 || document.getElementById('navCartBadgeCount').innerText === '0') {
                if (typeof showCyberNotify === 'function') {
                    showCyberNotify("CART IS EMPTY", "Your shopping cart is currently empty. Please add products before checking out.", "warning");
                } else {
                    alert("> YOUR CART IS EMPTY. PLEASE ADD PRODUCTS BEFORE CHECKING OUT.");
                }
                return;
            }
            window.location.href = `/Home/Storefront/Checkout?cartId=${cartId}`;
        }

        // Initialize state from local persistent memory (Unified across Admin/POS/Store)
        document.addEventListener("DOMContentLoaded", function() {
            const savedTheme = localStorage.getItem('digipose_global_theme') || localStorage.getItem('digipose_theme') || localStorage.getItem('digipose_store_theme') || 'dark';
            document.documentElement.setAttribute('data-theme', savedTheme);
            if (savedTheme === 'light') {
                document.body.classList.add('light-theme');
                const icon = document.getElementById('themeIcon');
                if (icon) icon.className = 'fa-solid fa-moon';
            }
            const savedLang = localStorage.getItem('digipose_global_lang') || localStorage.getItem('digipose_lang') || localStorage.getItem('digipose_store_lang') || 'VI';
            switchLanguage(savedLang);
            loadStorefrontCart();

            const profileDropdownEl = document.getElementById("profileDropdown");
            const profileCaret = document.getElementById("hudProfileCaret");
            if (profileDropdownEl && profileCaret) {
                const parentDropdown = profileDropdownEl.closest('.dropdown');
                if (parentDropdown) {
                    parentDropdown.addEventListener('show.bs.dropdown', function () {
                        profileCaret.style.transform = "rotate(180deg)";
                        profileCaret.style.color = "#00FF66";
                    });
                    parentDropdown.addEventListener('hide.bs.dropdown', function () {
                        profileCaret.style.transform = "rotate(0deg)";
                        profileCaret.style.color = "#00E5FF";
                    });
                }
            }
        });
    </script>
    @await Html.PartialAsync("_CyberNotificationModal")
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
