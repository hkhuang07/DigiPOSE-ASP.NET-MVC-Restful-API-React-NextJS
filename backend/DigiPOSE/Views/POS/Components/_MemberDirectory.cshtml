<!-- ==================== VIEW 4: VIP CUSTOMERS & B2B CORPORATE DIRECTORY ==================== -->
<section id="viewCustomers" class="fullscreen-view">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; border-bottom:1px solid var(--pos-border); padding-bottom:10px;">
        <div>
            <h3 style="font-family:var(--font-hdr); color:var(--pos-cyan); font-size:1.3rem; font-weight:700; margin:0;"><i class="fa-solid fa-user-shield me-2"></i>VIP & CORPORATE DIRECTORY</h3>
            <div style="font-size:0.75rem; color:var(--pos-text-secondary); margin-top:2px;">LOYALTY REWARDS & B2B CREDIT GUARDRAIL AUDIT</div>
        </div>
        <div style="display:flex; gap:8px;">
            <input type="text" id="txtVipSearch" class="cyber-search-input" placeholder="SEARCH BY NAME OR PHONE..." style="width:260px;" oninput="renderVipTable()" />
            <button onclick="openVipModal(null)" class="btn-checkout-execute" style="height:40px; font-size:0.8rem; padding:0 16px;"><i class="fa-solid fa-user-plus"></i> NEW ACCOUNT</button>
            <button onclick="loadCatalogMetadata()" class="deck-btn"><i class="fa-solid fa-rotate"></i> REFRESH</button>
        </div>
    </div>
    <div class="table-responsive">
        <table class="cart-table w-100" style="background:#080C10; border:1px solid var(--pos-border);">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>CLIENT / CORPORATION</th>
                    <th>CONTACT PHONE</th>
                    <th>ACCOUNT TIER</th>
                    <th style="text-align:center;">REWARDS / CREDIT DEBT</th>
                    <th style="text-align:center;">ACTIONS</th>
                </tr>
            </thead>
            <tbody id="vipDirectoryTableBody">
                <tr><td colspan="6" style="text-align:center; padding:30px; color:var(--pos-text-muted);">INITIALIZING CLIENT DIRECTORY...</td></tr>
            </tbody>
        </table>
    </div>
</section>
