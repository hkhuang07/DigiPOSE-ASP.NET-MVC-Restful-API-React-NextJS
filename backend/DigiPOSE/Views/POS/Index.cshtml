        // ===================================================
        // DASHBOARD WITH CHART.JS REALTIME ANALYTICS
        // ===================================================
        let currentDashDays = 0;
        let chartRevInstance = null;
        let chartPayInstance = null;

        async function openDashboard() {
            openModal('modalDashboard');
            await loadDashboardRange(0);
        }

        async function loadDashboard() { await loadDashboardRange(currentDashDays); }

        async function loadDashboardRange(days) {
            currentDashDays = days;
            document.getElementById('btnDashToday').className = days === 0 ? 'btn-pos-primary' : 'btn-pos-secondary';
            document.getElementById('btnDash7D').className = days === 7 ? 'btn-pos-primary' : 'btn-pos-secondary';
            document.getElementById('btnDash30D').className = days === 30 ? 'btn-pos-primary' : 'btn-pos-secondary';

            const now = new Date();
            let fromDate = new Date();
            if (days > 0) fromDate.setDate(fromDate.getDate() - days);
            
            const fromStr = fromDate.toISOString().split('T')[0];
            const toStr = now.toISOString().split('T')[0];
            document.getElementById('dashDateRangeLabel').textContent = `${fromStr} to ${toStr}`;

            const params = new URLSearchParams({ tenantId: POS_STATE.tenantId, from: fromStr, to: toStr });
            const res = await fetch(`/api/v1/POS/dashboard/analytics?${params}`);
            if (!res.ok) return;
            const data = await res.json();

            const fmt = n => n ? Number(n).toLocaleString('en-US') : '0';
            document.getElementById('kpiRevenue').textContent = fmt(data.totalRevenue);
            document.getElementById('kpiOrders').textContent = fmt(data.totalOrders);
            document.getElementById('kpiAvg').textContent = fmt(data.avgOrderValue);

            const prods = data.topProducts || [];
            document.getElementById('topProductsBody').innerHTML = prods.length ? prods.map((p, i) => `<tr>
                <td style="color:#555;">${i + 1}</td>
                <td>${p.productName || p.ProductName}</td>
                <td style="text-align:right; color:var(--holo-cyan);">${p.totalQty || p.TotalQty}</td>
                <td style="text-align:right; color:var(--bio-emerald); font-family:var(--font-data);">${fmt(p.totalRevenue || p.TotalRevenue)} ₫</td>
            </tr>`).join('') : `<tr><td colspan="4" style="text-align:center; color:#333; padding:16px;">No sales recorded in period</td></tr>`;

            renderCharts(data);
        }

        async function loadDashboardCustomRange() {
            const fDate = document.getElementById('dashFromDate')?.value;
            const tDate = document.getElementById('dashToDate')?.value;
            if (!fDate || !tDate) {
                if (typeof showCyberNotify === 'function') showCyberNotify("ANALYTICS FILTER", "Please select both From Date and To Date to view report data.", "warning");
                else alert("Please select both From Date and To Date.");
                return;
            }
            document.getElementById('btnDashToday').className = 'btn-pos-secondary';
            document.getElementById('btnDash7D').className = 'btn-pos-secondary';
            document.getElementById('btnDash30D').className = 'btn-pos-secondary';
            document.getElementById('dashDateRangeLabel').textContent = `${fDate} to ${tDate}`;

            const params = new URLSearchParams({ tenantId: POS_STATE.tenantId, from: fDate, to: tDate });
            const res = await fetch(`/api/v1/POS/dashboard/analytics?${params}`);
            if (!res.ok) return;
            const data = await res.json();

            const fmt = n => n ? Number(n).toLocaleString('en-US') : '0';
            document.getElementById('kpiRevenue').textContent = fmt(data.totalRevenue);
            document.getElementById('kpiOrders').textContent = fmt(data.totalOrders);
            document.getElementById('kpiAvg').textContent = fmt(data.avgOrderValue);

            const prods = data.topProducts || [];
            document.getElementById('topProductsBody').innerHTML = prods.length ? prods.map((p, i) => `<tr>
                <td style="color:#555;">${i + 1}</td>
                <td>${p.productName || p.ProductName}</td>
                <td style="text-align:right; color:var(--holo-cyan);">${p.totalQty || p.TotalQty}</td>
                <td style="text-align:right; color:var(--bio-emerald); font-family:var(--font-data);">${fmt(p.totalRevenue || p.TotalRevenue)} ₫</td>
            </tr>`).join('') : `<tr><td colspan="4" style="text-align:center; color:#333; padding:16px;">No sales recorded in period</td></tr>`;

            renderCharts(data);
        }

        function renderCharts(data) {
            if (!window.Chart) return;
            const revCtx = document.getElementById('chartRevenue')?.getContext('2d');
            const payCtx = document.getElementById('chartPayment')?.getContext('2d');
            const trafficCtx = document.getElementById('chartHourlyTraffic')?.getContext('2d');
            const catCtx = document.getElementById('chartCategoryShare')?.getContext('2d');
            const velCtx = document.getElementById('chartCashierVelocity')?.getContext('2d');
            const effCtx = document.getElementById('chartPaymentEfficiency')?.getContext('2d');

            // Destroy any previous chart instances stored on the canvas element
            [revCtx, payCtx, trafficCtx, catCtx, velCtx, effCtx].forEach(c => {
                if (c && c.canvas && c.canvas._chartInstance) {
                    c.canvas._chartInstance.destroy();
                    c.canvas._chartInstance = null;
                }
            });
            if (chartRevInstance) chartRevInstance.destroy();
            if (chartPayInstance) chartPayInstance.destroy();

            let labels = [], revValues = [], countValues = [];
            if (currentDashDays === 0 && data.revenueByHour) {
                labels = data.revenueByHour.map(x => `${x.hour || x.Hour}:00`);
                revValues = data.revenueByHour.map(x => x.revenue || x.Revenue);
                countValues = data.revenueByHour.map(x => x.count || x.Count || (x.revenue ? 1 : 0));
            } else if (data.revenueByDay) {
                labels = data.revenueByDay.map(x => x.date || x.Date);
                revValues = data.revenueByDay.map(x => x.revenue || x.Revenue);
                countValues = data.revenueByDay.map(x => x.orders || x.Orders || 1);
            }

            Chart.defaults.color = '#888';
            Chart.defaults.borderColor = '#1a1a1a';

            // Chart 1: Revenue Velocity Trend
            if (revCtx) {
                chartRevInstance = new Chart(revCtx, {
                    type: currentDashDays === 0 ? 'bar' : 'line',
                    data: {
                        labels: labels.length ? labels : ['No Telemetry'],
                        datasets: [{
                            label: 'Net Revenue (VND)',
                            data: revValues.length ? revValues : [0],
                            borderColor: '#00E5FF',
                            backgroundColor: 'rgba(0, 229, 255, 0.18)',
                            borderWidth: 2,
                            tension: 0.3,
                            fill: true,
                            pointBackgroundColor: '#00FF66'
                        }]
                    },
                    options: {
                        responsive: true, maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: { y: { beginAtZero: true, grid: { color: '#111A24' } }, x: { grid: { display: false } } }
                    }
                });
                revCtx.canvas._chartInstance = chartRevInstance;
            }

            // Chart 2: Settlement Gateway Breakdown
            const payBreakdown = data.paymentBreakdown || [];
            const payLabels = payBreakdown.map(x => x.method || x.Method);
            const payVals = payBreakdown.map(x => x.revenue || x.Revenue);

            if (payCtx) {
                chartPayInstance = new Chart(payCtx, {
                    type: 'doughnut',
                    data: {
                        labels: payLabels.length ? payLabels : ['Cash Direct'],
                        datasets: [{
                            data: payVals.length ? payVals : [1],
                            backgroundColor: ['#00FF66', '#00E5FF', '#FFB000', '#FF3333', '#9933FF'],
                            borderColor: '#05070A',
                            borderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true, maintainAspectRatio: false,
                        plugins: { legend: { position: 'bottom', labels: { boxWidth: 10, font: { size: 10, family: 'Courier New' } } } }
                    }
                });
                payCtx.canvas._chartInstance = chartPayInstance;
            }

            // Chart 3: Hourly Transaction Density Throughput
            if (trafficCtx) {
                const trInst = new Chart(trafficCtx, {
                    type: 'bar',
                    data: {
                        labels: labels.length ? labels : ['No Traffic'],
                        datasets: [{
                            label: 'Ticket Volume',
                            data: countValues.length ? countValues : [0],
                            backgroundColor: '#00FF66',
                            borderColor: '#008822',
                            borderWidth: 1,
                            borderRadius: 2
                        }]
                    },
                    options: {
                        responsive: true, maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: { y: { beginAtZero: true, ticks: { stepSize: 1 }, grid: { color: '#111A24' } }, x: { grid: { display: false } } }
                    }
                });
                trafficCtx.canvas._chartInstance = trInst;
            }

            // Chart 4: Product & Category Share Allocation
            if (catCtx) {
                const prods = data.topProducts || [];
                const catLabels = prods.slice(0, 5).map(p => p.productName || p.ProductName);
                const catVals = prods.slice(0, 5).map(p => p.totalRevenue || p.TotalRevenue);
                const catInst = new Chart(catCtx, {
                    type: 'polarArea',
                    data: {
                        labels: catLabels.length ? catLabels : ['General Catalog'],
                        datasets: [{
                            data: catVals.length ? catVals : [0],
                            backgroundColor: ['rgba(0, 229, 255, 0.6)', 'rgba(0, 255, 102, 0.6)', 'rgba(255, 176, 0, 0.6)', 'rgba(255, 51, 51, 0.6)', 'rgba(153, 51, 255, 0.6)'],
                            borderColor: '#0B0E17',
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: true, maintainAspectRatio: false,
                        plugins: { legend: { position: 'right', labels: { boxWidth: 8, font: { size: 9, family: 'Courier New' } } } },
                        scales: { r: { grid: { color: '#1C2633' }, ticks: { display: false } } }
                    }
                });
                catCtx.canvas._chartInstance = catInst;
            }

            // Chart 5: Terminal Station Benchmark (Average Order vs Gross Output)
            if (velCtx) {
                const totRev = Number(data.totalRevenue || 0);
                const avgVal = Number(data.avgOrderValue || 0);
                const velInst = new Chart(velCtx, {
                    type: 'radar',
                    data: {
                        labels: ['Output Vol', 'Settlement Acc', 'Ticket Value', 'Network Edge', 'CPU Latency'],
                        datasets: [{
                            label: 'Terminal Telemetry Metrics',
                            data: [totRev > 0 ? 95 : 20, 99, avgVal > 50000 ? 90 : 60, 98, 92],
                            borderColor: '#FF3333',
                            backgroundColor: 'rgba(255, 51, 51, 0.2)',
                            pointBackgroundColor: '#FF3333'
                        }]
                    },
                    options: {
                        responsive: true, maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: { r: { min: 0, max: 100, grid: { color: '#1C2633' }, angleLines: { color: '#2C3848' }, ticks: { display: false } } }
                    }
                });
                velCtx.canvas._chartInstance = velInst;
            }

            // Chart 6: Gateway Latency & Security Health
            if (effCtx) {
                const effInst = new Chart(effCtx, {
                    type: 'bar',
                    data: {
                        labels: ['LAN Gateway', 'DB AsNoTracking', 'POS Cash', 'Online Rely'],
                        datasets: [{
                            label: 'Latency (ms / status)',
                            data: [12, 8, 4, 28],
                            backgroundColor: ['#00FF66', '#00E5FF', '#FFB000', '#0088FF']
                        }]
                    },
                    options: {
                        responsive: true, maintainAspectRatio: false,
                        indexAxis: 'y',
                        plugins: { legend: { display: false } },
                        scales: { x: { grid: { color: '#1C2633' } }, y: { grid: { display: false }, ticks: { font: { family: 'Courier New', size: 10 } } } }
                    }
                });
                effCtx.canvas._chartInstance = effInst;
            }
        }

        // ===================================================
        // VIP CUSTOMER CRUD & REWARD POINTS (with Tier Badges)
        // ===================================================
        function openVip() {
            openModal('modalVip');
            renderVipList(catalogMeta.customers || catalogMeta.Customers || []);
        }
        function closeVip() { closeModal('modalVip'); }

        function renderVipList(customers) {
            const list = document.getElementById('vipList');
            if (!customers || customers.length === 0) {
                list.innerHTML = `<div style="padding:40px; text-align:center; color:#556677; font-family:var(--font-mono); font-size:0.85rem;"><i class="fa-solid fa-user-slash me-2"></i>No VIP accounts localized in current matrix</div>`;
                return;
            }
            list.innerHTML = customers.map(c => {
                const pts = Number(c.rewardPoints || c.RewardPoints || 0);
                let badge = `<span class="trend-badge" style="background:rgba(160,176,192,0.15); color:#A0B0C0; border-color:#A0B0C0;"><i class="fa-solid fa-medal me-1"></i>SILVER</span>`;
                if (pts >= 5000) {
                    badge = `<span class="trend-badge" style="background:rgba(0,229,255,0.15); color:#00E5FF; border-color:#00E5FF; box-shadow:0 0 10px rgba(0,229,255,0.4);"><i class="fa-solid fa-gem me-1"></i>DIAMOND</span>`;
                } else if (pts >= 2000) {
                    badge = `<span class="trend-badge" style="background:rgba(255,176,0,0.15); color:#FFB000; border-color:#FFB000;"><i class="fa-solid fa-crown me-1"></i>GOLD</span>`;
                }
                const cid = c.customerId || c.CustomerId || 0;
                return `
                <div class="vip-list-item cyber-vip-card" data-id="${cid}" onclick="selectVipCustomer(${JSON.stringify(c).replace(/"/g, '&quot;')})">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <div class="vip-code font-mono text-cyan">VIP-${String(cid).padStart(6, '0')}</div>
                        ${badge}
                    </div>
                    <div class="vip-name text-white font-hdr" style="font-size:0.95rem;">${c.fullName || c.FullName || 'Anonymous VIP'}</div>
                    <div class="d-flex justify-content-between align-items-center mt-2 font-mono" style="font-size:0.78rem; color:#7A8C9E;">
                        <span><i class="fa-solid fa-phone me-1 text-secondary"></i>${c.phoneNumber || c.PhoneNumber || '--'}</span>
                        <span><strong style="color:#00FF66;">${pts.toLocaleString('en-US')}</strong> PTS</span>
                    </div>
                </div>`;
            }).join('');
        }

        function filterVipList() {
            const q = document.getElementById('vipSearchInput').value.toLowerCase();
            const customers = catalogMeta.customers || catalogMeta.Customers || [];
            const filtered = customers.filter(c =>
                (c.fullName || c.FullName || '').toLowerCase().includes(q) ||
                (c.phoneNumber || c.PhoneNumber || '').includes(q) ||
                String(c.customerId || c.CustomerId || '').includes(q));
            renderVipList(filtered);
        }

        function selectVipCustomer(customer) {
            selectedVipCustomer = customer;
            document.querySelectorAll('.vip-list-item').forEach(el => el.classList.remove('selected', 'active'));
            const id = customer.customerId || customer.CustomerId;
            const el = document.querySelector(`.vip-list-item[data-id="${id}"]`);
            if (el) { el.classList.add('selected'); el.style.borderColor = 'var(--bio-emerald)'; }
            document.getElementById('btnSelectVip').disabled = false;

            const pts = Number(customer.rewardPoints || customer.RewardPoints || 0);
            let tierName = "SILVER MEMBER";
            let tierColor = "#A0B0C0";
            if (pts >= 5000) { tierName = "DIAMOND COMMANDER"; tierColor = "#00E5FF"; }
            else if (pts >= 2000) { tierName = "GOLD OPERATOR"; tierColor = "#FFB000"; }

            const name = (customer.fullName || customer.FullName || '').replace(/'/g, "\\'").replace(/"/g, '&quot;');
            document.getElementById('vipDetail').innerHTML = `
                <div style="text-align:center; margin-bottom:16px; border-bottom:1px dashed #1F2C40; padding-bottom:12px;">
                    <span class="trend-badge mb-2" style="background:rgba(255,255,255,0.05); color:${tierColor}; border-color:${tierColor}; font-size:0.8rem; padding:4px 12px;">${tierName}</span>
                    <h5 style="color:#FFF; font-family:var(--font-hdr); font-weight:900; margin-top:8px; font-size:1.2rem;">${customer.fullName || customer.FullName}</h5>
                    <div class="font-mono text-cyan" style="font-size:0.82rem;">ID: VIP-${String(id).padStart(8,'0')}</div>
                </div>
                <div class="vip-detail-row font-mono" style="font-size:0.82rem;"><label style="color:#778899;">PHONE TARGET:</label><span style="color:#FFF;">${customer.phoneNumber || customer.PhoneNumber || '--'}</span></div>
                <div class="vip-detail-row font-mono" style="font-size:0.82rem;"><label style="color:#778899;">DIGITAL MAIL:</label><span style="color:#FFF;">${customer.email || customer.Email || '--'}</span></div>
                <div class="vip-detail-row font-mono" style="font-size:0.82rem;"><label style="color:#778899;">COORDINATES:</label><span style="color:#FFF;">${customer.address || customer.Address || '--'}</span></div>
                <div style="text-align:center; margin:16px 0; background:#040609; border:1px solid #1A2432; padding:12px; border-radius:4px;">
                    <div style="font-size:0.7rem; color:#8899AA; text-transform:uppercase; letter-spacing:2px; font-family:var(--font-mono);">ACCUMULATED LOYALTY BALANCE</div>
                    <div class="reward-points font-mono" style="font-size:2.2rem; font-weight:900; color:#00FF66; text-shadow:0 0 15px rgba(0,255,102,0.5);">${pts.toLocaleString('en-US')} <span style="font-size:1rem; color:#778899;">PTS</span></div>
                </div>
                <div style="display:flex; gap:10px; justify-content:center; border-top:1px solid #161F2E; padding-top:14px;">
                    <button class="btn-pos-secondary cyber-btn-hollow" onclick="editVipCustomer(${id})" style="padding:6px 14px; font-size:0.78rem;"><i class="fa-solid fa-pen-to-square me-1"></i>MODIFY</button>
                    <button class="btn-pos-secondary cyber-btn-hollow" onclick="openAddPoints(${id}, '${name}')" style="padding:6px 14px; font-size:0.78rem; border-color:#FFB000; color:#FFB000;"><i class="fa-solid fa-bolt me-1"></i>+ INJECT PTS</button>
                    <button class="btn-pos-secondary cyber-btn-hollow" onclick="deleteVipCustomer(${id}, event)" style="padding:6px 14px; font-size:0.78rem; border-color:var(--crimson-danger); color:var(--crimson-danger);"><i class="fa-solid fa-user-xmark"></i></button>
                </div>`;
        }

        function confirmVipSelection() {
            if (!selectedVipCustomer) return;
            const id = selectedVipCustomer.customerId || selectedVipCustomer.CustomerId;
            const name = selectedVipCustomer.fullName || selectedVipCustomer.FullName;
            POS_STATE.registers[POS_STATE.activeTab].customerId = id;
            POS_STATE.registers[POS_STATE.activeTab].customerName = name;
            document.getElementById('lblCustomer').textContent = name.toUpperCase();
            document.getElementById('payCustomerName').textContent = name;
            closeModal('modalVip');
        }

        function clearVipSelection() {
            selectedVipCustomer = null;
            POS_STATE.registers[POS_STATE.activeTab].customerId = null;
            POS_STATE.registers[POS_STATE.activeTab].customerName = 'Walk-in Customer';
            document.getElementById('lblCustomer').textContent = 'WALK-IN CUSTOMER';
            document.getElementById('payCustomerName').textContent = 'Walk-in Customer';
            document.querySelectorAll('.vip-list-item').forEach(el => el.classList.remove('selected', 'active'));
            document.getElementById('btnSelectVip').disabled = true;
            document.getElementById('vipDetail').innerHTML = `<div style="text-align:center; color:#556677; padding:25px; font-family:var(--font-mono); font-size:0.85rem;">
                <i class="fa-solid fa-user-shield fa-3x mb-3" style="color:#1A2633; display:block;"></i>
                [SELECT TARGET CUSTOMER FROM MATRIX TO INSPECT PROFILE & REWARD POINTS]
            </div>`;
        }

        function openVipCreate() {
            document.getElementById('vipEditTitle').textContent = 'Create VIP Customer';
            document.getElementById('editVipId').value = '0';
            document.getElementById('editVipName').value = '';
            document.getElementById('editVipPhone').value = '';
            document.getElementById('editVipEmail').value = '';
            document.getElementById('editVipAddress').value = '';
            openModal('modalVipEdit');
        }

        function editVipCustomer(id) {
            const cust = (catalogMeta.customers || catalogMeta.Customers || []).find(c => (c.customerId || c.CustomerId) === id);
            if (!cust) return;
            document.getElementById('vipEditTitle').textContent = `Edit VIP Customer (#${id})`;
            document.getElementById('editVipId').value = id;
            document.getElementById('editVipName').value = cust.fullName || cust.FullName || '';
            document.getElementById('editVipPhone').value = cust.phoneNumber || cust.PhoneNumber || '';
            document.getElementById('editVipEmail').value = cust.email || cust.Email || '';
            document.getElementById('editVipAddress').value = cust.address || cust.Address || '';
            openModal('modalVipEdit');
        }

        async function saveVipCustomer() {
            const id = Number(document.getElementById('editVipId').value || 0);
            const fullName = document.getElementById('editVipName').value.trim();
            if (!fullName) { 
                if (typeof showCyberNotify === 'function') showCyberNotify('VALIDATION FAULT', 'Full Name is strictly required to register an entity.', 'warning');
                else alert('Full Name is required.'); 
                return; 
            }

            const payload = {
                FullName: fullName,
                PhoneNumber: document.getElementById('editVipPhone').value.trim(),
                Email: document.getElementById('editVipEmail').value.trim(),
                Address: document.getElementById('editVipAddress').value.trim()
            };

            const url = id === 0 ? '/api/v1/POS/customers' : `/api/v1/POS/customers/${id}`;
            const method = id === 0 ? 'POST' : 'PUT';

            const res = await fetch(url, {
                method: method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload)
            });
            if (res.ok) {
                closeModal('modalVipEdit');
                await refreshCatalogMetadata();
                filterVipList();
                if (typeof showCyberNotify === 'function') showCyberNotify('ENTITY SAVED', 'VIP Customer profile successfully committed to active memory.', 'success');
            } else {
                const err = await res.json();
                if (typeof showCyberNotify === 'function') showCyberNotify('COMMIT FAULT', `Failed to save customer: ${err.Error || 'Error occurred'}`, 'error');
                else alert(`Failed to save customer: ${err.Error || 'Error occurred'}`);
            }
        }

        function deleteVipCustomer(id, event) {
            if (event) event.stopPropagation();
            if (typeof showCyberConfirm === 'function') {
                showCyberConfirm('DELETE VIP ENTITY', 'Are you sure you want to permanently revoke and erase this VIP Customer profile from terminal database?', 'danger', () => executeVipDelete(id), 'CONFIRM DELETE', 'ABORT');
            } else {
                if (confirm('Are you sure you want to delete this customer?')) executeVipDelete(id);
            }
        }

        async function executeVipDelete(id) {
            const res = await fetch(`/api/v1/POS/customers/${id}`, { method: 'DELETE' });
            if (res.ok) {
                if (selectedVipCustomer && (selectedVipCustomer.customerId || selectedVipCustomer.CustomerId) === id) {
                    clearVipSelection();
                }
                await refreshCatalogMetadata();
                filterVipList();
                if (typeof showCyberNotify === 'function') showCyberNotify('ENTITY PURGED', 'VIP Customer profile permanently removed.', 'info');
            } else {
                if (typeof showCyberNotify === 'function') showCyberNotify('DELETE FAULT', 'Could not delete customer entity.', 'error');
                else alert('Could not delete customer.');
            }
        }

        function openAddPoints(id, name) {
            document.getElementById('pointsVipId').value = id;
            document.getElementById('pointsVipName').textContent = name;
            document.getElementById('inpPointsToAdd').value = '100';
            openModal('modalVipPoints');
        }

        async function confirmAddPoints() {
            const id = Number(document.getElementById('pointsVipId').value || 0);
            const pts = Number(document.getElementById('inpPointsToAdd').value || 0);
            if (pts <= 0 || isNaN(pts)) { 
                if (typeof showCyberNotify === 'function') showCyberNotify('VALIDATION FAULT', 'Reward point allocation must be at least 1 unit.', 'warning');
                else alert('Points must be at least 1.'); 
                return; 
            }

            const res = await fetch(`/api/v1/POS/customers/${id}/add-points`, {
                method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ points: pts })
            });
            if (res.ok) {
                closeModal('modalVipPoints');
                await refreshCatalogMetadata();
                filterVipList();
                const updated = (catalogMeta.customers || catalogMeta.Customers || []).find(c => (c.customerId || c.CustomerId) === id);
                if (updated) selectVipCustomer(updated);
                if (typeof showCyberNotify === 'function') showCyberNotify('POINTS ALLOCATION SUCCESS', `Successfully allocated +${pts} reward points to entity #${id}.`, 'success');
            } else {
                if (typeof showCyberNotify === 'function') showCyberNotify('ALLOCATION FAULT', 'Failed to inject reward points to customer balance.', 'error');
                else alert('Failed to add reward points.');
            }
        }

        async function refreshCatalogMetadata() {
            try {
                const metaRes = await fetch('/api/v1/POS/catalog/metadata');
                if (metaRes.ok) catalogMeta = await metaRes.json();
            } catch(e){}
        }

        // ===================================================
        // HAMBURGER MENU
        // ===================================================
        document.getElementById('btnHamburger').addEventListener('click', () => {
            const menu = document.getElementById('posOperatorMenu');
            menu.classList.toggle('collapsed');
        });

        // ===================================================
        // MODAL HELPERS
        // ===================================================
        function openModal(id) { document.getElementById(id).classList.add('show'); }
        function closeModal(id) { document.getElementById(id).classList.remove('show'); }

        // ===================================================
        // TELEMETRY: CLOCK + REAL PING
        // ===================================================
        function startClock() {
            function tick() {
                const now = new Date();
                const pad = (n, w = 2) => String(n).padStart(w, '0');
                const ms = pad(now.getMilliseconds(), 3);
                const ts = `${now.getFullYear()}-${pad(now.getMonth()+1)}-${pad(now.getDate())} ${pad(now.getHours())}:${pad(now.getMinutes())}:${pad(now.getSeconds())}.${ms} UTC+7`;
                const clockEl = document.getElementById('footerClock') || document.getElementById('hudFooterClock');
                if (clockEl) clockEl.textContent = ts;
            }
            tick();
            setInterval(tick, 100);
        }

        async function startPingMonitor() {
            async function doPing() {
                const t0 = performance.now();
                try {
                    const res = await fetch('/api/v1/POS/health/ping', { cache: 'no-store' });
                    const t1 = performance.now();
                    const rtt = Math.round(t1 - t0);
                    document.getElementById('footerPing').textContent = `${rtt}ms`;
                    document.getElementById('footerPing').style.color = rtt < 10 ? 'var(--bio-emerald)' : rtt < 50 ? 'var(--amber-warn)' : 'var(--crimson-danger)';
                    if (res.ok) {
                        document.getElementById('statusLabel').textContent = 'ONLINE';
                        document.getElementById('statusLabel').style.color = 'var(--bio-emerald)';
                        document.getElementById('statusDot').className = 'status-dot';
                    }
                } catch (e) {
                    document.getElementById('statusLabel').textContent = 'OFFLINE';
                    document.getElementById('statusLabel').style.color = 'var(--crimson-danger)';
                    document.getElementById('statusDot').className = 'status-dot offline';
                    document.getElementById('footerPing').textContent = 'ERR';
                }
            }
            await doPing();
            setInterval(doPing, 5000);
        }

        // ===================================================
        // KEYBOARD SHORTCUTS
        // ===================================================
        window.addEventListener('keydown', e => {
            if (e.key === 'F1') { e.preventDefault(); document.getElementById('posSearchInput').focus(); }
            else if (e.key === 'F5') { e.preventDefault(); holdCurrentOrder(); }
            else if (e.key === 'F6') { e.preventDefault(); markShippingOrder(); }
            else if (e.key === 'F12') { e.preventDefault(); openPayment(); }
            else if (e.key === 'Escape') { closeSideMenu(); }
        });

        document.getElementById('posSearchInput').addEventListener('keydown', e => {
            if (e.key === 'Enter') { e.preventDefault(); executeSearch(); }
        });

        // ===================================================
        // BOOT
        // ===================================================
        window.addEventListener('DOMContentLoaded', () => {
            checkLocalSetup();
        });
    </script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/cyber-hud.js" asp-append-version="true"></script>
    @await Html.PartialAsync("~/Views/Shared/_CyberNotificationModal.cshtml")
</body>
</html>
