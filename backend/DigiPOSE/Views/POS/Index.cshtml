                    <p style="color:#8A9CAE; font-size:0.82rem; line-height:1.5; margin-top:8px;">
                        Switching your Counter station will disengage your current register lock and return you to the Terminal Cascading Setup Matrix. Any active uncommitted transaction items will be retained in background draft memory.
                    </p>
                </div>
                <div style="background:#070A0E; border:1px dashed #2A384A; padding:12px; font-size:0.78rem; color:#A0B0C0;">
                    <div class="d-flex justify-content-between mb-1"><span>CURRENT STATION:</span><strong id="switchCurrentCounter" style="color:#00FF66;">STATION-01</strong></div>
                    <div class="d-flex justify-content-between"><span>SHIFT STATUS:</span><strong id="switchCurrentShift" style="color:#FFB000;">ACTIVE</strong></div>
                </div>
            </div>
            <div class="modal-footer" style="background:#070A0E; border-top:1px solid #1A222D;">
                <button class="btn-pos-secondary cyber-btn-hollow" onclick="closeModal('modalSwitchCounter')"><i class="fa-solid fa-ban me-1"></i>RETAIN CURRENT STATION</button>
                <button class="btn-pos-primary cyber-btn-execute" style="background:linear-gradient(90deg, #00E5FF 0%, #0088FF 100%); color:#000; box-shadow:0 0 20px rgba(0,229,255,0.4); padding:10px 22px; font-size:0.95rem;" onclick="confirmSwitchCounter()">
                    <i class="fa-solid fa-power-off me-2"></i>PROCEED TO SWITCH COUNTER
                </button>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // ===================================================
        // POS STATE — Tenant scoped from auth claim (server-rendered)
        // ===================================================
        const POS_STATE = {
            tenantId: @(ViewBag.AuthorizedTenantId ?? 0),
            tenantName: '@(ViewBag.AuthorizedTenantName?.ToString()?.Replace("'", "\\'") ?? "N/A")',
            counterId: null, counterName: '',
            shiftId: null, shiftStartTime: null,
            userId: @(User.FindFirst("UserId")?.Value ?? User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "1"),
            activeTab: 0,
            registers: [
                { orderId: null, items: [], customerId: null, customerName: 'Walk-in Customer', orderType: 'retail' },
                { orderId: null, items: [], customerId: null, customerName: 'Shipping Order', orderType: 'retail' },
                { orderId: null, items: [], customerId: null, customerName: 'Held Draft', orderType: 'retail' }
            ]
};

        let catalogMeta = { categories: [], manufacturers: [], productTypes: [], units: [], customers: [] };
        let selectedPaymentMethodId = null;
        let selectedVipCustomer = null;
        let lastCheckoutData = null;

        // ===================================================
        // SETUP GATE — Cascading Architecture: Super Admin 3-Select / Operator 2-Select
        // ===================================================
        async function initSetupGate() {
            const adminSel = document.getElementById('adminTenantSelect');
            if (adminSel) {
                const bId = parseInt(adminSel.value) || 0;
                if (bId <= 0) {
                    const cSel = document.getElementById('setupCounterSel');
                    const wSel = document.getElementById('setupWarehouseSel');
                    if (cSel) { cSel.innerHTML = '<option value="">-- Select Target Tenant First --</option>'; cSel.disabled = true; }
                    if (wSel) { wSel.innerHTML = '<option value="">-- Select Target Tenant First --</option>'; wSel.disabled = true; }
                    return;
                }
                POS_STATE.tenantId = bId;
            }
            const bId = POS_STATE.tenantId;
            if (!bId || bId <= 0) {
                console.warn(">>> [QUARANTINE_ACTIVE]: Tenant ID evaluates to zero or null. Telemetry fetching blocked under Zero-Trust protocol.");
                return;
            }
            await loadCountersAndWarehousesForTenant();
        }

        async function loadCountersAndWarehousesForTenant() {
            const bId = POS_STATE.tenantId;
            const cSel = document.getElementById('setupCounterSel');
            const wSel = document.getElementById('setupWarehouseSel');
            const btnNext = document.getElementById('btnStep1Next');
            if (btnNext) btnNext.disabled = true;

            if (!bId || bId <= 0 || isNaN(bId)) {
                if (cSel) { cSel.innerHTML = '<option value="">-- Select Target Tenant First --</option>'; cSel.disabled = true; }
                if (wSel) { wSel.innerHTML = '<option value="">-- Select Target Tenant First --</option>'; wSel.disabled = true; }
                return;
            }

            if (cSel) { cSel.innerHTML = '<option value="">-- Loading active terminals... --</option>'; cSel.disabled = true; }
            if (wSel) { wSel.innerHTML = '<option value="">-- Loading warehouse matrix... --</option>'; wSel.disabled = true; }

            const validateSelections = () => {
                const isValid = cSel && cSel.value && wSel && wSel.value;
                if (btnNext) btnNext.disabled = !isValid;
            };

            if (cSel) cSel.onchange = validateSelections;
            if (wSel) wSel.onchange = validateSelections;

            // 1. Synchronize Counter Terminals independently
            try {
                const cRes = await fetch(`/api/v1/POS/setup/tenants/${bId}/counters`);
                if (cSel) {
                    if (cRes.ok) {
                        const counters = await cRes.json();
                        cSel.innerHTML = counters.length ? '<option value="">-- Select Operating Counter --</option>' : '<option value="">No active terminals found</option>';
                        counters.forEach(c => {
                            const cid = c.counterId || c.CounterId;
                            const cname = c.counterName || c.CounterName || `Counter #${cid}`;
                            const opt = document.createElement('option');
                            opt.value = cid;
                            opt.setAttribute('data-name', cname);
                            opt.textContent = `${cname} [Terminal #${cid}]`;
                            cSel.appendChild(opt);
                        });
                        cSel.disabled = counters.length === 0;
                    } else {
                        cSel.innerHTML = '<option value="">-- Terminal synchronization failure --</option>';
                        cSel.disabled = true;
                    }
                }
            } catch (err) {
                console.error(">>> [COUNTER_SYNC_FAULT]:", err);
                if (cSel) { cSel.innerHTML = '<option value="">-- Terminal synchronization failure --</option>'; cSel.disabled = true; }
            }

            // 2. Synchronize Warehouse (ProductInventory Depot Matrix) independently
            try {
                const wRes = await fetch(`/api/v1/POS/setup/tenants/${bId}/warehouses`);
                if (wSel) {
                    if (wRes.ok) {
                        const warehouses = await wRes.json();
                        wSel.innerHTML = warehouses.length ? '<option value="">-- Select Warehouse (ProductInventory) --</option>' : '<option value="">No stock depots mapped</option>';
                        warehouses.forEach(w => {
                            const wid = w.warehouseId || w.WarehouseId || bId;
                            const wname = w.warehouseName || w.WarehouseName || `WH-0${bId} Main Stock Depot`;
                            const opt = document.createElement('option');
                            opt.value = wid;
                            opt.setAttribute('data-name', wname);
                            opt.textContent = wname;
                            wSel.appendChild(opt);
                        });
                        wSel.disabled = warehouses.length === 0;
                    } else {
                        wSel.innerHTML = '<option value="">-- Warehouse synchronization failure --</option>';
                        wSel.disabled = true;
                    }
                }
            } catch (err) {
                console.error(">>> [WAREHOUSE_SYNC_FAULT]:", err);
                if (wSel) { wSel.innerHTML = '<option value="">-- Warehouse synchronization failure --</option>'; wSel.disabled = true; }
            }

            // 3. Synchronize Inventory Status Chips
            try {
                const iRes = await fetch(`/api/v1/POS/setup/tenants/${bId}/inventory-summary`);
                if (iRes.ok) {
                    const inv = await iRes.json();
                    const total = inv.totalProducts !== undefined ? inv.totalProducts : (inv.TotalProducts || 0);
                    const low = inv.lowStock !== undefined ? inv.lowStock : (inv.LowStock || 0);
                    const out = inv.outOfStock !== undefined ? inv.outOfStock : (inv.OutOfStock || 0);
                    const invEl = document.getElementById('inventoryChips');
                    if (invEl) {
                        invEl.innerHTML = `
                            <span class="inv-chip good"><i class="fa-solid fa-box me-1"></i>${total} SKUs In Stock</span>
                            <span class="inv-chip warn"><i class="fa-solid fa-triangle-exclamation me-1"></i>${low} Low Level</span>
                            <span class="inv-chip bad"><i class="fa-solid fa-xmark me-1"></i>${out} Stockout</span>`;
                    }
                }
            } catch (err) {
                console.warn(">>> [INVENTORY_CHIPS_SYNC_FAULT]:", err);
            }
            validateSelections();
        }

        async function onAdminTenantSwitch(selectEl) {
            const newTenantId = parseInt(selectEl.value, 10) || 0;
            const opt = selectEl.options[selectEl.selectedIndex];
            const newTenantName = (opt && newTenantId > 0) ? opt.text.split(' (ID:')[0] : 'Tenant #' + newTenantId;
            POS_STATE.tenantId = newTenantId;
            POS_STATE.tenantName = newTenantName;
            const cSel = document.getElementById('setupCounterSel');
            const wSel = document.getElementById('setupWarehouseSel');
            if (cSel) { cSel.innerHTML = '<option value="">-- Loading active terminals... --</option>'; cSel.disabled = true; }
            if (wSel) { wSel.innerHTML = '<option value="">-- Loading warehouse matrix... --</option>'; wSel.disabled = true; }
            const nBtn = document.getElementById('btnStep1Next');
            if (nBtn) nBtn.disabled = true;
            await loadCountersAndWarehousesForTenant();
        }

        async function confirmSetup() {
            const cSel = document.getElementById('setupCounterSel');
            const wSel = document.getElementById('setupWarehouseSel');
            if (!cSel || !cSel.value || !wSel || !wSel.value) { 
                if (typeof showCyberNotify === 'function') showCyberNotify("SELECTION REQUIRED", "Please select both an operating counter terminal and an active warehouse inventory depot before launching workflow.", "warning");
                else alert('Please select both a counter and a warehouse.'); 
                return; 
            }
            POS_STATE.counterId = parseInt(cSel.value);
            POS_STATE.counterName = cSel.options[cSel.selectedIndex].dataset.name;
            POS_STATE.warehouseId = parseInt(wSel.value);
            POS_STATE.warehouseName = wSel.options[wSel.selectedIndex].dataset.name;

            document.getElementById('setupStep1').style.display = 'none';
            document.getElementById('setupStep2').style.display = 'block';
            document.getElementById('step1dot').className = 'step-dot done';
            document.getElementById('step2dot').className = 'step-dot active';

            // Persist terminal session to localStorage
            localStorage.setItem('posCounter', JSON.stringify({
                tenantId: POS_STATE.tenantId,
                tenantName: POS_STATE.tenantName,
                counterId: POS_STATE.counterId, 
                counterName: POS_STATE.counterName,
                warehouseId: POS_STATE.warehouseId,
                warehouseName: POS_STATE.warehouseName
            }));

            await enterPOS();
        }

        async function enterPOS() {
            document.getElementById('setupProgressMsg').textContent = 'Loading catalog metadata...';
            try {
                const metaRes = await fetch('/api/v1/POS/catalog/metadata');
                if (metaRes.ok) catalogMeta = await metaRes.json();
            } catch (e) { console.warn('Metadata load failed'); }

            document.getElementById('setupProgressMsg').textContent = 'Loading product catalog...';
            await loadProductGrid();

            document.getElementById('setupProgressMsg').textContent = 'Checking for active shift...';
            await checkExistingShift();

            document.getElementById('setupProgressMsg').textContent = 'Building category sidebar...';
            buildSidebarCategories();

            updateFooterContext();
            startClock();
            startPingMonitor();

            document.getElementById('setupGate').style.display = 'none';
            await loadPaymentMethods();
        }

        function updateFooterContext() {
            document.getElementById('footerTenant').textContent = POS_STATE.tenantName || '--';
            document.getElementById('footerCounter').textContent = POS_STATE.counterName || '--';
            document.getElementById('footerWarehouse').textContent = POS_STATE.warehouseName ? POS_STATE.warehouseName.split(' - ')[0] : (POS_STATE.tenantId ? `WH-0${POS_STATE.tenantId}` : '--');
            document.getElementById('footerShift').textContent = POS_STATE.shiftId ? `#${POS_STATE.shiftId}` : 'Not Started';
            document.getElementById('shiftTenantLabel').textContent = POS_STATE.tenantName;
            document.getElementById('shiftCounterLabel').textContent = POS_STATE.counterName;
        }

        // Restore counter from localStorage on refresh (tenant always from auth cookie)
        async function checkLocalSetup() {
            const saved = localStorage.getItem('posCounter');
            if (saved) {
                try {
                    const s = JSON.parse(saved);
                    if (s.counterId && s.warehouseId && s.tenantId === POS_STATE.tenantId && !document.getElementById('adminTenantSelect')) {
                        POS_STATE.counterId = s.counterId;
                        POS_STATE.counterName = s.counterName || '';
                        POS_STATE.warehouseId = s.warehouseId;
                        POS_STATE.warehouseName = s.warehouseName || '';
                        document.getElementById('setupStep1').style.display = 'none';
                        document.getElementById('setupStep2').style.display = 'block';
                        document.getElementById('step1dot').className = 'step-dot done';
                        document.getElementById('step2dot').className = 'step-dot active';
                        await enterPOS();
                        return;
                    }
                } catch (e) {}
            }
            initSetupGate();
        }

        // ===================================================
        // SHIFT MANAGEMENT
        // ===================================================
        async function checkExistingShift() {
            if (!POS_STATE.userId || !POS_STATE.counterId) return;
            try {
                const res = await fetch(`/api/v1/POS/shift/active?userId=${POS_STATE.userId}&counterId=${POS_STATE.counterId}`);
                if (res.ok) {
                    const shift = await res.json();
                    POS_STATE.shiftId = shift.shiftId;
                    POS_STATE.shiftStartTime = shift.startTime;
                    
                    // >>> [STALE_SHIFT_QUARANTINE]: Detect day-boundary overflow under Blind Close rules
                    const shiftDate = new Date(shift.startTime);
                    const now = new Date();
                    if (now.toDateString() !== shiftDate.toDateString() && now > shiftDate) {
                        POS_STATE.isStaleShift = true;
                        updateShiftUI(true);
                        document.getElementById('btnPayment').disabled = true;
                        setTimeout(() => {
                            if (typeof showCyberNotify === 'function') {
                                showCyberNotify("STALE SHIFT QUARANTINE TRIGGERED", `Active shift #${shift.shiftId} originated on a previous date (${shiftDate.toLocaleDateString()}). Trading operations are strictly frozen under Blind Close protocols. You must count physical drawer cash and close this shift before conducting today's sales.`, "error");
                            }
                            openCloseShift();
                        }, 1000);
                        return;
                    } else {
                        POS_STATE.isStaleShift = false;
                    }

                    updateShiftUI(true);
                    updateFooterContext();
                    await ensureActiveDraftOrder();
                }
            } catch (e) {}
        }

        function updateShiftUI(hasShift) {
            const dot = document.getElementById('shiftDot');
            const label = document.getElementById('shiftStatusLabel');
            const ssBadge = document.getElementById('sidebarShiftStatus');
            const startBtn = document.getElementById('opMenuStartShift');
            const closeBtn = document.getElementById('opMenuCloseShift');
            if (hasShift) {
                dot.className = 'shift-dot active';
                label.textContent = `Shift #${POS_STATE.shiftId} Active`;
                label.style.color = 'var(--bio-emerald)';
                ssBadge.className = 'shift-status-badge active-shift';
                document.getElementById('btnPayment').disabled = false;
                if (startBtn) startBtn.style.display = 'none';
                if (closeBtn) closeBtn.style.display = 'flex';
            } else {
                dot.className = 'shift-dot';
                label.textContent = 'No Active Shift';
                label.style.color = '';
                ssBadge.className = 'shift-status-badge';
                document.getElementById('btnPayment').disabled = true;
                if (startBtn) startBtn.style.display = 'flex';
                if (closeBtn) closeBtn.style.display = 'none';
            }
        }

        function openStartShift() {
            document.getElementById('shiftStartTime').textContent = new Date().toLocaleString('en-GB');
            document.getElementById('shiftTenantLabel').textContent = POS_STATE.tenantName;
            document.getElementById('shiftCounterLabel').textContent = POS_STATE.counterName;
            buildDenomTable();
            openModal('modalStartShift');
        }

        const DENOMS = [500000, 200000, 100000, 50000, 20000, 10000, 5000, 2000, 1000, 500, 200, 100];
        function buildDenomTable() {
            const tbody = document.getElementById('denomBody');
            tbody.innerHTML = '';
            DENOMS.forEach(d => {
                tbody.innerHTML += `<tr>
                    <td>${d.toLocaleString('en-US')} ₫</td>
                    <td style="text-align:right;">
                        <input type="number" class="denom-input" min="0" value="0" data-denom="${d}" oninput="recalcDenomTotal()" />
                    </td>
                    <td style="text-align:right;" id="denomRow_${d}" class="denom-total">0</td>
                </tr>`;
            });
        }

        function recalcDenomTotal() {
            let total = 0;
            document.querySelectorAll('.denom-input').forEach(inp => {
                const cnt = parseInt(inp.value) || 0;
                const denom = parseInt(inp.dataset.denom);
                const rowTotal = cnt * denom;
                document.getElementById(`denomRow_${denom}`).textContent = rowTotal.toLocaleString('en-US');
                total += rowTotal;
            });
            document.getElementById('denomTotal').textContent = total.toLocaleString('en-US');
        }

        async function confirmStartShift() {
            let startCash = 0;
            document.querySelectorAll('.denom-input').forEach(inp => {
                startCash += (parseInt(inp.value) || 0) * parseInt(inp.dataset.denom);
            });

            const payload = {
                UserId: POS_STATE.userId,
                TenantId: POS_STATE.tenantId,
                CounterId: POS_STATE.counterId,
                StartCash: startCash
            };

            const res = await fetch('/api/v1/POS/shift/start', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (res.ok) {
                const shift = await res.json();
                POS_STATE.shiftId = shift.shiftId;
                POS_STATE.shiftStartTime = shift.startTime;
                updateShiftUI(true);
                updateFooterContext();
                closeModal('modalStartShift');
                await ensureActiveDraftOrder();
            } else {
                const err = await res.json();
                alert(`Shift start failed: ${err.message || err.Message || 'Unknown error'}`);
            }
        }

        function switchCounter() {
            const curEl = document.getElementById('switchCurrentCounter');
            const shiftEl = document.getElementById('switchCurrentShift');
            if (curEl) curEl.textContent = POS_STATE.counterName || "UNKNOWN COUNTER";
            if (shiftEl) shiftEl.textContent = POS_STATE.shiftId ? `ACTIVE (ID: #${POS_STATE.shiftId})` : "NO ACTIVE SHIFT";
            openModal('modalSwitchCounter');
        }

        function confirmSwitchCounter() {
            localStorage.removeItem('posCounter');
            location.reload();
        }


        function goBackFromSetup() {
            try {
                if (typeof localStorage !== 'undefined') {
                    localStorage.removeItem('posCounter');
                }
                if (window.history.length > 1) {
                    window.history.back();
                    return;
                }
                const ref = document.referrer;
                if (ref && !ref.toLowerCase().includes('/pos') && ref !== window.location.href) {
                    window.location.href = ref;
                    return;
                }
            } catch (e) {
                console.warn(">>> [BACK_NAV_FAULT]:", e);
            }
            window.location.href = '/Home/DashboardRouter';
        }

        function closeSetupGate() {
            if (POS_STATE && POS_STATE.counterId) {
                const gate = document.getElementById('setupGate');
                if (gate) gate.style.display = 'none';
            } else {
                window.location.href = '/';
            }
        }

        function openCloseShift() {
            if (!POS_STATE.shiftId) { 
                if (typeof showCyberNotify === 'function') showCyberNotify("SHIFT ERROR", "No active work shift found to terminate.", "warning");
                else alert('No active shift to close.'); 
                return; 
            }
            document.getElementById('closeShiftIdLabel').textContent = `#${POS_STATE.shiftId}`;
            document.getElementById('closeShiftStartTime').textContent = new Date(POS_STATE.shiftStartTime || Date.now()).toLocaleString('en-GB');
            document.getElementById('inpCloseEndCash').value = '';
            openModal('modalCloseShift');
        }

        async function confirmCloseShift() {
            const endCashVal = document.getElementById('inpCloseEndCash').value;
            if (endCashVal === '' || isNaN(endCashVal) || Number(endCashVal) < 0) {
                if (typeof showCyberNotify === 'function') showCyberNotify("BLIND CLOSE VALIDATION", "Please input a valid physical cash count amount in the drawer (non-negative integer).", "warning");
                else alert('Please enter a valid non-negative End Cash amount.');
                return;
            }
            const res = await fetch('/api/v1/POS/shift/close', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ shiftId: POS_STATE.shiftId, endCash: Number(endCashVal) })
            });
            if (res.ok) {
                const data = await res.json();
                const balStatus = data.isBalanced !== false ? '[✓ BALANCED VERIFIED]' : `[⚠️ CASH DISCREPANCY: ${(data.cashDifference||0).toLocaleString('en-US')} ₫]`;
                const summaryMsg = `>>> [SHIFT SETTLEMENT & BLIND CLOSE AUDIT]\n` +
                                   `Shift Number:     #${data.shiftId}\n` +
                                   `Verification:     ${balStatus}\n` +
                                   `--------------------------------------------------\n` +
                                   `Opening Float:    ${(data.startCash||0).toLocaleString('en-US')} ₫\n` +
                                   `Total Sales:      ${(data.totalRevenue||0).toLocaleString('en-US')} ₫ (${data.orderCount||0} orders)\n` +
                                   `Expected Drawer:  ${(data.expectedEndCash || ((data.startCash||0)+(data.totalRevenue||0)) || 0).toLocaleString('en-US')} ₫\n` +
                                   `Declared Drawer:  ${(data.endCash||0).toLocaleString('en-US')} ₫\n\n` +
                                   `${data.message || 'Shift closed successfully.'}`;
                if (typeof showCyberNotify === 'function') showCyberNotify("SHIFT CLOSED SUCCESS", summaryMsg, data.isBalanced !== false ? "success" : "warning");
                else alert(summaryMsg);
                POS_STATE.shiftId = null;
                POS_STATE.shiftStartTime = null;
                POS_STATE.isStaleShift = false;
                closeModal('modalCloseShift');
                updateShiftUI(false);
                updateFooterContext();

                // >>> [AUTO-CLEANUP]: Fire-and-forget draft purge on shift close.
                // No await \u2014 this runs in background, never blocks cashier workflow.
                fetch('/api/v1/POS/retail-draft/cleanup-stale', { method: 'DELETE' })
                    .then(r => r.ok ? r.json() : null)
                    .then(d => { if (d?.purgedCount > 0) console.log(`>>> [SHIFT_CLOSE_CLEANUP]: Purged ${d.purgedCount} stale draft(s).`); })
                    .catch(() => {});
            } else {
                const err = await res.json();
                if (typeof showCyberNotify === 'function') showCyberNotify("SHIFT CLOSE FAULT", `Error closing shift: ${err.message || err.Error || 'Unknown error'}`, "error");
                else alert(`Error closing shift: ${err.message || err.Error || 'Unknown error'}`);
            }
        }

        // ===================================================
        // PRODUCT CATALOG
        // ===================================================
        async function loadProductGrid(queryParams = '') {
            const container = document.getElementById('productGrid');
            container.innerHTML = `<div style="grid-column:1/-1; text-align:center; padding:40px; color:#333;">
                <i class="fa-solid fa-spinner fa-spin fa-2x" style="color:var(--holo-cyan);"></i>
                <div style="margin-top:8px; font-size:0.78rem;">Querying inventory...</div></div>`;
            try {
                const tenantParam = POS_STATE.tenantId ? `tenantId=${POS_STATE.tenantId}` : 'tenantId=1';
                const res = await fetch(`/api/v1/POS/catalog/products?${tenantParam}${queryParams}`);
                if (res.ok) {
                    const data = await res.json();
                    renderProductCards(data.products || data.Products || []);
                    return;
                }
            } catch (e) {}
            container.innerHTML = `<div style="grid-column:1/-1; text-align:center; padding:40px; color:var(--crimson-danger);">
                <i class="fa-solid fa-triangle-exclamation fa-2x"></i><div style="margin-top:8px;">Catalog unavailable</div></div>`;
        }

        function renderProductCards(products) {
            const container = document.getElementById('productGrid');
            if (!products || products.length === 0) {
                container.innerHTML = `<div style="grid-column:1/-1; text-align:center; padding:40px; color:#444;">No products found</div>`;
                return;
            }
            container.innerHTML = '';
            products.forEach(p => {
                const stock = p.availableStock !== undefined ? p.availableStock : (p.AvailableStock || 0);
                const stockClass = stock === 0 ? 'zero' : (stock <= 5 ? 'low' : '');
                const card = document.createElement('div');
                card.className = `prod-card${stock === 0 ? ' out-of-stock' : ''}`;
                card.style.height = "210px";
                card.style.padding = "6px";
                if (stock > 0) {
                    card.onclick = () => addItemToOrder(p.productId || p.ProductId, p.sku || p.Sku, p.productName || p.ProductName, p.basePrice || p.BasePrice);
                }
                const imgUrl = p.imageUrl || p.ImageUrl || 'https://images.unsplash.com/photo-1526738549149-8e07eca6c147?auto=format&fit=crop&w=300&q=80';
                card.innerHTML = `
                    <span class="prod-stock-chip ${stockClass}" style="position:absolute; top:6px; right:6px; z-index:2; background:#000;">${stock}</span>
                    <div style="height:92px; width:100%; margin-bottom:6px; overflow:hidden; border-bottom:1px solid #1A1A1A; position:relative; background:#050505; display:flex; align-items:center; justify-content:center;">
                        <img src="${imgUrl}" alt="Item" onerror="this.src='https://images.unsplash.com/photo-1526738549149-8e07eca6c147?auto=format&fit=crop&w=300&q=80'" style="width:100%; height:100%; object-fit:cover; opacity:0.85; transition:transform 0.2s;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'"/>
                    </div>
