        function viewInvoice() {
            if (!lastCheckoutData) return;
            const receipt = window.open('', '_blank', 'width=420,height=650');
            receipt.document.write(generateReceiptHtml(false));
            receipt.document.close();
        }

        function printInvoice() {
            if (!lastCheckoutData) return;
            const printWin = window.open('', '_blank', 'width=420,height=650');
            printWin.document.write(generateReceiptHtml(true));
            printWin.document.close();
            printWin.focus();
            setTimeout(() => { printWin.print(); printWin.close(); }, 300);
        }

        // ===================================================
        // ORDERS TODAY
        // ===================================================
        async function openOrdersToday() {
            openModal('modalOrdersToday');
            await loadOrdersToday(true);
        }

        async function loadOrdersToday(reset = false) {
            if (reset) document.getElementById('todayFilterInvoice').value = '';
            const invoiceFilter = document.getElementById('todayFilterInvoice').value;
            const tbody = document.getElementById('ordersTodayBody');
            tbody.innerHTML = `<tr><td colspan="6" style="text-align:center; color:#333; padding:16px;"><i class="fa-solid fa-spinner fa-spin"></i></td></tr>`;

            const params = new URLSearchParams({ tenantId: POS_STATE.tenantId });
            if (POS_STATE.shiftId) params.append('shiftId', POS_STATE.shiftId);
            if (invoiceFilter) params.append('invoiceNo', invoiceFilter);

            const res = await fetch(`/api/v1/POS/orders/today?${params}`);
            if (!res.ok) { tbody.innerHTML = `<tr><td colspan="6" style="text-align:center; color:var(--crimson-danger); padding:16px;">Failed to load orders</td></tr>`; return; }

            const data = await res.json();
            const orders = data.orders || data.Orders || [];
            if (orders.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" style="text-align:center; color:#333; padding:16px;">No orders found today</td></tr>`;
            } else {
                tbody.innerHTML = orders.map(o => `<tr onclick="viewOrderDetails(${o.orderId || o.OrderId})" style="cursor:pointer;" title="Click to inspect transaction breakdown">
                    <td style="color:var(--holo-cyan); font-weight:bold; font-family:var(--font-hdr); font-size:0.75rem;"><i class="fa-solid fa-receipt me-1"></i>${o.invoiceNumber || o.InvoiceNumber || 'N/A'}</td>
                    <td style="color:#888; font-size:0.75rem;">${new Date(o.createdAt || o.CreatedAt).toLocaleTimeString('en-GB', {hour:'2-digit', minute:'2-digit', second:'2-digit'})}</td>
                    <td>${o.snapshotCustomerName || o.SnapshotCustomerName || 'Walk-in'}</td>
                    <td style="text-align:right; color:var(--bio-emerald); font-family:var(--font-data); font-weight:bold;">${(o.totalAmount || o.TotalAmount || 0).toLocaleString('en-US')} ₫</td>
                    <td style="color:#AAA;"><span style="background:#1C2424; padding:2px 6px; border:1px solid #334444;">${o.paymentMethod || o.PaymentMethod || 'Cash'}</span></td>
                    <td style="text-align:center; color:var(--holo-cyan); font-weight:bold;">${o.itemCount || o.ItemCount || 0}</td>
                </tr>`).join('');
            }
            const totalRev = data.totalRevenue || data.TotalRevenue || 0;
            const totalOrd = data.totalOrders || data.TotalOrders || 0;
            document.getElementById('ordersTodaySummary').innerHTML = `
                <span>${totalOrd} orders today</span>
                <span style="color:var(--bio-emerald); font-family:var(--font-data);">Total: ${totalRev.toLocaleString('en-US')} ₫</span>`;
        }

