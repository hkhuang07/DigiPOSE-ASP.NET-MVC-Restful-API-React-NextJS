    <!-- Scripts -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // ===================================================
        // POS STATE — Branch scoped from auth claim (server-rendered)
        // ===================================================
        const POS_STATE = {
            branchId: @(User.FindFirst("BranchId")?.Value ?? "null"),
            branchName: '@(User.FindFirst("BranchName")?.Value?.Replace("'", "\\'") ?? "N/A")',
            counterId: null, counterName: '',
            shiftId: null, shiftStartTime: null,
            userId: @(User.FindFirst("UserId")?.Value ?? User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "0"),
            activeTab: 0,
            registers: [
                { orderId: null, items: [], customerId: null, customerName: 'Walk-in Customer', orderType: 'retail' },
                { orderId: null, items: [], customerId: null, customerName: 'Shipping Order', orderType: 'retail' },
                { orderId: null, items: [], customerId: null, customerName: 'Held Draft', orderType: 'retail' }
            ]
        };

        let catalogMeta = { categories: [], manufacturers: [], productTypes: [], units: [], customers: [] };
        let selectedPaymentMethodId = null;
        let selectedVipCustomer = null;
        let lastCheckoutData = null;

        // ===================================================
        // SETUP GATE — Branch from auth claim, only counter selection required
        // ===================================================
        async function initSetupGate() {
            // Branch is already in POS_STATE from auth claim — just load counters + inventory
            const cRes = await fetch(`/api/v1/POS/setup/branches/${POS_STATE.branchId}/counters`);
            if (!cRes.ok) { alert('Failed to load counters. Check network.'); return; }
            const counters = await cRes.json();
            const cSel = document.getElementById('setupCounterSel');
            cSel.innerHTML = counters.length
                ? '<option value="">-- Select Counter --</option>'
                : '<option value="">No counters available</option>';
            counters.forEach(c => cSel.innerHTML += `<option value="${c.counterId}" data-name="${c.counterName}">${c.counterName}</option>`);
            cSel.addEventListener('change', () => {
                document.getElementById('btnStep1Next').disabled = !cSel.value;
            });

            // Load inventory summary for this branch
            const iRes = await fetch(`/api/v1/POS/setup/branches/${POS_STATE.branchId}/inventory-summary`);
            if (iRes.ok) {
                const inv = await iRes.json();
                document.getElementById('inventoryChips').innerHTML = `
                    <span class="inv-chip good"><i class="fa-solid fa-box me-1"></i>${inv.totalProducts} In Stock</span>
                    <span class="inv-chip warn"><i class="fa-solid fa-triangle-exclamation me-1"></i>${inv.lowStock} Low</span>
                    <span class="inv-chip bad"><i class="fa-solid fa-xmark me-1"></i>${inv.outOfStock} Out</span>`;
            }
        }

        async function confirmSetup() {
            const cSel = document.getElementById('setupCounterSel');
            if (!cSel.value) { alert('Please select a counter.'); return; }
            POS_STATE.counterId = parseInt(cSel.value);
            POS_STATE.counterName = cSel.options[cSel.selectedIndex].dataset.name;

            document.getElementById('setupStep1').style.display = 'none';
            document.getElementById('setupStep2').style.display = 'block';
            document.getElementById('step1dot').className = 'step-dot done';
            document.getElementById('step2dot').className = 'step-dot active';

            // Persist counter to localStorage (branch always from auth cookie)
            localStorage.setItem('posCounter', JSON.stringify({
                counterId: POS_STATE.counterId, counterName: POS_STATE.counterName
            }));

            await enterPOS();
        }

        async function enterPOS() {
            document.getElementById('setupProgressMsg').textContent = 'Loading catalog metadata...';
            try {
                const metaRes = await fetch('/api/v1/POS/catalog/metadata');
                if (metaRes.ok) catalogMeta = await metaRes.json();
            } catch (e) { console.warn('Metadata load failed'); }

            document.getElementById('setupProgressMsg').textContent = 'Loading product catalog...';
            await loadProductGrid();

            document.getElementById('setupProgressMsg').textContent = 'Checking for active shift...';
            await checkExistingShift();

            document.getElementById('setupProgressMsg').textContent = 'Building category sidebar...';
            buildSidebarCategories();

            updateFooterContext();
            startClock();
            startPingMonitor();

            document.getElementById('setupGate').style.display = 'none';
            await loadPaymentMethods();
        }

        function updateFooterContext() {
            document.getElementById('footerBranch').textContent = POS_STATE.branchName || '--';
            document.getElementById('footerCounter').textContent = POS_STATE.counterName || '--';
            document.getElementById('footerWarehouse').textContent = POS_STATE.branchId ? `WH-0${POS_STATE.branchId}` : '--';
            document.getElementById('footerShift').textContent = POS_STATE.shiftId ? `#${POS_STATE.shiftId}` : 'Not Started';
            document.getElementById('shiftBranchLabel').textContent = POS_STATE.branchName;
            document.getElementById('shiftCounterLabel').textContent = POS_STATE.counterName;
        }

        // Restore counter from localStorage on refresh (branch always from auth cookie)
        async function checkLocalSetup() {
            const saved = localStorage.getItem('posCounter');
            if (saved) {
                try {
                    const s = JSON.parse(saved);
                    if (s.counterId) {
                        POS_STATE.counterId = s.counterId;
                        POS_STATE.counterName = s.counterName || '';
                        document.getElementById('setupStep1').style.display = 'none';
                        document.getElementById('setupStep2').style.display = 'block';
                        document.getElementById('step1dot').className = 'step-dot done';
                        document.getElementById('step2dot').className = 'step-dot active';
                        await enterPOS();
                        return;
                    }
                } catch (e) {}
            }
            initSetupGate();
        }

        // ===================================================
        // SHIFT MANAGEMENT
        // ===================================================
        async function checkExistingShift() {
            if (!POS_STATE.userId || !POS_STATE.counterId) return;
            try {
                const res = await fetch(`/api/v1/POS/shift/active?userId=${POS_STATE.userId}&counterId=${POS_STATE.counterId}`);
                if (res.ok) {
                    const shift = await res.json();
                    POS_STATE.shiftId = shift.shiftId;
                    POS_STATE.shiftStartTime = shift.startTime;
                    updateShiftUI(true);
                    updateFooterContext();
                    await ensureActiveDraftOrder();
                }
            } catch (e) {}
        }

        function updateShiftUI(hasShift) {
            const dot = document.getElementById('shiftDot');
            const label = document.getElementById('shiftStatusLabel');
            const ssBadge = document.getElementById('sidebarShiftStatus');
            if (hasShift) {
                dot.className = 'shift-dot active';
                label.textContent = `Shift #${POS_STATE.shiftId} Active`;
                label.style.color = 'var(--bio-emerald)';
                ssBadge.className = 'shift-status-badge active-shift';
                document.getElementById('btnPayment').disabled = false;
            } else {
                dot.className = 'shift-dot';
                label.textContent = 'No Active Shift';
                label.style.color = '';
                ssBadge.className = 'shift-status-badge';
                document.getElementById('btnPayment').disabled = true;
            }
        }

        function openStartShift() {
            document.getElementById('shiftStartTime').textContent = new Date().toLocaleString('en-GB');
            document.getElementById('shiftBranchLabel').textContent = POS_STATE.branchName;
            document.getElementById('shiftCounterLabel').textContent = POS_STATE.counterName;
            buildDenomTable();
            openModal('modalStartShift');
        }

        const DENOMS = [500000, 200000, 100000, 50000, 20000, 10000, 5000, 2000, 1000, 500, 200, 100];
        function buildDenomTable() {
            const tbody = document.getElementById('denomBody');
            tbody.innerHTML = '';
            DENOMS.forEach(d => {
                tbody.innerHTML += `<tr>
                    <td>${d.toLocaleString('en-US')} ₫</td>
                    <td style="text-align:right;">
                        <input type="number" class="denom-input" min="0" value="0" data-denom="${d}" oninput="recalcDenomTotal()" />
                    </td>
                    <td style="text-align:right;" id="denomRow_${d}" class="denom-total">0</td>
                </tr>`;
            });
        }

        function recalcDenomTotal() {
            let total = 0;
            document.querySelectorAll('.denom-input').forEach(inp => {
                const cnt = parseInt(inp.value) || 0;
                const denom = parseInt(inp.dataset.denom);
                const rowTotal = cnt * denom;
                document.getElementById(`denomRow_${denom}`).textContent = rowTotal.toLocaleString('en-US');
                total += rowTotal;
            });
            document.getElementById('denomTotal').textContent = total.toLocaleString('en-US');
        }

        async function confirmStartShift() {
            let startCash = 0;
            document.querySelectorAll('.denom-input').forEach(inp => {
                startCash += (parseInt(inp.value) || 0) * parseInt(inp.dataset.denom);
            });

            const payload = {
                UserId: POS_STATE.userId,
                BranchId: POS_STATE.branchId,
                CounterId: POS_STATE.counterId,
                StartCash: startCash
            };

            const res = await fetch('/api/v1/POS/shift/start', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (res.ok) {
                const shift = await res.json();
                POS_STATE.shiftId = shift.shiftId;
                POS_STATE.shiftStartTime = shift.startTime;
                updateShiftUI(true);
                updateFooterContext();
                closeModal('modalStartShift');
                await ensureActiveDraftOrder();
            } else {
                const err = await res.json();
                alert(`Shift start failed: ${err.message || err.Message || 'Unknown error'}`);
            }
        }

        // ===================================================
        // PRODUCT CATALOG
        // ===================================================
        async function loadProductGrid(queryParams = '') {
            const container = document.getElementById('productGrid');
            container.innerHTML = `<div style="grid-column:1/-1; text-align:center; padding:40px; color:#333;">
                <i class="fa-solid fa-spinner fa-spin fa-2x" style="color:var(--holo-cyan);"></i>
                <div style="margin-top:8px; font-size:0.78rem;">Querying inventory...</div></div>`;
            try {
                const branchParam = POS_STATE.branchId ? `branchId=${POS_STATE.branchId}` : 'branchId=1';
                const res = await fetch(`/api/v1/POS/catalog/products?${branchParam}${queryParams}`);
                if (res.ok) {
                    const data = await res.json();
                    renderProductCards(data.products || data.Products || []);
                    return;
                }
            } catch (e) {}
            container.innerHTML = `<div style="grid-column:1/-1; text-align:center; padding:40px; color:var(--crimson-danger);">
                <i class="fa-solid fa-triangle-exclamation fa-2x"></i><div style="margin-top:8px;">Catalog unavailable</div></div>`;
        }

        function renderProductCards(products) {
            const container = document.getElementById('productGrid');
            if (!products || products.length === 0) {
                container.innerHTML = `<div style="grid-column:1/-1; text-align:center; padding:40px; color:#444;">No products found</div>`;
                return;
            }
            container.innerHTML = '';
            products.forEach(p => {
                const stock = p.availableStock !== undefined ? p.availableStock : (p.AvailableStock || 0);
                const stockClass = stock === 0 ? 'zero' : (stock <= 5 ? 'low' : '');
                const card = document.createElement('div');
                card.className = `prod-card${stock === 0 ? ' out-of-stock' : ''}`;
                if (stock > 0) {
                    card.onclick = () => addItemToOrder(p.productId || p.ProductId, p.sku || p.Sku, p.productName || p.ProductName, p.basePrice || p.BasePrice);
                }
                card.innerHTML = `
                    <span class="prod-stock-chip ${stockClass}">${stock}</span>
                    <div class="prod-sku">${p.sku || p.Sku}</div>
                    <div class="prod-name">${p.productName || p.ProductName}</div>
                    <div>
                        <div class="prod-price">${Number(p.basePrice || p.BasePrice).toLocaleString('en-US')}</div>
                        <div class="prod-unit">${p.unitName || p.UnitName || ''} &bull; ${p.categoryName || p.CategoryName || ''}</div>
                    </div>`;
                container.appendChild(card);
            });
        }

        function buildSidebarCategories() {
            const cats = catalogMeta.categories || catalogMeta.Categories || [];
            const container = document.getElementById('sidebarCategories');
            container.innerHTML = `<div class="sidebar-nav-item active" onclick="setPrimaryFilter('all', null)">
                <i class="fa-solid fa-border-all"></i><span>All Products</span></div>`;
            cats.forEach(c => {
                container.innerHTML += `<div class="sidebar-nav-item" onclick="loadProductGrid('&categoryId=${c.categoryId || c.CategoryId}')">
                    <i class="fa-solid fa-tag"></i><span>${c.categoryName || c.CategoryName}</span></div>`;
            });
        }

        // Filters
        function setPrimaryFilter(type, btn) {
            document.querySelectorAll('.btn-filter').forEach(b => b.classList.remove('active'));
            if (btn) btn.classList.add('active');
            const strip = document.getElementById('subFilterStrip');
            strip.innerHTML = '';

            if (type === 'all') {
                strip.innerHTML = `<span style="color:#333; font-size:0.7rem;">Showing all products</span>`;
                loadProductGrid();
                return;
            }
            let list = [], paramName = '';
            if (type === 'category') { list = catalogMeta.categories || catalogMeta.Categories || []; paramName = 'categoryId'; }
            else if (type === 'manufacturer') { list = catalogMeta.manufacturers || catalogMeta.Manufacturers || []; paramName = 'manufacturerId'; }
            else if (type === 'productType') { list = catalogMeta.productTypes || catalogMeta.ProductTypes || []; paramName = 'productTypeId'; }
            else if (type === 'unit') { list = catalogMeta.units || catalogMeta.Units || []; paramName = 'unitId'; }

            if (list.length === 0) { strip.innerHTML = `<span style="color:var(--amber-warn); font-size:0.7rem;">No filter options available</span>`; return; }
            list.forEach(item => {
                const id = item.categoryId || item.CategoryId || item.manufacturerId || item.ManufacturerId || item.productTypeId || item.ProductTypeId || item.unitId || item.UnitId;
                const name = item.categoryName || item.CategoryName || item.manufacturerName || item.ManufacturerName || item.typeName || item.TypeName || item.unitName || item.UnitName;
                const tag = document.createElement('button');
                tag.className = 'btn-sub-tag';
                tag.textContent = name;
                tag.onclick = () => {
                    document.querySelectorAll('.btn-sub-tag').forEach(t => t.classList.remove('active'));
                    tag.classList.add('active');
                    loadProductGrid(`&${paramName}=${id}`);
                };
                strip.appendChild(tag);
            });
        }

        function applySortFilter(sortType, btn) {
            document.querySelectorAll('.btn-filter').forEach(b => b.classList.remove('active'));
            if (btn) btn.classList.add('active');
            loadProductGrid(`&filterType=${sortType}`);
        }

        function executeSearch() {
            const q = document.getElementById('posSearchInput').value.trim();
            loadProductGrid(`&query=${encodeURIComponent(q)}`);
        }

        // ===================================================
        // DRAFT ORDER & CART MANAGEMENT
        // ===================================================
        async function ensureActiveDraftOrder() {
            if (!POS_STATE.shiftId) {
                document.getElementById('lblOrderNo').textContent = '---';
                return null;
            }
            const reg = POS_STATE.registers[POS_STATE.activeTab];
            if (reg.orderId) {
                document.getElementById('lblOrderNo').textContent = `#${reg.orderId}`;
                renderOrderTable();
                return reg.orderId;
            }
            try {
                const res = await fetch('/api/v1/POS/retail-draft/create', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ BranchId: POS_STATE.branchId, ShiftId: POS_STATE.shiftId, UserId: POS_STATE.userId })
                });
                if (res.ok) {
                    const data = await res.json();
                    reg.orderId = data.orderId || data.OrderId;
                    document.getElementById('lblOrderNo').textContent = `#${reg.orderId}`;
                    renderOrderTable();
                    return reg.orderId;
                }
                const err = await res.json();
                if (err.error === 'INVALID_SHIFT') {
                    document.getElementById('lblOrderNo').textContent = 'START SHIFT';
                    document.getElementById('btnPayment').disabled = true;
                }
            } catch (e) {}
            return null;
        }

        async function addItemToOrder(productId, sku, name, unitPrice) {
            const orderId = await ensureActiveDraftOrder();
            if (!orderId || !POS_STATE.shiftId) {
                console.warn('>>> [OPERATOR_GATE_INTERCEPT]: Cashier must explicitly open work shift prior to processing retail sales.');
                alert('>>> [MANDATORY_SHIFT_AUTHORITY]\nAn active work shift is strictly required before processing retail sales or modifying terminal inventory.\n\nOpening Shift Initiation Protocol...');
                openStartShift();
                return;
            }
            try {
                const res = await fetch('/api/v1/POS/retail-draft/add-item', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ OrderId: orderId, ProductId: productId, Quantity: 1, ClientScanId: crypto.randomUUID() })
                });
                if (res.ok) {
                    const update = await res.json();
                    POS_STATE.registers[POS_STATE.activeTab].items = update.items || update.Items || [];
                    renderOrderTable();
                } else {
                    const err = await res.json();
                    if (err.error === 'OUT_OF_STOCK') alert(`Out of stock: ${err.productName}`);
                    else alert(err.message || err.Message || 'Failed to add item');
                }
            } catch (e) { console.error(e); }
        }

        async function removeItemFromOrder(productId) {
            const reg = POS_STATE.registers[POS_STATE.activeTab];
            if (!reg.orderId) return;
            const res = await fetch('/api/v1/POS/retail-draft/remove-item', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ OrderId: reg.orderId, ProductId: productId })
            });
            if (res.ok) {
                const update = await res.json();
                reg.items = update.items || update.Items || [];
                renderOrderTable();
            }
        }

        function renderOrderTable() {
            const reg = POS_STATE.registers[POS_STATE.activeTab];
            const tbody = document.getElementById('orderTableBody');
            document.getElementById('lblCustomer').textContent = reg.customerName.toUpperCase();
            document.getElementById('payCustomerName').textContent = reg.customerName;

            if (!reg.items || reg.items.length === 0) {
                tbody.innerHTML = `<tr><td colspan="5" style="text-align:center; padding:30px; color:#333;">
                    <i class="fa-solid fa-crosshairs fa-2x" style="color:#1A1A1A; display:block; margin-bottom:8px;"></i>
                    Awaiting product selection...</td></tr>`;
                updateTotals(0, 0, 0);
                return;
            }

            let gross = 0, vat = 0;
            let html = '';
            reg.items.forEach(item => {
                const total = item.lineTotal || item.LineTotal || 0;
                const unitPrice = item.unitPrice || item.UnitPrice || 0;
                const qty = item.quantity || item.Quantity || 1;
                const taxAmt = total - (qty * unitPrice);
                gross += (qty * unitPrice);
                vat += taxAmt;
                html += `<tr>
                    <td style="color:var(--holo-cyan); font-size:0.72rem; font-weight:bold;">${item.sku || item.Sku}</td>
                    <td style="font-weight:600; font-size:0.8rem;">${item.productName || item.ProductName}</td>
                    <td style="text-align:center;">
                        <span style="color:var(--bio-emerald); font-weight:bold;">×${qty}</span>
                    </td>
                    <td style="text-align:right; color:var(--bio-emerald); font-weight:bold; font-family:var(--font-data);">${total.toLocaleString('en-US')}</td>
                    <td style="text-align:center;"><button class="btn-void" onclick="removeItemFromOrder(${item.productId || item.ProductId})"><i class="fa-solid fa-xmark"></i></button></td>
                </tr>`;
            });
            tbody.innerHTML = html;
            const totalAmt = gross + vat;
            updateTotals(gross, vat, totalAmt);
        }

        function updateTotals(gross, vat, total) {
            const fmt = n => n.toLocaleString('en-US');
            document.getElementById('txtGross').textContent = `${fmt(gross)} ₫`;
            document.getElementById('txtVat').textContent = `${fmt(vat)} ₫`;
            document.getElementById('txtDiscount').textContent = `0 ₫`;
            document.getElementById('txtTotal').textContent = fmt(total);
            // Sync to payment modal
            document.getElementById('paySub').textContent = `${fmt(gross)} ₫`;
            document.getElementById('payVat').textContent = `${fmt(vat)} ₫`;
            document.getElementById('payDiscount').textContent = `0 ₫`;
            document.getElementById('payTotal').textContent = fmt(total);
        }

        function switchTab(idx) {
            POS_STATE.activeTab = idx;
            ['tabNow','tabShip','tabTemp'].forEach((id, i) => {
                document.getElementById(id).classList.toggle('active', i === idx);
            });
            renderOrderTable();
            if (POS_STATE.shiftId) ensureActiveDraftOrder();
        }

        function holdCurrentOrder() {
            const reg = POS_STATE.registers[POS_STATE.activeTab];
            if (!reg.items || reg.items.length === 0) { alert('Cannot hold an empty order.'); return; }
            POS_STATE.registers[2] = JSON.parse(JSON.stringify(reg));
            POS_STATE.registers[POS_STATE.activeTab] = { orderId: null, items: [], customerId: null, customerName: 'Walk-in Customer' };
            document.getElementById('tabTemp').textContent = '';
            document.getElementById('tabTemp').innerHTML = `<i class="fa-solid fa-bookmark me-1"></i>Held (1)`;
            renderOrderTable();
            ensureActiveDraftOrder();
        }

        function markShippingOrder() {
            const reg = POS_STATE.registers[POS_STATE.activeTab];
            if (!reg.items || reg.items.length === 0) { alert('Cannot ship an empty order.'); return; }
            POS_STATE.registers[1] = JSON.parse(JSON.stringify(reg));
            POS_STATE.registers[1].customerName = 'Shipping Order';
            POS_STATE.registers[POS_STATE.activeTab] = { orderId: null, items: [], customerId: null, customerName: 'Walk-in Customer' };
            document.getElementById('tabShip').innerHTML = `<i class="fa-solid fa-truck me-1"></i>Ship (1)`;
            renderOrderTable();
            ensureActiveDraftOrder();
        }

        // ===================================================
        // PAYMENT FLOW
        // ===================================================
        let paymentMethods = [];
        async function loadPaymentMethods() {
            const res = await fetch('/api/v1/POS/payment-methods');
            if (res.ok) paymentMethods = await res.json();
        }

        function toggleOrderType(type) {
            const reg = POS_STATE.registers[POS_STATE.activeTab];
            reg.orderType = type;
            const btnRetail = document.getElementById('btnOrderTypeRetail');
            const btnB2B = document.getElementById('btnOrderTypeB2B');
            const invoiceBlock = document.getElementById('b2bInvoiceBlock');
            
            if (type === 'b2b') {
                btnB2B.className = 'btn-pos-primary';
                btnRetail.className = 'btn-pos-secondary';
                invoiceBlock.style.display = 'block';
            } else {
                btnRetail.className = 'btn-pos-primary';
                btnB2B.className = 'btn-pos-secondary';
                invoiceBlock.style.display = 'none';
            }
            validatePaymentState();
        }

        function validatePaymentState() {
            const reg = POS_STATE.registers[POS_STATE.activeTab];
            const confirmBtn = document.getElementById('btnConfirmPayment');
            const warnBox = document.getElementById('b2bComplianceWarn');
            
            let isB2bValid = true;
            if (reg.orderType === 'b2b') {
                const taxCode = document.getElementById('payTaxCode').value.trim();
                const compName = document.getElementById('payCompanyName').value.trim();
                const hasVip = !!reg.customerId;
                
                warnBox.style.display = hasVip ? 'none' : 'block';
                if (!hasVip || !taxCode || !compName) {
                    isB2bValid = false;
                }
            } else {
                warnBox.style.display = 'none';
            }

            confirmBtn.disabled = !(selectedPaymentMethodId && isB2bValid);
        }

        function openPayment() {
            const reg = POS_STATE.registers[POS_STATE.activeTab];
            if (!reg.orderId || !reg.items || reg.items.length === 0) {
                alert('Add items to the order before processing payment.');
                return;
            }
            if (!POS_STATE.shiftId) {
                alert('>>> [OPERATOR_GATE]: Please explicitly Start Shift before payment execution.');
                openStartShift();
                return;
            }
            // Render payment methods
            const grid = document.getElementById('paymentMethodGrid');
            if (paymentMethods.length === 0) {
                grid.innerHTML = `<div style="color:#333;">No payment methods available</div>`;
            } else {
                grid.innerHTML = '';
                const icons = { 'Cash': 'fa-money-bill-wave', 'Card': 'fa-credit-card', 'QR': 'fa-qrcode', 'Transfer': 'fa-building-columns' };
                paymentMethods.forEach(m => {
                    const iconKey = Object.keys(icons).find(k => m.methodName.includes(k)) || 'Card';
                    const btn = document.createElement('div');
                    btn.className = 'payment-method-btn';
                    btn.innerHTML = `<i class="fa-solid ${icons[iconKey] || 'fa-credit-card'}"></i>${m.methodName}`;
                    btn.onclick = () => {
                        document.querySelectorAll('.payment-method-btn').forEach(b => b.classList.remove('selected'));
                        btn.classList.add('selected');
                        selectedPaymentMethodId = m.paymentMethodId;
                        validatePaymentState();
                    };
                    grid.appendChild(btn);
                });
            }
            selectedPaymentMethodId = null;
            document.getElementById('tenderedInput').value = '';
            document.getElementById('changeDisplay').textContent = '0';
            
            // Initialize Order Nature to Retail or existing selection
            toggleOrderType(reg.orderType || 'retail');
            openModal('modalPayment');
        }

        function calcChange() {
            const totalText = document.getElementById('txtTotal').textContent.replace(/,/g, '');
            const total = parseFloat(totalText) || 0;
            const tendered = parseFloat(document.getElementById('tenderedInput').value) || 0;
            const change = Math.max(0, tendered - total);
            document.getElementById('changeDisplay').textContent = change.toLocaleString('en-US');
        }

        async function confirmPayment() {
            const reg = POS_STATE.registers[POS_STATE.activeTab];
            if (!reg.orderId || !selectedPaymentMethodId) return;
            
            if (reg.orderType === 'b2b' && (!reg.customerId || !document.getElementById('payTaxCode').value.trim() || !document.getElementById('payCompanyName').value.trim())) {
                alert('>>> [B2B_COMPLIANCE_ERROR]: B2B orders strictly require an authenticated Customer Entity, legal Company Name, and Tax Code (MST).');
                return;
            }

            const totalText = document.getElementById('txtTotal').textContent.replace(/,/g, '');
            const total = parseFloat(totalText) || 0;
            const tendered = parseFloat(document.getElementById('tenderedInput').value) || total;

            const payload = {
                OrderId: reg.orderId,
                PaymentMethodId: selectedPaymentMethodId,
                CustomerId: reg.customerId || null,
                TenderedAmount: tendered,
                IdempotencyKey: crypto.randomUUID(),
                DocType: reg.orderType === 'b2b' ? 'B2B_INVOICE' : 'POS_RETAIL',
                CounterId: POS_STATE.counterId || null,
                WarehouseId: POS_STATE.branchId || null,
                BuyerTaxCode: reg.orderType === 'b2b' ? document.getElementById('payTaxCode').value.trim() : null,
                BuyerLegalName: reg.orderType === 'b2b' ? document.getElementById('payCompanyName').value.trim() : (reg.customerName !== 'Walk-in Customer' ? reg.customerName : null)
            };

            document.getElementById('btnConfirmPayment').disabled = true;
            document.getElementById('btnConfirmPayment').innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i>Processing...';

            const res = await fetch('/api/v1/POS/checkout/paid', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (res.ok) {
                const data = await res.json();
                lastCheckoutData = data;
                closeModal('modalPayment');

                // Populate success modal with immutable Retail Document Serial (doc_no)
                document.getElementById('successInvoice').textContent = data.docNo || data.DocNo || data.invoiceNumber || 'REC-XXXX';
                document.getElementById('successTotal').textContent = `${total.toLocaleString('en-US')} ₫`;
                document.getElementById('successTime').textContent = new Date(data.processedAt || data.ProcessedAt).toLocaleString('en-GB');
                document.getElementById('successChange').textContent = `${(data.changeAmount || data.ChangeAmount || 0).toLocaleString('en-US')} ₫`;
                document.getElementById('successMethod').textContent = paymentMethods.find(m => m.paymentMethodId === selectedPaymentMethodId)?.methodName || 'Cash';
                openModal('modalPaySuccess');

                // Reset register
                POS_STATE.registers[POS_STATE.activeTab] = { orderId: null, items: [], customerId: null, customerName: 'Walk-in Customer', orderType: 'retail' };
                renderOrderTable();
            } else {
                const err = await res.json();
                alert(`Payment failed: ${err.error || err.Error || 'Unknown error'}`);
                document.getElementById('btnConfirmPayment').disabled = false;
                document.getElementById('btnConfirmPayment').innerHTML = '<i class="fa-solid fa-bolt me-1"></i>Confirm Payment';
            }
        }

        function closePaySuccess() {
            closeModal('modalPaySuccess');
            if (POS_STATE.shiftId) ensureActiveDraftOrder();
        }

