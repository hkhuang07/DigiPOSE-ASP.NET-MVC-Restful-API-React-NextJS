@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DigiPOS - POS Center</title>
    <link rel="icon" type="image/png" href="~/images/brand/logo_dark.jpg" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />
    <link rel="stylesheet" href="~/css/cyber-hud.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Rajdhani:wght@600;700&family=Roboto+Mono:wght@400;500;700&family=VT323&display=swap" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <style>
        :root {
            --true-black: #000000;
            --carbon-void: #0A0A0A;
            --bg-void: #000000;
            --bg-surface: #0A0A0A;
            --holo-cyan: #00E5FF;
            --primary-cyan: #00E5FF;
            --bio-emerald: #00FF66;
            --amber-warn: #FFB000;
            --crimson-danger: #FF3333;
            --font-hdr: 'Orbitron', 'Rajdhani', sans-serif;
            --font-data: 'VT323', 'Roboto Mono', monospace;
            --font-mono: 'Roboto Mono', monospace;
            --operator-menu-w: 220px;
            --header-h: 64px;
            --footer-h: 36px;
            --register-w: 400px;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background: var(--true-black);
            color: #EEE;
            font-family: 'Roboto Mono', monospace;
            height: 100vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            user-select: none;
        }

        /* CRT scanline overlay */
        body::before {
            content: "";
            position: fixed;
            inset: 0;
            background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0,0,0,0.08) 2px, rgba(0,0,0,0.08) 4px);
            pointer-events: none;
            z-index: 9999;
        }

        /* ======================================================
           TOP HEADER — Inline Counter/Warehouse selectors
        ====================================================== */
        .pos-header {
            height: var(--header-h);
            background: var(--carbon-void);
            border-bottom: 1px solid var(--holo-cyan);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 12px;
            box-shadow: 0 2px 20px rgba(0,229,255,0.2);
            flex-shrink: 0;
            z-index: 100;
        }

        .header-left { display: flex; align-items: center; gap: 10px; }

        .btn-hamburger {
            background: transparent;
            border: 1px solid #333;
            color: var(--holo-cyan);
            width: 34px; height: 34px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1rem; cursor: pointer;
            transition: all 0.15s;
            flex-shrink: 0;
        }
        .btn-hamburger:hover { border-color: var(--holo-cyan); background: rgba(0,229,255,0.1); }

        .pos-brand {
            font-family: var(--font-hdr);
            font-size: 0.95rem;
            font-weight: 900;
            color: #FFF;
            text-decoration: none;
            letter-spacing: 1px;
            display: flex; align-items: center; gap: 8px;
        }
        .pos-brand .hud-logo-svg { width: 30px; height: 30px; flex-shrink: 0; }
        .pos-brand .brand-name span.accent { color: var(--holo-cyan); }
        .pos-brand .brand-name { display: flex; flex-direction: column; line-height: 1; }
        .pos-brand .brand-name .title-main { font-size: 0.88rem; font-weight: 900; letter-spacing: 1px; }
        .pos-brand .brand-name .title-sub { font-size: 0.52rem; color: #555; letter-spacing: 2px; font-family: var(--font-mono); font-weight: 400; }
        .pos-brand .hud-badge-ver {
            font-size: 0.52rem; font-family: var(--font-mono); font-weight: 400;
            color: var(--holo-cyan); border: 1px solid rgba(0,229,255,0.4);
            padding: 1px 4px; margin-left: 4px; letter-spacing: 1px;
        }

        .header-center { display: flex; align-items: center; gap: 6px; }
        .header-right { display: flex; align-items: center; gap: 8px; }

        /* Inline Counter/Warehouse selectors in header */
        .inline-selector {
            background: #050505; border: 1px solid #333; color: #CCC;
            padding: 4px 8px; font-family: var(--font-mono); font-size: 0.72rem;
            outline: none; height: 30px; min-width: 140px; max-width: 200px;
            -webkit-appearance: none; appearance: none; cursor: pointer;
        }
        .inline-selector:focus { border-color: var(--holo-cyan); }
        .inline-selector option { background: #0A0A0A; }
        .selector-label { font-size: 0.6rem; color: #555; text-transform: uppercase; letter-spacing: 1px; font-family: var(--font-mono); }

        /* Navbar icons — synced with Admin HUD */
        .hud-nav-icon-btn, .hud-notif-btn {
            background: #000000; border: 1px solid var(--holo-cyan); color: #FFFFFF;
            width: 38px; height: 38px; font-size: 1rem; display: flex; align-items: center; justify-content: center;
            cursor: pointer; position: relative; transition: all 0.2s ease;
            clip-path: polygon(6px 0, 100% 0, calc(100% - 6px) 100%, 0 100%);
        }
        .hud-lang-btn {
            background: #000000; border-top: 1px solid var(--holo-cyan); border-bottom: 1px solid var(--holo-cyan); border-left: none; border-right: none; color: var(--holo-cyan);
            height: 38px; padding: 0 14px; font-family: var(--font-hdr); font-size: 0.8rem; font-weight: 700;
            display: flex; align-items: center; gap: 8px; cursor: pointer; transition: all 0.2s ease;
            clip-path: polygon(10px 0, 100% 0, calc(100% - 10px) 100%, 0 100%); text-transform: uppercase;
        }
        .hud-lang-btn:hover, .hud-nav-icon-btn:hover, .hud-notif-btn:hover {
            background: rgba(0, 229, 255, 0.15); color: var(--holo-cyan); box-shadow: 0 0 10px rgba(0,229,255,0.4);
        }
        .hud-notif-wrapper { position: relative !important; overflow: visible !important; }
        .hud-notif-badge {
            position: absolute !important; top: -6px !important; right: -6px !important; background: #FF3333 !important; color: #FFFFFF !important;
            font-family: 'VT323', monospace !important; font-size: 0.85rem !important; font-weight: bold !important;
            padding: 2px 7px !important; border-radius: 4px !important; box-shadow: 0 0 12px #FF3333, 0 0 18px rgba(255, 51, 51, 0.8) !important;
            border: 1px solid rgba(255, 255, 255, 0.6) !important; z-index: 1050 !important; pointer-events: none;
        }
        .hud-profile-trigger {
            display: flex; align-items: center; gap: 14px; padding: 4px 14px 4px 6px;
            border: 1px solid var(--holo-cyan); background: #000000; cursor: pointer;
            transition: all 0.2s ease; height: 38px; box-shadow: 0 0 5px rgba(0, 229, 255, 0.2);
        }
        .hud-profile-trigger:hover { border-color: var(--holo-cyan); box-shadow: 0 0 12px rgba(0, 229, 255, 0.7); background: rgba(0, 229, 255, 0.08); }
        .hud-profile-trigger::after { display: none !important; }
        .hud-avatar-box {
            width: 28px; height: 28px; border: 1px solid var(--holo-cyan); background: transparent; color: var(--holo-cyan);
            display: flex; align-items: center; justify-content: center; font-family: 'VT323', monospace; font-size: 1rem; font-weight: 700;
        }
        .hud-user-info { display: flex; flex-direction: column; align-items: flex-start; justify-content: center; }
        .hud-user-name { font-family: 'VT323', monospace; font-size: 1.15rem; color: #FFFFFF; font-weight: bold; letter-spacing: 2px; line-height: 1; }
        .hud-user-role { font-family: 'VT323', monospace; font-size: 0.75rem; color: var(--holo-cyan); letter-spacing: 1.5px; line-height: 1; margin-top: 2px; }
        .dropdown-menu.pos-drop {
            background: #0A0A0A; border: 1px solid var(--holo-cyan); border-radius: 0; min-width: 210px; box-shadow: 0 10px 30px rgba(0,0,0,0.9), 0 0 10px rgba(0,229,255,0.4);
        }
        .dropdown-item { color: #D8F8FF; font-family: var(--font-mono); font-size: 0.85rem; padding: 8px 16px; display: flex; align-items: center; }
        .dropdown-item:hover { background: rgba(0,229,255,0.15); color: var(--holo-cyan); }
        .hud-dropdown-menu {
            background: #0A0A0A !important; border: 1px solid var(--holo-cyan) !important; border-radius: 0 !important;
            box-shadow: 0 10px 30px rgba(0,0,0,0.9), 0 0 10px rgba(0,229,255,0.4) !important;
        }
        .hud-dropdown-menu .dropdown-item { color: #D8F8FF; font-family: var(--font-mono); font-size: 0.85rem; }
        .hud-dropdown-menu .dropdown-item:hover { background: rgba(0,229,255,0.15); color: var(--holo-cyan); }

        /* Inline setup warning banner */
        .setup-warning-banner {
            background: rgba(255,176,0,0.08); border-bottom: 1px solid rgba(255,176,0,0.3);
            padding: 6px 16px; font-family: var(--font-mono); font-size: 0.75rem; color: var(--amber-warn);
            display: flex; align-items: center; gap: 8px; flex-shrink: 0;
        }
        .setup-warning-banner.hidden { display: none; }

        /* ======================================================
           WORKSPACE: SIDEBAR + CATALOG + REGISTER
        ====================================================== */
        .pos-workspace { flex: 1; display: flex; overflow: hidden; }

        /* LEFT: OPERATOR MENU SIDEBAR (Order 1 - Left) */
        .pos-operator-menu {
            order: 1; width: var(--operator-menu-w); background: #050505; border-right: 1px solid rgba(0, 229, 255, 0.2);
            display: flex; flex-direction: column; flex-shrink: 0; overflow-y: auto; transition: width 0.2s ease;
        }
        .pos-operator-menu.collapsed { width: 0; overflow: hidden; }
        .pos-operator-menu::-webkit-scrollbar { width: 3px; }
        .pos-operator-menu::-webkit-scrollbar-thumb { background: #1A1A1A; }

        .op-menu-header { padding: 10px 14px; font-family: var(--font-hdr); font-size: 0.65rem; color: var(--holo-cyan); text-transform: uppercase; letter-spacing: 2px; border-bottom: 1px solid #111; display: flex; align-items: center; gap: 6px; }
        .op-menu-section { padding: 8px 14px 4px; font-size: 0.6rem; color: #333; text-transform: uppercase; letter-spacing: 2px; }
        .op-menu-divider { height: 1px; background: #0D0D0D; margin: 4px 0; }
        .op-menu-item {
            display: flex; align-items: center; gap: 10px; padding: 9px 14px; color: #888; cursor: pointer;
            text-decoration: none; font-size: 0.82rem; border-left: 2px solid transparent; transition: all 0.12s; white-space: nowrap;
        }
        .op-menu-item:hover { background: rgba(0,229,255,0.06); color: var(--holo-cyan); border-left-color: var(--holo-cyan); }
        .op-menu-item.active { color: var(--bio-emerald); border-left-color: var(--bio-emerald); background: rgba(0,255,102,0.04); }
        .op-menu-item i { width: 16px; text-align: center; font-size: 0.85rem; }

        .shift-status-badge { display: flex; align-items: center; gap: 6px; padding: 6px 14px 2px; font-size: 0.7rem; color: #555; }
        .shift-status-badge.active-shift { color: var(--bio-emerald); }
        .shift-dot { width: 6px; height: 6px; border-radius: 50%; background: #222; flex-shrink: 0; }
        .shift-dot.active { background: var(--bio-emerald); box-shadow: 0 0 6px var(--bio-emerald); }

        /* REGISTER PANEL — Single queue (Order 3 - Right) */
        .pos-register { order: 3; width: var(--register-w); display: flex; flex-direction: column; background: #050505; border-left: 1px solid rgba(0, 229, 255, 0.3); border-right: none; flex-shrink: 0; }

        .register-header-strip {
            display: flex; align-items: center; justify-content: space-between;
            padding: 8px 12px; background: #080808; border-bottom: 1px solid #1A1A1A;
        }
        .register-order-info { display: flex; align-items: center; gap: 8px; }
        .order-no-chip { font-family: var(--font-hdr); font-size: 0.72rem; color: var(--holo-cyan); background: #000; padding: 3px 8px; border: 1px solid #222; }
        .draft-queue-btn {
            background: transparent; border: 1px solid #333; color: #888; padding: 4px 10px;
            font-family: var(--font-mono); font-size: 0.72rem; cursor: pointer; transition: all 0.15s; position: relative;
        }
        .draft-queue-btn:hover { border-color: var(--amber-warn); color: var(--amber-warn); }
        .draft-count-badge {
            position: absolute; top: -6px; right: -6px; background: var(--amber-warn); color: #000;
            font-size: 0.6rem; font-weight: bold; padding: 1px 5px; border-radius: 8px; min-width: 14px; text-align: center;
        }

        /* Customer row */
        .register-customer-row {
            display: flex; align-items: center; justify-content: space-between;
            padding: 6px 10px; background: #080808; border-bottom: 1px solid #1A1A1A; min-height: 36px;
        }
        .customer-info { display: flex; align-items: center; gap: 6px; font-size: 0.78rem; }
        .customer-name { color: var(--holo-cyan); font-weight: bold; font-family: 'Rajdhani', sans-serif; }
        .btn-select-customer { background: transparent; border: 1px dashed #333; color: #666; padding: 2px 8px; font-size: 0.72rem; cursor: pointer; transition: all 0.15s; }
        .btn-select-customer:hover { border-color: var(--holo-cyan); color: var(--holo-cyan); }

        /* Shipping toggle */
        .shipping-toggle { display: flex; align-items: center; gap: 6px; padding: 4px 10px; background: #050505; border-bottom: 1px solid #111; font-size: 0.72rem; color: #666; }
        .toggle-switch { position: relative; width: 32px; height: 16px; background: #222; border: 1px solid #444; cursor: pointer; transition: all 0.2s; }
        .toggle-switch.on { background: var(--holo-cyan); border-color: var(--holo-cyan); }
        .toggle-switch::after { content: ''; position: absolute; top: 1px; left: 1px; width: 12px; height: 12px; background: #666; transition: all 0.2s; }
        .toggle-switch.on::after { left: 17px; background: #000; }

        /* Line items table */
        .register-items { flex: 1; overflow-y: auto; }
        .register-items::-webkit-scrollbar { width: 3px; }
        .register-items::-webkit-scrollbar-thumb { background: #222; }

        table.order-table { width: 100%; border-collapse: collapse; font-size: 0.78rem; }
        .order-table thead th {
            background: #080808; color: #555; font-family: 'Rajdhani', sans-serif; font-size: 0.7rem; font-weight: 700;
            text-transform: uppercase; padding: 5px 8px; border-bottom: 1px solid #1A1A1A; position: sticky; top: 0;
        }
        .order-table tbody td { padding: 6px 8px; border-bottom: 1px solid #0D0D0D; vertical-align: middle; }
        .order-table tbody tr:hover td { background: rgba(0,229,255,0.03); }

        /* Line item note */
        .line-note-btn { background: transparent; border: none; color: #444; cursor: pointer; font-size: 0.7rem; padding: 2px; transition: color 0.15s; }
        .line-note-btn:hover { color: var(--amber-warn); }
        .line-note-btn.has-note { color: var(--amber-warn); }
        .line-note-input {
            width: 100%; background: #050505; border: 1px solid #222; color: #AAA; padding: 3px 6px;
            font-size: 0.7rem; font-family: var(--font-mono); outline: none; margin-top: 3px; display: none;
        }
        .line-note-input.show { display: block; }
        .line-note-input:focus { border-color: var(--amber-warn); }

        .btn-void { background: transparent; border: 1px solid #333; color: #666; padding: 1px 5px; font-size: 0.7rem; cursor: pointer; transition: all 0.1s; }
        .btn-void:hover { border-color: var(--crimson-danger); color: var(--crimson-danger); }

        /* Billing strip */
        .billing-strip { background: #030303; border-top: 1px solid #1A1A1A; padding: 8px 10px; }
        .billing-row { display: flex; justify-content: space-between; align-items: center; padding: 2px 0; font-size: 0.78rem; }
        .billing-row span:first-child { color: #666; }
        .billing-row span:last-child { color: #CCC; font-weight: bold; }
        .billing-total-row { display: flex; justify-content: space-between; align-items: baseline; padding: 5px 0 3px; border-top: 1px solid #1A1A1A; margin-top: 4px; }
        .total-label { font-family: var(--font-hdr); font-size: 0.75rem; color: #AAA; text-transform: uppercase; }
        .total-amount { font-family: var(--font-data); font-size: 2rem; color: var(--bio-emerald); font-weight: bold; line-height: 1; }

        /* Action buttons */
        .register-actions { padding: 8px; display: grid; grid-template-columns: 1fr 1fr; gap: 5px; border-top: 1px solid #1A1A1A; }
        .btn-action {
            padding: 8px 6px; font-family: 'Rajdhani', sans-serif; font-size: 0.8rem; font-weight: 700;
            cursor: pointer; border: 1px solid; text-transform: uppercase; letter-spacing: 0.5px;
            display: flex; align-items: center; justify-content: center; gap: 5px; transition: all 0.15s;
        }
        .btn-hold { background: transparent; border-color: var(--amber-warn); color: var(--amber-warn); }
        .btn-hold:hover { background: rgba(255,176,0,0.1); }
        .btn-ship { background: transparent; border-color: var(--holo-cyan); color: var(--holo-cyan); }
        .btn-ship:hover { background: rgba(0,229,255,0.1); }
        .btn-clear { background: transparent; border-color: var(--crimson-danger); color: var(--crimson-danger); }
        .btn-clear:hover { background: rgba(255,51,51,0.1); }
        .btn-payment {
            grid-column: span 2; background: var(--bio-emerald); border-color: var(--bio-emerald); color: #000;
            font-size: 0.95rem; padding: 10px; box-shadow: 0 0 15px rgba(0,255,102,0.3);
        }
        .btn-payment:hover { background: #000; color: var(--bio-emerald); box-shadow: 0 0 20px rgba(0,255,102,0.5); }
        .btn-payment:disabled { opacity: 0.4; cursor: not-allowed; box-shadow: none; }

        /* CATALOG (Order 2 - Center Workspace) */
        .pos-catalog { order: 2; flex: 1; display: flex; flex-direction: column; min-width: 0; position: relative; }
        .catalog-toolbar { background: #050505; border-bottom: 1px solid #1A1A1A; padding: 8px 12px; flex-shrink: 0; }
        .search-row { display: flex; gap: 6px; margin-bottom: 6px; }
        .pos-search-input {
            flex: 1; background: #000; border: 1px solid #333; border-right: none; color: #EEE;
            padding: 6px 12px; font-family: var(--font-mono); font-size: 0.88rem; outline: none; transition: border-color 0.15s;
        }
        .pos-search-input:focus { border-color: var(--holo-cyan); }
        .btn-search { background: var(--holo-cyan); border: 1px solid var(--holo-cyan); color: #000; padding: 6px 14px; font-family: var(--font-hdr); font-size: 0.75rem; font-weight: 700; cursor: pointer; letter-spacing: 1px; }
        .btn-search:hover { background: #000; color: var(--holo-cyan); }

        .filter-tags-row { display: flex; gap: 4px; flex-wrap: wrap; }
        .btn-filter {
            background: transparent; border: 1px solid #2A2A2A; color: #888; padding: 3px 10px;
            font-size: 0.75rem; font-family: 'Rajdhani', sans-serif; font-weight: 700; text-transform: uppercase;
            cursor: pointer; letter-spacing: 0.5px; transition: all 0.15s;
        }
        .btn-filter:hover, .btn-filter.active { border-color: var(--holo-cyan); color: var(--holo-cyan); background: rgba(0,229,255,0.08); }

        .sub-filter-strip {
            background: #030303; border-bottom: 1px solid #111; padding: 5px 12px;
            display: flex; gap: 4px; overflow-x: auto; min-height: 30px; align-items: center; flex-shrink: 0;
        }
        .btn-sub-tag {
            background: #000; border: 1px dashed #2A2A2A; color: #888; padding: 2px 8px;
            font-size: 0.72rem; font-weight: bold; cursor: pointer; white-space: nowrap; transition: all 0.1s;
        }
        .btn-sub-tag:hover, .btn-sub-tag.active { border-color: var(--holo-cyan); color: var(--holo-cyan); }

        /* Product grid — min 3 columns */
        .product-grid {
            flex: 1; overflow-y: auto; padding: 10px; display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 8px; align-content: flex-start;
        }
        .product-grid::-webkit-scrollbar { width: 4px; }
        .product-grid::-webkit-scrollbar-thumb { background: #222; }
        .product-grid.hidden { display: none; }

        .prod-card {
            background: #0A0A0A; border: 1px solid #1E1E1E; padding: 8px; cursor: pointer;
            position: relative; display: flex; flex-direction: column; height: 210px; transition: all 0.15s;
        }
        .prod-card:hover { border-color: var(--bio-emerald); box-shadow: 0 0 10px rgba(0,255,102,0.2); transform: translateY(-1px); }
        .prod-card.out-of-stock { opacity: 0.4; cursor: not-allowed; }
        .prod-stock-chip { position: absolute; top: 5px; right: 5px; font-size: 0.65rem; font-weight: bold; padding: 1px 5px; border: 1px solid var(--holo-cyan); color: var(--holo-cyan); background: #000; }
        .prod-stock-chip.low { border-color: var(--amber-warn); color: var(--amber-warn); }
        .prod-stock-chip.zero { border-color: var(--crimson-danger); color: var(--crimson-danger); }
        .prod-sku { font-size: 0.65rem; color: var(--holo-cyan); font-weight: bold; margin-top: 4px; }
        .prod-name { font-family: 'Rajdhani', sans-serif; font-size: 0.88rem; font-weight: 700; color: #DDD; flex: 1; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; margin-top: 4px; }
        .prod-price { font-family: var(--font-data); font-size: 1.2rem; color: var(--bio-emerald); font-weight: bold; padding-top: 5px; border-top: 1px solid #1A1A1A; }
        .prod-unit { font-size: 0.65rem; color: #666; }

        /* ======================================================
           EMBEDDED DASHBOARD PANEL (replaces product grid)
        ====================================================== */
        .dashboard-panel { flex: 1; overflow-y: auto; padding: 16px; background: #04060A; display: none; }
        .dashboard-panel.show { display: block; }
        .dash-filter-bar { display: flex; gap: 8px; margin-bottom: 16px; align-items: center; flex-wrap: wrap; background: #080C14; padding: 10px; border: 1px solid #1A2432; }
        .dash-filter-btn { background: transparent; border: 1px solid #333; color: #888; padding: 5px 12px; font-family: var(--font-mono); font-size: 0.75rem; cursor: pointer; transition: all 0.15s; }
        .dash-filter-btn.active { border-color: var(--holo-cyan); color: var(--holo-cyan); background: rgba(0,229,255,0.1); }
        .dash-kpi-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 16px; }
        .dash-kpi-card { background: #0A0E17; border: 1px solid #1C2838; padding: 14px; position: relative; overflow: hidden; border-left: 4px solid var(--holo-cyan); }
        .dash-kpi-title { font-family: var(--font-mono); font-size: 0.72rem; color: #8A9CAE; text-transform: uppercase; letter-spacing: 1px; }
        .dash-kpi-number { font-family: 'VT323', monospace; font-size: 2.2rem; color: #FFF; line-height: 1.1; margin: 6px 0 2px; }
        .dash-kpi-sub { font-size: 0.68rem; color: #556677; font-family: var(--font-mono); }
        .dash-chart-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin-bottom: 16px; }
        .dash-chart-box { background: #0A0E17; border: 1px solid #1C2838; padding: 14px; }
        .dash-chart-header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #1A222D; padding-bottom: 6px; margin-bottom: 10px; font-family: var(--font-hdr); font-size: 0.78rem; color: #FFF; }
        .dash-table-box { background: #0A0E17; border: 1px solid #1C2838; padding: 14px; margin-bottom: 12px; }
        .dash-table { width: 100%; border-collapse: collapse; font-size: 0.8rem; }
        .dash-table th { background: #0C1017; color: #A0B0C0; padding: 8px; font-size: 0.72rem; text-transform: uppercase; border-bottom: 1px solid #1C2633; font-family: var(--font-mono); }
        .dash-table td { padding: 8px; border-bottom: 1px solid #0E141E; }

        /* ======================================================
           EMBEDDED ORDERS TIMELINE FEED (replaces product grid)
        ====================================================== */
        .orders-feed-panel { flex: 1; overflow-y: auto; padding: 16px; background: #04060A; display: none; }
        .orders-feed-panel.show { display: block; }
        .feed-filter-bar { display: flex; gap: 8px; margin-bottom: 12px; align-items: center; flex-wrap: wrap; }
        .order-feed-card {
            background: #0A0E17; border: 1px solid #1C2838; padding: 14px; margin-bottom: 8px;
            cursor: pointer; transition: all 0.15s; position: relative;
        }
        .order-feed-card:hover { border-color: var(--holo-cyan); }
        .order-feed-card .feed-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
        .order-feed-card .feed-body { font-size: 0.82rem; color: #AAA; }
        .order-feed-card .feed-footer { display: flex; justify-content: space-between; align-items: center; margin-top: 8px; font-size: 0.75rem; color: #667; }
        .feed-status-pill { font-family: var(--font-mono); font-size: 0.68rem; padding: 2px 8px; border: 1px solid; }
        .feed-expand-area { display: none; margin-top: 10px; padding-top: 10px; border-top: 1px dashed #222; font-size: 0.8rem; }
        .feed-expand-area.show { display: block; }

        /* ======================================================
           SHIFT SLIDE DRAWER (from right)
        ====================================================== */
        .shift-drawer {
            position: fixed; top: 0; right: 0; width: 340px; height: 100vh;
            background: #07090D; border-left: 1px solid var(--holo-cyan); box-shadow: -4px 0 30px rgba(0,229,255,0.15);
            z-index: 300; transform: translateX(100%); transition: transform 0.25s ease; overflow-y: auto;
        }
        .shift-drawer.show { transform: translateX(0); }
        .shift-drawer-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 299; display: none; }
        .shift-drawer-overlay.show { display: block; }
        .drawer-header { padding: 14px 16px; border-bottom: 1px solid #1A222D; display: flex; justify-content: space-between; align-items: center; }
        .drawer-title { font-family: var(--font-hdr); font-size: 0.88rem; color: var(--holo-cyan); letter-spacing: 1px; }
        .drawer-close { background: transparent; border: 1px solid #333; color: #888; width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; cursor: pointer; font-size: 0.9rem; }
        .drawer-close:hover { border-color: var(--crimson-danger); color: var(--crimson-danger); }
        .drawer-body { padding: 16px; }
        .drawer-footer { padding: 12px 16px; border-top: 1px solid #1A222D; display: flex; gap: 8px; justify-content: flex-end; }
        .quick-amount-btn { background: #0A0E17; border: 1px solid #2A384A; color: #A0B0C0; padding: 6px 12px; font-family: var(--font-mono); font-size: 0.78rem; cursor: pointer; transition: all 0.15s; }
        .quick-amount-btn:hover { border-color: var(--bio-emerald); color: var(--bio-emerald); }
        .quick-amount-btn.active { border-color: var(--bio-emerald); color: var(--bio-emerald); background: rgba(0,255,102,0.1); }

        /* ======================================================
           CUSTOMER COMMAND PALETTE (Ctrl+K style)
        ====================================================== */
        .command-palette-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.7); z-index: 400; display: none; align-items: flex-start; justify-content: center; padding-top: 120px; }
        .command-palette-overlay.show { display: flex; }
        .command-palette {
            width: 500px; max-height: 500px; background: #0A0A0A; border: 1px solid var(--holo-cyan);
            box-shadow: 0 10px 60px rgba(0,229,255,0.2); overflow: hidden;
        }
        .palette-search-box { display: flex; align-items: center; border-bottom: 1px solid #1A1A1A; padding: 12px; }
        .palette-search-box i { color: var(--holo-cyan); margin-right: 10px; font-size: 1rem; }
        .palette-search-input { flex: 1; background: transparent; border: none; color: #EEE; font-family: var(--font-mono); font-size: 0.92rem; outline: none; }
        .palette-results { max-height: 350px; overflow-y: auto; }
        .palette-results::-webkit-scrollbar { width: 3px; }
        .palette-results::-webkit-scrollbar-thumb { background: #333; }
        .palette-result-item {
            padding: 10px 14px; border-bottom: 1px solid #111; cursor: pointer; transition: all 0.12s;
            display: flex; align-items: center; justify-content: space-between;
        }
        .palette-result-item:hover { background: rgba(0,229,255,0.06); }
        .palette-result-item.selected { background: rgba(0,255,102,0.06); border-left: 3px solid var(--bio-emerald); }
        .palette-result-info { display: flex; flex-direction: column; gap: 2px; }
        .palette-result-name { font-weight: 700; color: #DDD; font-size: 0.88rem; }
        .palette-result-meta { font-size: 0.72rem; color: #888; }
        .palette-result-badge { font-family: var(--font-mono); font-size: 0.72rem; color: var(--bio-emerald); }
        .palette-create-row { padding: 10px 14px; border-top: 1px solid #222; background: #050505; }
        .palette-create-btn { background: transparent; border: 1px dashed var(--bio-emerald); color: var(--bio-emerald); padding: 6px 14px; font-family: var(--font-mono); font-size: 0.78rem; cursor: pointer; width: 100%; transition: all 0.15s; }
        .palette-create-btn:hover { background: rgba(0,255,102,0.08); }
        .palette-inline-form { padding: 12px 14px; border-top: 1px solid #222; background: #080808; display: none; }
        .palette-inline-form.show { display: block; }
        .palette-form-input { width: 100%; background: #000; border: 1px solid #333; color: #EEE; padding: 6px 8px; font-family: var(--font-mono); font-size: 0.82rem; outline: none; margin-bottom: 6px; }
        .palette-form-input:focus { border-color: var(--holo-cyan); }
        .palette-form-actions { display: flex; gap: 6px; justify-content: flex-end; margin-top: 6px; }

        /* ======================================================
           PAYMENT SLIDE PANEL (full-height from right)
        ====================================================== */
        .payment-slide-panel {
            position: fixed; top: 0; right: 0; width: 420px; height: 100vh;
            background: #07090D; border-left: 1px solid var(--bio-emerald); box-shadow: -4px 0 30px rgba(0,255,102,0.15);
            z-index: 350; transform: translateX(100%); transition: transform 0.25s ease;
            display: flex; flex-direction: column; overflow: hidden;
        }
        .payment-slide-panel.show { transform: translateX(0); }
        .payment-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 349; display: none; }
        .payment-overlay.show { display: block; }
        .pay-panel-header { padding: 14px 16px; border-bottom: 1px solid var(--bio-emerald); display: flex; justify-content: space-between; align-items: center; flex-shrink: 0; }
        .pay-panel-body { flex: 1; overflow-y: auto; padding: 16px; }
        .pay-panel-footer { padding: 12px 16px; border-top: 1px solid #1A222D; flex-shrink: 0; }

        .pay-type-toggle { display: flex; gap: 4px; margin-bottom: 14px; }
        .pay-type-btn { flex: 1; padding: 8px; text-align: center; font-family: 'Rajdhani', sans-serif; font-weight: 700; font-size: 0.82rem; cursor: pointer; border: 1px solid #333; background: transparent; color: #888; transition: all 0.15s; }
        .pay-type-btn.active { border-color: var(--bio-emerald); color: var(--bio-emerald); background: rgba(0,255,102,0.06); }

        .pay-customer-section { margin-bottom: 14px; }
        .pay-section-title { font-family: var(--font-mono); font-size: 0.72rem; color: #667; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px; border-bottom: 1px dashed #222; padding-bottom: 4px; }
        .pay-input { width: 100%; background: #000; border: 1px solid #333; color: #EEE; padding: 6px 8px; font-family: var(--font-mono); font-size: 0.82rem; outline: none; margin-bottom: 6px; }
        .pay-input:focus { border-color: var(--holo-cyan); }

        .payment-method-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; margin-bottom: 14px; }
        .payment-method-btn {
            padding: 10px 6px; background: #000; border: 1px solid #222; color: #888;
            font-family: 'Rajdhani', sans-serif; font-weight: 700; font-size: 0.8rem; cursor: pointer;
            text-align: center; transition: all 0.15s; display: flex; flex-direction: column; align-items: center; gap: 4px;
        }
        .payment-method-btn:hover { border-color: var(--holo-cyan); color: var(--holo-cyan); }
        .payment-method-btn.selected { border-color: var(--bio-emerald); color: var(--bio-emerald); background: rgba(0,255,102,0.06); }
        .payment-method-btn i { font-size: 1.2rem; }
        .pay-other-dropdown { width: 100%; margin-bottom: 14px; }

        .pay-summary-row { display: flex; justify-content: space-between; padding: 3px 0; font-size: 0.82rem; }
        .pay-summary-row span:first-child { color: #666; }
        .pay-total-row { display: flex; justify-content: space-between; align-items: baseline; padding: 8px 0 0; border-top: 1px solid #1A1A1A; }
        .pay-total-label { font-family: var(--font-hdr); font-size: 0.78rem; color: #AAA; }
        .pay-total-val { font-family: var(--font-data); font-size: 2rem; color: var(--bio-emerald); }
        .change-highlight { font-family: var(--font-data); font-size: 1.5rem; color: var(--holo-cyan); font-weight: bold; }

        /* Receipt inline card */
        .receipt-card { display: none; }
        .receipt-card.show { display: block; }
        .receipt-success-icon { font-size: 2.5rem; color: var(--bio-emerald); text-align: center; margin: 12px 0; }

        /* Form controls */
        .pos-input, .pos-select { background: #000; border: 1px solid #333; color: #EEE; padding: 7px 10px; font-family: var(--font-mono); font-size: 0.85rem; width: 100%; outline: none; transition: border-color 0.15s; }
        .pos-input:focus, .pos-select:focus { border-color: var(--holo-cyan); }

        /* Modal buttons */
        .btn-pos-primary { background: var(--holo-cyan); border: 1px solid var(--holo-cyan); color: #000; padding: 8px 18px; font-family: var(--font-hdr); font-size: 0.78rem; font-weight: 700; cursor: pointer; letter-spacing: 1px; text-transform: uppercase; transition: all 0.15s; }
        .btn-pos-primary:hover { background: #000; color: var(--holo-cyan); }
        .btn-pos-primary:disabled { opacity: 0.4; cursor: not-allowed; }
        .btn-pos-success { background: var(--bio-emerald); border: 1px solid var(--bio-emerald); color: #000; padding: 8px 18px; font-family: var(--font-hdr); font-size: 0.78rem; font-weight: 700; cursor: pointer; letter-spacing: 1px; text-transform: uppercase; transition: all 0.15s; }
        .btn-pos-success:hover { background: #000; color: var(--bio-emerald); }
        .btn-pos-secondary { background: transparent; border: 1px solid #444; color: #888; padding: 8px 18px; font-family: 'Rajdhani', sans-serif; font-size: 0.78rem; font-weight: 700; cursor: pointer; transition: all 0.15s; }
        .btn-pos-secondary:hover { border-color: #888; color: #CCC; }

        /* ======================================================
           DRAFT QUEUE SIDEBAR (slide from right, narrow)
        ====================================================== */
        .draft-sidebar { position: fixed; top: 0; right: 0; width: 280px; height: 100vh; background: #07090D; border-left: 1px solid var(--amber-warn); box-shadow: -4px 0 20px rgba(255,176,0,0.15); z-index: 250; transform: translateX(100%); transition: transform 0.25s ease; overflow-y: auto; }
        .draft-sidebar.show { transform: translateX(0); }
        .draft-sidebar-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 249; display: none; }
        .draft-sidebar-overlay.show { display: block; }
        .draft-item { padding: 12px 14px; border-bottom: 1px solid #1A1A1A; cursor: pointer; transition: all 0.15s; }
        .draft-item:hover { background: rgba(255,176,0,0.06); }
        .draft-item-header { display: flex; justify-content: space-between; font-size: 0.82rem; margin-bottom: 4px; }
        .draft-item-meta { font-size: 0.72rem; color: #667; }

        /* ======================================================
           FOOTER TELEMETRY STRIP
        ====================================================== */
        .pos-footer {
            height: var(--footer-h) !important; background: var(--bg-surface) !important;
            border-top: 1px solid rgba(0, 229, 255, 0.4) !important;
            display: flex !important; align-items: center !important; justify-content: space-between !important;
            padding: 0 1.25rem !important; font-family: var(--font-mono) !important; font-size: 0.75rem !important;
            color: var(--primary-cyan) !important; flex-shrink: 0 !important; z-index: 100 !important;
        }
        .footer-left { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; color: var(--holo-cyan); }
        .footer-status { display: flex; align-items: center; gap: 4px; }
        .status-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--bio-emerald); box-shadow: 0 0 8px var(--bio-emerald); animation: posPingBlink 1.5s infinite alternate; }
        .status-dot.offline { background: var(--crimson-danger); box-shadow: 0 0 6px var(--crimson-danger); animation: none; }
        @@keyframes posPingBlink { 0% { opacity: 0.3; } 100% { opacity: 1; } }
        .ping-val { color: var(--holo-cyan); font-weight: bold; }
        .footer-meta { color: var(--holo-cyan); display: flex; align-items: center; gap: 4px; }
        .inline-footer-sel { background: #050505; border: 1px solid rgba(0,229,255,0.3); color: var(--holo-cyan); font-family: var(--font-mono); font-size: 0.73rem; outline: none; cursor: pointer; padding: 1px 6px; }
        .inline-footer-sel option { background: #0A0A0A; color: #EEE; }
        .footer-clock { color: #E0E0E0; font-family: var(--font-mono); font-size: 0.8rem; }

        /* Slide-out hamburger menu */
        .side-menu-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.7); z-index: 200; display: none; }
        .side-menu-overlay.show { display: block; }
        .side-menu { position: fixed; top: 0; left: 0; width: 240px; height: 100vh; background: #060606; border-right: 1px solid var(--holo-cyan); box-shadow: 4px 0 30px rgba(0,229,255,0.15); z-index: 201; transform: translateX(-100%); transition: transform 0.2s ease; overflow-y: auto; }
        .side-menu.show { transform: translateX(0); }
        .side-menu-header { padding: 14px 16px 10px; font-family: var(--font-hdr); font-size: 0.75rem; color: var(--holo-cyan); border-bottom: 1px solid #111; display: flex; align-items: center; gap: 8px; }
        .side-menu-item { display: flex; align-items: center; gap: 12px; padding: 11px 18px; color: #CCC; cursor: pointer; font-size: 0.88rem; border-left: 2px solid transparent; transition: all 0.15s; }
        .side-menu-item:hover { background: rgba(0,229,255,0.07); color: var(--holo-cyan); border-left-color: var(--holo-cyan); }
        .side-menu-item i { width: 18px; text-align: center; }
        .side-menu-divider { height: 1px; background: #111; margin: 6px 0; }
        .side-menu-section { padding: 8px 18px 4px; font-size: 0.65rem; color: #444; text-transform: uppercase; letter-spacing: 2px; }
    </style>
</head>
<body>

    <!-- ====================================================
         HEADER — Inline Counter/Warehouse selectors
    ==================================================== -->
    <header class="pos-header">
        <div class="header-left">
            <button class="btn-hamburger" id="btnHamburger" title="Operator Menu">
                <i class="fa-solid fa-bars"></i>
            </button>
            <a href="/Home/DashboardRouter" class="pos-brand text-decoration-none">
                @await Html.PartialAsync("~/Views/Shared/_NavbarBrand.cshtml")
            </a>
        </div>

        <!-- Terminal Status and Shift Indicator -->
        <div class="header-center">
            <div class="shift-status-badge" id="sidebarShiftStatus" style="border:1px solid rgba(0,229,255,0.4); background:#050F14; padding:4px 14px; border-radius:0;">
                <span class="shift-dot" id="shiftDot"></span>
                <span id="shiftStatusLabel" style="font-size:0.75rem; font-family:'Orbitron'; color:#00FF66; font-weight:700; text-transform:uppercase;">No Shift</span>
            </div>
        </div>

        <div class="header-right">
            <!-- Language Dropdown — synced with Admin -->
            <div class="dropdown d-inline-block">
                <button class="hud-lang-btn dropdown-toggle px-3" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Switch Language">
                    <i class="fa-solid fa-globe me-1" style="font-size:1.0rem; color:#00E5FF;"></i>
                    <span id="langShortCode" style="font-family:'VT323'; font-size:1.1rem; font-weight:bold;">VI</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end hud-dropdown-menu">
                    <li><h6 class="dropdown-header" style="color:#00E5FF; font-family:'Orbitron';">LOCALIZATION</h6></li>
                    <li><a class="dropdown-item" href="javascript:switchLanguage('VI')"><i class="fa-solid fa-check text-success me-2" id="iconVI"></i> Tiếng Việt [ VI ]</a></li>
                    <li><a class="dropdown-item" href="javascript:switchLanguage('EN')"><i class="fa-solid fa-minus text-muted me-2" id="iconEN"></i> English [ EN ]</a></li>
                </ul>
            </div>

            <!-- Dark/Light Toggle — synced with Admin -->
            <button type="button" class="hud-nav-icon-btn px-3" id="themeToggleBtn" title="Toggle Theme">
                <i class="fa-solid fa-sun" id="themeIcon" style="font-size:1.0rem; color:#FFB000;"></i>
            </button>

            <!-- Notification Dropdown — synced with Admin -->
            <div class="dropdown hud-notif-wrapper position-relative d-inline-block me-3">
                <button class="hud-notif-btn px-3" type="button" id="notifDropdown" data-bs-toggle="dropdown" aria-expanded="false" title="Notifications">
                    <i class="fa-solid fa-bell" style="font-size:1.0rem; color:#FFFFFF;"></i>
                </button>
                <span class="hud-notif-badge" id="hudNotifBadge">0</span>
                <ul class="dropdown-menu dropdown-menu-end hud-dropdown-menu" aria-labelledby="notifDropdown" id="hudNotifMenu">
                    <li><h6 class="dropdown-header" style="color:#00E5FF; font-family:'Orbitron';">NOTIFICATIONS</h6></li>
                    <li><span class="dropdown-item" style="color:#555;">No notifications</span></li>
                </ul>
            </div>

            <!-- Profile Dropdown -->
            @{
                string? userAvatar = User.FindFirst("AvatarUrl")?.Value;
            }
            <div class="dropdown">
                <div class="hud-profile-trigger" id="profileDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    <div class="hud-avatar-box" style="overflow:hidden; padding:0;">
                        @if (!string.IsNullOrEmpty(userAvatar))
                        {
                            <img src="~/uploads/avatars/@userAvatar" alt="Avatar" style="width:100%; height:100%; object-fit:cover;" />
                        }
                        else
                        {
                            <span>@(User.Identity?.Name != null && User.Identity.Name.Length >= 2 ? User.Identity.Name.Substring(0, 2).ToUpper() : "OP")</span>
                        }
                    </div>
                    <div class="hud-user-info">
                        <span class="hud-user-name">@(User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "OPERATOR")</span>
                        <span class="hud-user-role">@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "CASHIER")</span>
                    </div>
                    <i class="fa-solid fa-caret-down ms-2" style="font-size:0.75rem; color:var(--holo-cyan);"></i>
                </div>
                <ul class="dropdown-menu dropdown-menu-end hud-dropdown-menu">
                    <li><a class="dropdown-item" href="/Home/DashboardRouter"><i class="fa-solid fa-user-shield me-2" style="color:#FFB000;"></i> Admin Portal</a></li>
                    <li><a class="dropdown-item" href="/Auth/Logout"><i class="fa-solid fa-right-from-bracket me-2" style="color:var(--crimson-danger);"></i> Logout</a></li>
                </ul>
            </div>
        </div>
    </header>

    <!-- Inline setup warning banner -->
    <div class="setup-warning-banner" id="setupWarningBanner">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <span>Please select your active <strong>Counter</strong> and <strong>Warehouse</strong> in the telemetry footer below to begin operations.</span>
    </div>

    <!-- ====================================================
         WORKSPACE: SIDEBAR + REGISTER + CATALOG
    ==================================================== -->
    <div class="pos-workspace">
        <!-- LEFT SIDEBAR: Operator Menu -->
        <nav class="pos-operator-menu" id="posOperatorMenu">
            <div class="op-menu-header"><i class="fa-solid fa-satellite-dish"></i> OPERATIONS</div>
            <div class="op-menu-item active" onclick="showCatalogView()"><i class="fa-solid fa-grip"></i><span>POS TERMINAL</span></div>
            <div class="op-menu-item" onclick="showDashboardView()"><i class="fa-solid fa-chart-pie"></i><span>Analytics</span></div>
            <div class="op-menu-item" onclick="showOrdersFeedView()"><i class="fa-solid fa-receipt"></i><span>Orders Today</span></div>
            <div class="op-menu-divider"></div>
            <div class="op-menu-section">Shift Control</div>
            <div class="op-menu-item" id="opMenuStartShift" onclick="openStartShiftDrawer()"><i class="fa-solid fa-play" style="color:var(--bio-emerald);"></i><span>Start Shift</span></div>
            <div class="op-menu-item" id="opMenuCloseShift" style="display:none;" onclick="openCloseShiftDrawer()"><i class="fa-solid fa-stop" style="color:var(--crimson-danger);"></i><span>Close Shift</span></div>
        </nav>

        <!-- CATALOG AREA (switchable views - Center Workspace) -->
        <main class="pos-catalog">
            <!-- Search & filter toolbar -->
            <div class="catalog-toolbar">
                <div class="search-row">
                    <input type="text" class="pos-search-input" id="posSearchInput" placeholder="Search product by name, SKU, barcode... [F1]" />
                    <button class="btn-search" onclick="executeSearch()"><i class="fa-solid fa-search me-1"></i>SEARCH</button>
                </div>
                <div class="filter-tags-row">
                    <button class="btn-filter active" onclick="setPrimaryFilter('all', this)">ALL</button>
                    <button class="btn-filter" onclick="setPrimaryFilter('category', this)">CATEGORY</button>
                    <button class="btn-filter" onclick="setPrimaryFilter('manufacturer', this)">BRAND</button>
                    <button class="btn-filter" onclick="setPrimaryFilter('unit', this)">UNIT</button>
                </div>
            </div>
            <div class="sub-filter-strip" id="subFilterStrip">
                <span style="color:#333; font-size:0.7rem;">Showing all products</span>
            </div>

            <!-- Product Grid (default view) -->
            <div class="product-grid" id="productGrid">
                <div style="grid-column:1/-1; text-align:center; padding:40px; color:#333;">
                    <i class="fa-solid fa-spinner fa-spin fa-2x" style="color:var(--holo-cyan);"></i>
                    <div style="margin-top:8px; font-size:0.78rem;">Loading catalog...</div>
                </div>
            </div>

            <!-- Dashboard Panel (embedded, replaces grid) -->
            <div class="dashboard-panel" id="dashboardPanel">
                <div class="dash-filter-bar">
                    <button class="dash-filter-btn active" id="btnDashToday" onclick="loadDashboardRange(0)">TODAY</button>
                    <button class="dash-filter-btn" id="btnDash7D" onclick="loadDashboardRange(7)">7 DAYS</button>
                    <button class="dash-filter-btn" id="btnDash30D" onclick="loadDashboardRange(30)">30 DAYS</button>
                    <div style="display:flex; align-items:center; gap:6px; margin-left:auto;">
                        <input type="date" id="dashFromDate" class="pay-input" style="width:130px; padding:4px 6px; font-size:0.75rem;" />
                        <span style="color:#555;">→</span>
                        <input type="date" id="dashToDate" class="pay-input" style="width:130px; padding:4px 6px; font-size:0.75rem;" />
                        <button class="btn-pos-primary" style="padding:4px 10px; font-size:0.72rem;" onclick="loadDashboardCustomRange()"><i class="fa-solid fa-filter me-1"></i>FILTER</button>
                    </div>
                    <span style="font-family:var(--font-mono); font-size:0.75rem; color:var(--holo-cyan);" id="dashDateRangeLabel">--</span>
                </div>

                <!-- KPI Widgets -->
                <div class="dash-kpi-grid">
                    <div class="dash-kpi-card" style="border-left-color:var(--holo-cyan);"><div class="dash-kpi-title">TOTAL REVENUE</div><div class="dash-kpi-number" id="kpiRevenue" style="color:var(--holo-cyan);">0</div><div class="dash-kpi-sub">VND (net)</div></div>
                    <div class="dash-kpi-card" style="border-left-color:var(--bio-emerald);"><div class="dash-kpi-title">TOTAL ORDERS</div><div class="dash-kpi-number" id="kpiOrders" style="color:var(--bio-emerald);">0</div><div class="dash-kpi-sub">Settled tickets</div></div>
                    <div class="dash-kpi-card" style="border-left-color:var(--amber-warn);"><div class="dash-kpi-title">AVG ORDER VALUE</div><div class="dash-kpi-number" id="kpiAvg" style="color:var(--amber-warn);">0</div><div class="dash-kpi-sub">Per transaction</div></div>
                    <div class="dash-kpi-card" style="border-left-color:#0088FF;"><div class="dash-kpi-title">TOTAL PRODUCTS</div><div class="dash-kpi-number" id="kpiProducts" style="color:#0088FF;">0</div><div class="dash-kpi-sub">Active SKUs</div></div>
                </div>

                <!-- Charts Grid -->
                <div class="dash-chart-grid">
                    <div class="dash-chart-box"><div class="dash-chart-header"><span><i class="fa-solid fa-chart-column me-2 text-info"></i>Products Sold by Qty</span></div><div style="height:220px;"><canvas id="chartProductQty"></canvas></div></div>
                    <div class="dash-chart-box"><div class="dash-chart-header"><span><i class="fa-solid fa-chart-pie me-2" style="color:var(--amber-warn);"></i>Payment Methods</span></div><div style="height:220px;"><canvas id="chartPayment"></canvas></div></div>
                    <div class="dash-chart-box"><div class="dash-chart-header"><span><i class="fa-solid fa-chart-line me-2" style="color:var(--bio-emerald);"></i>Revenue Trend</span></div><div style="height:220px;"><canvas id="chartRevenue"></canvas></div></div>
                    <div class="dash-chart-box"><div class="dash-chart-header"><span><i class="fa-solid fa-chart-bar me-2" style="color:var(--crimson-danger);"></i>Top Selling Products</span></div><div style="height:220px;"><canvas id="chartTopProducts"></canvas></div></div>
                </div>

                <!-- Top Customers Table -->
                <div class="dash-table-box">
                    <div class="dash-chart-header" style="border-bottom:1px solid #1A222D; padding-bottom:6px; margin-bottom:10px;"><span><i class="fa-solid fa-users me-2" style="color:var(--bio-emerald);"></i>Top Customers by Revenue</span></div>
                    <table class="dash-table"><thead><tr><th>#</th><th>Customer</th><th style="text-align:right;">Orders</th><th style="text-align:right;">Revenue (₫)</th></tr></thead><tbody id="topCustomersBody"><tr><td colspan="4" style="text-align:center; color:#555; padding:20px;">Loading...</td></tr></tbody></table>
                </div>

                <!-- Top Orders Table -->
                <div class="dash-table-box">
                    <div class="dash-chart-header" style="border-bottom:1px solid #1A222D; padding-bottom:6px; margin-bottom:10px;"><span><i class="fa-solid fa-trophy me-2" style="color:var(--amber-warn);"></i>Top Orders by Revenue</span></div>
                    <table class="dash-table"><thead><tr><th>#</th><th>Invoice</th><th>Time</th><th style="text-align:right;">Amount (₫)</th></tr></thead><tbody id="topOrdersBody"><tr><td colspan="4" style="text-align:center; color:#555; padding:20px;">Loading...</td></tr></tbody></table>
                </div>
            </div>

            <!-- Orders Feed Panel (embedded, replaces grid) -->
            <div class="orders-feed-panel" id="ordersFeedPanel">
                <div class="feed-filter-bar">
                    <input type="text" class="pos-search-input" id="feedSearchInput" placeholder="Search invoice #..." style="max-width:250px; border-right:1px solid #333;" oninput="loadOrdersFeed()" />
                    <button class="btn-pos-primary" style="padding:6px 14px; font-size:0.75rem;" onclick="loadOrdersFeed(true)"><i class="fa-solid fa-rotate-right me-1"></i>REFRESH</button>
                    <span style="margin-left:auto; font-family:var(--font-mono); font-size:0.78rem; color:#667;" id="feedSummary">--</span>
                </div>
                <div id="ordersFeedContainer">
                    <div style="text-align:center; padding:40px; color:#555;"><i class="fa-solid fa-spinner fa-spin me-2"></i>Loading orders...</div>
                </div>
            </div>
        </main>

        <!-- REGISTER PANEL — Single active order (Right Sidebar) -->
        <section class="pos-register" id="posRegisterPanel">
            <div class="register-header-strip">
                <div class="register-order-info">
                    <span class="order-no-chip">Order <span id="lblOrderNo">---</span></span>
                    <span style="font-size:0.72rem; color:#555;" id="lblTotalItemsCount">0</span>
                    <span style="font-size:0.65rem; color:#444;">items</span>
                </div>
                <button class="draft-queue-btn" onclick="toggleDraftSidebar()" title="Held / Draft Orders">
                    <i class="fa-solid fa-layer-group me-1"></i>DRAFTS
                    <span class="draft-count-badge" id="draftQueueCount">0</span>
                </button>
            </div>

            <div class="register-customer-row">
                <div class="customer-info">
                    <i class="fa-solid fa-user" style="color:#333;"></i>
                    <span class="customer-name" id="lblCustomer">WALK-IN CUSTOMER</span>
                </div>
                <button class="btn-select-customer" onclick="openCustomerPalette()">
                    <i class="fa-solid fa-search me-1"></i>SELECT
                </button>
            </div>

            <!-- Shipping toggle (replaces tab) -->
            <div class="shipping-toggle">
                <div class="toggle-switch" id="shippingToggle" onclick="toggleShipping()"></div>
                <span>Shipping Order</span>
            </div>

            <div class="register-items">
                <table class="order-table">
                    <thead>
                        <tr>
                            <th>SKU</th>
                            <th>Item</th>
                            <th style="text-align:center;">Qty</th>
                            <th style="text-align:right;">Total</th>
                            <th style="width:50px; text-align:center;"></th>
                        </tr>
                    </thead>
                    <tbody id="orderTableBody">
                        <tr>
                            <td colspan="5" style="text-align:center; padding:35px; color:#444; background:rgba(0,0,0,0.3);">
                                <i class="fa-solid fa-barcode fa-3x mb-2" style="color:#222; display:block;"></i>
                                <span style="font-family:var(--font-mono); font-size:0.85rem;">[SCAN OR SELECT PRODUCT]</span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="billing-strip">
                <div class="billing-row"><span>Gross Amount:</span><span id="txtGross">0 ₫</span></div>
                <div class="billing-row"><span>VAT Tax:</span><span id="txtVat">0 ₫</span></div>
                <div class="billing-row"><span>Discount:</span><span id="txtDiscount">0 ₫</span></div>
                <div class="billing-total-row">
                    <span class="total-label">Total</span>
                    <div class="d-flex align-items-baseline gap-1">
                        <span class="total-amount" id="txtTotal">0</span>
                        <span style="font-size:0.85rem; color:#888; font-family:var(--font-mono);">₫</span>
                    </div>
                </div>
            </div>

            <div class="register-actions">
                <button class="btn-action btn-hold" onclick="holdCurrentOrder()"><i class="fa-solid fa-pause"></i> HOLD</button>
                <button class="btn-action btn-clear" onclick="clearCurrentOrder()"><i class="fa-solid fa-trash-can"></i> CLEAR</button>
                <button class="btn-action btn-payment" id="btnPayment" onclick="openPaymentPanel()" disabled>
                    <i class="fa-solid fa-bolt"></i> PAYMENT [F12]
                </button>
            </div>
        </section>
    </div>

    <!-- ====================================================
         SHIFT SLIDE DRAWER (from right)
    ==================================================== -->
    <div class="shift-drawer-overlay" id="shiftDrawerOverlay" onclick="closeShiftDrawer()"></div>
    <aside class="shift-drawer" id="shiftDrawer">
        <div class="drawer-header">
            <span class="drawer-title" id="shiftDrawerTitle"><i class="fa-solid fa-play me-2"></i>START SHIFT</span>
            <button class="drawer-close" onclick="closeShiftDrawer()"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <div class="drawer-body" id="shiftDrawerBody">
            <!-- Dynamically populated -->
        </div>
        <div class="drawer-footer" id="shiftDrawerFooter">
            <!-- Dynamically populated -->
        </div>
    </aside>

    <!-- ====================================================
         CUSTOMER COMMAND PALETTE (Ctrl+K floating search)
    ==================================================== -->
    <div class="command-palette-overlay" id="customerPaletteOverlay" onclick="closeCustomerPalette()">
        <div class="command-palette" onclick="event.stopPropagation()">
            <div class="palette-search-box">
                <i class="fa-solid fa-search"></i>
                <input type="text" class="palette-search-input" id="paletteSearchInput" placeholder="Search customer by name, phone, ID..." oninput="filterPaletteResults()" />
            </div>
            <div class="palette-results" id="paletteResults"></div>
            <div class="palette-create-row">
                <button class="palette-create-btn" onclick="togglePaletteCreateForm()"><i class="fa-solid fa-user-plus me-1"></i> Create New Customer</button>
            </div>
            <div class="palette-inline-form" id="paletteCreateForm">
                <input type="text" class="palette-form-input" id="newCustName" placeholder="Full Name *" />
                <input type="text" class="palette-form-input" id="newCustPhone" placeholder="Phone Number" />
                <input type="email" class="palette-form-input" id="newCustEmail" placeholder="Email" />
                <input type="text" class="palette-form-input" id="newCustAddress" placeholder="Address" />
                <div class="palette-form-actions">
                    <button class="btn-pos-secondary" style="padding:4px 12px; font-size:0.75rem;" onclick="togglePaletteCreateForm()">CANCEL</button>
                    <button class="btn-pos-success" style="padding:4px 12px; font-size:0.75rem;" onclick="savePaletteCustomer()"><i class="fa-solid fa-floppy-disk me-1"></i>SAVE</button>
                </div>
            </div>
        </div>
    </div>

    <!-- ====================================================
         PAYMENT SLIDE PANEL (full-height from right)
    ==================================================== -->
    <div class="payment-overlay" id="paymentOverlay" onclick="closePaymentPanel()"></div>
    <aside class="payment-slide-panel" id="paymentPanel">
        <div class="pay-panel-header">
            <span style="font-family:var(--font-hdr); font-size:0.88rem; color:var(--bio-emerald); letter-spacing:1px;"><i class="fa-solid fa-bolt me-2"></i>PAYMENT</span>
            <button class="drawer-close" onclick="closePaymentPanel()"><i class="fa-solid fa-xmark"></i></button>
        </div>

        <!-- Payment Form View -->
        <div class="pay-panel-body" id="payFormView">
            <!-- Transaction Type -->
            <div class="pay-type-toggle">
                <button class="pay-type-btn active" id="btnPayRetail" onclick="togglePayType('retail')">B2C RETAIL</button>
                <button class="pay-type-btn" id="btnPayB2B" onclick="togglePayType('b2b')">B2B INVOICE</button>
            </div>

            <!-- Customer Info Section (B2C & Walk-in Auto Create) -->
            <div class="pay-customer-section" id="payB2CSection">
                <div class="pay-section-title" style="display:flex; justify-content:space-between; align-items:center;">
                    <span>Customer Details / Auto-Create</span>
                    <span style="font-size:0.65rem; color:#666; font-weight:normal;">(Input to auto-register)</span>
                </div>
                <div id="payCustomerDisplay" style="font-size:0.85rem; color:var(--holo-cyan); margin-bottom:8px;"><i class="fa-solid fa-user me-1"></i> <span id="payCustomerName">Walk-in Customer</span></div>
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:6px;">
                    <input type="text" class="pay-input" id="payWalkinPhone" placeholder="SĐT (Phone)..." />
                    <input type="text" class="pay-input" id="payWalkinName" placeholder="Tên (Full Name)..." />
                    <input type="text" class="pay-input" id="payWalkinCccd" placeholder="CCCD / ID No..." />
                    <input type="text" class="pay-input" id="payWalkinTax" placeholder="Mã số thuế (Tax Code)..." />
                </div>
                <input type="text" class="pay-input" id="payWalkinAddress" placeholder="Địa chỉ (Address)..." style="margin-top:6px; width:100%;" />
            </div>

            <!-- B2B Section (hidden by default) -->
            <div class="pay-customer-section" id="payB2BSection" style="display:none;">
                <div class="pay-section-title">B2B Invoice Details <span style="color:var(--crimson-danger);">*</span></div>
                <div id="b2bComplianceWarn" style="background:rgba(255,51,51,0.08); border:1px solid var(--crimson-danger); padding:8px; margin-bottom:8px; font-size:0.72rem; color:#FF8888; display:none;">
                    <i class="fa-solid fa-triangle-exclamation me-1"></i> B2B requires VIP customer + Tax Code + Company Name
                </div>
                <input type="text" class="pay-input" id="payCompanyName" placeholder="Company Name *" oninput="validatePaymentState()" />
                <input type="text" class="pay-input" id="payTaxCode" placeholder="Tax Code (MST) *" oninput="validatePaymentState()" />
                <input type="text" class="pay-input" id="payBudgetCode" placeholder="Budget Code" />
                <input type="text" class="pay-input" id="payIdNo" placeholder="ID Number" />
                <input type="text" class="pay-input" id="payBankName" placeholder="Bank Name" />
                <input type="text" class="pay-input" id="payBankAccount" placeholder="Bank Account" />
            </div>

            <!-- Payment Methods -->
            <div class="pay-section-title">Payment Method</div>
            <div class="payment-method-grid" id="paymentMethodGrid"></div>
            <select class="pos-select pay-other-dropdown" id="payOtherMethodSel" style="display:none;" onchange="selectOtherPayMethod(this)">
                <option value="">-- Other Methods --</option>
            </select>

            <!-- Order Summary -->
            <div style="margin-top:14px; border-top:1px solid #222; padding-top:10px;">
                <div class="pay-section-title">Order Summary</div>
                <div class="pay-summary-row"><span>Subtotal:</span><span id="paySub">0 ₫</span></div>
                <div class="pay-summary-row"><span>VAT Tax:</span><span id="payVat">0 ₫</span></div>
                <div class="pay-summary-row"><span>Discount:</span><span id="payDiscount">0 ₫</span></div>
                <div class="pay-total-row">
                    <span class="pay-total-label">TOTAL</span>
                    <div class="d-flex align-items-baseline gap-1">
                        <span class="pay-total-val" id="payTotal">0</span>
                        <span style="color:#888; font-size:0.85rem;">₫</span>
                    </div>
                </div>
            </div>

            <!-- Tendered & Change -->
            <div style="margin-top:14px;">
                <div class="pay-section-title">Amount Received</div>
                <input type="number" class="pos-input" id="tenderedInput" placeholder="Enter amount..." oninput="calcChange()" style="font-size:1.2rem; font-weight:700; text-align:right; color:var(--bio-emerald);" />
                <div style="display:flex; justify-content:space-between; align-items:baseline; margin-top:8px;">
                    <span style="font-size:0.78rem; color:#666;">Change:</span>
                    <div class="d-flex align-items-baseline gap-1">
                        <span class="change-highlight" id="changeDisplay">0</span>
                        <span style="color:#888; font-size:0.78rem;">₫</span>
                    </div>
                </div>
            </div>

            <!-- Notes -->
            <div style="margin-top:14px;">
                <div class="pay-section-title">Order Notes</div>
                <textarea class="pos-input" id="payNotes" rows="2" placeholder="Optional notes..." style="resize:none;"></textarea>
            </div>
        </div>

        <!-- Receipt Card View (shown after payment success) -->
        <div class="pay-panel-body receipt-card" id="receiptCardView">
            <div class="receipt-success-icon"><i class="fa-solid fa-circle-check"></i></div>
            <div style="text-align:center; margin-bottom:14px;">
                <div style="font-family:var(--font-hdr); font-size:1rem; color:var(--holo-cyan); letter-spacing:1px;" id="receiptDocNo">--</div>
                <div style="font-family:var(--font-data); font-size:2rem; color:var(--bio-emerald); margin-top:4px;" id="receiptTotal">0 ₫</div>
                <div style="font-size:0.78rem; color:#666; margin-top:4px;" id="receiptTime">--</div>
            </div>
            <div style="border-top:1px dashed #333; padding-top:10px;">
                <div class="pay-summary-row"><span>Payment:</span><span id="receiptMethod">--</span></div>
                <div class="pay-summary-row"><span>Change:</span><span id="receiptChange">0 ₫</span></div>
                <div class="pay-summary-row"><span>Customer:</span><span id="receiptCustomer">Walk-in</span></div>
                <div class="pay-summary-row"><span>Cashier:</span><span>@(User.FindFirst("FullName")?.Value ?? "Operator")</span></div>
            </div>
            <div style="border-top:1px dashed #333; padding-top:10px; margin-top:10px;">
                <div class="pay-section-title">Items</div>
                <table class="dash-table" style="font-size:0.75rem;"><thead><tr><th>Item</th><th style="text-align:center;">Qty</th><th style="text-align:right;">Amount</th></tr></thead><tbody id="receiptItemsBody"></tbody></table>
            </div>
        </div>

        <div class="pay-panel-footer" id="payFormFooter">
            <button class="btn-pos-secondary" onclick="closePaymentPanel()"><i class="fa-solid fa-arrow-left me-1"></i>BACK</button>
            <button class="btn-pos-success" id="btnConfirmPayment" onclick="confirmPayment()" disabled style="padding:10px 22px; font-size:0.95rem;">
                <i class="fa-solid fa-bolt me-1"></i>CONFIRM PAYMENT
            </button>
        </div>
        <div class="pay-panel-footer" id="receiptFooter" style="display:none;">
            <button class="btn-pos-secondary" onclick="viewInvoice()"><i class="fa-solid fa-eye me-1"></i>VIEW</button>
            <button class="btn-pos-secondary" onclick="printInvoice()"><i class="fa-solid fa-print me-1"></i>PRINT</button>
            <button class="btn-pos-success" onclick="closePaymentAndReset()"><i class="fa-solid fa-plus me-1"></i>NEW ORDER</button>
        </div>
    </aside>

    <!-- ====================================================
         DRAFT QUEUE SIDEBAR
    ==================================================== -->
    <div class="draft-sidebar-overlay" id="draftSidebarOverlay" onclick="closeDraftSidebar()"></div>
    <aside class="draft-sidebar" id="draftSidebar">
        <div class="drawer-header" style="border-color:var(--amber-warn);">
            <span class="drawer-title" style="color:var(--amber-warn);"><i class="fa-solid fa-layer-group me-2"></i>HELD ORDERS</span>
            <button class="drawer-close" onclick="closeDraftSidebar()"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <div id="draftListContainer" style="padding:8px;">
            <div style="text-align:center; padding:30px; color:#555; font-size:0.82rem;">No held orders</div>
        </div>
    </aside>

    <!-- ====================================================
         SLIDE-OUT HAMBURGER MENU
    ==================================================== -->
    <div class="side-menu-overlay" id="sideMenuOverlay" onclick="closeSideMenu()"></div>
    <div class="side-menu" id="sideMenu">
        <div class="side-menu-header"><i class="fa-solid fa-terminal me-2"></i> TERMINAL MENU</div>
        <div class="side-menu-item" onclick="showCatalogView(); closeSideMenu();"><i class="fa-solid fa-grip"></i><span>Product Catalog</span></div>
        <div class="side-menu-item" onclick="showDashboardView(); closeSideMenu();"><i class="fa-solid fa-chart-pie"></i><span>Analytics Dashboard</span></div>
        <div class="side-menu-item" onclick="showOrdersFeedView(); closeSideMenu();"><i class="fa-solid fa-receipt"></i><span>Orders Today</span></div>
        <div class="side-menu-divider"></div>
        <div class="side-menu-section">Shift</div>
        <div class="side-menu-item" onclick="openStartShiftDrawer(); closeSideMenu();"><i class="fa-solid fa-play" style="color:var(--bio-emerald);"></i><span>Start Shift</span></div>
        <div class="side-menu-item" onclick="openCloseShiftDrawer(); closeSideMenu();"><i class="fa-solid fa-stop" style="color:var(--crimson-danger);"></i><span>Close Shift</span></div>
        <div class="side-menu-divider"></div>
        <div class="side-menu-item" onclick="openCustomerPalette(); closeSideMenu();"><i class="fa-solid fa-user-group"></i><span>Customer Search</span></div>
        <div class="side-menu-divider"></div>
        <a class="side-menu-item" href="/Home/DashboardRouter"><i class="fa-solid fa-user-shield"></i><span>Admin Portal</span></a>
        <a class="side-menu-item" href="/Auth/Logout"><i class="fa-solid fa-right-from-bracket" style="color:var(--crimson-danger);"></i><span>Logout</span></a>
    </div>

    <!-- ====================================================
         FOOTER TELEMETRY STRIP & CONTEXT SELECTORS
    ==================================================== -->
    <footer class="pos-footer">
        <div class="footer-left">
            <div class="footer-status">
                <span class="status-dot" id="statusDot"></span>
                <span id="statusLabel" style="color:var(--bio-emerald);">ONLINE</span>
            </div>
            <span>RTT: <span class="ping-val" id="footerPing">--</span></span>
            <span style="color:#333;">|</span>
            @if (ViewBag.IsSuperAdmin == true)
            {
                <span class="footer-meta">
                    <i class="fa-solid fa-building me-1"></i>
                    <select id="adminTenantSelect" class="inline-footer-sel" onchange="onAdminTenantSwitch(this)">
                        @foreach (var t in (IEnumerable<DigiPOSE.Models.Tenant>)ViewBag.AllTenants)
                        {
                            if (t.TenantId == (int)ViewBag.AuthorizedTenantId)
                            {
                                <option value="@t.TenantId" selected>@t.TenantName</option>
                            }
                            else
                            {
                                <option value="@t.TenantId">@t.TenantName</option>
                            }
                        }
                    </select>
                    <span id="footerTenant" style="display:none;">--</span>
                </span>
            }
            else
            {
                <span class="footer-meta"><i class="fa-solid fa-building me-1"></i><span id="footerTenant">--</span></span>
            }
            <span style="color:#333;">|</span>
            <span class="footer-meta">
                <i class="fa-solid fa-desktop me-1"></i>
                <select id="headerCounterSel" class="inline-footer-sel" onchange="onHeaderCounterChange(this)">
                    <option value="">-- Counter --</option>
                </select>
                <span id="footerCounter" style="display:none;">--</span>
            </span>
            <span style="color:#333;">|</span>
            <span class="footer-meta">
                <i class="fa-solid fa-warehouse me-1"></i>
                <select id="headerWarehouseSel" class="inline-footer-sel" onchange="onHeaderWarehouseChange(this)">
                    <option value="">-- Warehouse --</option>
                </select>
                <span id="footerWarehouse" style="display:none;">--</span>
            </span>
            <span style="color:#333;">|</span>
            <span class="footer-meta"><i class="fa-solid fa-key me-1"></i>Shift <span id="footerShift">--</span></span>
        </div>
        <span class="footer-clock" id="footerClock">--</span>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // ===================================================
        // POS STATE
        // ===================================================
        const POS_STATE = {
            tenantId: @(ViewBag.AuthorizedTenantId ?? 0),
            tenantName: '@(ViewBag.AuthorizedTenantName?.ToString()?.Replace("'", "\\'") ?? "N/A")',
            counterId: null, counterName: '',
            warehouseId: null, warehouseName: '',
            shiftId: null, shiftStartTime: null, isStaleShift: false,
            userId: @(User.FindFirst("UserId")?.Value ?? User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "1"),
            currentOrder: { orderId: null, items: [], customerId: null, customerName: 'Walk-in Customer', orderType: 'retail', isShipping: false },
            draftQueue: [],
            activeView: 'catalog'
        };

        let catalogMeta = { categories: [], manufacturers: [], productTypes: [], units: [], customers: [] };
        let selectedPaymentMethodId = null;
        let lastCheckoutData = null;
        let paymentMethods = [];

        // ===================================================
        // INLINE HEADER SETUP — Load counters/warehouses on boot
        // ===================================================
        async function loadHeaderSelectors() {
            const bId = POS_STATE.tenantId;
            if (!bId || bId <= 0) return;
            const cSel = document.getElementById('headerCounterSel');
            const wSel = document.getElementById('headerWarehouseSel');

            // Load counters
            try {
                const cRes = await fetch(`/api/v1/POS/setup/tenants/${bId}/counters`);
                if (cRes.ok) {
                    const counters = await cRes.json();
                    cSel.innerHTML = '<option value="">-- Select Counter --</option>';
                    counters.forEach(c => {
                        const cid = c.counterId || c.CounterId;
                        const cname = c.counterName || c.CounterName || `Counter #${cid}`;
                        const opt = document.createElement('option');
                        opt.value = cid; opt.setAttribute('data-name', cname);
                        opt.textContent = cname;
                        cSel.appendChild(opt);
                    });
                }
            } catch (err) { console.error('>>> [COUNTER_LOAD_FAULT]:', err); }

            // Load warehouses
            try {
                const wRes = await fetch(`/api/v1/POS/setup/tenants/${bId}/warehouses`);
                if (wRes.ok) {
                    const warehouses = await wRes.json();
                    wSel.innerHTML = '<option value="">-- Select Warehouse --</option>';
                    warehouses.forEach(w => {
                        const wid = w.warehouseId || w.WarehouseId || bId;
                        const wname = w.warehouseName || w.WarehouseName || `Warehouse #${wid}`;
                        const opt = document.createElement('option');
                        opt.value = wid; opt.setAttribute('data-name', wname);
                        opt.textContent = wname;
                        wSel.appendChild(opt);
                    });
                }
            } catch (err) { console.error('>>> [WAREHOUSE_LOAD_FAULT]:', err); }

            // Restore from localStorage
            const saved = localStorage.getItem('posCounter');
            if (saved) {
                try {
                    const s = JSON.parse(saved);
                    if (s.counterId && s.tenantId === POS_STATE.tenantId) {
                        cSel.value = s.counterId;
                        POS_STATE.counterId = s.counterId;
                        POS_STATE.counterName = s.counterName || '';
                    }
                    if (s.warehouseId) {
                        wSel.value = s.warehouseId;
                        POS_STATE.warehouseId = s.warehouseId;
                        POS_STATE.warehouseName = s.warehouseName || '';
                    }
                } catch(e) {}
            }
            checkSetupReady();
        }

        function onHeaderCounterChange(sel) {
            POS_STATE.counterId = parseInt(sel.value) || null;
            POS_STATE.counterName = sel.value ? sel.options[sel.selectedIndex].dataset.name : '';
            persistHeaderSelection();
            checkSetupReady();
        }

        function onHeaderWarehouseChange(sel) {
            POS_STATE.warehouseId = parseInt(sel.value) || null;
            POS_STATE.warehouseName = sel.value ? sel.options[sel.selectedIndex].dataset.name : '';
            persistHeaderSelection();
            checkSetupReady();
        }

        function persistHeaderSelection() {
            localStorage.setItem('posCounter', JSON.stringify({
                tenantId: POS_STATE.tenantId, tenantName: POS_STATE.tenantName,
                counterId: POS_STATE.counterId, counterName: POS_STATE.counterName,
                warehouseId: POS_STATE.warehouseId, warehouseName: POS_STATE.warehouseName
            }));
        }

        async function onAdminTenantSwitch(selectEl) {
            POS_STATE.tenantId = parseInt(selectEl.value) || 0;
            POS_STATE.tenantName = selectEl.options[selectEl.selectedIndex]?.text || '';
            POS_STATE.counterId = null; POS_STATE.warehouseId = null;
            localStorage.removeItem('posCounter');
            await loadHeaderSelectors();
        }

        async function checkSetupReady() {
            const banner = document.getElementById('setupWarningBanner');
            if (POS_STATE.counterId && POS_STATE.warehouseId) {
                banner.classList.add('hidden');
                updateFooterContext();
                await enterPOS();
            } else {
                banner.classList.remove('hidden');
            }
        }

        async function enterPOS() {
            try {
                const metaRes = await fetch('/api/v1/POS/catalog/metadata');
                if (metaRes.ok) catalogMeta = await metaRes.json();
            } catch (e) {}
            await loadProductGrid();
            await checkExistingShift();
            buildSidebarCategories();
            updateFooterContext();
            startClock();
            startPingMonitor();
            await loadPaymentMethods();
        }

        function updateFooterContext() {
            document.getElementById('footerTenant').textContent = POS_STATE.tenantName || '--';
            document.getElementById('footerCounter').textContent = POS_STATE.counterName || '--';
            document.getElementById('footerWarehouse').textContent = POS_STATE.warehouseName || '--';
            document.getElementById('footerShift').textContent = POS_STATE.shiftId ? `#${POS_STATE.shiftId}` : 'None';
        }

        // ===================================================
        // VIEW SWITCHING (Catalog / Dashboard / Orders Feed)
        // ===================================================
        function showCatalogView() {
            POS_STATE.activeView = 'catalog';
            document.getElementById('productGrid').classList.remove('hidden');
            document.getElementById('dashboardPanel').classList.remove('show');
            document.getElementById('ordersFeedPanel').classList.remove('show');
            if (document.getElementById('posRegisterPanel')) document.getElementById('posRegisterPanel').style.display = '';
            updateSidebarActive(0);
        }

        function showDashboardView() {
            POS_STATE.activeView = 'dashboard';
            document.getElementById('productGrid').classList.add('hidden');
            document.getElementById('dashboardPanel').classList.add('show');
            document.getElementById('ordersFeedPanel').classList.remove('show');
            if (document.getElementById('posRegisterPanel')) document.getElementById('posRegisterPanel').style.display = 'none';
            updateSidebarActive(1);
            loadDashboardRange(0);
        }

        function showOrdersFeedView() {
            POS_STATE.activeView = 'orders';
            document.getElementById('productGrid').classList.add('hidden');
            document.getElementById('dashboardPanel').classList.remove('show');
            document.getElementById('ordersFeedPanel').classList.add('show');
            if (document.getElementById('posRegisterPanel')) document.getElementById('posRegisterPanel').style.display = 'none';
            updateSidebarActive(2);
            loadOrdersFeed(true);
        }

        function updateSidebarActive(idx) {
            document.querySelectorAll('.pos-operator-menu .op-menu-item').forEach((el, i) => {
                if (i < 3) el.classList.toggle('active', i === idx);
            });
        }

        // ===================================================
        // SHIFT MANAGEMENT — Slide Drawer
        // ===================================================
        async function checkExistingShift() {
            if (!POS_STATE.userId || !POS_STATE.counterId) return;
            try {
                const res = await fetch(`/api/v1/POS/shift/active?userId=${POS_STATE.userId}&counterId=${POS_STATE.counterId}`);
                if (res.ok) {
                    const shift = await res.json();
                    POS_STATE.shiftId = shift.shiftId;
                    POS_STATE.shiftStartTime = shift.startTime;
                    const shiftDate = new Date(shift.startTime);
                    const now = new Date();
                    if (now.toDateString() !== shiftDate.toDateString() && now > shiftDate) {
                        POS_STATE.isStaleShift = true;
                        updateShiftUI(true);
                        document.getElementById('btnPayment').disabled = true;
                        setTimeout(() => {
                            if (typeof showCyberNotify === 'function') showCyberNotify("STALE SHIFT", `Shift #${shift.shiftId} from previous date. Close it first.`, "error");
                            openCloseShiftDrawer();
                        }, 1000);
                        return;
                    }
                    POS_STATE.isStaleShift = false;
                    updateShiftUI(true);
                    updateFooterContext();
                    await ensureActiveDraftOrder();
                }
            } catch (e) {}
        }

        function updateShiftUI(hasShift) {
            const dot = document.getElementById('shiftDot');
            const label = document.getElementById('shiftStatusLabel');
            const startBtn = document.getElementById('opMenuStartShift');
            const closeBtn = document.getElementById('opMenuCloseShift');
            if (hasShift) {
                dot.className = 'shift-dot active';
                label.textContent = `Shift #${POS_STATE.shiftId}`;
                label.style.color = 'var(--bio-emerald)';
                document.getElementById('btnPayment').disabled = false;
                if (startBtn) startBtn.style.display = 'none';
                if (closeBtn) closeBtn.style.display = 'flex';
            } else {
                dot.className = 'shift-dot';
                label.textContent = 'No Shift';
                label.style.color = '';
                document.getElementById('btnPayment').disabled = true;
                if (startBtn) startBtn.style.display = 'flex';
                if (closeBtn) closeBtn.style.display = 'none';
            }
        }

        function openStartShiftDrawer() {
            document.getElementById('shiftDrawerTitle').innerHTML = '<i class="fa-solid fa-play me-2" style="color:var(--bio-emerald);"></i>START SHIFT';
            document.getElementById('shiftDrawerBody').innerHTML = `
                <div style="background:#0C1018; border:1px solid #1A2432; padding:12px; margin-bottom:14px;">
                    <div style="font-size:0.72rem; color:#667;">COUNTER</div>
                    <div style="color:#FFF; font-weight:bold;">${POS_STATE.counterName || '--'}</div>
                    <div style="font-size:0.72rem; color:#667; margin-top:6px;">TIME</div>
                    <div style="color:#AAA;">${new Date().toLocaleString('en-GB')}</div>
                </div>
                <div class="pay-section-title">Opening Cash (₫)</div>
                <input type="number" class="pos-input" id="inpStartCash" placeholder="Enter opening cash..." min="0" step="1000" style="font-size:1.2rem; font-weight:bold; color:var(--bio-emerald);" />
                <div style="display:flex; gap:6px; margin-top:8px; flex-wrap:wrap;">
                    <button class="quick-amount-btn" onclick="setStartCash(100000)">100K</button>
                    <button class="quick-amount-btn" onclick="setStartCash(200000)">200K</button>
                    <button class="quick-amount-btn" onclick="setStartCash(500000)">500K</button>
                    <button class="quick-amount-btn" onclick="setStartCash(1000000)">1M</button>
                    <button class="quick-amount-btn" onclick="setStartCash(2000000)">2M</button>
                </div>`;
            document.getElementById('shiftDrawerFooter').innerHTML = `
                <button class="btn-pos-secondary" onclick="closeShiftDrawer()">CANCEL</button>
                <button class="btn-pos-success" onclick="confirmStartShift()" style="padding:8px 20px;"><i class="fa-solid fa-play me-1"></i>START</button>`;
            openShiftDrawer();
        }

        function openCloseShiftDrawer() {
            if (!POS_STATE.shiftId) {
                if (typeof showCyberNotify === 'function') showCyberNotify("NO SHIFT", "No active shift to close.", "warning");
                return;
            }
            const duration = POS_STATE.shiftStartTime ? Math.round((Date.now() - new Date(POS_STATE.shiftStartTime).getTime()) / 60000) : 0;
            document.getElementById('shiftDrawerTitle').innerHTML = '<i class="fa-solid fa-stop me-2" style="color:var(--crimson-danger);"></i>CLOSE SHIFT';
            document.getElementById('shiftDrawerBody').innerHTML = `
                <div style="background:rgba(255,51,51,0.08); border:1px solid var(--crimson-danger); padding:10px; margin-bottom:14px; font-size:0.78rem; color:#FF8888;">
                    <i class="fa-solid fa-triangle-exclamation me-1"></i> Closing shift will finalize the financial ledger.
                </div>
                <div style="background:#0C1018; border:1px solid #1A2432; padding:12px; margin-bottom:14px;">
                    <div class="pay-summary-row"><span style="color:#667;">Shift ID:</span><span style="color:var(--holo-cyan); font-weight:bold;">#${POS_STATE.shiftId}</span></div>
                    <div class="pay-summary-row"><span style="color:#667;">Started:</span><span style="color:#AAA;">${new Date(POS_STATE.shiftStartTime || Date.now()).toLocaleString('en-GB')}</span></div>
                    <div class="pay-summary-row"><span style="color:#667;">Duration:</span><span style="color:var(--amber-warn);">${duration} min</span></div>
                </div>
                <div class="pay-section-title">Final Cash in Drawer (₫) <span style="color:var(--crimson-danger);">*</span></div>
                <input type="number" class="pos-input" id="inpCloseEndCash" placeholder="Count and enter cash..." min="0" step="1000" style="font-size:1.2rem; font-weight:bold; color:var(--bio-emerald);" />`;
            document.getElementById('shiftDrawerFooter').innerHTML = `
                <button class="btn-pos-secondary" onclick="closeShiftDrawer()">RESUME SHIFT</button>
                <button class="btn-pos-primary" onclick="confirmCloseShift()" style="background:linear-gradient(90deg,#FF3333,#CC0000); border-color:#FF3333; color:#FFF; padding:8px 18px;">
                    <i class="fa-solid fa-lock me-1"></i>CLOSE SHIFT
                </button>`;
            openShiftDrawer();
        }

        function setStartCash(amount) {
            document.getElementById('inpStartCash').value = amount;
            document.querySelectorAll('.quick-amount-btn').forEach(b => b.classList.remove('active'));
            event.target.classList.add('active');
        }

        function openShiftDrawer() {
            document.getElementById('shiftDrawerOverlay').classList.add('show');
            document.getElementById('shiftDrawer').classList.add('show');
        }
        function closeShiftDrawer() {
            document.getElementById('shiftDrawerOverlay').classList.remove('show');
            document.getElementById('shiftDrawer').classList.remove('show');
        }

        async function confirmStartShift() {
            const startCash = parseInt(document.getElementById('inpStartCash').value) || 0;
            const res = await fetch('/api/v1/POS/shift/start', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ UserId: POS_STATE.userId, TenantId: POS_STATE.tenantId, CounterId: POS_STATE.counterId, StartCash: startCash })
            });
            if (res.ok) {
                const shift = await res.json();
                POS_STATE.shiftId = shift.shiftId;
                POS_STATE.shiftStartTime = shift.startTime;
                updateShiftUI(true);
                updateFooterContext();
                closeShiftDrawer();
                await ensureActiveDraftOrder();
            } else {
                const err = await res.json();
                alert(`Shift start failed: ${err.message || err.Message || 'Unknown error'}`);
            }
        }

        async function confirmCloseShift() {
            const endCashVal = document.getElementById('inpCloseEndCash').value;
            if (endCashVal === '' || isNaN(endCashVal) || Number(endCashVal) < 0) {
                if (typeof showCyberNotify === 'function') showCyberNotify("VALIDATION", "Enter valid cash amount.", "warning");
                return;
            }
            const res = await fetch('/api/v1/POS/shift/close', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ shiftId: POS_STATE.shiftId, endCash: Number(endCashVal) })
            });
            if (res.ok) {
                const data = await res.json();
                if (typeof showCyberNotify === 'function') showCyberNotify("SHIFT CLOSED", data.message || 'Shift closed successfully.', data.isBalanced !== false ? "success" : "warning");
                POS_STATE.shiftId = null; POS_STATE.shiftStartTime = null; POS_STATE.isStaleShift = false;
                closeShiftDrawer();
                updateShiftUI(false);
                updateFooterContext();
                fetch('/api/v1/POS/retail-draft/cleanup-stale', { method: 'DELETE' }).catch(() => {});
            } else {
                const err = await res.json();
                if (typeof showCyberNotify === 'function') showCyberNotify("CLOSE FAULT", err.message || 'Error', "error");
            }
        }

        // ===================================================
        // PRODUCT CATALOG
        // ===================================================
        async function loadProductGrid(queryParams = '') {
            const container = document.getElementById('productGrid');
            container.innerHTML = `<div style="grid-column:1/-1; text-align:center; padding:40px; color:#333;"><i class="fa-solid fa-spinner fa-spin fa-2x" style="color:var(--holo-cyan);"></i><div style="margin-top:8px; font-size:0.78rem;">Loading...</div></div>`;
            try {
                const tenantParam = POS_STATE.tenantId ? `tenantId=${POS_STATE.tenantId}` : 'tenantId=1';
                const res = await fetch(`/api/v1/POS/catalog/products?${tenantParam}${queryParams}`);
                if (res.ok) { const data = await res.json(); renderProductCards(data.products || data.Products || []); return; }
            } catch (e) {}
            container.innerHTML = `<div style="grid-column:1/-1; text-align:center; padding:40px; color:var(--crimson-danger);"><i class="fa-solid fa-triangle-exclamation fa-2x"></i><div style="margin-top:8px;">Catalog unavailable</div></div>`;
        }

        function renderProductCards(products) {
            const container = document.getElementById('productGrid');
            if (!products || products.length === 0) { container.innerHTML = `<div style="grid-column:1/-1; text-align:center; padding:40px; color:#444;">No products found</div>`; return; }
            container.innerHTML = '';
            products.forEach(p => {
                const stock = p.availableStock !== undefined ? p.availableStock : (p.AvailableStock || 0);
                const stockClass = stock === 0 ? 'zero' : (stock <= 5 ? 'low' : '');
                const card = document.createElement('div');
                card.className = `prod-card${stock === 0 ? ' out-of-stock' : ''}`;
                if (stock > 0) card.onclick = () => addItemToOrder(p.productId || p.ProductId, p.sku || p.Sku, p.productName || p.ProductName, p.basePrice || p.BasePrice);
                const imgUrl = p.imageUrl || p.ImageUrl || 'https://images.unsplash.com/photo-1526738549149-8e07eca6c147?auto=format&fit=crop&w=300&q=80';
                card.innerHTML = `
                    <span class="prod-stock-chip ${stockClass}" style="z-index:2;">${stock}</span>
                    <div style="height:92px; width:100%; margin-bottom:6px; overflow:hidden; border-bottom:1px solid #1A1A1A; background:#050505; display:flex; align-items:center; justify-content:center;">
                        <img src="${imgUrl}" alt="Item" onerror="this.src='https://images.unsplash.com/photo-1526738549149-8e07eca6c147?auto=format&fit=crop&w=300&q=80'" style="width:100%; height:100%; object-fit:cover; opacity:0.85;"/>
                    </div>
                    <div class="prod-sku">${p.sku || p.Sku}</div>
                    <div class="prod-name" title="${p.productName || p.ProductName}">${p.productName || p.ProductName}</div>
                    <div style="margin-top:auto;">
                        <div class="prod-price">${Number(p.basePrice || p.BasePrice).toLocaleString('en-US')} ₫</div>
                        <div class="prod-unit">${p.unitName || p.UnitName || ''} • ${p.categoryName || p.CategoryName || ''}</div>
                    </div>`;
                container.appendChild(card);
            });
        }

        function buildSidebarCategories() {
            const cats = catalogMeta.categories || catalogMeta.Categories || [];
            const container = document.getElementById('sidebarCategories');
            if (!container) return;
            container.innerHTML = '';
            cats.forEach(c => {
                container.innerHTML += `<div class="op-menu-item" onclick="loadProductGrid('&categoryId=${c.categoryId || c.CategoryId}'); showCatalogView();"><i class="fa-solid fa-angle-right" style="color:#555;"></i><span>${c.categoryName || c.CategoryName}</span></div>`;
            });
        }

        function setPrimaryFilter(type, btn) {
            document.querySelectorAll('.btn-filter').forEach(b => b.classList.remove('active'));
            if (btn) btn.classList.add('active');
            const strip = document.getElementById('subFilterStrip');
            strip.innerHTML = '';
            if (type === 'all') { strip.innerHTML = `<span style="color:#333; font-size:0.7rem;">Showing all products</span>`; loadProductGrid(); return; }
            let list = [], paramName = '';
            if (type === 'category') { list = catalogMeta.categories || []; paramName = 'categoryId'; }
            else if (type === 'manufacturer') { list = catalogMeta.manufacturers || []; paramName = 'manufacturerId'; }
            else if (type === 'unit') { list = catalogMeta.units || []; paramName = 'unitId'; }
            list.forEach(item => {
                const id = item.categoryId || item.manufacturerId || item.unitId || item.CategoryId || item.ManufacturerId || item.UnitId;
                const name = item.categoryName || item.manufacturerName || item.unitName || item.CategoryName || item.ManufacturerName || item.UnitName;
                const tag = document.createElement('button');
                tag.className = 'btn-sub-tag'; tag.textContent = name;
                tag.onclick = () => { document.querySelectorAll('.btn-sub-tag').forEach(t => t.classList.remove('active')); tag.classList.add('active'); loadProductGrid(`&${paramName}=${id}`); };
                strip.appendChild(tag);
            });
        }

        function executeSearch() {
            const q = document.getElementById('posSearchInput').value.trim();
            showCatalogView();
            loadProductGrid(`&query=${encodeURIComponent(q)}`);
        }

        // ===================================================
        // SINGLE ORDER + DRAFT QUEUE
        // ===================================================
        async function ensureActiveDraftOrder(forceCreate = false) {
            if (!POS_STATE.shiftId) { document.getElementById('lblOrderNo').textContent = '---'; return null; }
            const order = POS_STATE.currentOrder;
            if (order.orderId) { document.getElementById('lblOrderNo').textContent = `#${order.orderId}`; return order.orderId; }
            if (!forceCreate) { document.getElementById('lblOrderNo').textContent = 'READY'; return null; }
            try {
                const res = await fetch('/api/v1/POS/retail-draft/create', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ TenantId: POS_STATE.tenantId, ShiftId: POS_STATE.shiftId, UserId: POS_STATE.userId })
                });
                if (res.ok) {
                    const data = await res.json();
                    order.orderId = data.orderId || data.OrderId;
                    document.getElementById('lblOrderNo').textContent = `#${order.orderId}`;
                    renderOrderTable();
                    return order.orderId;
                }
            } catch (e) { console.error('>>> [DRAFT_CREATE_FAULT]:', e); }
            return null;
        }

        async function addItemToOrder(productId, sku, name, unitPrice) {
            if (POS_STATE.isStaleShift) {
                if (typeof showCyberNotify === 'function') showCyberNotify("STALE SHIFT", "Close stale shift first.", "error");
                openCloseShiftDrawer();
                return;
            }
            const orderId = await ensureActiveDraftOrder(true);
            if (!orderId || !POS_STATE.shiftId) {
                if (typeof showCyberNotify === 'function') showCyberNotify("START SHIFT", "Open a shift before adding items.", "warning");
                openStartShiftDrawer();
                return;
            }
            try {
                const res = await fetch('/api/v1/POS/retail-draft/add-item', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ OrderId: orderId, ProductId: productId, Quantity: 1, ClientScanId: crypto.randomUUID() })
                });
                if (res.ok) {
                    const update = await res.json();
                    POS_STATE.currentOrder.items = update.items || update.Items || [];
                    renderOrderTable();
                } else {
                    const err = await res.json();
                    if (typeof showCyberNotify === 'function') showCyberNotify("ADD FAILED", err.message || 'Error', err.error === 'OUT_OF_STOCK' ? "warning" : "error");
                }
            } catch (e) { console.error(e); }
        }

        async function removeItemFromOrder(productId) {
            const order = POS_STATE.currentOrder;
            if (!order.orderId) return;
            const res = await fetch('/api/v1/POS/retail-draft/remove-item', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ OrderId: order.orderId, ProductId: productId })
            });
            if (res.ok) { const update = await res.json(); order.items = update.items || update.Items || []; renderOrderTable(); }
        }

        function renderOrderTable() {
            const order = POS_STATE.currentOrder;
            const tbody = document.getElementById('orderTableBody');
            document.getElementById('lblCustomer').textContent = order.customerName.toUpperCase();
            document.getElementById('payCustomerName').textContent = order.customerName;
            updateDraftQueueBadge();

            if (!order.items || order.items.length === 0) {
                tbody.innerHTML = `<tr><td colspan="5" style="text-align:center; padding:35px; color:#444; background:rgba(0,0,0,0.3);"><i class="fa-solid fa-barcode fa-3x mb-2" style="color:#222; display:block;"></i><span style="font-family:var(--font-mono); font-size:0.85rem;">[SCAN OR SELECT PRODUCT]</span></td></tr>`;
                updateTotals(0, 0, 0, 0);
                return;
            }

            let gross = 0, vat = 0, totalCount = 0;
            let html = '';
            order.items.forEach(item => {
                const total = item.lineTotal || item.LineTotal || 0;
                const unitPrice = item.unitPrice || item.UnitPrice || 0;
                const qty = item.quantity || item.Quantity || 1;
                const taxAmt = total - (qty * unitPrice);
                const pid = item.productId || item.ProductId;
                const noteVal = item.notes || item.Notes || '';
                const hasNote = noteVal.length > 0;
                gross += (qty * unitPrice);
                vat += taxAmt;
                totalCount += qty;
                html += `<tr>
                    <td style="color:var(--holo-cyan); font-size:0.75rem; font-family:var(--font-mono); font-weight:bold;">${item.sku || item.Sku}</td>
                    <td>
                        <div style="font-weight:700; font-size:0.85rem; color:#E0E0E0;">${item.productName || item.ProductName}</div>
                        <button class="line-note-btn ${hasNote ? 'has-note' : ''}" onclick="toggleLineNote(this, ${pid})" title="Add note"><i class="fa-solid fa-sticky-note"></i></button>
                        <input class="line-note-input ${hasNote ? 'show' : ''}" value="${noteVal}" placeholder="e.g. less ice..." onblur="saveLineNote(${pid}, this.value)" data-pid="${pid}" />
                    </td>
                    <td style="text-align:center;"><span style="color:var(--bio-emerald); font-family:var(--font-mono); font-weight:bold; font-size:0.9rem;">×${qty}</span></td>
                    <td style="text-align:right; color:var(--bio-emerald); font-weight:bold; font-family:var(--font-mono); font-size:0.95rem;">${total.toLocaleString('en-US')}</td>
                    <td style="text-align:center;"><button class="btn-void" onclick="removeItemFromOrder(${pid})" title="Remove"><i class="fa-solid fa-xmark"></i></button></td>
                </tr>`;
            });
            tbody.innerHTML = html;
            updateTotals(gross, vat, gross + vat, totalCount);
        }

        function toggleLineNote(btn, productId) {
            const input = btn.nextElementSibling;
            input.classList.toggle('show');
            if (input.classList.contains('show')) input.focus();
        }

        function saveLineNote(productId, noteValue) {
            const item = POS_STATE.currentOrder.items.find(i => (i.productId || i.ProductId) === productId);
            if (item) { item.notes = noteValue; item.Notes = noteValue; }
        }

        function updateTotals(gross, vat, total, count = 0) {
            const fmt = n => n.toLocaleString('en-US');
            document.getElementById('txtGross').textContent = `${fmt(gross)} ₫`;
            document.getElementById('txtVat').textContent = `${fmt(vat)} ₫`;
            document.getElementById('txtDiscount').textContent = `0 ₫`;
            document.getElementById('txtTotal').textContent = fmt(total);
            document.getElementById('lblTotalItemsCount').textContent = count;
            document.getElementById('paySub').textContent = `${fmt(gross)} ₫`;
            document.getElementById('payVat').textContent = `${fmt(vat)} ₫`;
            document.getElementById('payDiscount').textContent = `0 ₫`;
            document.getElementById('payTotal').textContent = fmt(total);
        }

        // Shipping toggle
        function toggleShipping() {
            const toggle = document.getElementById('shippingToggle');
            POS_STATE.currentOrder.isShipping = !POS_STATE.currentOrder.isShipping;
            toggle.classList.toggle('on', POS_STATE.currentOrder.isShipping);
        }

        // Hold order → push to draft queue
        function holdCurrentOrder() {
            const order = POS_STATE.currentOrder;
            if (!order.items || order.items.length === 0) { if (typeof showCyberNotify === 'function') showCyberNotify("EMPTY", "No items to hold.", "warning"); return; }
            POS_STATE.draftQueue.push(JSON.parse(JSON.stringify(order)));
            POS_STATE.currentOrder = { orderId: null, items: [], customerId: null, customerName: 'Walk-in Customer', orderType: 'retail', isShipping: false };
            renderOrderTable();
            ensureActiveDraftOrder(false);
            updateDraftQueueBadge();
            if (typeof showCyberNotify === 'function') showCyberNotify("HELD", "Order saved to draft queue.", "success");
        }

        function clearCurrentOrder() {
            POS_STATE.currentOrder = { orderId: null, items: [], customerId: null, customerName: 'Walk-in Customer', orderType: 'retail', isShipping: false };
            renderOrderTable();
            ensureActiveDraftOrder(false);
        }

        function updateDraftQueueBadge() {
            document.getElementById('draftQueueCount').textContent = POS_STATE.draftQueue.length;
        }

        // Draft sidebar
        function toggleDraftSidebar() {
            document.getElementById('draftSidebarOverlay').classList.add('show');
            document.getElementById('draftSidebar').classList.add('show');
            renderDraftList();
        }
        function closeDraftSidebar() {
            document.getElementById('draftSidebarOverlay').classList.remove('show');
            document.getElementById('draftSidebar').classList.remove('show');
        }
        function renderDraftList() {
            const container = document.getElementById('draftListContainer');
            if (POS_STATE.draftQueue.length === 0) { container.innerHTML = '<div style="text-align:center; padding:30px; color:#555; font-size:0.82rem;">No held orders</div>'; return; }
            container.innerHTML = POS_STATE.draftQueue.map((d, i) => {
                const itemCount = d.items ? d.items.reduce((s, it) => s + (it.quantity || it.Quantity || 1), 0) : 0;
                const total = d.items ? d.items.reduce((s, it) => s + (it.lineTotal || it.LineTotal || 0), 0) : 0;
                return `<div class="draft-item" onclick="resumeDraft(${i})">
                    <div class="draft-item-header"><span style="color:var(--holo-cyan);">#${d.orderId || 'New'}</span><span style="color:var(--bio-emerald);">${total.toLocaleString('en-US')} ₫</span></div>
                    <div class="draft-item-meta">${itemCount} items • ${d.customerName}</div>
                </div>`;
            }).join('');
        }
        function resumeDraft(index) {
            if (POS_STATE.currentOrder.items && POS_STATE.currentOrder.items.length > 0) {
                POS_STATE.draftQueue.push(JSON.parse(JSON.stringify(POS_STATE.currentOrder)));
            }
            POS_STATE.currentOrder = POS_STATE.draftQueue.splice(index, 1)[0];
            renderOrderTable();
            updateDraftQueueBadge();
            closeDraftSidebar();
        }

        // ===================================================
        // CUSTOMER COMMAND PALETTE
        // ===================================================
        function openCustomerPalette() {
            document.getElementById('customerPaletteOverlay').classList.add('show');
            document.getElementById('paletteSearchInput').value = '';
            document.getElementById('paletteCreateForm').classList.remove('show');
            filterPaletteResults();
            setTimeout(() => document.getElementById('paletteSearchInput').focus(), 100);
        }
        function closeCustomerPalette() {
            document.getElementById('customerPaletteOverlay').classList.remove('show');
        }
        function filterPaletteResults() {
            const q = document.getElementById('paletteSearchInput').value.toLowerCase();
            const customers = catalogMeta.customers || catalogMeta.Customers || [];
            const filtered = customers.filter(c =>
                (c.fullName || c.FullName || '').toLowerCase().includes(q) ||
                (c.phoneNumber || c.PhoneNumber || '').includes(q) ||
                String(c.customerId || c.CustomerId || '').includes(q)
            );
            const container = document.getElementById('paletteResults');
            if (filtered.length === 0) { container.innerHTML = '<div style="padding:20px; text-align:center; color:#555; font-size:0.82rem;">No customers found</div>'; return; }
            container.innerHTML = filtered.map(c => {
                const pts = Number(c.rewardPoints || c.RewardPoints || 0);
                const cid = c.customerId || c.CustomerId;
                return `<div class="palette-result-item" onclick="selectPaletteCustomer(${cid}, '${(c.fullName || c.FullName || '').replace(/'/g, "\\'")}')">
                    <div class="palette-result-info">
                        <span class="palette-result-name">${c.fullName || c.FullName}</span>
                        <span class="palette-result-meta"><i class="fa-solid fa-phone me-1"></i>${c.phoneNumber || c.PhoneNumber || '--'} • ${pts.toLocaleString('en-US')} pts</span>
                    </div>
                    <span class="palette-result-badge">VIP-${String(cid).padStart(4, '0')}</span>
                </div>`;
            }).join('');
        }
        function selectPaletteCustomer(id, name) {
            POS_STATE.currentOrder.customerId = id;
            POS_STATE.currentOrder.customerName = name;
            document.getElementById('lblCustomer').textContent = name.toUpperCase();
            document.getElementById('payCustomerName').textContent = name;
            closeCustomerPalette();
        }
        function togglePaletteCreateForm() {
            document.getElementById('paletteCreateForm').classList.toggle('show');
        }
        async function savePaletteCustomer() {
            const fullName = document.getElementById('newCustName').value.trim();
            if (!fullName) { alert('Name is required.'); return; }
            const res = await fetch('/api/v1/POS/customers', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ FullName: fullName, PhoneNumber: document.getElementById('newCustPhone').value.trim(), Email: document.getElementById('newCustEmail').value.trim(), Address: document.getElementById('newCustAddress').value.trim() })
            });
            if (res.ok) {
                await refreshCatalogMetadata();
                togglePaletteCreateForm();
                filterPaletteResults();
                if (typeof showCyberNotify === 'function') showCyberNotify('SAVED', 'Customer created.', 'success');
            } else { alert('Failed to save customer.'); }
        }
        async function refreshCatalogMetadata() {
            try { const r = await fetch('/api/v1/POS/catalog/metadata'); if (r.ok) catalogMeta = await r.json(); } catch(e){}
        }

        // ===================================================
        // PAYMENT SLIDE PANEL
        // ===================================================
        async function loadPaymentMethods() {
            const res = await fetch('/api/v1/POS/payment-methods');
            if (res.ok) paymentMethods = await res.json();
        }

        function openPaymentPanel() {
            const order = POS_STATE.currentOrder;
            if (!order.orderId || !order.items || order.items.length === 0) { alert('Add items first.'); return; }
            if (!POS_STATE.shiftId) { openStartShiftDrawer(); return; }

            // Render payment methods — max 5 visible + overflow dropdown
            const grid = document.getElementById('paymentMethodGrid');
            const otherSel = document.getElementById('payOtherMethodSel');
            const allowedNames = ['cash', 'credit card', 'debit card', 'e-wallet', 'bank transfer', 'vnpay', 'store credit'];
            const posMethods = paymentMethods.filter(m => allowedNames.includes((m.methodName || '').toLowerCase()) || m.paymentMethodId <= 6);
            const visibleMethods = posMethods.slice(0, 5);
            const overflowMethods = posMethods.slice(5);
            const icons = { 'Cash': 'fa-money-bill-wave', 'Card': 'fa-credit-card', 'QR': 'fa-qrcode', 'Transfer': 'fa-building-columns', 'VNPAY': 'fa-qrcode', 'Wallet': 'fa-wallet' };

            grid.innerHTML = '';
            visibleMethods.forEach(m => {
                const iconKey = Object.keys(icons).find(k => m.methodName.includes(k)) || 'Card';
                const btn = document.createElement('div');
                btn.className = 'payment-method-btn';
                btn.innerHTML = `<i class="fa-solid ${icons[iconKey] || 'fa-credit-card'}"></i>${m.methodName}`;
                btn.onclick = () => { document.querySelectorAll('.payment-method-btn').forEach(b => b.classList.remove('selected')); btn.classList.add('selected'); selectedPaymentMethodId = m.paymentMethodId; otherSel.value = ''; validatePaymentState(); };
                grid.appendChild(btn);
            });

            if (overflowMethods.length > 0) {
                otherSel.innerHTML = '<option value="">-- Other Methods --</option>';
                overflowMethods.forEach(m => { otherSel.innerHTML += `<option value="${m.paymentMethodId}">${m.methodName}</option>`; });
                otherSel.style.display = 'block';
            } else { otherSel.style.display = 'none'; }

            selectedPaymentMethodId = null;
            document.getElementById('tenderedInput').value = '';
            document.getElementById('changeDisplay').textContent = '0';
            if (document.getElementById('payWalkinPhone')) document.getElementById('payWalkinPhone').value = '';
            if (document.getElementById('payWalkinName')) document.getElementById('payWalkinName').value = '';
            if (document.getElementById('payWalkinCccd')) document.getElementById('payWalkinCccd').value = '';
            if (document.getElementById('payWalkinTax')) document.getElementById('payWalkinTax').value = '';
            if (document.getElementById('payWalkinAddress')) document.getElementById('payWalkinAddress').value = '';
            togglePayType(order.orderType || 'retail');

            // Show form, hide receipt
            document.getElementById('payFormView').style.display = '';
            document.getElementById('receiptCardView').classList.remove('show');
            document.getElementById('payFormFooter').style.display = '';
            document.getElementById('receiptFooter').style.display = 'none';

            document.getElementById('paymentOverlay').classList.add('show');
            document.getElementById('paymentPanel').classList.add('show');
        }

        function closePaymentPanel() {
            document.getElementById('paymentOverlay').classList.remove('show');
            document.getElementById('paymentPanel').classList.remove('show');
        }

        function selectOtherPayMethod(sel) {
            if (sel.value) {
                selectedPaymentMethodId = parseInt(sel.value);
                document.querySelectorAll('.payment-method-btn').forEach(b => b.classList.remove('selected'));
                validatePaymentState();
            }
        }

        function togglePayType(type) {
            POS_STATE.currentOrder.orderType = type;
            document.getElementById('btnPayRetail').classList.toggle('active', type === 'retail');
            document.getElementById('btnPayB2B').classList.toggle('active', type === 'b2b');
            document.getElementById('payB2CSection').style.display = type === 'retail' ? '' : 'none';
            document.getElementById('payB2BSection').style.display = type === 'b2b' ? '' : 'none';
            validatePaymentState();
        }

        function validatePaymentState() {
            const order = POS_STATE.currentOrder;
            const confirmBtn = document.getElementById('btnConfirmPayment');
            const warnBox = document.getElementById('b2bComplianceWarn');
            let isValid = !!selectedPaymentMethodId;
            if (order.orderType === 'b2b') {
                const hasVip = !!order.customerId;
                const hasTax = document.getElementById('payTaxCode').value.trim().length > 0;
                const hasComp = document.getElementById('payCompanyName').value.trim().length > 0;
                warnBox.style.display = (hasVip && hasTax && hasComp) ? 'none' : 'block';
                if (!hasVip || !hasTax || !hasComp) isValid = false;
            } else { warnBox.style.display = 'none'; }
            confirmBtn.disabled = !isValid;
        }

        function calcChange() {
            const totalText = document.getElementById('txtTotal').textContent.replace(/,/g, '');
            const total = parseFloat(totalText) || 0;
            const tendered = parseFloat(document.getElementById('tenderedInput').value) || 0;
            document.getElementById('changeDisplay').textContent = Math.max(0, tendered - total).toLocaleString('en-US');
        }

        async function confirmPayment() {
            const order = POS_STATE.currentOrder;
            if (!order.orderId || !selectedPaymentMethodId) return;
            const totalText = document.getElementById('txtTotal').textContent.replace(/,/g, '');
            const total = parseFloat(totalText) || 0;
            const tendered = parseFloat(document.getElementById('tenderedInput').value) || total;
            const walkinPhone = document.getElementById('payWalkinPhone')?.value?.trim() || null;
            const walkinName = document.getElementById('payWalkinName')?.value?.trim() || null;
            const walkinCccd = document.getElementById('payWalkinCccd')?.value?.trim() || null;
            const walkinTax = document.getElementById('payWalkinTax')?.value?.trim() || null;
            const walkinAddr = document.getElementById('payWalkinAddress')?.value?.trim() || null;

            const payload = {
                OrderId: order.orderId, PaymentMethodId: selectedPaymentMethodId,
                CustomerId: order.customerId || null, TenderedAmount: tendered,
                IdempotencyKey: crypto.randomUUID(),
                DocType: order.orderType === 'b2b' ? 'B2B_INVOICE' : 'POS_RETAIL',
                CounterId: POS_STATE.counterId || null, WarehouseId: POS_STATE.tenantId || null,
                BuyerPhone: walkinPhone,
                BuyerCccd: order.orderType === 'b2b' ? document.getElementById('payIdNo')?.value?.trim() : walkinCccd,
                BuyerAddress: walkinAddr,
                BuyerTaxCode: order.orderType === 'b2b' ? document.getElementById('payTaxCode').value.trim() : walkinTax,
                BuyerLegalName: order.orderType === 'b2b' ? document.getElementById('payCompanyName').value.trim() : (walkinName || (order.customerName !== 'Walk-in Customer' ? order.customerName : null)),
                Notes: document.getElementById('payNotes')?.value?.trim() || null
            };

            document.getElementById('btnConfirmPayment').disabled = true;
            document.getElementById('btnConfirmPayment').innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i>Processing...';

            const res = await fetch('/api/v1/POS/checkout/paid', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
            if (res.ok) {
                const data = await res.json();
                const displayCustName = payload.BuyerLegalName || (walkinPhone ? `Khách hàng (${walkinPhone})` : order.customerName);
                lastCheckoutData = Object.assign({}, data, { itemsSnapshot: JSON.parse(JSON.stringify(order.items || [])), customerSnapshot: displayCustName });

                // Show receipt card
                document.getElementById('payFormView').style.display = 'none';
                document.getElementById('receiptCardView').classList.add('show');
                document.getElementById('payFormFooter').style.display = 'none';
                document.getElementById('receiptFooter').style.display = '';

                document.getElementById('receiptDocNo').textContent = data.docNo || data.DocNo || data.invoiceNumber || '--';
                document.getElementById('receiptTotal').textContent = `${total.toLocaleString('en-US')} ₫`;
                document.getElementById('receiptTime').textContent = new Date(data.processedAt || data.ProcessedAt || Date.now()).toLocaleString('en-GB');
                document.getElementById('receiptChange').textContent = `${(data.changeAmount || data.ChangeAmount || 0).toLocaleString('en-US')} ₫`;
                document.getElementById('receiptMethod').textContent = paymentMethods.find(m => m.paymentMethodId === selectedPaymentMethodId)?.methodName || 'Cash';
                document.getElementById('receiptCustomer').textContent = displayCustName;

                const receiptBody = document.getElementById('receiptItemsBody');
                receiptBody.innerHTML = order.items.map(it => `<tr><td>${it.productName || it.ProductName}</td><td style="text-align:center;">x${it.quantity || it.Quantity || 1}</td><td style="text-align:right;">${(it.lineTotal || it.LineTotal || 0).toLocaleString('en-US')} ₫</td></tr>`).join('');

                // Reset order
                POS_STATE.currentOrder = { orderId: null, items: [], customerId: null, customerName: 'Walk-in Customer', orderType: 'retail', isShipping: false };
                renderOrderTable();
            } else {
                const err = await res.json();
                if (typeof showCyberNotify === 'function') showCyberNotify("PAYMENT FAILED", err.error || 'Error', "error");
                document.getElementById('btnConfirmPayment').disabled = false;
                document.getElementById('btnConfirmPayment').innerHTML = '<i class="fa-solid fa-bolt me-1"></i>CONFIRM PAYMENT';
            }
        }

        function closePaymentAndReset() {
            closePaymentPanel();
            if (POS_STATE.shiftId) ensureActiveDraftOrder();
        }

        function generateReceiptHtml(isPrint) {
            if (!lastCheckoutData) return '';
            const inv = lastCheckoutData.docNo || lastCheckoutData.DocNo || lastCheckoutData.invoiceNumber || '--';
            const total = document.getElementById('receiptTotal')?.textContent || '0';
            const time = document.getElementById('receiptTime')?.textContent || '--';
            const method = document.getElementById('receiptMethod')?.textContent || 'Cash';
            const change = document.getElementById('receiptChange')?.textContent || '0';
            const customer = lastCheckoutData.customerSnapshot || 'Walk-in Customer';
            const items = lastCheckoutData.itemsSnapshot || [];
            let itemsRows = items.map((it, idx) => {
                const name = it.productName || it.ProductName || 'Item';
                const qty = it.quantity || it.Quantity || 1;
                const sub = it.lineTotal || it.LineTotal || 0;
                const note = it.notes || it.Notes || '';
                return `<tr><td style="text-align:left; border-bottom:1px dotted #ccc;">${idx+1}. ${name}${note ? '<br><i style="font-size:10px; color:#666;">'+note+'</i>' : ''}</td><td style="text-align:center; border-bottom:1px dotted #ccc;">x${qty}</td><td style="text-align:right; border-bottom:1px dotted #ccc;">${sub.toLocaleString('en-US')} ₫</td></tr>`;
            }).join('');
            return `<!DOCTYPE html><html><head><meta charset="utf-8"><title>Receipt - ${inv}</title><style>body{font-family:'Courier New',monospace;font-size:12px;margin:0;padding:16px;background:#fff;color:#000;width:350px;margin:0 auto;}.center{text-align:center;}.line{border-top:1px dashed #000;margin:8px 0;}.bold{font-weight:bold;}table{width:100%;border-collapse:collapse;font-size:11px;margin:8px 0;}th,td{padding:4px 2px;}@@media print{body{margin:0;padding:4px;width:100%;}}</style></head><body><div class="center bold" style="font-size:16px;">DIGIPOSE ENTERPRISE</div><div class="center" style="font-size:10px;">${POS_STATE.tenantName} | ${POS_STATE.counterName}</div><div class="center" style="font-size:10px;">${time}</div><div class="line"></div><div style="font-size:11px;"><b>Doc No:</b> ${inv}</div><div style="font-size:11px;"><b>Customer:</b> ${customer}</div><div style="font-size:11px;"><b>Payment:</b> ${method}</div><div class="line"></div><table><thead><tr style="border-bottom:2px solid #000;"><th style="text-align:left;">Item</th><th style="text-align:center;">Qty</th><th style="text-align:right;">Amount</th></tr></thead><tbody>${itemsRows}</tbody></table><div class="line"></div><div style="display:flex;justify-content:space-between;font-size:14px;" class="bold"><span>TOTAL:</span><span>${total}</span></div><div style="display:flex;justify-content:space-between;font-size:11px;margin-top:3px;"><span>Change:</span><span>${change}</span></div><div class="line"></div><div class="center" style="font-size:10px;margin-top:10px;">Thank you!</div><div class="center" style="font-size:9px;color:#555;">Powered by DigiPOSE v1.0</div></body></html>`;
        }

        function viewInvoice() { if (!lastCheckoutData) return; const w = window.open('', '_blank', 'width=420,height=650'); w.document.write(generateReceiptHtml(false)); w.document.close(); }
        function printInvoice() { if (!lastCheckoutData) return; const w = window.open('', '_blank', 'width=420,height=650'); w.document.write(generateReceiptHtml(true)); w.document.close(); w.focus(); setTimeout(() => { w.print(); w.close(); }, 300); }

        // ===================================================
        // DASHBOARD ANALYTICS (Embedded tab)
        // ===================================================
        let currentDashDays = 0;
        async function loadDashboardRange(days) {
            currentDashDays = days;
            document.getElementById('btnDashToday').classList.toggle('active', days === 0);
            document.getElementById('btnDash7D').classList.toggle('active', days === 7);
            document.getElementById('btnDash30D').classList.toggle('active', days === 30);
            const now = new Date(); let fromDate = new Date();
            if (days > 0) fromDate.setDate(fromDate.getDate() - days);
            const fromStr = fromDate.toISOString().split('T')[0];
            const toStr = now.toISOString().split('T')[0];
            document.getElementById('dashDateRangeLabel').textContent = `${fromStr} → ${toStr}`;
            const params = new URLSearchParams({ tenantId: POS_STATE.tenantId, from: fromStr, to: toStr });
            const res = await fetch(`/api/v1/POS/dashboard/analytics?${params}`);
            if (!res.ok) return;
            const data = await res.json();
            const fmt = n => n ? Number(n).toLocaleString('en-US') : '0';
            document.getElementById('kpiRevenue').textContent = fmt(data.totalRevenue);
            document.getElementById('kpiOrders').textContent = fmt(data.totalOrders);
            document.getElementById('kpiAvg').textContent = fmt(data.avgOrderValue);
            document.getElementById('kpiProducts').textContent = fmt(data.totalProducts || (catalogMeta.categories || []).length);
            renderDashCharts(data);
            renderDashTables(data);
        }

        async function loadDashboardCustomRange() {
            const fDate = document.getElementById('dashFromDate')?.value;
            const tDate = document.getElementById('dashToDate')?.value;
            if (!fDate || !tDate) { alert('Select both dates.'); return; }
            document.querySelectorAll('.dash-filter-btn').forEach(b => b.classList.remove('active'));
            document.getElementById('dashDateRangeLabel').textContent = `${fDate} → ${tDate}`;
            const params = new URLSearchParams({ tenantId: POS_STATE.tenantId, from: fDate, to: tDate });
            const res = await fetch(`/api/v1/POS/dashboard/analytics?${params}`);
            if (!res.ok) return;
            const data = await res.json();
            const fmt = n => n ? Number(n).toLocaleString('en-US') : '0';
            document.getElementById('kpiRevenue').textContent = fmt(data.totalRevenue);
            document.getElementById('kpiOrders').textContent = fmt(data.totalOrders);
            document.getElementById('kpiAvg').textContent = fmt(data.avgOrderValue);
            renderDashCharts(data);
            renderDashTables(data);
        }

        function renderDashCharts(data) {
            if (!window.Chart) return;
            Chart.defaults.color = '#888'; Chart.defaults.borderColor = '#1a1a1a';
            ['chartProductQty','chartPayment','chartRevenue','chartTopProducts'].forEach(id => {
                const el = document.getElementById(id);
                if (el && el._chartInstance) { el._chartInstance.destroy(); el._chartInstance = null; }
            });

            let labels = [], revValues = [], countValues = [];
            if (currentDashDays === 0 && data.revenueByHour) {
                labels = data.revenueByHour.map(x => `${x.hour || x.Hour}:00`);
                revValues = data.revenueByHour.map(x => x.revenue || x.Revenue);
                countValues = data.revenueByHour.map(x => x.count || x.Count || 0);
            } else if (data.revenueByDay) {
                labels = data.revenueByDay.map(x => x.date || x.Date);
                revValues = data.revenueByDay.map(x => x.revenue || x.Revenue);
                countValues = data.revenueByDay.map(x => x.orders || x.Orders || 0);
            }

            // Chart 1: Products sold by qty (vertical bar)
            const ctx1 = document.getElementById('chartProductQty')?.getContext('2d');
            if (ctx1) {
                const prods = (data.topProducts || []).slice(0, 8);
                const inst = new Chart(ctx1, { type: 'bar', data: { labels: prods.map(p => (p.productName || p.ProductName || '').substring(0, 15)), datasets: [{ label: 'Qty Sold', data: prods.map(p => p.totalQty || p.TotalQty), backgroundColor: '#00E5FF', borderRadius: 3 }] }, options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, grid: { color: '#111A24' } }, x: { grid: { display: false } } } } });
                ctx1.canvas._chartInstance = inst;
            }

            // Chart 2: Payment methods (doughnut)
            const ctx2 = document.getElementById('chartPayment')?.getContext('2d');
            if (ctx2) {
                const pb = data.paymentBreakdown || [];
                const inst = new Chart(ctx2, { type: 'doughnut', data: { labels: pb.length ? pb.map(x => x.method || x.Method) : ['Cash'], datasets: [{ data: pb.length ? pb.map(x => x.revenue || x.Revenue) : [1], backgroundColor: ['#00FF66','#00E5FF','#FFB000','#FF3333','#9933FF'], borderColor: '#0A0A0A', borderWidth: 2 }] }, options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom', labels: { boxWidth: 10, font: { size: 10, family: 'Courier New' } } } } } });
                ctx2.canvas._chartInstance = inst;
            }

            // Chart 3: Revenue trend (line)
            const ctx3 = document.getElementById('chartRevenue')?.getContext('2d');
            if (ctx3) {
                const inst = new Chart(ctx3, { type: 'line', data: { labels: labels.length ? labels : ['--'], datasets: [{ label: 'Revenue (₫)', data: revValues.length ? revValues : [0], borderColor: '#00FF66', backgroundColor: 'rgba(0,255,102,0.1)', borderWidth: 2, tension: 0.3, fill: true, pointBackgroundColor: '#00E5FF' }] }, options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, grid: { color: '#111A24' } }, x: { grid: { display: false } } } } });
                ctx3.canvas._chartInstance = inst;
            }

            // Chart 4: Top selling products (horizontal bar)
            const ctx4 = document.getElementById('chartTopProducts')?.getContext('2d');
            if (ctx4) {
                const prods = (data.topProducts || []).slice(0, 6);
                const inst = new Chart(ctx4, { type: 'bar', data: { labels: prods.map(p => (p.productName || p.ProductName || '').substring(0, 18)), datasets: [{ label: 'Revenue', data: prods.map(p => p.totalRevenue || p.TotalRevenue), backgroundColor: ['#00E5FF','#00FF66','#FFB000','#FF3333','#9933FF','#0088FF'] }] }, options: { responsive: true, maintainAspectRatio: false, indexAxis: 'y', plugins: { legend: { display: false } }, scales: { x: { grid: { color: '#111A24' } }, y: { grid: { display: false } } } } });
                ctx4.canvas._chartInstance = inst;
            }
        }

        function renderDashTables(data) {
            // Top customers
            const customers = data.topCustomers || [];
            document.getElementById('topCustomersBody').innerHTML = customers.length ? customers.map((c, i) => `<tr><td style="color:${i < 3 ? 'var(--amber-warn)' : '#888'};">${i+1}</td><td style="color:#DDD;">${c.customerName || c.CustomerName || 'Walk-in'}</td><td style="text-align:right; color:var(--holo-cyan);">${c.orderCount || c.OrderCount || 0}</td><td style="text-align:right; color:var(--bio-emerald); font-family:var(--font-data);">${(c.totalRevenue || c.TotalRevenue || 0).toLocaleString('en-US')}</td></tr>`).join('') : '<tr><td colspan="4" style="text-align:center; color:#555; padding:20px;">No data</td></tr>';

            // Top orders
            const orders = data.topOrders || [];
            document.getElementById('topOrdersBody').innerHTML = orders.length ? orders.map((o, i) => `<tr><td style="color:${i < 3 ? 'var(--amber-warn)' : '#888'};">${i+1}</td><td style="color:var(--holo-cyan);">${o.invoiceNumber || o.InvoiceNumber || '#'+o.orderId}</td><td style="color:#AAA;">${new Date(o.createdAt || o.CreatedAt).toLocaleString('en-GB')}</td><td style="text-align:right; color:var(--bio-emerald); font-family:var(--font-data);">${(o.totalAmount || o.TotalAmount || 0).toLocaleString('en-US')}</td></tr>`).join('') : '<tr><td colspan="4" style="text-align:center; color:#555; padding:20px;">No data</td></tr>';
        }

        // ===================================================
        // ORDERS FEED (Embedded timeline)
        // ===================================================
        async function loadOrdersFeed(reset = false) {
            if (reset) document.getElementById('feedSearchInput').value = '';
            const invoiceFilter = document.getElementById('feedSearchInput').value;
            const container = document.getElementById('ordersFeedContainer');
            container.innerHTML = '<div style="text-align:center; padding:30px; color:#555;"><i class="fa-solid fa-spinner fa-spin me-2"></i>Loading...</div>';
            const params = new URLSearchParams({ tenantId: POS_STATE.tenantId });
            if (POS_STATE.shiftId) params.append('shiftId', POS_STATE.shiftId);
            if (invoiceFilter) params.append('invoiceNo', invoiceFilter);
            const res = await fetch(`/api/v1/POS/orders/today?${params}`);
            if (!res.ok) { container.innerHTML = '<div style="text-align:center; padding:30px; color:var(--crimson-danger);">Failed to load</div>'; return; }
            const data = await res.json();
            const orders = data.orders || data.Orders || [];
            document.getElementById('feedSummary').textContent = `${data.totalOrders || orders.length} orders • ${(data.totalRevenue || 0).toLocaleString('en-US')} ₫`;
            if (orders.length === 0) { container.innerHTML = '<div style="text-align:center; padding:30px; color:#555;">No orders today</div>'; return; }
            container.innerHTML = orders.map(o => {
                const oid = o.orderId || o.OrderId;
                const statusColor = (o.status || '') === 'Draft' ? 'var(--amber-warn)' : 'var(--bio-emerald)';
                return `<div class="order-feed-card" onclick="toggleFeedExpand(this, ${oid})">
                    <div class="feed-header">
                        <span style="font-family:var(--font-hdr); font-size:0.82rem; color:var(--holo-cyan);"><i class="fa-solid fa-receipt me-1"></i>${o.invoiceNumber || o.InvoiceNumber || 'N/A'}</span>
                        <span class="feed-status-pill" style="border-color:${statusColor}; color:${statusColor};">${o.status || o.Status || 'Paid'}</span>
                    </div>
                    <div class="feed-body">
                        <span style="color:#DDD;">${o.snapshotCustomerName || o.SnapshotCustomerName || 'Walk-in'}</span>
                        <span style="float:right; color:var(--bio-emerald); font-family:var(--font-data); font-size:1.1rem; font-weight:bold;">${(o.totalAmount || o.TotalAmount || 0).toLocaleString('en-US')} ₫</span>
                    </div>
                    <div class="feed-footer">
                        <span><i class="fa-solid fa-clock me-1"></i>${new Date(o.createdAt || o.CreatedAt).toLocaleTimeString('en-GB')}</span>
                        <span>${o.paymentMethod || o.PaymentMethod || 'Cash'}</span>
                    </div>
                    <div class="feed-expand-area" id="feedExpand_${oid}">Loading details...</div>
                </div>`;
            }).join('');
        }

        async function toggleFeedExpand(card, orderId) {
            const area = document.getElementById(`feedExpand_${orderId}`);
            if (area.classList.contains('show')) { area.classList.remove('show'); return; }
            area.classList.add('show');
            try {
                const res = await fetch(`/api/v1/POS/orders/${orderId}/details`);
                if (!res.ok) { area.innerHTML = '<span style="color:var(--crimson-danger);">Failed to load details</span>'; return; }
                const d = await res.json();
                const items = (d.items || d.Items || []).map(i => `<tr><td>${i.sku || i.Sku}</td><td>${i.productName || i.ProductName}</td><td style="text-align:center;">x${i.quantity || i.Quantity}</td><td style="text-align:right;">${(i.lineTotal || 0).toLocaleString('en-US')} ₫</td></tr>`).join('');
                area.innerHTML = `<table class="dash-table" style="font-size:0.75rem;"><thead><tr><th>SKU</th><th>Product</th><th>Qty</th><th style="text-align:right;">Total</th></tr></thead><tbody>${items}</tbody></table>
                <div style="margin-top:8px; display:flex; justify-content:space-between; font-size:0.78rem;"><span style="color:#667;">Gross: ${(d.grossAmount||0).toLocaleString('en-US')} ₫</span><span style="color:var(--amber-warn);">Tax: ${(d.taxAmount||0).toLocaleString('en-US')} ₫</span><span style="color:var(--bio-emerald); font-weight:bold;">Total: ${(d.totalAmount||0).toLocaleString('en-US')} ₫</span></div>`;
            } catch(e) { area.innerHTML = '<span style="color:var(--crimson-danger);">Error loading details</span>'; }
        }

        // ===================================================
        // HAMBURGER MENU
        // ===================================================
        document.getElementById('btnHamburger').addEventListener('click', () => {
            document.getElementById('sideMenu').classList.add('show');
            document.getElementById('sideMenuOverlay').classList.add('show');
        });
        function closeSideMenu() {
            document.getElementById('sideMenu').classList.remove('show');
            document.getElementById('sideMenuOverlay').classList.remove('show');
        }

        // ===================================================
        // LANGUAGE / THEME
        // ===================================================
        function switchLanguage(lang) {
            document.getElementById('langShortCode').textContent = lang;
            document.getElementById('iconVI').className = lang === 'VI' ? 'fa-solid fa-check text-success me-2' : 'fa-solid fa-minus text-muted me-2';
            document.getElementById('iconEN').className = lang === 'EN' ? 'fa-solid fa-check text-success me-2' : 'fa-solid fa-minus text-muted me-2';
        }

        // ===================================================
        // CLOCK & PING
        // ===================================================
        function startClock() {
            function tick() {
                const now = new Date();
                const pad = (n, w = 2) => String(n).padStart(w, '0');
                const ts = `${now.getFullYear()}-${pad(now.getMonth()+1)}-${pad(now.getDate())} ${pad(now.getHours())}:${pad(now.getMinutes())}:${pad(now.getSeconds())} UTC+7`;
                const el = document.getElementById('footerClock');
                if (el) el.textContent = ts;
            }
            tick(); setInterval(tick, 1000);
        }

        async function startPingMonitor() {
            async function doPing() {
                const t0 = performance.now();
                try {
                    const res = await fetch('/api/v1/POS/health/ping', { cache: 'no-store' });
                    const rtt = Math.round(performance.now() - t0);
                    document.getElementById('footerPing').textContent = `${rtt}ms`;
                    document.getElementById('footerPing').style.color = rtt < 10 ? 'var(--bio-emerald)' : rtt < 50 ? 'var(--amber-warn)' : 'var(--crimson-danger)';
                    if (res.ok) { document.getElementById('statusLabel').textContent = 'ONLINE'; document.getElementById('statusLabel').style.color = 'var(--bio-emerald)'; document.getElementById('statusDot').className = 'status-dot'; }
                } catch (e) {
                    document.getElementById('statusLabel').textContent = 'OFFLINE'; document.getElementById('statusLabel').style.color = 'var(--crimson-danger)'; document.getElementById('statusDot').className = 'status-dot offline';
                }
            }
            await doPing(); setInterval(doPing, 5000);
        }

        // ===================================================
        // KEYBOARD SHORTCUTS
        // ===================================================
        window.addEventListener('keydown', e => {
            if (e.key === 'F1') { e.preventDefault(); document.getElementById('posSearchInput').focus(); }
            else if (e.key === 'F5') { e.preventDefault(); holdCurrentOrder(); }
            else if (e.key === 'F12') { e.preventDefault(); openPaymentPanel(); }
            else if (e.key === 'Escape') { closeSideMenu(); closeShiftDrawer(); closeCustomerPalette(); closePaymentPanel(); closeDraftSidebar(); }
            else if (e.ctrlKey && e.key === 'k') { e.preventDefault(); openCustomerPalette(); }
        });

        document.getElementById('posSearchInput').addEventListener('keydown', e => {
            if (e.key === 'Enter') { e.preventDefault(); executeSearch(); }
        });

        // ===================================================
        // BOOT
        // ===================================================
        window.addEventListener('DOMContentLoaded', () => {
            loadHeaderSelectors();
        });
    </script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/cyber-hud.js" asp-append-version="true"></script>
    @await Html.PartialAsync("~/Views/Shared/_CyberNotificationModal.cshtml")
</body>
</html>
