@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DigiPOS - POS Center</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />
    <link rel="stylesheet" href="~/css/cyber-hud.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Rajdhani:wght@600;700&family=Roboto+Mono:wght@400;500;700&family=VT323&display=swap" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <style>
        :root {
            --true-black: #000000;
            --carbon-void: #0A0A0A;
            --bg-void: #000000;
            --bg-surface: #0A0A0A;
            --holo-cyan: #00E5FF;
            --primary-cyan: #00E5FF;
            --bio-emerald: #00FF66;
            --amber-warn: #FFB000;
            --crimson-danger: #FF3333;
            --font-hdr: 'Orbitron', 'Rajdhani', sans-serif;
            --font-data: 'VT323', 'Roboto Mono', monospace;
            --operator-menu-w: 220px;
            --header-h: 64px;
            --footer-h: 36px;
            --register-w: 400px;
        }

        body.light-theme {
            --true-black: #050E14;
            --carbon-void: #0C1A24;
            --bg-void: #050E14;
            --bg-surface: #0C1A24;
            --holo-cyan: #00E5FF;
            --primary-cyan: #00E5FF;
        }

        .hud-navbar {
            position: relative !important;
            flex-shrink: 0 !important;
            height: var(--header-h) !important;
            z-index: 100 !important;
            background: var(--bg-surface, #0A0A0A) !important;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background: var(--true-black);
            color: #EEE;
            font-family: 'Roboto Mono', monospace;
            height: 100vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            user-select: none;
        }

        /* CRT scanline overlay */
        body::before {
            content: "";
            position: fixed;
            inset: 0;
            background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0,0,0,0.08) 2px, rgba(0,0,0,0.08) 4px);
            pointer-events: none;
            z-index: 9999;
        }

        /* ======================================================
           TOP HEADER
        ====================================================== */
        .pos-header {
            height: var(--header-h);
            background: var(--carbon-void);
            border-bottom: 1px solid var(--holo-cyan);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 12px;
            box-shadow: 0 2px 20px rgba(0,229,255,0.2);
            flex-shrink: 0;
            z-index: 100;
        }

        .header-left { display: flex; align-items: center; gap: 10px; }

        .btn-hamburger {
            background: transparent;
            border: 1px solid #333;
            color: var(--holo-cyan);
            width: 34px; height: 34px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1rem; cursor: pointer;
            transition: all 0.15s;
            flex-shrink: 0;
        }
        .btn-hamburger:hover { border-color: var(--holo-cyan); background: rgba(0,229,255,0.1); }

        .pos-brand {
            font-family: var(--font-hdr);
            font-size: 0.95rem;
            font-weight: 900;
            color: #FFF;
            text-decoration: none;
            letter-spacing: 1px;
            display: flex; align-items: center; gap: 8px;
        }
        .pos-brand .hud-logo-svg {
            width: 30px; height: 30px; flex-shrink: 0;
        }
        .pos-brand .brand-name span.accent { color: var(--holo-cyan); }
        .pos-brand .brand-name { display: flex; flex-direction: column; line-height: 1; }
        .pos-brand .brand-name .title-main { font-size: 0.88rem; font-weight: 900; letter-spacing: 1px; }
        .pos-brand .brand-name .title-sub { font-size: 0.52rem; color: #555; letter-spacing: 2px; font-family: 'Roboto Mono', monospace; font-weight: 400; }
        .pos-brand .hud-badge-ver {
            font-size: 0.52rem; font-family: 'Roboto Mono', monospace; font-weight: 400;
            color: var(--holo-cyan); border: 1px solid rgba(0,229,255,0.4);
            padding: 1px 4px; margin-left: 4px; letter-spacing: 1px;
        }

        .header-right { display: flex; align-items: center; gap: 8px; }

        /* Navbar icons & Language — match Administrator HUD */
        .hud-nav-icon-btn, .hud-notif-btn {
            background: #000000; border: 1px solid var(--holo-cyan); color: #FFFFFF;
            width: 38px; height: 38px; font-size: 1rem; display: flex; align-items: center; justify-content: center;
            cursor: pointer; position: relative; transition: all 0.2s ease;
            clip-path: polygon(6px 0, 100% 0, calc(100% - 6px) 100%, 0 100%);
        }
        .hud-lang-btn {
            background: #000000; border-top: 1px solid var(--holo-cyan); border-bottom: 1px solid var(--holo-cyan); border-left: none; border-right: none; color: var(--holo-cyan);
            height: 38px; padding: 0 14px; font-family: var(--font-hdr); font-size: 0.8rem; font-weight: 700;
            display: flex; align-items: center; gap: 8px; cursor: pointer; transition: all 0.2s ease;
            clip-path: polygon(10px 0, 100% 0, calc(100% - 10px) 100%, 0 100%); text-transform: uppercase;
        }
        .hud-lang-btn:hover, .hud-nav-icon-btn:hover, .hud-notif-btn:hover {
            background: rgba(0, 229, 255, 0.15); color: var(--holo-cyan); box-shadow: 0 0 10px rgba(0,229,255,0.4);
        }
        .hud-notif-wrapper { position: relative !important; overflow: visible !important; }
        .hud-notif-badge {
            position: absolute !important; top: -6px !important; right: -6px !important; background: #FF3333 !important; color: #FFFFFF !important;
            font-family: 'VT323', 'Roboto Mono', monospace !important; font-size: 0.85rem !important; font-weight: bold !important;
            padding: 2px 7px !important; border-radius: 4px !important; box-shadow: 0 0 12px #FF3333, 0 0 18px rgba(255, 51, 51, 0.8) !important;
            border: 1px solid rgba(255, 255, 255, 0.6) !important; z-index: 1050 !important; pointer-events: none;
        }
        .hud-profile-trigger {
            display: flex; align-items: center; gap: 14px; padding: 4px 14px 4px 6px;
            border: 1px solid var(--holo-cyan); background: #000000; cursor: pointer;
            transition: all 0.2s ease; height: 38px; box-shadow: 0 0 5px rgba(0, 229, 255, 0.2);
        }
        .hud-profile-trigger:hover { border-color: var(--holo-cyan); box-shadow: 0 0 12px rgba(0, 229, 255, 0.7); background: rgba(0, 229, 255, 0.08); }
        .hud-profile-trigger::after { display: none !important; }

        .hud-avatar-box {
            width: 28px; height: 28px; border: 1px solid var(--holo-cyan); background: transparent; color: var(--holo-cyan);
            display: flex; align-items: center; justify-content: center; font-family: 'VT323', 'Orbitron', monospace; font-size: 1rem; font-weight: 700; text-shadow: 0 0 8px var(--holo-cyan);
        }
        .hud-user-info { display: flex; flex-direction: column; align-items: flex-start; justify-content: center; }
        .hud-user-name { font-family: 'VT323', 'Orbitron', monospace; font-size: 1.15rem; color: #FFFFFF; font-weight: bold; letter-spacing: 2px; line-height: 1; text-shadow: 0 0 4px rgba(255, 255, 255, 0.5); }
        .hud-user-role { font-family: 'VT323', 'Roboto Mono', monospace; font-size: 0.75rem; color: var(--holo-cyan); letter-spacing: 1.5px; line-height: 1; margin-top: 2px; text-shadow: 0 0 6px rgba(0, 229, 255, 0.6); }
        #hudProfileCaret { transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1); display: inline-block; color: var(--holo-cyan); }
        .dropdown-toggle[aria-expanded="true"] #hudProfileCaret, .show > .hud-profile-trigger #hudProfileCaret { transform: rotate(180deg); color: var(--bio-emerald); }

        .dropdown-menu.pos-drop {
            background: #0A0A0A; border: 1px solid var(--holo-cyan); border-radius: 0; min-width: 210px; box-shadow: 0 10px 30px rgba(0,0,0,0.9), 0 0 10px rgba(0,229,255,0.4); backdrop-filter: blur(16px);
        }
        .dropdown-item { color: #D8F8FF; font-family: 'Roboto Mono', monospace; font-size: 0.85rem; padding: 8px 16px; display: flex; align-items: center; }
        .dropdown-item:hover { background: rgba(0,229,255,0.15); color: var(--holo-cyan); padding-left: 20px; transition: all 0.15s ease; }
        .dropdown-divider { border-color: rgba(0,229,255,0.2); }

        /* ======================================================
           WORKSPACE: SIDEBAR + CATALOG + REGISTER
        ====================================================== */
        .pos-workspace {
            flex: 1;
            display: flex;
            overflow: hidden;
        }

        /* -------  LEFT: OPERATOR MENU SIDEBAR  ------- */
        .pos-operator-menu {
            width: var(--operator-menu-w);
            background: #050505;
            border-right: 1px solid #1A1A1A;
            display: flex;
            flex-direction: column;
            flex-shrink: 0;
            overflow-y: auto;
            transition: width 0.2s ease;
        }
        .pos-operator-menu.collapsed { width: 0; overflow: hidden; }
        .pos-operator-menu::-webkit-scrollbar { width: 3px; }
        .pos-operator-menu::-webkit-scrollbar-thumb { background: #1A1A1A; }

        .op-menu-header {
            padding: 10px 14px;
            font-family: var(--font-hdr);
            font-size: 0.65rem;
            color: var(--holo-cyan);
            text-transform: uppercase;
            letter-spacing: 2px;
            border-bottom: 1px solid #111;
            display: flex; align-items: center; gap: 6px;
        }

        .op-menu-section { padding: 8px 14px 4px; font-size: 0.6rem; color: #333; text-transform: uppercase; letter-spacing: 2px; }
        .op-menu-divider { height: 1px; background: #0D0D0D; margin: 4px 0; }

        .op-menu-item {
            display: flex; align-items: center; gap: 10px;
            padding: 9px 14px;
            color: #888;
            cursor: pointer;
            text-decoration: none;
            font-size: 0.82rem;
            border-left: 2px solid transparent;
            transition: all 0.12s;
            white-space: nowrap;
        }
        .op-menu-item:hover { background: rgba(0,229,255,0.06); color: var(--holo-cyan); border-left-color: var(--holo-cyan); }
        .op-menu-item.active { color: var(--bio-emerald); border-left-color: var(--bio-emerald); background: rgba(0,255,102,0.04); }
        .op-menu-item i { width: 16px; text-align: center; font-size: 0.85rem; }

        /* Shift status in operator menu */
        .shift-status-badge {
            display: flex; align-items: center; gap: 6px;
            padding: 6px 14px 2px;
            font-size: 0.7rem; color: #555;
        }
        .shift-status-badge.active-shift { color: var(--bio-emerald); }
        .shift-dot { width: 6px; height: 6px; border-radius: 50%; background: #222; flex-shrink: 0; }
        .shift-dot.active { background: var(--bio-emerald); box-shadow: 0 0 6px var(--bio-emerald); }

        /* -------  CENTER-LEFT: ORDER REGISTER  ------- */
        .pos-register {
            width: var(--register-w);
            display: flex;
            flex-direction: column;
            background: #050505;
            border-right: 1px solid #1A1A1A;
            flex-shrink: 0;
        }

        /* -------  CENTER-RIGHT: CATALOG  ------- */
        .pos-catalog {
            flex: 1;
            display: flex;
            flex-direction: column;
            min-width: 0;
        }

        /* Top toolbar row */
        .catalog-toolbar {
            background: #050505;
            border-bottom: 1px solid #1A1A1A;
            padding: 8px 12px;
            flex-shrink: 0;
        }

        .search-row {
            display: flex;
            gap: 6px;
            margin-bottom: 6px;
        }

        .pos-search-input {
            flex: 1;
            background: #000;
            border: 1px solid #333;
            border-right: none;
            color: #EEE;
            padding: 6px 12px;
            font-family: 'Roboto Mono', monospace;
            font-size: 0.88rem;
            outline: none;
            transition: border-color 0.15s;
        }
        .pos-search-input:focus { border-color: var(--holo-cyan); }

        .btn-search {
            background: var(--holo-cyan);
            border: 1px solid var(--holo-cyan);
            color: #000;
            padding: 6px 14px;
            font-family: var(--font-hdr);
            font-size: 0.75rem;
            font-weight: 700;
            cursor: pointer;
            letter-spacing: 1px;
        }
        .btn-search:hover { background: #000; color: var(--holo-cyan); }

        /* Filter tags row */
        .filter-tags-row {
            display: flex;
            gap: 4px;
            flex-wrap: wrap;
        }

        .btn-filter {
            background: transparent;
            border: 1px solid #2A2A2A;
            color: #888;
            padding: 3px 10px;
            font-size: 0.75rem;
            font-family: 'Rajdhani', sans-serif;
            font-weight: 700;
            text-transform: uppercase;
            cursor: pointer;
            letter-spacing: 0.5px;
            transition: all 0.15s;
        }
        .btn-filter:hover, .btn-filter.active {
            border-color: var(--holo-cyan);
            color: var(--holo-cyan);
            background: rgba(0,229,255,0.08);
        }
        .btn-filter.sort-tag:hover, .btn-filter.sort-tag.active {
            border-color: var(--bio-emerald);
            color: var(--bio-emerald);
            background: rgba(0,255,102,0.06);
        }

        /* Dynamic sub-filter strip */
        .sub-filter-strip {
            background: #030303;
            border-bottom: 1px solid #111;
            padding: 5px 12px;
            display: flex;
            gap: 4px;
            overflow-x: auto;
            min-height: 30px;
            align-items: center;
            flex-shrink: 0;
        }
        .sub-filter-strip::-webkit-scrollbar { height: 3px; }
        .sub-filter-strip::-webkit-scrollbar-thumb { background: #333; }

        .btn-sub-tag {
            background: #000;
            border: 1px dashed #2A2A2A;
            color: #888;
            padding: 2px 8px;
            font-size: 0.72rem;
            font-weight: bold;
            cursor: pointer;
            white-space: nowrap;
            transition: all 0.1s;
        }
        .btn-sub-tag:hover, .btn-sub-tag.active { border-color: var(--holo-cyan); color: var(--holo-cyan); background: rgba(0,229,255,0.06); }

        /* Product grid */
        .product-grid {
            flex: 1;
            overflow-y: auto;
            padding: 10px;
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
            gap: 8px;
            align-content: flex-start;
        }
        .product-grid::-webkit-scrollbar { width: 4px; }
        .product-grid::-webkit-scrollbar-thumb { background: #222; }

        .prod-card {
            background: #0A0A0A;
            border: 1px solid #1E1E1E;
            padding: 8px;
            cursor: pointer;
            position: relative;
            display: flex;
            flex-direction: column;
            height: 170px;
            transition: all 0.15s;
        }
        .prod-card:hover {
            border-color: var(--bio-emerald);
            box-shadow: 0 0 10px rgba(0,255,102,0.2);
            transform: translateY(-1px);
        }
        .prod-card.out-of-stock { opacity: 0.4; cursor: not-allowed; }

        .prod-stock-chip {
            position: absolute;
            top: 5px; right: 5px;
            font-size: 0.65rem;
            font-weight: bold;
            padding: 1px 5px;
            border: 1px solid var(--holo-cyan);
            color: var(--holo-cyan);
            background: #000;
        }
        .prod-stock-chip.low { border-color: var(--amber-warn); color: var(--amber-warn); }
        .prod-stock-chip.zero { border-color: var(--crimson-danger); color: var(--crimson-danger); }

        .prod-sku { font-size: 0.65rem; color: var(--holo-cyan); font-weight: bold; margin-top: 4px; }
        .prod-name {
            font-family: 'Rajdhani', sans-serif;
            font-size: 0.88rem;
            font-weight: 700;
            color: #DDD;
            flex: 1;
            overflow: hidden;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            margin-top: 4px;
        }
        .prod-price {
            font-family: var(--font-data);
            font-size: 1.2rem;
            color: var(--bio-emerald);
            font-weight: bold;
            padding-top: 5px;
            border-top: 1px solid #1A1A1A;
        }
        .prod-unit { font-size: 0.65rem; color: #666; }

        /* Customer row */
        .register-customer-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 6px 10px;
            background: #080808;
            border-bottom: 1px solid #1A1A1A;
            min-height: 36px;
        }

        .customer-info {
            display: flex; align-items: center; gap: 6px;
            font-size: 0.78rem;
        }
        .customer-name { color: var(--holo-cyan); font-weight: bold; font-family: 'Rajdhani', sans-serif; }

        .btn-select-customer {
            background: transparent;
            border: 1px dashed #333;
            color: #666;
            padding: 2px 8px;
            font-size: 0.72rem;
            cursor: pointer;
            transition: all 0.15s;
        }
        .btn-select-customer:hover { border-color: var(--holo-cyan); color: var(--holo-cyan); }

        /* Tabs: NOW / SHIPPING / TEMP */
        .order-tabs {
            display: flex;
            border-bottom: 1px solid #1A1A1A;
        }
        .order-tab {
            flex: 1;
            padding: 7px 4px;
            text-align: center;
            font-family: 'Rajdhani', sans-serif;
            font-size: 0.75rem;
            font-weight: 700;
            color: #555;
            cursor: pointer;
            border-right: 1px solid #111;
            background: #050505;
            transition: all 0.15s;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .order-tab:last-child { border-right: none; }
        .order-tab:hover { color: #AAA; background: #0A0A0A; }
        .order-tab.active { color: var(--holo-cyan); background: rgba(0,229,255,0.06); border-bottom: 2px solid var(--holo-cyan); }

        /* Order # badge */
        .order-no-badge {
            font-family: var(--font-hdr);
            font-size: 0.65rem;
            color: #444;
            padding: 3px 10px;
            border-bottom: 1px solid #111;
        }

        /* Line items table */
        .register-items {
            flex: 1;
            overflow-y: auto;
        }
        .register-items::-webkit-scrollbar { width: 3px; }
        .register-items::-webkit-scrollbar-thumb { background: #222; }

        table.order-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.78rem;
        }
        .order-table thead th {
            background: #080808;
            color: #555;
            font-family: 'Rajdhani', sans-serif;
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            padding: 5px 8px;
            border-bottom: 1px solid #1A1A1A;
            position: sticky; top: 0;
        }
        .order-table tbody td {
            padding: 6px 8px;
            border-bottom: 1px solid #0D0D0D;
            vertical-align: middle;
        }
        .order-table tbody tr:hover td { background: rgba(0,229,255,0.03); }

        .btn-void {
            background: transparent;
            border: 1px solid #333;
            color: #666;
            padding: 1px 5px;
            font-size: 0.7rem;
            cursor: pointer;
            transition: all 0.1s;
        }
        .btn-void:hover { border-color: var(--crimson-danger); color: var(--crimson-danger); }

        /* Billing strip */
        .billing-strip {
            background: #030303;
            border-top: 1px solid #1A1A1A;
            padding: 8px 10px;
        }

        .billing-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 2px 0;
            font-size: 0.78rem;
        }
        .billing-row span:first-child { color: #666; }
        .billing-row span:last-child { color: #CCC; font-weight: bold; }

        .billing-total-row {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            padding: 5px 0 3px;
            border-top: 1px solid #1A1A1A;
            margin-top: 4px;
        }
        .total-label { font-family: var(--font-hdr); font-size: 0.75rem; color: #AAA; text-transform: uppercase; }
        .total-amount { font-family: var(--font-data); font-size: 2rem; color: var(--bio-emerald); font-weight: bold; line-height: 1; }

        /* Action buttons */
        .register-actions {
            padding: 8px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 5px;
            border-top: 1px solid #1A1A1A;
        }

        .btn-action {
            padding: 8px 6px;
            font-family: 'Rajdhani', sans-serif;
            font-size: 0.8rem;
            font-weight: 700;
            cursor: pointer;
            border: 1px solid;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            display: flex; align-items: center; justify-content: center; gap: 5px;
            transition: all 0.15s;
        }
        .btn-hold { background: transparent; border-color: var(--amber-warn); color: var(--amber-warn); }
        .btn-hold:hover { background: rgba(255,176,0,0.1); }
        .btn-ship { background: transparent; border-color: var(--holo-cyan); color: var(--holo-cyan); }
        .btn-ship:hover { background: rgba(0,229,255,0.1); }
        .btn-payment {
            grid-column: span 2;
            background: var(--bio-emerald);
            border-color: var(--bio-emerald);
            color: #000;
            font-size: 0.95rem;
            padding: 10px;
            box-shadow: 0 0 15px rgba(0,255,102,0.3);
        }
        .btn-payment:hover { background: #000; color: var(--bio-emerald); box-shadow: 0 0 20px rgba(0,255,102,0.5); }
        .btn-payment:disabled { opacity: 0.4; cursor: not-allowed; box-shadow: none; }

        /* ======================================================
           FOOTER TELEMETRY STRIP (Synchronized with Admin HUD Theme)
        ====================================================== */
        .pos-footer, .hud-footer {
            height: var(--footer-h, 36px) !important;
            background: var(--bg-surface, #0A0A0A) !important;
            border-top: 1px solid rgba(0, 229, 255, 0.4) !important;
            display: flex !important;
            align-items: center !important;
            justify-content: space-between !important;
            padding: 0 1.25rem !important;
            font-family: 'Roboto Mono', 'VT323', monospace !important;
            font-size: 0.75rem !important;
            color: var(--primary-cyan, #00E5FF) !important;
            flex-shrink: 0 !important;
            position: relative !important;
            backdrop-filter: blur(10px) !important;
            z-index: 100 !important;
        }

        .footer-left { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; color: var(--holo-cyan, #00E5FF); }
        .footer-status { display: flex; align-items: center; gap: 4px; color: var(--holo-cyan, #00E5FF); }
        .status-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--bio-emerald); box-shadow: 0 0 8px var(--bio-emerald); animation: posPingBlink 1.5s infinite alternate; }
        .status-dot.offline { background: var(--crimson-danger); box-shadow: 0 0 6px var(--crimson-danger); animation: none; }
        @@keyframes posPingBlink { 0% { opacity: 0.3; } 100% { opacity: 1; } }
        .ping-val { color: var(--holo-cyan); font-weight: bold; }
        .footer-meta { color: var(--holo-cyan, #00E5FF); display: flex; align-items: center; gap: 4px; }
        .footer-clock { color: #E0E0E0; font-family: 'Roboto Mono', 'VT323', monospace; font-size: 0.8rem; }

        /* ======================================================
           SLIDE-OUT SIDEBAR MENU (hamburger)
        ====================================================== */
        .side-menu-overlay {
            position: fixed; inset: 0;
            background: rgba(0,0,0,0.7);
            z-index: 200;
            display: none;
        }
        .side-menu-overlay.show { display: block; }

        .side-menu {
            position: fixed;
            top: 0; left: 0;
            width: 240px; height: 100vh;
            background: #060606;
            border-right: 1px solid var(--holo-cyan);
            box-shadow: 4px 0 30px rgba(0,229,255,0.15);
            z-index: 201;
            transform: translateX(-100%);
            transition: transform 0.2s ease;
            overflow-y: auto;
        }
        .side-menu.show { transform: translateX(0); }

        .side-menu-header {
            padding: 14px 16px 10px;
            font-family: var(--font-hdr);
            font-size: 0.75rem;
            color: var(--holo-cyan);
            border-bottom: 1px solid #111;
            display: flex; align-items: center; gap: 8px;
        }

        .side-menu-item {
            display: flex; align-items: center; gap: 12px;
            padding: 11px 18px;
            color: #CCC;
            cursor: pointer;
            font-size: 0.88rem;
            border-left: 2px solid transparent;
            transition: all 0.15s;
        }
        .side-menu-item:hover { background: rgba(0,229,255,0.07); color: var(--holo-cyan); border-left-color: var(--holo-cyan); }
        .side-menu-item i { width: 18px; text-align: center; }

        .side-menu-divider { height: 1px; background: #111; margin: 6px 0; }
        .side-menu-section { padding: 8px 18px 4px; font-size: 0.65rem; color: #444; text-transform: uppercase; letter-spacing: 2px; }

        /* ======================================================
           MODALS (shared base)
        ====================================================== */
        .pos-modal-bg {
            position: fixed; inset: 0;
            background: rgba(0,0,0,0.85);
            z-index: 500;
            display: none;
            align-items: center;
            justify-content: center;
        }
        .pos-modal-bg.show { display: flex; }

        .pos-modal {
            background: #0A0A0A;
            border: 1px solid var(--holo-cyan);
            box-shadow: 0 0 40px rgba(0,229,255,0.2);
            width: 90%;
            max-height: 90vh;
            overflow-y: auto;
            position: relative;
        }
        .pos-modal::-webkit-scrollbar { width: 4px; }
        .pos-modal::-webkit-scrollbar-thumb { background: #333; }

        .modal-hdr {
            display: flex; align-items: center; justify-content: space-between;
            padding: 12px 16px;
            border-bottom: 1px solid #1A1A1A;
            background: #060606;
        }
        .modal-title {
            font-family: var(--font-hdr);
            font-size: 0.9rem;
            color: var(--holo-cyan);
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .btn-close-modal {
            background: transparent;
            border: 1px solid #333;
            color: #888;
            width: 28px; height: 28px;
            display: flex; align-items: center; justify-content: center;
            cursor: pointer; font-size: 0.9rem;
            transition: all 0.15s;
        }
        .btn-close-modal:hover { border-color: var(--crimson-danger); color: var(--crimson-danger); }

        .modal-body { padding: 16px; }
        .modal-footer {
            padding: 10px 16px;
            border-top: 1px solid #1A1A1A;
            display: flex; gap: 8px; justify-content: flex-end;
        }

        /* Form controls inside modals */
        .pos-input, .pos-select {
            background: #000;
            border: 1px solid #333;
            color: #EEE;
            padding: 7px 10px;
            font-family: 'Roboto Mono', monospace;
            font-size: 0.85rem;
            width: 100%;
            outline: none;
            transition: border-color 0.15s;
            -webkit-appearance: none;
        }
        .pos-input:focus, .pos-select:focus { border-color: var(--holo-cyan); }
        .pos-select option { background: #111; }

        .form-row { margin-bottom: 12px; }
        .form-label { display: block; font-size: 0.72rem; color: #666; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px; }

        /* Buttons in modals */
        .btn-pos-primary {
            background: var(--holo-cyan); border: 1px solid var(--holo-cyan); color: #000;
            padding: 8px 18px; font-family: var(--font-hdr); font-size: 0.78rem; font-weight: 700;
            cursor: pointer; letter-spacing: 1px; text-transform: uppercase; transition: all 0.15s;
        }
        .btn-pos-primary:hover { background: #000; color: var(--holo-cyan); }
        .btn-pos-primary:disabled { opacity: 0.4; cursor: not-allowed; }

        .btn-pos-success {
            background: var(--bio-emerald); border: 1px solid var(--bio-emerald); color: #000;
            padding: 8px 18px; font-family: var(--font-hdr); font-size: 0.78rem; font-weight: 700;
            cursor: pointer; letter-spacing: 1px; text-transform: uppercase; transition: all 0.15s;
        }
        .btn-pos-success:hover { background: #000; color: var(--bio-emerald); }

        .btn-pos-secondary {
            background: transparent; border: 1px solid #444; color: #888;
            padding: 8px 18px; font-family: 'Rajdhani', sans-serif; font-size: 0.78rem; font-weight: 700;
            cursor: pointer; transition: all 0.15s;
        }
        .btn-pos-secondary:hover { border-color: #888; color: #CCC; }

        /* ======================================================
           START SHIFT MODAL
        ====================================================== */
        #modalStartShift .pos-modal { max-width: 600px; }

        .shift-info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-bottom: 14px;
        }
        .shift-info-item label { font-size: 0.7rem; color: #555; text-transform: uppercase; letter-spacing: 0.5px; display: block; margin-bottom: 3px; }
        .shift-info-item span { font-family: var(--font-hdr); font-size: 0.85rem; color: #CCC; }

        /* Cash denomination table */
        .denom-table { width: 100%; border-collapse: collapse; font-size: 0.8rem; }
        .denom-table th { background: #060606; color: #555; font-size: 0.7rem; text-transform: uppercase; padding: 5px 8px; border-bottom: 1px solid #1A1A1A; text-align: right; }
        .denom-table th:first-child { text-align: left; }
        .denom-table td { padding: 5px 8px; border-bottom: 1px solid #0D0D0D; text-align: right; }
        .denom-table td:first-child { text-align: left; color: #888; }
        .denom-input { background: #000; border: 1px solid #222; color: #EEE; padding: 3px 6px; width: 60px; text-align: right; font-size: 0.8rem; outline: none; }
        .denom-input:focus { border-color: var(--holo-cyan); }
        .denom-total { color: var(--bio-emerald); font-family: var(--font-data); }

        /* Unfinished orders list in shift modal */
        .pending-order-item {
            display: flex; justify-content: space-between; align-items: center;
            padding: 6px 10px;
            border: 1px solid #111;
            margin-bottom: 4px;
            font-size: 0.78rem;
        }
        .pending-order-item:hover { border-color: #333; }

        /* ======================================================
           PAYMENT MODAL
        ====================================================== */
        #modalPayment .pos-modal { max-width: 560px; }

        .payment-method-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 6px;
            margin-bottom: 14px;
        }
        .payment-method-btn {
            padding: 10px 6px;
            background: #000;
            border: 1px solid #222;
            color: #888;
            font-family: 'Rajdhani', sans-serif;
            font-weight: 700;
            font-size: 0.8rem;
            cursor: pointer;
            text-align: center;
            transition: all 0.15s;
            display: flex; flex-direction: column; align-items: center; gap: 4px;
        }
        .payment-method-btn:hover { border-color: var(--holo-cyan); color: var(--holo-cyan); }
        .payment-method-btn.selected { border-color: var(--bio-emerald); color: var(--bio-emerald); background: rgba(0,255,102,0.06); }
        .payment-method-btn i { font-size: 1.2rem; }

        .payment-summary-row {
            display: flex; justify-content: space-between; align-items: baseline;
            padding: 3px 0;
            font-size: 0.82rem;
        }
        .payment-summary-row span:first-child { color: #666; }
        .payment-total-row {
            display: flex; justify-content: space-between; align-items: baseline;
            padding: 8px 0 0;
            border-top: 1px solid #1A1A1A;
        }
        .payment-total-label { font-family: var(--font-hdr); font-size: 0.78rem; color: #AAA; }
        .payment-total-val { font-family: var(--font-data); font-size: 2.2rem; color: var(--bio-emerald); }

        .change-highlight { font-family: var(--font-data); font-size: 1.5rem; color: var(--holo-cyan); font-weight: bold; }

        /* ======================================================
           PAYMENT SUCCESS MODAL
        ====================================================== */
        #modalPaySuccess .pos-modal { max-width: 400px; text-align: center; }

        .success-icon { font-size: 3rem; color: var(--bio-emerald); margin: 16px 0 8px; }
        .success-invoice { font-family: var(--font-hdr); font-size: 1rem; color: var(--holo-cyan); }
        .success-total { font-family: var(--font-data); font-size: 2rem; color: var(--bio-emerald); }
        .success-meta { font-size: 0.78rem; color: #666; margin: 8px 0; }

        /* ======================================================
           ORDERS TODAY MODAL
        ====================================================== */
        #modalOrdersToday .pos-modal { max-width: 700px; }

        .orders-filter-row {
            display: flex; gap: 8px; margin-bottom: 12px;
        }

        .orders-table { width: 100%; border-collapse: collapse; font-size: 0.8rem; }
        .orders-table th { background: #060606; color: #555; padding: 6px 10px; font-size: 0.7rem; text-transform: uppercase; border-bottom: 1px solid #1A1A1A; }
        .orders-table td { padding: 7px 10px; border-bottom: 1px solid #0D0D0D; }
        .orders-table tr:hover td { background: rgba(0,229,255,0.03); cursor: pointer; }
        .orders-summary-row { display: flex; justify-content: space-between; margin-top: 10px; font-size: 0.82rem; color: #666; }

        /* ======================================================
           POS DASHBOARD MODAL
        ====================================================== */
        #modalDashboard .pos-modal { max-width: 640px; }

        .kpi-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 16px; }
        .kpi-card {
            background: #060606;
            border: 1px solid #1A1A1A;
            padding: 12px 10px;
            text-align: center;
        }
        .kpi-label { font-size: 0.65rem; color: #555; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 4px; }
        .kpi-value { font-family: var(--font-data); font-size: 1.8rem; color: var(--holo-cyan); }
        .kpi-sub { font-size: 0.7rem; color: #444; margin-top: 2px; }

        .top-products-table { width: 100%; border-collapse: collapse; font-size: 0.8rem; }
        .top-products-table th { background: #060606; color: #555; padding: 5px 8px; font-size: 0.7rem; text-transform: uppercase; border-bottom: 1px solid #1A1A1A; }
        .top-products-table td { padding: 6px 8px; border-bottom: 1px solid #0D0D0D; }

        /* ======================================================
           VIP CUSTOMER MODAL
        ====================================================== */
        #modalVip .pos-modal { max-width: 680px; }

        .vip-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
        .vip-list { border: 1px solid #1A1A1A; max-height: 350px; overflow-y: auto; }
        .vip-list::-webkit-scrollbar { width: 3px; }
        .vip-list-item {
            padding: 8px 12px;
            cursor: pointer;
            border-bottom: 1px solid #0D0D0D;
            font-size: 0.82rem;
        }
        .vip-list-item:hover { background: rgba(0,229,255,0.06); color: var(--holo-cyan); }
        .vip-list-item.selected { background: rgba(0,255,102,0.06); border-left: 2px solid var(--bio-emerald); }
        .vip-list-item .vip-code { font-size: 0.7rem; color: #555; }
        .vip-list-item .vip-name { font-weight: bold; color: #DDD; }
        .vip-list-item .vip-phone { font-size: 0.72rem; color: #888; }

        .vip-detail { border: 1px solid #1A1A1A; padding: 12px; }
        .vip-detail-row { display: flex; justify-content: space-between; padding: 4px 0; border-bottom: 1px solid #0D0D0D; font-size: 0.8rem; }
        .vip-detail-row label { color: #555; }
        .vip-detail-row span { color: #DDD; font-weight: bold; }
        .reward-points { font-family: var(--font-data); font-size: 1.5rem; color: var(--amber-warn); }

        /* ======================================================
           SETUP GATE (Pre-POS Setup Form)
        ====================================================== */
        #setupGate {
            position: fixed; inset: 0;
            background: #000;
            z-index: 1000;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .setup-card {
            background: #0A0A0A;
            border: 1px solid var(--holo-cyan);
            box-shadow: 0 0 60px rgba(0,229,255,0.15);
            padding: 32px;
            width: 90%;
            max-width: 420px;
        }
        .setup-logo {
            font-family: var(--font-hdr);
            font-size: 1.2rem;
            font-weight: 900;
            color: #FFF;
            text-align: center;
            margin-bottom: 6px;
        }
        .setup-logo span { color: var(--holo-cyan); }
        .setup-subtitle { text-align: center; font-size: 0.72rem; color: #555; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 24px; }

        .setup-step-indicator {
            display: flex; gap: 6px; justify-content: center; margin-bottom: 20px;
        }
        .step-dot { width: 8px; height: 8px; border-radius: 50%; background: #222; transition: all 0.2s; }
        .step-dot.active { background: var(--holo-cyan); box-shadow: 0 0 8px var(--holo-cyan); }
        .step-dot.done { background: var(--bio-emerald); }

        .inventory-chips { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 8px; }
        .inv-chip { padding: 3px 10px; border: 1px solid #222; font-size: 0.72rem; color: #666; }
        .inv-chip.good { border-color: var(--bio-emerald); color: var(--bio-emerald); }
        .inv-chip.warn { border-color: var(--amber-warn); color: var(--amber-warn); }
        .inv-chip.bad { border-color: var(--crimson-danger); color: var(--crimson-danger); }
    </style>
</head>
<body>

    <!-- ====================================================
         SETUP GATE — Counter selection only
         Tenant is determined from auth claim (server-side)
    ==================================================== -->
    <div id="setupGate">
        <div class="setup-card" style="position: relative;">
            <button type="button" onclick="closeSetupGate(); if(!POS_STATE || !POS_STATE.counterId) window.location.href='/';" title="Close Terminal Setup" style="position: absolute; top: 12px; right: 12px; background: rgba(255, 51, 102, 0.15); border: 1px solid #FF3366; color: #FF3366; width: 32px; height: 32px; border-radius: 4px; cursor: pointer; display: flex; align-items: center; justify-content: center; z-index: 99999; transition: all 0.2s;">
                <i class="fa-solid fa-xmark" style="font-size: 1.1rem;"></i>
            </button>
            <div class="setup-logo" style="display:flex; align-items:center; justify-content:center; gap:10px; margin-bottom:4px;">
                <svg width="36" height="36" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <polygon points="50,5 95,27 95,73 50,95 5,73 5,27" stroke="#00E5FF" stroke-width="4" fill="rgba(0,229,255,0.1)"/>
                    <circle cx="50" cy="50" r="24" stroke="#00E5FF" stroke-width="3" stroke-dasharray="6 4"/>
                    <circle cx="50" cy="50" r="8" fill="#00FF66"/>
                    <line x1="50" y1="15" x2="50" y2="35" stroke="#00E5FF" stroke-width="3"/>
                    <line x1="50" y1="65" x2="50" y2="85" stroke="#00E5FF" stroke-width="3"/>
                    <line x1="15" y1="50" x2="35" y2="50" stroke="#00E5FF" stroke-width="3"/>
                    <line x1="65" y1="50" x2="85" y2="50" stroke="#00E5FF" stroke-width="3"/>
                </svg>
                <div>
                    <div style="font-family:var(--font-hdr); font-size:1.2rem; font-weight:900; color:#FFF; letter-spacing:2px;">Digi<span style="color:var(--holo-cyan);">POSE</span> <span style="font-size:0.6rem; color:var(--holo-cyan); border:1px solid rgba(0,229,255,0.4); padding:1px 5px;">v1.0</span></div>
                    <div style="font-size:0.62rem; color:#555; font-family:'Roboto Mono',monospace; letter-spacing:2px; text-transform:uppercase;">POS Terminal</div>
                </div>
            </div>
            <div class="setup-subtitle">POS Terminal Setup</div>

            <div class="setup-step-indicator">
                <div class="step-dot active" id="step1dot"></div>
                <div class="step-dot" id="step2dot"></div>
            </div>

            <!-- Tenant Selection or Quarantine Enforcement -->
            @if (ViewBag.IsQuarantined == true)
            {
                <div class="quarantine-lockdown" style="border: 2px solid #FF3366; background: rgba(255, 51, 102, 0.08); padding: 22px; text-align: center; border-radius: 4px; box-shadow: 0 0 20px rgba(255, 51, 102, 0.3); margin-bottom: 20px;">
                    <i class="fa-solid fa-shield-halved text-danger mb-3" style="font-size: 2.8rem; color: #FF3366 !important;"></i>
                    <h5 style="font-family: var(--font-hdr); font-weight: 800; color: #FF3366; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 12px;">
                        >>> TERMINAL QUARANTINED
                    </h5>
                    <div style="font-family: 'Roboto Mono', monospace; font-size: 0.85rem; color: #FFF; line-height: 1.6; margin-bottom: 12px; text-align: left;">
                        <span style="color: #FF3366; font-weight: bold;">[ERROR]:</span> ACCESS DENIED // NO AUTHORIZED ROUTING IN [USER_TENANTS] TABLE.
                    </div>
                    <p style="font-family: 'Roboto Mono', monospace; font-size: 0.8rem; color: #AAA; line-height: 1.5; margin-bottom: 0; text-align: left;">
                        System fallback to HQ Tenant 1 is strictly prohibited under Zero-Trust operational protocols. Please contact your Principal Security Officer to grant terminal credentials in the UserTenants ledger.
                    </p>
                    <a href="/" class="btn-pos-primary mt-4" style="background: #FF3366; color:#000; border: none; font-weight: 900; display:block; text-align:center; text-decoration:none;">
                        <i class="fa-solid fa-arrow-left me-2"></i>RETURN TO COMMAND CENTER
                    </a>
                </div>
            }
            else
            {
                @if (ViewBag.IsSuperAdmin == true)
                {
                    <div class="form-row mb-3">
                        <label class="form-label text-cyan"><i class="fa-solid fa-sitemap me-1"></i> Super Admin Tenant Switching</label>
                        <select id="adminTenantSelect" class="pos-select" style="border-color: var(--holo-cyan);" onchange="onAdminTenantSwitch(this)">
                            @foreach (var br in (IEnumerable<DigiPOSE.Models.Tenant>)ViewBag.AllTenants)
                            {
                                if (br.TenantId == (int)ViewBag.AuthorizedTenantId)
                                {
                                    <option value="@br.TenantId" selected>@br.TenantName (ID: @br.TenantId)</option>
                                }
                                else
                                {
                                    <option value="@br.TenantId">@br.TenantName (ID: @br.TenantId)</option>
                                }
                            }
                        </select>
                        <small style="font-size: 0.65rem; color: #777;">Super Admin privileges grant omni-channel terminal control across all physical tenants.</small>
                    </div>
                }
                else
                {
                    <div style="border:1px solid #1A1A1A; padding:8px 12px; margin-bottom:14px; display:flex; align-items:center; gap:8px;">
                        <i class="fa-solid fa-code-tenant" style="color:var(--holo-cyan);"></i>
                        <div>
                            <div style="font-size:0.65rem; color:#555; text-transform:uppercase; letter-spacing:1px;">Assigned Tenant (Verified)</div>
                            <div style="font-family:var(--font-hdr); font-size:0.9rem; color:var(--holo-cyan);">@ViewBag.AuthorizedTenantName</div>
                        </div>
                        <span style="margin-left:auto; font-size:0.65rem; color:#444; border:1px solid #222; padding:2px 6px;">ID: @ViewBag.AuthorizedTenantId</span>
                    </div>
                }

                <!-- Step 1: Counter selection -->
                <div id="setupStep1">
                    <div class="form-row">
                        <label class="form-label">Select Counter / Terminal</label>
                        <select id="setupCounterSel" class="pos-select">
                            <option value="">-- Loading counters... --</option>
                        </select>
                    </div>
                    <div class="form-row">
                        <label class="form-label">Tenant Inventory Status</label>
                        <div class="inventory-chips" id="inventoryChips">
                            <span style="color:#444; font-size:0.72rem;">Loading...</span>
                        </div>
                    </div>
                    <button class="btn-pos-primary" style="width:100%; margin-top:4px;" id="btnStep1Next" onclick="confirmSetup()" disabled>
                        <i class="fa-solid fa-terminal me-1"></i>Enter POS
                    </button>
                </div>
            }

            <!-- Step 2: Initializing -->
            <div id="setupStep2" style="display:none; text-align:center;">
                <div style="margin:16px 0;">
                    <i class="fa-solid fa-gear fa-spin" style="font-size:2rem; color:var(--holo-cyan);"></i>
                </div>
                <div style="font-family:var(--font-hdr); color:#AAA; font-size:0.85rem;">Initializing POS Engine...</div>
                <div id="setupProgressMsg" style="font-size:0.72rem; color:#555; margin-top:6px;">Loading catalog...</div>
            </div>
        </div>
    </div>

                  <!-- ====================================================
         TOP HEADER (Synchronized with Administrator Command HUD)
    ==================================================== -->
    <header class="hud-navbar">
        <!-- Left Navbar -->
        <div class="hud-navbar-left">
            <button type="button" class="hud-toggle-btn" id="btnHamburger" title="Operator Menu">
                <i class="fa-solid fa-bars"></i>
            </button>
            <a class="hud-brand" href="/Home/Index" title="System Home">
                <svg class="hud-logo-icon" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <polygon points="50,5 95,27 95,73 50,95 5,73 5,27" stroke="#00E5FF" stroke-width="4" fill="rgba(0, 229, 255, 0.1)"/>
                    <circle cx="50" cy="50" r="24" stroke="#00E5FF" stroke-width="3" stroke-dasharray="6 4"/>
                    <circle cx="50" cy="50" r="8" fill="#00FF66"/>
                    <line x1="50" y1="15" x2="50" y2="35" stroke="#00E5FF" stroke-width="3"/>
                    <line x1="50" y1="65" x2="50" y2="85" stroke="#00E5FF" stroke-width="3"/>
                    <line x1="15" y1="50" x2="35" y2="50" stroke="#00E5FF" stroke-width="3"/>
                    <line x1="65" y1="50" x2="85" y2="50" stroke="#00E5FF" stroke-width="3"/>
                </svg>
                <div class="hud-brand-title">
                    Digi<span>POSE</span> HUD <span class="hud-badge-ver">v1.0</span>
                </div>
            </a>
        </div>

        <!-- Right Navbar Actions -->
        <div class="hud-navbar-right">
            <!-- Language Selector (Icon + Text) -->
            <button type="button" class="hud-lang-btn" id="langToggleBtn" title="Switch Language (English / Tiếng Việt)">
                <i class="fa-solid fa-globe"></i>
                <span id="langText">English</span>
            </button>

            <!-- Dark / Light Mode Switcher (Icon Only) -->
            <button type="button" class="hud-nav-icon-btn" id="themeToggleBtn" title="Toggle Dark (Void) / Light (Holo) Mode">
                <i class="fa-solid fa-sun" id="themeIcon"></i>
            </button>

            <!-- Notification Dropdown (Icon Only + Red Badge Outside) -->
            <div class="dropdown hud-notif-wrapper">
                <button class="hud-notif-btn" type="button" id="notifDropdown" data-bs-toggle="dropdown" aria-expanded="false" title="Notifications">
                    <i class="fa-solid fa-bell" style="font-size: 1.1rem; color: #FFFFFF;"></i>
                    <span class="hud-notif-badge" id="hudNotifBadge">3</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end hud-dropdown-menu" aria-labelledby="notifDropdown" id="hudNotifMenu">
                    <li><h6 class="dropdown-header text-cyan" style="color:#00E5FF; font-family:'Orbitron';">TELEMETRY ALERTS</h6></li>
                    <li><a class="dropdown-item" href="#"><i class="fa-solid fa-triangle-exclamation text-warning me-2"></i> SKU-109 inventory below minimum threshold</a></li>
                    <li><a class="dropdown-item" href="#"><i class="fa-solid fa-circle-check text-success me-2"></i> POS terminal engine synchronized</a></li>
                </ul>
            </div>

            <!-- Profile Dropdown -->
            @{
                string? userAvatar = User.FindFirst("AvatarUrl")?.Value;
            }
            <div class="dropdown">
                <div class="hud-profile-trigger dropdown-toggle" id="profileDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    <div class="hud-avatar-box" style="overflow: hidden; padding: 0;">
                        @if (!string.IsNullOrEmpty(userAvatar))
                        {
                            <img src="~/uploads/avatars/@userAvatar" alt="Avatar" style="width: 100%; height: 100%; object-fit: cover;" />
                        }
                        else
                        {
                            <span>@(User.Identity?.Name != null && User.Identity.Name.Length >= 2 ? User.Identity.Name.Substring(0, 2).ToUpper() : "OP")</span>
                        }
                    </div>
                    <div class="hud-user-info">
                        <span class="hud-user-name">@(User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "COMMANDER")</span>
                        <span class="hud-user-role">@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "POS OPERATOR")</span>
                    </div>
                    <i class="fa-solid fa-caret-down text-cyan ms-2" id="hudProfileCaret" style="font-size: 0.75rem; transition: transform 0.2s ease;"></i>
                </div>
                <ul class="dropdown-menu dropdown-menu-end hud-dropdown-menu" aria-labelledby="profileDropdown">
                    <li><a class="dropdown-item" href="/Home/DashboardRouter"><i class="fa-solid fa-user-shield me-2" style="color: #FFB000;"></i> Role Portal Home</a></li>
                    <li><a class="dropdown-item" href="/Home/Index"><i class="fa-solid fa-house-user me-2" style="color: #00E5FF;"></i> User Portal Home</a></li>
                    <li><a class="dropdown-item" href="/Home/Storefront/Index"><i class="fa-solid fa-store me-2" style="color: #0088FF;"></i> Corporate Storefront</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item" asp-area="" asp-controller="Profile" asp-action="Index"><i class="fa-solid fa-id-card me-2" style="color: #00E5FF;"></i> View Profile</a></li>
                    <li><a class="dropdown-item" asp-area="" asp-controller="Profile" asp-action="Index" asp-fragment="orders-tab"><i class="fa-solid fa-boxes-stacked me-2" style="color: #00FF66;"></i> My Orders</a></li>
                    <li><a class="dropdown-item" asp-area="" asp-controller="Auth" asp-action="ChangePassword"><i class="fa-solid fa-key me-2" style="color: #FFB000;"></i> Change Password</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item text-danger" asp-area="" asp-controller="Auth" asp-action="Logout"><i class="fa-solid fa-power-off me-2"></i> Log Out</a></li>
                </ul>
            </div>
        </div>
    </header>

    <!-- ====================================================
         MAIN WORKSPACE: [OPERATOR MENU] [REGISTER] [CATALOG]
    ==================================================== -->
    <div class="pos-workspace">

        <!-- LEFTMOST: OPERATOR MENU (toggle with hamburger) -->
        <aside class="pos-operator-menu" id="posOperatorMenu">
            <div class="op-menu-header">
                <i class="fa-solid fa-terminal"></i>
                OPERATOR MENU
            </div>

            <!-- Shift status indicator -->
            <div class="shift-status-badge" id="sidebarShiftStatus">
                <div class="shift-dot" id="shiftDot"></div>
                <span id="shiftStatusLabel">No Active Shift</span>
            </div>
            <div class="op-menu-divider"></div>

            <!-- POS Operations -->
            <div class="op-menu-section">POS Operations</div>
            <div class="op-menu-item" onclick="openDashboard()">
                <i class="fa-solid fa-chart-line" style="color:var(--holo-cyan);"></i> Dashboard
            </div>
            <div class="op-menu-item" id="opMenuStartShift" onclick="openStartShift()">
                <i class="fa-solid fa-clock-rotate-left" style="color:var(--amber-warn);"></i> Start Shift
            </div>
            <div class="op-menu-item" id="opMenuCloseShift" onclick="openCloseShift()" style="display:none;">
                <i class="fa-solid fa-door-open" style="color:var(--crimson-danger);"></i> Close Shift
            </div>
            <div class="op-menu-item" onclick="openVip()">
                <i class="fa-solid fa-id-badge" style="color:var(--bio-emerald);"></i> VIP Customer
            </div>
            <div class="op-menu-item" onclick="openOrdersToday()">
                <i class="fa-solid fa-receipt" style="color:#CCC;"></i> Orders Today
            </div>
            <div class="op-menu-item" onclick="switchCounter()">
                <i class="fa-solid fa-desktop" style="color:var(--holo-cyan);"></i> Switch Counter
            </div>

            <div class="op-menu-divider"></div>
            <!-- Catalog Filters -->
            <div class="op-menu-section">Catalog</div>
            <div class="op-menu-item" onclick="setPrimaryFilter('all', null)">
                <i class="fa-solid fa-border-all" style="color: #00E5FF;"></i> All Products
            </div>
            <div class="op-menu-item" onclick="setPrimaryFilter('category', null)">
                <i class="fa-solid fa-tags" style="color: #00FF66;"></i> By Category
            </div>
            <div class="op-menu-item" onclick="setPrimaryFilter('manufacturer', null)">
                <i class="fa-solid fa-industry" style="color: #FFB000;"></i> By Manufacturer
            </div>
            <div id="sidebarCategories"></div>

            @if (User.IsInRole("Super Admin") || User.IsInRole("Tenant Manager") || User.IsInRole("Admin") || User.IsInRole("Administrator"))
            {
                <div class="op-menu-divider"></div>
                <div class="op-menu-section">Admin: Sales</div>
                <a class="op-menu-item" href="/Administrator/Orders/Index">
                    <i class="fa-solid fa-receipt" style="color: #FFB000;"></i> Sales Orders
                </a>
                <a class="op-menu-item" href="/Administrator/Retails/Index">
                    <i class="fa-solid fa-file-invoice" style="color: #00E5FF;"></i> Retail Docs
                </a>
                <a class="op-menu-item" href="/Home/DashboardRouter">
                    <i class="fa-solid fa-user-shield" style="color: #00FF66;"></i> Role Home
                </a>
            }
            <div class="op-menu-divider"></div>
            <div class="op-menu-section">Links & Terminals</div>
            <a class="op-menu-item" href="/Home/Storefront/Index" style="border: 1px solid #0088FF; box-shadow: 0 0 10px rgba(0, 136, 255, 0.15); background: rgba(0, 136, 255, 0.03); margin-bottom: 4px; color: #0088FF;">
                <i class="fa-solid fa-store" style="color: #0088FF;"></i> Online Storefront
            </a>
            <a class="op-menu-item" href="/Home/Index" style="border: 1px solid #00E5FF; box-shadow: 0 0 10px rgba(0, 229, 255, 0.15); background: rgba(0, 229, 255, 0.03); color: #00E5FF;">
                <i class="fa-solid fa-house-user" style="color: #00E5FF;"></i> Home
            </a>
        </aside>

        <!-- CENTER-LEFT: ORDER REGISTER -->
        <section class="pos-register">
            <!-- Customer row -->
            <div class="register-customer-row">
                <div class="customer-info">
                    <i class="fa-solid fa-user" style="color:#444; font-size:0.85rem;"></i>
                    <span class="customer-name" id="lblCustomer">WALK-IN CUSTOMER</span>
                </div>
                <button class="btn-select-customer" onclick="openVip()">
                    <i class="fa-solid fa-magnifying-glass me-1"></i>VIP
                </button>
            </div>

            <!-- Tabs -->
            <div class="order-tabs">
                <div class="order-tab active" id="tabNow" onclick="switchTab(0)">
                    <i class="fa-solid fa-cash-register me-1"></i>Now
                </div>
                <div class="order-tab" id="tabShip" onclick="switchTab(1)">
                    <i class="fa-solid fa-truck me-1"></i>Shipping
                </div>
                <div class="order-tab" id="tabTemp" onclick="switchTab(2)">
                    <i class="fa-solid fa-bookmark me-1"></i>Held
                </div>
            </div>

            <!-- Order No -->
            <div class="order-no-badge">
                ORDER <span id="lblOrderNo" style="color:var(--holo-cyan);">---</span>
            </div>

            <!-- Line items -->
            <div class="register-items">
                <table class="order-table" id="orderTable">
                    <thead>
                        <tr>
                            <th style="width:22%;">SKU</th>
                            <th style="width:35%;">Product</th>
                            <th style="width:12%; text-align:center;">Qty</th>
                            <th style="width:22%; text-align:right;">Amount</th>
                            <th style="width:9%;"></th>
                        </tr>
                    </thead>
                    <tbody id="orderTableBody">
                        <tr>
                            <td colspan="5" style="text-align:center; padding:30px; color:#333;">
                                <i class="fa-solid fa-crosshairs fa-2x" style="color:#1A1A1A; display:block; margin-bottom:8px;"></i>
                                Awaiting product selection...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Billing totals -->
            <div class="billing-strip">
                <div class="billing-row">
                    <span>Subtotal:</span>
                    <span id="txtGross">0 ₫</span>
                </div>
                <div class="billing-row">
                    <span>VAT:</span>
                    <span id="txtVat" style="color:var(--holo-cyan);">0 ₫</span>
                </div>
                <div class="billing-row">
                    <span>Discount:</span>
                    <span id="txtDiscount" style="color:var(--amber-warn);">0 ₫</span>
                </div>
                <div class="billing-total-row">
                    <span class="total-label">Total Amount</span>
                    <span class="total-amount" id="txtTotal">0</span>
                </div>
                <div style="text-align:right; font-size:0.7rem; color:#444; margin-top:2px;">VND</div>
            </div>

            <!-- Action buttons -->
            <div class="register-actions">
                <button class="btn-action btn-hold" onclick="holdCurrentOrder()">
                    <i class="fa-solid fa-pause"></i> Hold [F5]
                </button>
                <button class="btn-action btn-ship" onclick="markShippingOrder()">
                    <i class="fa-solid fa-truck"></i> Ship [F6]
                </button>
                <button class="btn-action btn-payment" id="btnPayment" onclick="openPayment()" disabled>
                    <i class="fa-solid fa-bolt me-2"></i> PAYMENT [F12]
                </button>
            </div>
        </section>

        <!-- CENTER-RIGHT: PRODUCT CATALOG -->
        <section class="pos-catalog">
            <!-- Toolbar -->
            <div class="catalog-toolbar">
                <div class="search-row">
                    <span style="background:#000; border:1px solid #333; border-right:none; padding:0 10px; display:flex; align-items:center;">
                        <i class="fa-solid fa-barcode" style="color:var(--holo-cyan);"></i>
                    </span>
                    <input type="text" id="posSearchInput" class="pos-search-input" placeholder="SKU / Barcode / Product Name  [F1]" autocomplete="off" />
                    <button class="btn-search" onclick="executeSearch()">SEARCH</button>
                </div>
                <div class="filter-tags-row">
                    <button class="btn-filter active" id="btnFltAll" onclick="setPrimaryFilter('all', this)">All</button>
                    <button class="btn-filter" id="btnFltCate" onclick="setPrimaryFilter('category', this)">Category</button>
                    <button class="btn-filter" id="btnFltManu" onclick="setPrimaryFilter('manufacturer', this)">Manufacturer</button>
                    <button class="btn-filter" id="btnFltType" onclick="setPrimaryFilter('productType', this)">Type</button>
                    <button class="btn-filter" id="btnFltUnit" onclick="setPrimaryFilter('unit', this)">Unit</button>
                    <span style="border-left:1px solid #222; margin:0 4px; height:18px; align-self:center;"></span>
                    <button class="btn-filter sort-tag" onclick="applySortFilter('newest', this)"><i class="fa-solid fa-star me-1"></i>New</button>
                    <button class="btn-filter sort-tag" onclick="applySortFilter('bestseller', this)"><i class="fa-solid fa-fire me-1"></i>Best</button>
                    <button class="btn-filter sort-tag" onclick="applySortFilter('promo', this)"><i class="fa-solid fa-tag me-1"></i>Promo</button>
                </div>
            </div>

            <!-- Sub-filter strip -->
            <div class="sub-filter-strip" id="subFilterStrip">
                <span style="color:#333; font-size:0.7rem;">Select a filter above to narrow catalog</span>
            </div>

            <!-- Product grid -->
            <div class="product-grid" id="productGrid">
                <div style="grid-column:1/-1; text-align:center; padding:40px; color:#333;">
                    <i class="fa-solid fa-gear fa-spin fa-2x" style="color:var(--holo-cyan);"></i>
                    <div style="margin-top:10px; font-family:var(--font-hdr); font-size:0.8rem;">Loading catalog...</div>
                </div>
            </div>
        </section>
    </div>
    <!-- ====================================================
         FOOTER TELEMETRY
    ==================================================== -->
    <footer class="pos-footer hud-footer">
        <div class="footer-left hud-footer-status" style="display:flex; align-items:center; gap:10px; flex-wrap:wrap; font-size:0.75rem;">
            <div class="footer-status" id="footerStatus" style="display:flex; align-items:center; gap:4px;">
                <div class="status-dot" id="statusDot"></div>
                <span style="color:#D8F8FF;">SYSTEM STATUS: <strong id="statusLabel" style="color:var(--bio-emerald, #00FF66);">CHECKING...</strong></span>
            </div>
            <span style="color:rgba(255,255,255,0.2);">|</span>
            <div style="display:flex; align-items:center; gap:4px;">
                <span style="color:#D8F8FF;">LAN SYN: <strong class="ping-val" id="footerPing" style="color:var(--holo-cyan, #00E5FF);">--ms</strong></span>
            </div>
            <span style="color:rgba(255,255,255,0.2);">|</span>
            <span class="footer-meta" style="color:#D8F8FF;">TENANT: <strong id="footerTenant" style="color:var(--holo-cyan, #00E5FF);">--</strong></span>
            <span style="color:rgba(255,255,255,0.2);">|</span>
            <span class="footer-meta" style="color:#D8F8FF;">COUNTER: <strong id="footerCounter" style="color:#AAA;">--</strong></span>
            <span style="color:rgba(255,255,255,0.2);">|</span>
            <span class="footer-meta" style="color:#D8F8FF;">WAREHOUSE: <strong id="footerWarehouse" style="color:#AAA;">--</strong></span>
            <span style="color:rgba(255,255,255,0.2);">|</span>
            <span class="footer-meta" style="color:#D8F8FF;">SHIFT: <strong id="footerShift" style="color:var(--bio-emerald, #00FF66);">--</strong></span>
        </div>
        <div class="hud-footer-time">
            <i class="fa-solid fa-microchip me-1" style="color:var(--holo-cyan, #00E5FF);"></i>
            <span id="hudFooterClock" style="font-family:'Roboto Mono',monospace; font-size:0.8rem; color:#E0E0E0;">2026-07-27 00:00:00.000 UTC+7</span>
        </div>
    </footer>

    <!-- ====================================================
         MODAL: START SHIFT
    ==================================================== -->
    <div class="pos-modal-bg" id="modalStartShift">
        <div class="pos-modal" style="max-width:580px;">
            <div class="modal-hdr">
                <span class="modal-title"><i class="fa-solid fa-clock-rotate-left me-2"></i>Start Work Shift</span>
                <button class="btn-close-modal" onclick="closeModal('modalStartShift')"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="modal-body">
                <div class="shift-info-grid">
                    <div class="shift-info-item">
                        <label>Start Time</label>
                        <span id="shiftStartTime">--</span>
                    </div>
                    <div class="shift-info-item">
                        <label>Cashier</label>
                        <span>@(User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "Operator")</span>
                    </div>
                    <div class="shift-info-item">
                        <label>Tenant</label>
                        <span id="shiftTenantLabel">--</span>
                    </div>
                    <div class="shift-info-item">
                        <label>Counter</label>
                        <span id="shiftCounterLabel">--</span>
                    </div>
                </div>

                <div class="form-row">
                    <label class="form-label">Opening Cash Count</label>
                    <table class="denom-table" id="denomTable">
                        <thead>
                            <tr>
                                <th>Denomination (₫)</th>
                                <th>Count</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody id="denomBody"></tbody>
                        <tfoot>
                            <tr>
                                <td colspan="2" style="text-align:right; color:#555; font-size:0.78rem; padding-top:6px;">OPENING CASH TOTAL:</td>
                                <td style="text-align:right; padding-top:6px;"><span class="denom-total" id="denomTotal">0</span> ₫</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <div id="pendingOrdersSection" style="display:none;">
                    <div class="form-label" style="margin-top:10px; color:var(--amber-warn);">
                        <i class="fa-solid fa-triangle-exclamation me-1"></i>Pending Unfinished Orders
                    </div>
                    <div id="pendingOrdersList"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn-pos-secondary" onclick="closeModal('modalStartShift')">Cancel</button>
                <button class="btn-pos-success" onclick="confirmStartShift()">
                    <i class="fa-solid fa-play me-1"></i>Confirm Start Shift
                </button>
            </div>
        </div>
    </div>

    <!-- ====================================================
         MODAL: PAYMENT
    ==================================================== -->
    <div class="pos-modal-bg" id="modalPayment">
        <div class="pos-modal" style="max-width:520px;">
            <div class="modal-hdr">
                <span class="modal-title"><i class="fa-solid fa-credit-card me-2"></i>Payment</span>
                <button class="btn-close-modal" onclick="closeModal('modalPayment')"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="modal-body">
                <!-- Order Nature Selector (B2B vs Walk-in Retail) -->
                <div class="form-row">
                    <label class="form-label" style="display:flex; justify-content:space-between; align-items:center;">
                        <span>TRANSACTION NATURE</span>
                        <span style="font-size:0.68rem; color:#666; font-family:var(--font-mono);">[PRO_BILLING_SPEC]</span>
                    </label>
                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px;">
                        <button type="button" id="btnOrderTypeRetail" class="btn-pos-primary" onclick="toggleOrderType('retail')" style="padding:6px 10px; font-size:0.78rem;">
                            <i class="fa-solid fa-person-walking me-1"></i>Walk-in Retail (B2C)
                        </button>
                        <button type="button" id="btnOrderTypeB2B" class="btn-pos-secondary" onclick="toggleOrderType('b2b')" style="padding:6px 10px; font-size:0.78rem;">
                            <i class="fa-solid fa-building me-1"></i>Corporate (B2B)
                        </button>
                    </div>
                </div>

                <!-- B2B Compliance Restriction Box -->
                <div id="b2bComplianceWarn" style="display:none; background:#1A0A0A; border:1px solid var(--crimson-danger); padding:10px; margin-bottom:12px; border-left:4px solid var(--crimson-danger);">
                    <div style="font-family:var(--font-mono); font-size:0.72rem; color:var(--crimson-danger); line-height:1.4;">
                        <i class="fa-solid fa-triangle-exclamation me-1"></i>
                        <strong>>>> [CORPORATE_COMPLIANCE_RESTRICTION]:</strong> Corporate B2B billing strictly forbids anonymous walk-in transactions. Assign a verified Client Entity &amp; valid Tax ID to unlock payment execution.
                    </div>
                </div>

                <!-- Customer selection -->
                <div class="form-row">
                    <label class="form-label">Customer Profile</label>
                    <div style="display:flex; gap:6px; align-items:center;">
                        <span style="flex:1; font-family:'Rajdhani',sans-serif; font-size:0.95rem; color:var(--holo-cyan); background:#0B0B0B; border:1px solid #1A1A1A; padding:6px 10px;" id="payCustomerName">Walk-in Customer</span>
                        <button class="btn-pos-secondary" onclick="openVip();" style="padding:6px 12px; font-size:0.75rem;"><i class="fa-solid fa-users me-1"></i>Select VIP</button>
                    </div>
                </div>

                <!-- B2B Corporate Invoice Credentials -->
                <div id="b2bInvoiceBlock" style="display:none; background:#080D10; border:1px solid #102028; padding:10px; margin-bottom:12px;">
                    <div style="font-family:var(--font-mono); font-size:0.68rem; color:var(--holo-cyan); text-transform:uppercase; margin-bottom:8px;">
                        <i class="fa-solid fa-file-invoice me-1"></i>Mandatory e-Invoice Credentials (MST / Tax Code)
                    </div>
                    <div class="form-row" style="margin-bottom:8px;">
                        <label class="form-label" style="font-size:0.72rem; color:#888;">Tax Code / MST (*)</label>
                        <input type="text" id="payTaxCode" class="pos-input" placeholder="e.g., 0101245789-001..." style="padding:6px 8px; font-size:0.85rem;" oninput="validatePaymentState()" />
                    </div>
                    <div class="form-row" style="margin-bottom:0;">
                        <label class="form-label" style="font-size:0.72rem; color:#888;">Company Legal Name &amp; Address (*)</label>
                        <input type="text" id="payCompanyName" class="pos-input" placeholder="e.g., DigiPRO Tech Solutions Ltd, Hanoi..." style="padding:6px 8px; font-size:0.85rem;" oninput="validatePaymentState()" />
                    </div>
                </div>

                <!-- Payment method -->
                <div class="form-row">
                    <label class="form-label">Payment Method</label>
                    <div class="payment-method-grid" id="paymentMethodGrid">
