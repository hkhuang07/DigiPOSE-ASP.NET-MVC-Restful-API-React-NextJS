@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DigiPOS - POS Center</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Rajdhani:wght@600;700&family=Roboto+Mono:wght@400;500;700&family=VT323&display=swap" rel="stylesheet" />
    <style>
        :root {
            --true-black: #000000;
            --carbon-void: #0A0A0A;
            --holo-cyan: #00E5FF;
            --bio-emerald: #00FF66;
            --amber-warn: #FFB000;
            --crimson-danger: #FF3333;
            --font-hdr: 'Orbitron', 'Rajdhani', sans-serif;
            --font-data: 'VT323', 'Roboto Mono', monospace;
            --sidebar-w: 200px;
            --header-h: 48px;
            --footer-h: 32px;
            --register-w: 380px;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background: var(--true-black);
            color: #EEE;
            font-family: 'Roboto Mono', monospace;
            height: 100vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            user-select: none;
        }

        /* CRT scanline overlay */
        body::before {
            content: "";
            position: fixed;
            inset: 0;
            background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0,0,0,0.08) 2px, rgba(0,0,0,0.08) 4px);
            pointer-events: none;
            z-index: 9999;
        }

        /* ======================================================
           TOP HEADER
        ====================================================== */
        .pos-header {
            height: var(--header-h);
            background: var(--carbon-void);
            border-bottom: 1px solid var(--holo-cyan);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 12px;
            box-shadow: 0 2px 20px rgba(0,229,255,0.2);
            flex-shrink: 0;
            z-index: 100;
        }

        .header-left { display: flex; align-items: center; gap: 10px; }

        .btn-hamburger {
            background: transparent;
            border: 1px solid #333;
            color: var(--holo-cyan);
            width: 34px; height: 34px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1rem; cursor: pointer;
            transition: all 0.15s;
            flex-shrink: 0;
        }
        .btn-hamburger:hover { border-color: var(--holo-cyan); background: rgba(0,229,255,0.1); }

        .pos-brand {
            font-family: var(--font-hdr);
            font-size: 1rem;
            font-weight: 900;
            color: #FFF;
            text-decoration: none;
            letter-spacing: 1px;
            display: flex; align-items: center; gap: 6px;
        }
        .pos-brand span { color: var(--holo-cyan); }

        .header-right { display: flex; align-items: center; gap: 8px; }

        /* Navbar icons — same style as main layout */
        .hud-nav-icon-btn {
            background: transparent;
            border: 1px solid #333;
            color: #CCC;
            width: 32px; height: 32px;
            display: flex; align-items: center; justify-content: center;
            cursor: pointer; border-radius: 0;
            transition: all 0.15s;
        }
        .hud-nav-icon-btn:hover { border-color: var(--holo-cyan); color: var(--holo-cyan); }

        .hud-profile-trigger {
            display: flex; align-items: center; gap: 6px;
            cursor: pointer; padding: 4px 8px;
            border: 1px solid #333;
            transition: all 0.15s;
        }
        .hud-profile-trigger:hover { border-color: var(--holo-cyan); }

        .hud-avatar-box {
            width: 28px; height: 28px;
            background: linear-gradient(135deg, #00E5FF22, #00FF6622);
            border: 1px solid var(--holo-cyan);
            display: flex; align-items: center; justify-content: center;
            font-family: var(--font-hdr); font-size: 0.65rem; font-weight: 700;
            color: var(--holo-cyan);
        }
        .hud-user-name { font-family: 'Rajdhani', sans-serif; font-size: 0.85rem; font-weight: 700; color: #EEE; line-height: 1; }
        .hud-user-role { font-size: 0.65rem; color: #888; line-height: 1; }

        .dropdown-menu.pos-drop {
            background: #0A0A0A;
            border: 1px solid var(--holo-cyan);
            border-radius: 0;
            min-width: 180px;
        }
        .dropdown-item { color: #DDD; font-size: 0.85rem; padding: 8px 14px; }
        .dropdown-item:hover { background: rgba(0,229,255,0.1); color: var(--holo-cyan); }
        .dropdown-divider { border-color: #222; }

        /* ======================================================
           WORKSPACE: SIDEBAR + CATALOG + REGISTER
        ====================================================== */
        .pos-workspace {
            flex: 1;
            display: flex;
            overflow: hidden;
        }

        /* -------  LEFT SIDEBAR  ------- */
        .pos-sidebar {
            width: var(--sidebar-w);
            background: #050505;
            border-right: 1px solid #222;
            display: flex;
            flex-direction: column;
            flex-shrink: 0;
            overflow-y: auto;
            transition: transform 0.2s ease;
        }

        .sidebar-section-title {
            font-family: var(--font-hdr);
            font-size: 0.6rem;
            color: #444;
            text-transform: uppercase;
            letter-spacing: 2px;
            padding: 10px 12px 4px;
            border-bottom: 1px solid #111;
        }

        .sidebar-nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 14px;
            color: #AAA;
            cursor: pointer;
            text-decoration: none;
            font-size: 0.82rem;
            border-left: 2px solid transparent;
            transition: all 0.15s;
        }
        .sidebar-nav-item:hover, .sidebar-nav-item.active {
            background: rgba(0,229,255,0.06);
            color: var(--holo-cyan);
            border-left-color: var(--holo-cyan);
        }
        .sidebar-nav-item i { width: 16px; text-align: center; font-size: 0.9rem; }

        .sidebar-divider { height: 1px; background: #111; margin: 4px 0; }

        /* Shift status badge in sidebar */
        .shift-status-badge {
            display: flex; align-items: center; gap: 6px;
            padding: 6px 14px;
            font-size: 0.72rem;
            color: #666;
        }
        .shift-status-badge.active-shift { color: var(--bio-emerald); }
        .shift-dot { width: 6px; height: 6px; border-radius: 50%; background: #333; flex-shrink: 0; }
        .shift-dot.active { background: var(--bio-emerald); box-shadow: 0 0 6px var(--bio-emerald); }

        /* -------  CENTER: CATALOG  ------- */
        .pos-catalog {
            flex: 1;
            display: flex;
            flex-direction: column;
            border-right: 1px solid #222;
            min-width: 0;
        }

        /* Top toolbar row */
        .catalog-toolbar {
            background: #050505;
            border-bottom: 1px solid #1A1A1A;
            padding: 8px 12px;
            flex-shrink: 0;
        }

        .search-row {
            display: flex;
            gap: 6px;
            margin-bottom: 6px;
        }

        .pos-search-input {
            flex: 1;
            background: #000;
            border: 1px solid #333;
            border-right: none;
            color: #EEE;
            padding: 6px 12px;
            font-family: 'Roboto Mono', monospace;
            font-size: 0.88rem;
            outline: none;
            transition: border-color 0.15s;
        }
        .pos-search-input:focus { border-color: var(--holo-cyan); }

        .btn-search {
            background: var(--holo-cyan);
            border: 1px solid var(--holo-cyan);
            color: #000;
            padding: 6px 14px;
            font-family: var(--font-hdr);
            font-size: 0.75rem;
            font-weight: 700;
            cursor: pointer;
            letter-spacing: 1px;
        }
        .btn-search:hover { background: #000; color: var(--holo-cyan); }

        /* Filter tags row */
        .filter-tags-row {
            display: flex;
            gap: 4px;
            flex-wrap: wrap;
        }

        .btn-filter {
            background: transparent;
            border: 1px solid #2A2A2A;
            color: #888;
            padding: 3px 10px;
            font-size: 0.75rem;
            font-family: 'Rajdhani', sans-serif;
            font-weight: 700;
            text-transform: uppercase;
            cursor: pointer;
            letter-spacing: 0.5px;
            transition: all 0.15s;
        }
        .btn-filter:hover, .btn-filter.active {
            border-color: var(--holo-cyan);
            color: var(--holo-cyan);
            background: rgba(0,229,255,0.08);
        }
        .btn-filter.sort-tag:hover, .btn-filter.sort-tag.active {
            border-color: var(--bio-emerald);
            color: var(--bio-emerald);
            background: rgba(0,255,102,0.06);
        }

        /* Dynamic sub-filter strip */
        .sub-filter-strip {
            background: #030303;
            border-bottom: 1px solid #111;
            padding: 5px 12px;
            display: flex;
            gap: 4px;
            overflow-x: auto;
            min-height: 30px;
            align-items: center;
            flex-shrink: 0;
        }
        .sub-filter-strip::-webkit-scrollbar { height: 3px; }
        .sub-filter-strip::-webkit-scrollbar-thumb { background: #333; }

        .btn-sub-tag {
            background: #000;
            border: 1px dashed #2A2A2A;
            color: #888;
            padding: 2px 8px;
            font-size: 0.72rem;
            font-weight: bold;
            cursor: pointer;
            white-space: nowrap;
            transition: all 0.1s;
        }
        .btn-sub-tag:hover, .btn-sub-tag.active { border-color: var(--holo-cyan); color: var(--holo-cyan); background: rgba(0,229,255,0.06); }

        /* Product grid */
        .product-grid {
            flex: 1;
            overflow-y: auto;
            padding: 10px;
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
            gap: 8px;
            align-content: flex-start;
        }
        .product-grid::-webkit-scrollbar { width: 4px; }
        .product-grid::-webkit-scrollbar-thumb { background: #222; }

        .prod-card {
            background: #0A0A0A;
            border: 1px solid #1E1E1E;
            padding: 8px;
            cursor: pointer;
            position: relative;
            display: flex;
            flex-direction: column;
            height: 170px;
            transition: all 0.15s;
        }
        .prod-card:hover {
            border-color: var(--bio-emerald);
            box-shadow: 0 0 10px rgba(0,255,102,0.2);
            transform: translateY(-1px);
        }
        .prod-card.out-of-stock { opacity: 0.4; cursor: not-allowed; }

        .prod-stock-chip {
            position: absolute;
            top: 5px; right: 5px;
            font-size: 0.65rem;
            font-weight: bold;
            padding: 1px 5px;
            border: 1px solid var(--holo-cyan);
            color: var(--holo-cyan);
            background: #000;
        }
        .prod-stock-chip.low { border-color: var(--amber-warn); color: var(--amber-warn); }
        .prod-stock-chip.zero { border-color: var(--crimson-danger); color: var(--crimson-danger); }

        .prod-sku { font-size: 0.65rem; color: var(--holo-cyan); font-weight: bold; margin-top: 4px; }
        .prod-name {
            font-family: 'Rajdhani', sans-serif;
            font-size: 0.88rem;
            font-weight: 700;
            color: #DDD;
            flex: 1;
            overflow: hidden;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            margin-top: 4px;
        }
        .prod-price {
            font-family: var(--font-data);
            font-size: 1.2rem;
            color: var(--bio-emerald);
            font-weight: bold;
            padding-top: 5px;
            border-top: 1px solid #1A1A1A;
        }
        .prod-unit { font-size: 0.65rem; color: #666; }

        /* -------  RIGHT: ORDER REGISTER  ------- */
        .pos-register {
            width: var(--register-w);
            display: flex;
            flex-direction: column;
            background: #050505;
            flex-shrink: 0;
        }

        /* Customer row */
        .register-customer-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 6px 10px;
            background: #080808;
            border-bottom: 1px solid #1A1A1A;
            min-height: 36px;
        }

        .customer-info {
            display: flex; align-items: center; gap: 6px;
            font-size: 0.78rem;
        }
        .customer-name { color: var(--holo-cyan); font-weight: bold; font-family: 'Rajdhani', sans-serif; }

        .btn-select-customer {
            background: transparent;
            border: 1px dashed #333;
            color: #666;
            padding: 2px 8px;
            font-size: 0.72rem;
            cursor: pointer;
            transition: all 0.15s;
        }
        .btn-select-customer:hover { border-color: var(--holo-cyan); color: var(--holo-cyan); }

        /* Tabs: NOW / SHIPPING / TEMP */
        .order-tabs {
            display: flex;
            border-bottom: 1px solid #1A1A1A;
        }
        .order-tab {
            flex: 1;
            padding: 7px 4px;
            text-align: center;
            font-family: 'Rajdhani', sans-serif;
            font-size: 0.75rem;
            font-weight: 700;
            color: #555;
            cursor: pointer;
            border-right: 1px solid #111;
            background: #050505;
            transition: all 0.15s;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .order-tab:last-child { border-right: none; }
        .order-tab:hover { color: #AAA; background: #0A0A0A; }
        .order-tab.active { color: var(--holo-cyan); background: rgba(0,229,255,0.06); border-bottom: 2px solid var(--holo-cyan); }

        /* Order # badge */
        .order-no-badge {
            font-family: var(--font-hdr);
            font-size: 0.65rem;
            color: #444;
            padding: 3px 10px;
            border-bottom: 1px solid #111;
        }

        /* Line items table */
        .register-items {
            flex: 1;
            overflow-y: auto;
        }
        .register-items::-webkit-scrollbar { width: 3px; }
        .register-items::-webkit-scrollbar-thumb { background: #222; }

        table.order-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.78rem;
        }
        .order-table thead th {
            background: #080808;
            color: #555;
            font-family: 'Rajdhani', sans-serif;
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            padding: 5px 8px;
            border-bottom: 1px solid #1A1A1A;
            position: sticky; top: 0;
        }
        .order-table tbody td {
            padding: 6px 8px;
            border-bottom: 1px solid #0D0D0D;
            vertical-align: middle;
        }
        .order-table tbody tr:hover td { background: rgba(0,229,255,0.03); }

        .btn-void {
            background: transparent;
            border: 1px solid #333;
            color: #666;
            padding: 1px 5px;
            font-size: 0.7rem;
            cursor: pointer;
            transition: all 0.1s;
        }
        .btn-void:hover { border-color: var(--crimson-danger); color: var(--crimson-danger); }

        /* Billing strip */
        .billing-strip {
            background: #030303;
            border-top: 1px solid #1A1A1A;
            padding: 8px 10px;
        }

        .billing-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 2px 0;
            font-size: 0.78rem;
        }
        .billing-row span:first-child { color: #666; }
        .billing-row span:last-child { color: #CCC; font-weight: bold; }

        .billing-total-row {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            padding: 5px 0 3px;
            border-top: 1px solid #1A1A1A;
            margin-top: 4px;
        }
        .total-label { font-family: var(--font-hdr); font-size: 0.75rem; color: #AAA; text-transform: uppercase; }
        .total-amount { font-family: var(--font-data); font-size: 2rem; color: var(--bio-emerald); font-weight: bold; line-height: 1; }

        /* Action buttons */
        .register-actions {
            padding: 8px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 5px;
            border-top: 1px solid #1A1A1A;
        }

        .btn-action {
            padding: 8px 6px;
            font-family: 'Rajdhani', sans-serif;
            font-size: 0.8rem;
            font-weight: 700;
            cursor: pointer;
            border: 1px solid;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            display: flex; align-items: center; justify-content: center; gap: 5px;
            transition: all 0.15s;
        }
        .btn-hold { background: transparent; border-color: var(--amber-warn); color: var(--amber-warn); }
        .btn-hold:hover { background: rgba(255,176,0,0.1); }
        .btn-ship { background: transparent; border-color: var(--holo-cyan); color: var(--holo-cyan); }
        .btn-ship:hover { background: rgba(0,229,255,0.1); }
        .btn-payment {
            grid-column: span 2;
            background: var(--bio-emerald);
            border-color: var(--bio-emerald);
            color: #000;
            font-size: 0.95rem;
            padding: 10px;
            box-shadow: 0 0 15px rgba(0,255,102,0.3);
        }
        .btn-payment:hover { background: #000; color: var(--bio-emerald); box-shadow: 0 0 20px rgba(0,255,102,0.5); }
        .btn-payment:disabled { opacity: 0.4; cursor: not-allowed; box-shadow: none; }

        /* ======================================================
           FOOTER TELEMETRY STRIP
        ====================================================== */
        .pos-footer {
            height: var(--footer-h);
            background: #030303;
            border-top: 1px solid #1A1A1A;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 12px;
            font-family: var(--font-data);
            font-size: 0.75rem;
            flex-shrink: 0;
        }

        .footer-left { display: flex; align-items: center; gap: 14px; }
        .footer-status { display: flex; align-items: center; gap: 4px; }
        .status-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--bio-emerald); box-shadow: 0 0 6px var(--bio-emerald); }
        .status-dot.offline { background: var(--crimson-danger); box-shadow: 0 0 6px var(--crimson-danger); }
        .ping-val { color: var(--bio-emerald); font-weight: bold; }
        .footer-meta { color: #444; }
        .footer-clock { color: #BBB; }

        /* ======================================================
           SLIDE-OUT SIDEBAR MENU (hamburger)
        ====================================================== */
        .side-menu-overlay {
            position: fixed; inset: 0;
            background: rgba(0,0,0,0.7);
            z-index: 200;
            display: none;
        }
        .side-menu-overlay.show { display: block; }

        .side-menu {
            position: fixed;
            top: 0; left: 0;
            width: 240px; height: 100vh;
            background: #060606;
            border-right: 1px solid var(--holo-cyan);
            box-shadow: 4px 0 30px rgba(0,229,255,0.15);
            z-index: 201;
            transform: translateX(-100%);
            transition: transform 0.2s ease;
            overflow-y: auto;
        }
        .side-menu.show { transform: translateX(0); }

        .side-menu-header {
            padding: 14px 16px 10px;
            font-family: var(--font-hdr);
            font-size: 0.75rem;
            color: var(--holo-cyan);
            border-bottom: 1px solid #111;
            display: flex; align-items: center; gap: 8px;
        }

        .side-menu-item {
            display: flex; align-items: center; gap: 12px;
            padding: 11px 18px;
            color: #CCC;
            cursor: pointer;
            font-size: 0.88rem;
            border-left: 2px solid transparent;
            transition: all 0.15s;
        }
        .side-menu-item:hover { background: rgba(0,229,255,0.07); color: var(--holo-cyan); border-left-color: var(--holo-cyan); }
        .side-menu-item i { width: 18px; text-align: center; }

        .side-menu-divider { height: 1px; background: #111; margin: 6px 0; }
        .side-menu-section { padding: 8px 18px 4px; font-size: 0.65rem; color: #444; text-transform: uppercase; letter-spacing: 2px; }

        /* ======================================================
           MODALS (shared base)
        ====================================================== */
        .pos-modal-bg {
            position: fixed; inset: 0;
            background: rgba(0,0,0,0.85);
            z-index: 500;
            display: none;
            align-items: center;
            justify-content: center;
        }
        .pos-modal-bg.show { display: flex; }

        .pos-modal {
            background: #0A0A0A;
            border: 1px solid var(--holo-cyan);
            box-shadow: 0 0 40px rgba(0,229,255,0.2);
            width: 90%;
            max-height: 90vh;
            overflow-y: auto;
            position: relative;
        }
        .pos-modal::-webkit-scrollbar { width: 4px; }
        .pos-modal::-webkit-scrollbar-thumb { background: #333; }

        .modal-hdr {
            display: flex; align-items: center; justify-content: space-between;
            padding: 12px 16px;
            border-bottom: 1px solid #1A1A1A;
            background: #060606;
        }
        .modal-title {
            font-family: var(--font-hdr);
            font-size: 0.9rem;
            color: var(--holo-cyan);
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .btn-close-modal {
            background: transparent;
            border: 1px solid #333;
            color: #888;
            width: 28px; height: 28px;
            display: flex; align-items: center; justify-content: center;
            cursor: pointer; font-size: 0.9rem;
            transition: all 0.15s;
        }
        .btn-close-modal:hover { border-color: var(--crimson-danger); color: var(--crimson-danger); }

        .modal-body { padding: 16px; }
        .modal-footer {
            padding: 10px 16px;
            border-top: 1px solid #1A1A1A;
            display: flex; gap: 8px; justify-content: flex-end;
        }

        /* Form controls inside modals */
        .pos-input, .pos-select {
            background: #000;
            border: 1px solid #333;
            color: #EEE;
            padding: 7px 10px;
            font-family: 'Roboto Mono', monospace;
            font-size: 0.85rem;
            width: 100%;
            outline: none;
            transition: border-color 0.15s;
            -webkit-appearance: none;
        }
        .pos-input:focus, .pos-select:focus { border-color: var(--holo-cyan); }
        .pos-select option { background: #111; }

        .form-row { margin-bottom: 12px; }
        .form-label { display: block; font-size: 0.72rem; color: #666; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px; }

        /* Buttons in modals */
        .btn-pos-primary {
            background: var(--holo-cyan); border: 1px solid var(--holo-cyan); color: #000;
            padding: 8px 18px; font-family: var(--font-hdr); font-size: 0.78rem; font-weight: 700;
            cursor: pointer; letter-spacing: 1px; text-transform: uppercase; transition: all 0.15s;
        }
        .btn-pos-primary:hover { background: #000; color: var(--holo-cyan); }
        .btn-pos-primary:disabled { opacity: 0.4; cursor: not-allowed; }

        .btn-pos-success {
            background: var(--bio-emerald); border: 1px solid var(--bio-emerald); color: #000;
            padding: 8px 18px; font-family: var(--font-hdr); font-size: 0.78rem; font-weight: 700;
            cursor: pointer; letter-spacing: 1px; text-transform: uppercase; transition: all 0.15s;
        }
        .btn-pos-success:hover { background: #000; color: var(--bio-emerald); }

        .btn-pos-secondary {
            background: transparent; border: 1px solid #444; color: #888;
            padding: 8px 18px; font-family: 'Rajdhani', sans-serif; font-size: 0.78rem; font-weight: 700;
            cursor: pointer; transition: all 0.15s;
        }
        .btn-pos-secondary:hover { border-color: #888; color: #CCC; }

        /* ======================================================
           START SHIFT MODAL
        ====================================================== */
        #modalStartShift .pos-modal { max-width: 600px; }

        .shift-info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-bottom: 14px;
        }
        .shift-info-item label { font-size: 0.7rem; color: #555; text-transform: uppercase; letter-spacing: 0.5px; display: block; margin-bottom: 3px; }
        .shift-info-item span { font-family: var(--font-hdr); font-size: 0.85rem; color: #CCC; }

        /* Cash denomination table */
        .denom-table { width: 100%; border-collapse: collapse; font-size: 0.8rem; }
        .denom-table th { background: #060606; color: #555; font-size: 0.7rem; text-transform: uppercase; padding: 5px 8px; border-bottom: 1px solid #1A1A1A; text-align: right; }
        .denom-table th:first-child { text-align: left; }
        .denom-table td { padding: 5px 8px; border-bottom: 1px solid #0D0D0D; text-align: right; }
        .denom-table td:first-child { text-align: left; color: #888; }
        .denom-input { background: #000; border: 1px solid #222; color: #EEE; padding: 3px 6px; width: 60px; text-align: right; font-size: 0.8rem; outline: none; }
        .denom-input:focus { border-color: var(--holo-cyan); }
        .denom-total { color: var(--bio-emerald); font-family: var(--font-data); }

        /* Unfinished orders list in shift modal */
        .pending-order-item {
            display: flex; justify-content: space-between; align-items: center;
            padding: 6px 10px;
            border: 1px solid #111;
            margin-bottom: 4px;
            font-size: 0.78rem;
        }
        .pending-order-item:hover { border-color: #333; }

        /* ======================================================
           PAYMENT MODAL
        ====================================================== */
        #modalPayment .pos-modal { max-width: 560px; }

        .payment-method-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 6px;
            margin-bottom: 14px;
        }
        .payment-method-btn {
            padding: 10px 6px;
            background: #000;
            border: 1px solid #222;
            color: #888;
            font-family: 'Rajdhani', sans-serif;
            font-weight: 700;
            font-size: 0.8rem;
            cursor: pointer;
            text-align: center;
            transition: all 0.15s;
            display: flex; flex-direction: column; align-items: center; gap: 4px;
        }
        .payment-method-btn:hover { border-color: var(--holo-cyan); color: var(--holo-cyan); }
        .payment-method-btn.selected { border-color: var(--bio-emerald); color: var(--bio-emerald); background: rgba(0,255,102,0.06); }
        .payment-method-btn i { font-size: 1.2rem; }

        .payment-summary-row {
            display: flex; justify-content: space-between; align-items: baseline;
            padding: 3px 0;
            font-size: 0.82rem;
        }
        .payment-summary-row span:first-child { color: #666; }
        .payment-total-row {
            display: flex; justify-content: space-between; align-items: baseline;
            padding: 8px 0 0;
            border-top: 1px solid #1A1A1A;
        }
        .payment-total-label { font-family: var(--font-hdr); font-size: 0.78rem; color: #AAA; }
        .payment-total-val { font-family: var(--font-data); font-size: 2.2rem; color: var(--bio-emerald); }

        .change-highlight { font-family: var(--font-data); font-size: 1.5rem; color: var(--holo-cyan); font-weight: bold; }

        /* ======================================================
           PAYMENT SUCCESS MODAL
        ====================================================== */
        #modalPaySuccess .pos-modal { max-width: 400px; text-align: center; }

        .success-icon { font-size: 3rem; color: var(--bio-emerald); margin: 16px 0 8px; }
        .success-invoice { font-family: var(--font-hdr); font-size: 1rem; color: var(--holo-cyan); }
        .success-total { font-family: var(--font-data); font-size: 2rem; color: var(--bio-emerald); }
        .success-meta { font-size: 0.78rem; color: #666; margin: 8px 0; }

        /* ======================================================
           ORDERS TODAY MODAL
        ====================================================== */
        #modalOrdersToday .pos-modal { max-width: 700px; }

        .orders-filter-row {
            display: flex; gap: 8px; margin-bottom: 12px;
        }

        .orders-table { width: 100%; border-collapse: collapse; font-size: 0.8rem; }
        .orders-table th { background: #060606; color: #555; padding: 6px 10px; font-size: 0.7rem; text-transform: uppercase; border-bottom: 1px solid #1A1A1A; }
        .orders-table td { padding: 7px 10px; border-bottom: 1px solid #0D0D0D; }
        .orders-table tr:hover td { background: rgba(0,229,255,0.03); cursor: pointer; }
        .orders-summary-row { display: flex; justify-content: space-between; margin-top: 10px; font-size: 0.82rem; color: #666; }

        /* ======================================================
           POS DASHBOARD MODAL
        ====================================================== */
        #modalDashboard .pos-modal { max-width: 640px; }

        .kpi-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 16px; }
        .kpi-card {
            background: #060606;
            border: 1px solid #1A1A1A;
            padding: 12px 10px;
            text-align: center;
        }
        .kpi-label { font-size: 0.65rem; color: #555; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 4px; }
        .kpi-value { font-family: var(--font-data); font-size: 1.8rem; color: var(--holo-cyan); }
        .kpi-sub { font-size: 0.7rem; color: #444; margin-top: 2px; }

        .top-products-table { width: 100%; border-collapse: collapse; font-size: 0.8rem; }
        .top-products-table th { background: #060606; color: #555; padding: 5px 8px; font-size: 0.7rem; text-transform: uppercase; border-bottom: 1px solid #1A1A1A; }
        .top-products-table td { padding: 6px 8px; border-bottom: 1px solid #0D0D0D; }

        /* ======================================================
           VIP CUSTOMER MODAL
        ====================================================== */
        #modalVip .pos-modal { max-width: 680px; }

        .vip-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
        .vip-list { border: 1px solid #1A1A1A; max-height: 350px; overflow-y: auto; }
        .vip-list::-webkit-scrollbar { width: 3px; }
        .vip-list-item {
            padding: 8px 12px;
            cursor: pointer;
            border-bottom: 1px solid #0D0D0D;
            font-size: 0.82rem;
        }
        .vip-list-item:hover { background: rgba(0,229,255,0.06); color: var(--holo-cyan); }
        .vip-list-item.selected { background: rgba(0,255,102,0.06); border-left: 2px solid var(--bio-emerald); }
        .vip-list-item .vip-code { font-size: 0.7rem; color: #555; }
        .vip-list-item .vip-name { font-weight: bold; color: #DDD; }
        .vip-list-item .vip-phone { font-size: 0.72rem; color: #888; }

        .vip-detail { border: 1px solid #1A1A1A; padding: 12px; }
        .vip-detail-row { display: flex; justify-content: space-between; padding: 4px 0; border-bottom: 1px solid #0D0D0D; font-size: 0.8rem; }
        .vip-detail-row label { color: #555; }
        .vip-detail-row span { color: #DDD; font-weight: bold; }
        .reward-points { font-family: var(--font-data); font-size: 1.5rem; color: var(--amber-warn); }

        /* ======================================================
           SETUP GATE (Pre-POS Setup Form)
        ====================================================== */
        #setupGate {
            position: fixed; inset: 0;
            background: #000;
            z-index: 1000;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .setup-card {
            background: #0A0A0A;
            border: 1px solid var(--holo-cyan);
            box-shadow: 0 0 60px rgba(0,229,255,0.15);
            padding: 32px;
            width: 90%;
            max-width: 420px;
        }
        .setup-logo {
            font-family: var(--font-hdr);
            font-size: 1.2rem;
            font-weight: 900;
            color: #FFF;
            text-align: center;
            margin-bottom: 6px;
        }
        .setup-logo span { color: var(--holo-cyan); }
        .setup-subtitle { text-align: center; font-size: 0.72rem; color: #555; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 24px; }

        .setup-step-indicator {
            display: flex; gap: 6px; justify-content: center; margin-bottom: 20px;
        }
        .step-dot { width: 8px; height: 8px; border-radius: 50%; background: #222; transition: all 0.2s; }
        .step-dot.active { background: var(--holo-cyan); box-shadow: 0 0 8px var(--holo-cyan); }
        .step-dot.done { background: var(--bio-emerald); }

        .inventory-chips { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 8px; }
        .inv-chip { padding: 3px 10px; border: 1px solid #222; font-size: 0.72rem; color: #666; }
        .inv-chip.good { border-color: var(--bio-emerald); color: var(--bio-emerald); }
        .inv-chip.warn { border-color: var(--amber-warn); color: var(--amber-warn); }
        .inv-chip.bad { border-color: var(--crimson-danger); color: var(--crimson-danger); }
    </style>
</head>
<body>

    <!-- ====================================================
         SETUP GATE — Counter selection only
         Branch is determined from auth claim (server-side)
    ==================================================== -->
    <div id="setupGate">
        <div class="setup-card">
            <div class="setup-logo">Digi<span>POS</span></div>
            <div class="setup-subtitle">POS Terminal Setup</div>

            <div class="setup-step-indicator">
                <div class="step-dot active" id="step1dot"></div>
                <div class="step-dot" id="step2dot"></div>
            </div>

            <!-- Branch chip (auto from auth claim) -->
            <div style="border:1px solid #1A1A1A; padding:8px 12px; margin-bottom:14px; display:flex; align-items:center; gap:8px;">
                <i class="fa-solid fa-code-branch" style="color:var(--holo-cyan);"></i>
                <div>
                    <div style="font-size:0.65rem; color:#555; text-transform:uppercase; letter-spacing:1px;">Assigned Branch</div>
                    <div style="font-family:var(--font-hdr); font-size:0.9rem; color:var(--holo-cyan);">@(User.FindFirst("BranchName")?.Value ?? "N/A")</div>
                </div>
                <span style="margin-left:auto; font-size:0.65rem; color:#444; border:1px solid #222; padding:2px 6px;">ID: @(User.FindFirst("BranchId")?.Value ?? "--")</span>
            </div>

            <!-- Step 1: Counter selection -->
            <div id="setupStep1">
                <div class="form-row">
                    <label class="form-label">Select Counter / Terminal</label>
                    <select id="setupCounterSel" class="pos-select">
                        <option value="">-- Loading counters... --</option>
                    </select>
                </div>
                <div class="form-row">
                    <label class="form-label">Branch Inventory Status</label>
                    <div class="inventory-chips" id="inventoryChips">
                        <span style="color:#444; font-size:0.72rem;">Loading...</span>
                    </div>
                </div>
                <button class="btn-pos-primary" style="width:100%; margin-top:4px;" id="btnStep1Next" onclick="confirmSetup()" disabled>
                    <i class="fa-solid fa-terminal me-1"></i>Enter POS
                </button>
            </div>

            <!-- Step 2: Initializing -->
            <div id="setupStep2" style="display:none; text-align:center;">
                <div style="margin:16px 0;">
                    <i class="fa-solid fa-gear fa-spin" style="font-size:2rem; color:var(--holo-cyan);"></i>
                </div>
                <div style="font-family:var(--font-hdr); color:#AAA; font-size:0.85rem;">Initializing POS Engine...</div>
                <div id="setupProgressMsg" style="font-size:0.72rem; color:#555; margin-top:6px;">Loading catalog...</div>
            </div>
        </div>
    </div>

    <!-- ====================================================
         HAMBURGER SIDE MENU
         Navigation ORDER mirrors main _Layout.cshtml MODULE structure
    ==================================================== -->
    <div class="side-menu-overlay" id="sideMenuOverlay" onclick="closeSideMenu()"></div>
    <div class="side-menu" id="sideMenu">
        <div class="side-menu-header">
            <i class="fa-solid fa-terminal"></i>
            OPERATOR MENU
        </div>

        <!-- POS Operations -->
        <div class="side-menu-section">POS Operations</div>
        <div class="side-menu-item" onclick="openDashboard(); closeSideMenu();">
            <i class="fa-solid fa-chart-line" style="color:var(--holo-cyan);"></i>
            Dashboard
        </div>
        <div class="side-menu-item" onclick="openStartShift(); closeSideMenu();">
            <i class="fa-solid fa-clock-rotate-left" style="color:var(--amber-warn);"></i>
            Start / Close Shift
        </div>
        <div class="side-menu-item" onclick="openVip(); closeSideMenu();">
            <i class="fa-solid fa-id-badge" style="color:var(--bio-emerald);"></i>
            VIP Customer
        </div>
        <div class="side-menu-item" onclick="openOrdersToday(); closeSideMenu();">
            <i class="fa-solid fa-receipt" style="color:#CCC;"></i>
            Orders Today
        </div>

        <div class="side-menu-divider"></div>
        <!-- Catalog Filters -->
        <div class="side-menu-section">Catalog</div>
        <div class="side-menu-item" onclick="setPrimaryFilter('all',null); closeSideMenu();">
            <i class="fa-solid fa-border-all"></i> All Products
        </div>
        <div class="side-menu-item" onclick="setPrimaryFilter('category',null); closeSideMenu();">
            <i class="fa-solid fa-tags"></i> By Category
        </div>
        <div class="side-menu-item" onclick="setPrimaryFilter('manufacturer',null); closeSideMenu();">
            <i class="fa-solid fa-industry"></i> By Manufacturer
        </div>

        @if (User.IsInRole("Super Admin") || User.IsInRole("Branch Manager"))
        {
            <div class="side-menu-divider"></div>
            <!-- MODULE 4: Sales & Billing (Admin only) -->
            <div class="side-menu-section">Admin: Sales</div>
            <a class="side-menu-item" href="/Administrator/Orders/Index">
                <i class="fa-solid fa-receipt"></i> Sales Orders
            </a>
            <a class="side-menu-item" href="/Administrator/Home/Index">
                <i class="fa-solid fa-gauge-high"></i> Admin Panel
            </a>
        }

        <div class="side-menu-divider"></div>
        <!-- MODULE 5: Links & Terminals (matches main layout bottom section) -->
        <div class="side-menu-section">Links &amp; Terminals</div>
        <a class="side-menu-item" href="/Storefront/Index" style="color:var(--holo-cyan); border-left-color:var(--holo-cyan);">
            <i class="fa-solid fa-cart-shopping" style="color:var(--holo-cyan);"></i> Online Storefront
        </a>
        <a class="side-menu-item" href="/Home/Index" style="color:#888;">
            <i class="fa-solid fa-gauge-high"></i> HUD Dashboard
        </a>
    </div>

    <!-- ====================================================
         TOP HEADER
    ==================================================== -->
    <header class="pos-header">
        <div class="header-left">
            <button class="btn-hamburger" id="btnHamburger" title="Operator Menu">
                <i class="fa-solid fa-bars"></i>
            </button>
            <a href="/Home/Index" class="pos-brand" title="Back to Main Dashboard">
                <i class="fa-solid fa-cash-register" style="color:var(--bio-emerald); font-size:1rem;"></i>
                Digi<span>POS</span>
                <span style="font-size:0.6rem; color:#444; margin-left:2px;">POS CENTER</span>
            </a>
        </div>
        <div class="header-right">
            <!-- Language -->
            <button class="hud-nav-icon-btn" id="langToggleBtn" title="Switch Language">
                <i class="fa-solid fa-globe" style="font-size:0.9rem;"></i>
            </button>
            <!-- Dark/Light mode -->
            <button class="hud-nav-icon-btn" id="themeToggleBtn" title="Toggle Theme">
                <i class="fa-solid fa-sun" id="themeIcon" style="font-size:0.9rem;"></i>
            </button>
            <!-- Notifications -->
            <div class="dropdown">
                <button class="hud-nav-icon-btn" data-bs-toggle="dropdown" title="Notifications">
                    <i class="fa-solid fa-bell" style="font-size:0.9rem;"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end pos-drop">
                    <li><h6 class="dropdown-header" style="color:var(--holo-cyan); font-family:var(--font-hdr); font-size:0.7rem;">ALERTS</h6></li>
                    <li><a class="dropdown-item" href="#"><i class="fa-solid fa-circle-info me-2 text-info"></i>POS Engine Ready</a></li>
                </ul>
            </div>
            <!-- Profile -->
            <div class="dropdown">
                <div class="hud-profile-trigger dropdown-toggle" id="profileDropdown" data-bs-toggle="dropdown">
                    <div class="hud-avatar-box">@(User.Identity?.Name != null && User.Identity.Name.Length >= 2 ? User.Identity.Name.Substring(0, 2).ToUpper() : "OP")</div>
                    <div>
                        <div class="hud-user-name">@(User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "Operator")</div>
                        <div class="hud-user-role">@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "POS Operator")</div>
                    </div>
                    <i class="fa-solid fa-caret-down" style="font-size:0.7rem; color:#666;"></i>
                </div>
                <ul class="dropdown-menu dropdown-menu-end pos-drop" aria-labelledby="profileDropdown">
                    <li><a class="dropdown-item" href="/Home/Index"><i class="fa-solid fa-house me-2"></i>Main Dashboard</a></li>
                    @if (User.IsInRole("Super Admin") || User.IsInRole("Branch Manager"))
                    {
                        <li><a class="dropdown-item" href="/Administrator/Home/Index"><i class="fa-solid fa-gauge-high me-2"></i>Admin Panel</a></li>
                    }
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item text-danger" asp-area="" asp-controller="Auth" asp-action="Logout"><i class="fa-solid fa-power-off me-2"></i>Log Out</a></li>
                </ul>
            </div>
        </div>
    </header>

    <!-- ====================================================
         MAIN WORKSPACE
    ==================================================== -->
    <div class="pos-workspace">

        <!-- LEFT SIDEBAR: Category quick-nav -->
        <aside class="pos-sidebar" id="posSidebar">
            <!-- Shift status -->
            <div class="shift-status-badge" id="sidebarShiftStatus">
                <div class="shift-dot" id="shiftDot"></div>
                <span id="shiftStatusLabel">No Active Shift</span>
            </div>
            <div class="sidebar-divider"></div>

            <div class="sidebar-section-title">Categories</div>
            <div id="sidebarCategories">
                <div class="sidebar-nav-item" onclick="setPrimaryFilter('all', null)">
                    <i class="fa-solid fa-border-all"></i>
                    <span>All Products</span>
                </div>
            </div>
            <div class="sidebar-divider"></div>
            <div class="sidebar-section-title">Sort By</div>
            <div class="sidebar-nav-item" onclick="applySortFilter('newest', this)">
                <i class="fa-solid fa-star" style="color:var(--bio-emerald);"></i> New Arrivals
            </div>
            <div class="sidebar-nav-item" onclick="applySortFilter('bestseller', this)">
                <i class="fa-solid fa-fire" style="color:var(--amber-warn);"></i> Best Sellers
            </div>
            <div class="sidebar-nav-item" onclick="applySortFilter('promo', this)">
                <i class="fa-solid fa-tag" style="color:var(--holo-cyan);"></i> Promotions
            </div>
        </aside>

        <!-- CENTER: CATALOG -->
        <section class="pos-catalog">
            <!-- Toolbar -->
            <div class="catalog-toolbar">
                <div class="search-row">
                    <span style="background:#000; border:1px solid #333; border-right:none; padding:0 10px; display:flex; align-items:center;">
                        <i class="fa-solid fa-barcode" style="color:var(--holo-cyan);"></i>
                    </span>
                    <input type="text" id="posSearchInput" class="pos-search-input" placeholder="SKU / Barcode / Product Name  [F1]" autocomplete="off" />
                    <button class="btn-search" onclick="executeSearch()">SEARCH</button>
                </div>
                <div class="filter-tags-row">
                    <button class="btn-filter active" id="btnFltAll" onclick="setPrimaryFilter('all', this)">All</button>
                    <button class="btn-filter" id="btnFltCate" onclick="setPrimaryFilter('category', this)">Category</button>
                    <button class="btn-filter" id="btnFltManu" onclick="setPrimaryFilter('manufacturer', this)">Manufacturer</button>
                    <button class="btn-filter" id="btnFltType" onclick="setPrimaryFilter('productType', this)">Type</button>
                    <button class="btn-filter" id="btnFltUnit" onclick="setPrimaryFilter('unit', this)">Unit</button>
                    <span style="border-left:1px solid #222; margin:0 4px; height:18px; align-self:center;"></span>
                    <button class="btn-filter sort-tag" onclick="applySortFilter('newest', this)"><i class="fa-solid fa-star me-1"></i>New</button>
                    <button class="btn-filter sort-tag" onclick="applySortFilter('bestseller', this)"><i class="fa-solid fa-fire me-1"></i>Best</button>
                    <button class="btn-filter sort-tag" onclick="applySortFilter('promo', this)"><i class="fa-solid fa-tag me-1"></i>Promo</button>
                </div>
            </div>

            <!-- Sub-filter strip -->
            <div class="sub-filter-strip" id="subFilterStrip">
                <span style="color:#333; font-size:0.7rem;">Select a filter above to narrow catalog</span>
            </div>

            <!-- Product grid -->
            <div class="product-grid" id="productGrid">
                <div style="grid-column:1/-1; text-align:center; padding:40px; color:#333;">
                    <i class="fa-solid fa-gear fa-spin fa-2x" style="color:var(--holo-cyan);"></i>
                    <div style="margin-top:10px; font-family:var(--font-hdr); font-size:0.8rem;">Loading catalog...</div>
                </div>
            </div>
        </section>

        <!-- RIGHT: ORDER REGISTER -->
        <section class="pos-register">
            <!-- Customer row -->
            <div class="register-customer-row">
                <div class="customer-info">
                    <i class="fa-solid fa-user" style="color:#444; font-size:0.85rem;"></i>
                    <span class="customer-name" id="lblCustomer">WALK-IN CUSTOMER</span>
                </div>
                <button class="btn-select-customer" onclick="openVip()">
                    <i class="fa-solid fa-magnifying-glass me-1"></i>VIP
                </button>
            </div>

            <!-- Tabs -->
            <div class="order-tabs">
                <div class="order-tab active" id="tabNow" onclick="switchTab(0)">
                    <i class="fa-solid fa-cash-register me-1"></i>Now
                </div>
                <div class="order-tab" id="tabShip" onclick="switchTab(1)">
                    <i class="fa-solid fa-truck me-1"></i>Shipping
                </div>
                <div class="order-tab" id="tabTemp" onclick="switchTab(2)">
                    <i class="fa-solid fa-bookmark me-1"></i>Held
                </div>
            </div>

            <!-- Order No -->
            <div class="order-no-badge">
                ORDER <span id="lblOrderNo" style="color:var(--holo-cyan);">---</span>
            </div>

            <!-- Line items -->
            <div class="register-items">
