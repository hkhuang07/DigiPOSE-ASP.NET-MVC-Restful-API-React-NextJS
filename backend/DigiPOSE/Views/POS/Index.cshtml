            if (!data) return;
            let itemLines = "";
            data.items.forEach(it => {
                itemLines += `
                <div style="display:flex; justify-content:space-between; margin-bottom: 2px;">
                    <span>${it.quantity}x ${it.productName}</span>
                    <span>${Number(it.lineTotal).toLocaleString()} ₫</span>
                </div>
                ${it.notes ? `<div style="font-size:0.75em; color:#555; margin-left:12px;">- Note: ${it.notes}</div>` : ""}`;
            });

            const b2bHeader = data.b2b ? `
                <div style="border-top:1px dashed #000; padding:6px 0; margin:6px 0; font-size:0.85em;">
                    <div><strong>B2B TAX INVOICE</strong></div>
                    <div>Entity: ${data.b2b.legalName}</div>
                    <div>MST / Tax Code: ${data.b2b.taxCode}</div>
                </div>` : "";

            const paperHtml = `
                <div style="text-align:center; font-family:'Roboto Mono', monospace; font-size:0.9rem;">
                    <div style="font-weight:bold; font-size:1.2em;">DigiPOS STATION #${POS_STATE.counterId}</div>
                    <div>${POS_STATE.tenantName} // ${POS_STATE.warehouseName}</div>
                    <div>------------------------------------------</div>
                    <div style="font-weight:bold; margin:6px 0;">RECEIPT: ${data.invoiceNumber} [DOC: ${data.docNo}]</div>
                    <div>Date: ${new Date(data.processedAt).toLocaleString()}</div>
                    <div>Service Mode: [${data.serviceMode}] | Cashier: ${POS_STATE.userName}</div>
                    <div>Customer: ${data.vipName}</div>
                    ${b2bHeader}
                    <div>------------------------------------------</div>
                    <div style="text-align:left; margin: 10px 0;">
                        ${itemLines}
                    </div>
                    <div>------------------------------------------</div>
                    <div style="display:flex; justify-content:space-between;">
                        <span>GROSS SUBTOTAL:</span>
                        <span>${Number(data.grossAmount || data.totalDue).toLocaleString()} ₫</span>
                    </div>
                    <div style="display:flex; justify-content:space-between;">
                        <span>DISCOUNT / PROMO:</span>
                        <span>-${Number(data.discountAmount || 0).toLocaleString()} ₫</span>
                    </div>
                    ${data.pointsDiscount > 0 ? `
                    <div style="display:flex; justify-content:space-between; color:#444;">
                        <span>LOYALTY REDEEM (${Number(data.redeemedPoints).toLocaleString()} PTS):</span>
                        <span>-${Number(data.pointsDiscount).toLocaleString()} ₫</span>
                    </div>` : ""}
                    <div style="display:flex; justify-content:space-between;">
                        <span>VAT TAX (INCL):</span>
                        <span>+${Number(data.vatAmount || Math.round((data.grossAmount || data.totalDue)*0.0909)).toLocaleString()} ₫</span>
                    </div>
                    <div style="display:flex; justify-content:space-between; font-weight:bold; font-size:1.1em; border-top:1px dashed #333; padding-top:4px; margin-top:4px;">
                        <span>TOTAL AMOUNT DUE:</span>
                        <span>${Number(data.totalDue).toLocaleString()} ₫</span>
                    </div>
                    <div style="display:flex; justify-content:space-between; margin-top:4px;">
                        <span>Tendered:</span>
                        <span>${Number(data.tendered).toLocaleString()} ₫</span>
                    </div>
                    <div style="display:flex; justify-content:space-between;">
                        <span>Change Returned:</span>
                        <span>${Number(data.change).toLocaleString()} ₫</span>
                    </div>
                    <div>------------------------------------------</div>
                    <div style="margin-top:10px; font-size:0.8em;">THANK YOU FOR YOUR BUSINESS! // SHA-256 SECURED</div>
                </div>`;

            $("#receiptPaperArea").html(paperHtml);
            $("#modalReceipt").css("display", "flex");
        }

        function closeReceiptModal() { $("#modalReceipt").hide(); }

        function printActiveReceipt() {
            const w = window.open('', '_blank', 'width=420,height=650');
            w.document.write(`<html><head><title>Print Receipt</title><style>body { font-family: monospace; padding: 15px; color: #000; }</style></head><body>`);
            w.document.write($("#receiptPaperArea").html());
            w.document.write(`\x3C/body></html>`);
            w.document.close();
            w.focus();
            setTimeout(() => { w.print(); w.close(); closeReceiptModal(); }, 300);
        }

        // --- ORDER TODAY 100% VIEW ENGINE ---
        function loadOrdersToday() {
            const filter = $("#txtOrderFilter").val()?.trim() || "";
            let url = `/api/v1/POS/orders/today?tenantId=${POS_STATE.tenantId}`;
            if (POS_STATE.shiftId > 0) url += `&shiftId=${POS_STATE.shiftId}`;
            if (filter) url += `&invoiceNo=${encodeURIComponent(filter)}`;

            $.get(url, function(data) {
                const list = data.orders || [];
                const tbody = $("#todayOrdersTableBody");
                if (list.length === 0) {
                    tbody.html(`<tr><td colspan="8" style="text-align:center; padding:30px; color:#666;">NO TRANSACTIONS RECORDED FOR CURRENT SHIFT / TODAY YET.</td></tr>`);
                    return;
                }
                let html = "";
                list.forEach(o => {
                    const statusBadge = o.statusId === 8 ? `<span style="color:var(--bio-emerald);"><i class="fa-solid fa-circle-check me-1"></i>COMPLETED</span>` : `<span style="color:var(--amber-warn);"><i class="fa-solid fa-hourglass-half me-1"></i>PENDING</span>`;
                    html += `
                    <tr>
                        <td>#${o.orderId}</td>
                        <td style="font-weight:700; color:var(--holo-cyan);">${o.invoiceNo || 'ORD-'+o.orderId}</td>
                        <td>${new Date(o.createdAt).toLocaleTimeString()}</td>
                        <td>${o.customerName || 'Walk-in Consumer'}</td>
                        <td><span class="filter-chip" style="font-size:0.75rem; padding:2px 8px;">${o.paymentMethod || 'Cash'}</span></td>
                        <td style="font-family:var(--font-data); font-size:1.4rem; color:var(--bio-emerald); font-weight:bold;">${Number(o.totalAmount).toLocaleString()} ₫</td>
                        <td>${statusBadge}</td>
                        <td style="text-align:center;">
                            <button onclick="reprintReceipt(${o.orderId})" class="deck-btn" style="padding:4px 10px; font-size:0.7rem;"><i class="fa-solid fa-print me-1"></i> RE-PRINT</button>
                        </td>
                    </tr>`;
                });
                tbody.html(html);
            });
        }

        function reprintReceipt(orderId) {
            sysNotify("infor", "SPOOL RE-PRINTING", `Initiating thermal spool re-print for Transaction #${orderId}...`);
        }

        // --- EXECUTIVE ANALYTICS 100% VIEW ENGINE ---
        function loadAnalyticsData() {
            const fDate = $("#dateFrom").val();
            const tDate = $("#dateTo").val();
            let url = `/api/v1/POS/dashboard/analytics?tenantId=${POS_STATE.tenantId}`;
            if (fDate) url += `&fromDate=${fDate}`;
            if (tDate) url += `&toDate=${tDate}`;

            $.get(url, function(res) {
                $("#kpiRevenue").text(Number(res.totalRevenue || 0).toLocaleString() + " ₫");
                $("#kpiOrders").text((res.totalOrders || 0).toLocaleString());
                $("#kpiProducts").text((res.totalProductsSold || 0).toLocaleString());
                $("#kpiAov").text(Number(Math.round(res.avgOrderValue || 0)).toLocaleString() + " ₫");
                $("#kpiTodayRevenue").text(Number(res.todayRevenue || 0).toLocaleString() + " ₫");
                $("#kpiTodayOrders").text((res.todayOrdersCount || 0).toLocaleString());
                $("#kpiTotalDiscount").text(Number(res.totalDiscount || 0).toLocaleString() + " ₫");
                $("#kpiTotalVat").text(Number(res.totalVat || 0).toLocaleString() + " ₫");

                Object.keys(POS_STATE.chartInstances).forEach(k => {
                    if (POS_STATE.chartInstances[k]) POS_STATE.chartInstances[k].destroy();
                });

                Chart.defaults.color = "#888";
                Chart.defaults.font.family = "'Roboto Mono', monospace";

                const ctxDaily = document.getElementById("chartDailyRevenue").getContext("2d");
                POS_STATE.chartInstances["daily"] = new Chart(ctxDaily, {
                    type: "bar",
                    data: {
                        labels: (res.revenueByDay || []).map(x => x.date),
                        datasets: [{
                            label: "Daily Revenue (VND)",
                            data: (res.revenueByDay || []).map(x => x.revenue),
                            backgroundColor: "rgba(0, 229, 255, 0.25)",
                            borderColor: "#00E5FF",
                            borderWidth: 2,
                            borderRadius: 4
                        }]
                    },
                    options: { responsive: true, maintainAspectRatio: false, scales: { y: { beginAtZero: true, grid: { color: "#161D24" } }, x: { grid: { color: "#161D24" } } } }
                });

                const ctxHourly = document.getElementById("chartHourlyVelocity").getContext("2d");
                POS_STATE.chartInstances["hourly"] = new Chart(ctxHourly, {
                    type: "line",
                    data: {
                        labels: (res.revenueByHour || []).map(x => x.hour + ":00"),
                        datasets: [{
                            label: "Hourly Velocity (VND)",
                            data: (res.revenueByHour || []).map(x => x.revenue),
                            borderColor: "#00FF66",
                            backgroundColor: "rgba(0, 255, 102, 0.1)",
                            fill: true,
                            tension: 0.3,
                            pointRadius: 4
                        }]
                    },
                    options: { responsive: true, maintainAspectRatio: false, scales: { y: { beginAtZero: true, grid: { color: "#161D24" } }, x: { grid: { color: "#161D24" } } } }
                });

                const ctxPay = document.getElementById("chartPaymentBreakdown").getContext("2d");
                POS_STATE.chartInstances["pay"] = new Chart(ctxPay, {
                    type: "bar",
                    data: {
                        labels: (res.paymentBreakdown || []).map(x => x.method),
                        datasets: [{
                            label: "Revenue Share by Method (VND)",
                            data: (res.paymentBreakdown || []).map(x => x.revenue),
                            backgroundColor: ["rgba(0, 229, 255, 0.6)", "rgba(0, 255, 102, 0.6)", "rgba(255, 176, 0, 0.6)", "rgba(255, 51, 51, 0.6)"],
                            borderColor: ["#00E5FF", "#00FF66", "#FFB000", "#FF3333"],
                            borderWidth: 1
                        }]
                    },
                    options: {
                        indexAxis: "y",
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: { x: { beginAtZero: true, grid: { color: "#161D24" } }, y: { grid: { color: "#161D24" } } }
                    }
                });

                const ctxTop = document.getElementById("chartTopProducts").getContext("2d");
                POS_STATE.chartInstances["top"] = new Chart(ctxTop, {
                    type: "bar",
                    data: {
                        labels: (res.topProducts || []).slice(0, 10).map(x => x.productName.length > 18 ? x.productName.substring(0, 18) + "..." : x.productName),
                        datasets: [{
                            label: "Total Units Dispatched",
                            data: (res.topProducts || []).slice(0, 10).map(x => x.totalQty),
                            backgroundColor: "rgba(255, 176, 0, 0.35)",
                            borderColor: "#FFB000",
                            borderWidth: 2
                        }]
                    },
                    options: { responsive: true, maintainAspectRatio: false, scales: { y: { beginAtZero: true, grid: { color: "#161D24" } }, x: { grid: { color: "#161D24" } } } }
                });

                let custHtml = "";
                (res.topCustomers || []).forEach(c => {
                    custHtml += `<tr><td style="font-weight:700; color:var(--holo-cyan);">${c.customerName}</td><td>${c.phone||'--'}</td><td style="text-align:right; font-family:var(--font-data); font-size:1.3rem; color:var(--bio-emerald);">${Number(c.totalSpend).toLocaleString()} ₫</td></tr>`;
                });
                if (!custHtml) custHtml = `<tr><td colspan="3" style="text-align:center;">NO CUSTOMER EXPENDITURE DETECTED</td></tr>`;
                $("#tblTopCustomers").html(custHtml);

                let ordHtml = "";
                (res.topOrders || []).forEach(o => {
                    ordHtml += `<tr><td style="color:var(--holo-cyan); font-weight:700;">${o.invoiceNumber}</td><td>${o.customer}</td><td>${o.createdAt}</td><td style="text-align:right; font-family:var(--font-data); font-size:1.3rem; color:var(--bio-emerald);">${Number(o.totalAmount).toLocaleString()} ₫</td></tr>`;
                });
                if (!ordHtml) ordHtml = `<tr><td colspan="4" style="text-align:center;">NO ORDERS DETECTED IN SELECTED TIMEFRAME</td></tr>`;
                $("#tblTopOrders").html(ordHtml);
            });
        }

        // --- VIP CUSTOMER MANAGEMENT ENGINE ---
        function renderVipTable() {
            const query = $("#txtVipSearch").val()?.trim().toLowerCase();
            const list = GLOBAL_CATALOG.customers || [];
            const tbody = $("#vipDirectoryTableBody");

            const filtered = query ? list.filter(c => (c.fullName || '').toLowerCase().includes(query) || (c.phoneNumber && c.phoneNumber.includes(query))) : list;

            if (filtered.length === 0) {
                tbody.html(`<tr><td colspan="6" style="text-align:center; padding:30px; color:#666;">NO VIP CUSTOMERS FOUND IN REPOSITORY.</td></tr>`);
                return;
            }

            let html = "";
            filtered.forEach(c => {
                html += `
                <tr>
                    <td style="font-family:var(--font-data); font-size:1.3rem;">#${c.customerId}</td>
                    <td style="font-weight:700; color:var(--holo-cyan); font-size:1rem;">${c.fullName}</td>
                    <td>${c.phoneNumber || '--'}</td>
                    <td><span class="filter-chip" style="font-size:0.75rem;">${c.typeName || 'Standard VIP'}</span></td>
                    <td style="text-align:center; font-family:var(--font-data); font-size:1.5rem;">
                        <span style="color:var(--amber-warn); font-weight:bold;">${c.rewardPoints || 0} PTS</span>
                        ${(c.debtBalance && c.debtBalance > 0) ? `<br/><span style="font-size:1.1rem; color:var(--crimson-danger);">DEBT: ${Number(c.debtBalance).toLocaleString()} ₫</span>` : ''}
                    </td>
                    <td style="text-align:center;">
                        <button onclick="attachVipCustomer(${c.customerId}, '${c.fullName.replace(/'/g, "\\'")}', ${c.rewardPoints || 0}, ${c.debtBalance || 0}, '${(c.companyName||'').replace(/'/g, "\\'")}')" class="deck-btn" style="padding:6px 12px; font-size:0.75rem; border-color:var(--bio-emerald); color:var(--bio-emerald);"><i class="fa-solid fa-check me-1"></i> SELECT</button>
                        <button onclick="openVipModal(${c.customerId}, '${c.fullName.replace(/'/g, "\\'")}', '${c.phoneNumber||''}')" class="deck-btn" style="padding:6px 10px; font-size:0.75rem;"><i class="fa-solid fa-pen"></i></button>
                        <button onclick="deleteVipCustomer(${c.customerId})" class="deck-btn" style="padding:6px 10px; font-size:0.75rem; border-color:var(--crimson-danger); color:var(--crimson-danger);"><i class="fa-solid fa-trash"></i></button>
                    </td>
                </tr>`;
            });
            tbody.html(html);
        }

        function openVipModal(id, name, phone) {
            if (id > 0) {
                $("#vipModalTitle").html(`<i class="fa-solid fa-user-pen me-2"></i> EDIT VIP ACCOUNT #${id}`);
                $("#vipEditId").val(id);
                $("#txtVipName").val(name);
                $("#txtVipPhone").val(phone);
            } else {
                $("#vipModalTitle").html(`<i class="fa-solid fa-user-plus me-2"></i> REGISTER NEW VIP ACCOUNT`);
                $("#vipEditId").val(0);
                $("#txtVipName").val("");
                $("#txtVipPhone").val("");
                $("#txtVipEmail").val("");
                $("#txtVipAddress").val("");
            }
            $("#modalVipAccount").css("display", "flex");
        }

        function closeVipModal() { $("#modalVipAccount").hide(); }

        function saveVipCustomer() {
            const id = parseInt($("#vipEditId").val()) || 0;
            const fullName = $("#txtVipName").val()?.trim();
            if (!fullName) { sysNotify("warning", "VALIDATION ERROR", "Full Name / Corporate Entity Name is required."); return; }

            const payload = {
                fullName: fullName,
                phoneNumber: $("#txtVipPhone").val()?.trim(),
                email: $("#txtVipEmail").val()?.trim(),
                address: $("#txtVipAddress").val()?.trim(),
                customerTypeId: parseInt($("#selVipType").val()) || 1
            };

            const type = id > 0 ? "PUT" : "POST";
            const url = id > 0 ? `/api/v1/POS/customers/${id}` : `/api/v1/POS/customers`;

            $.ajax({
                url: url,
                type: type,
                contentType: "application/json",
                data: JSON.stringify(payload),
                success: function(res) {
                    closeVipModal();
                    loadCatalogMetadata();
                },
                error: function(xhr) {
                    sysNotify("error", "DATABASE ERROR", "Failed to commit VIP customer account to database.");
                }
            });
        }

        function deleteVipCustomer(id) {
            sysConfirm("DELETE VIP ACCOUNT", `Are you sure you want to completely delete VIP Account #${id}?`, function() {
                $.ajax({
                    url: `/api/v1/POS/customers/${id}`,
                    type: "DELETE",
                    success: function() { loadCatalogMetadata(); sysNotify("success", "ACCOUNT DELETED", `VIP Account #${id} removed from repository.`); },
                    error: function() { sysNotify("error", "DELETE FAILED", "Failed to delete account from repository."); }
                });
            });
        }

        // --- SIGNALR REAL-TIME INVENTORY SYNCHRONIZATION ---
        function initSignalR() {
            if (typeof signalR === 'undefined' || !signalR.HubConnectionBuilder) {
                console.warn(">>> [SIGNALR_OFFLINE]: SignalR library unreachable or operating stand-alone local mode.");
                return;
            }
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/inventoryHub")
                .withAutomaticReconnect()
                .build();

            connection.on("OnInventoryChanged", function(tenantId, productId, newBalance) {
                if (parseInt(tenantId) === POS_STATE.tenantId) {
                    loadProductCatalog(currentFilterType);
                }
            });

            connection.start().catch(err => console.log("SignalR Connection established offline/fallback mode.", err));
        }
    </script>
}
