        function printInvoice() { window.print(); }

        // ===================================================
        // ORDERS TODAY
        // ===================================================
        async function openOrdersToday() {
            openModal('modalOrdersToday');
            await loadOrdersToday(true);
        }

        async function loadOrdersToday(reset = false) {
            if (reset) document.getElementById('todayFilterInvoice').value = '';
            const invoiceFilter = document.getElementById('todayFilterInvoice').value;
            const tbody = document.getElementById('ordersTodayBody');
            tbody.innerHTML = `<tr><td colspan="6" style="text-align:center; color:#333; padding:16px;"><i class="fa-solid fa-spinner fa-spin"></i></td></tr>`;

            const params = new URLSearchParams({ branchId: POS_STATE.branchId || 1 });
            if (POS_STATE.shiftId) params.append('shiftId', POS_STATE.shiftId);
            if (invoiceFilter) params.append('invoiceNo', invoiceFilter);

            const res = await fetch(`/api/v1/POS/orders/today?${params}`);
            if (!res.ok) { tbody.innerHTML = `<tr><td colspan="6" style="text-align:center; color:var(--crimson-danger); padding:16px;">Failed to load orders</td></tr>`; return; }

            const data = await res.json();
            const orders = data.orders || data.Orders || [];
            if (orders.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" style="text-align:center; color:#333; padding:16px;">No orders found today</td></tr>`;
            } else {
                tbody.innerHTML = orders.map(o => `<tr>
                    <td style="color:var(--holo-cyan); font-weight:bold; font-family:var(--font-hdr); font-size:0.75rem;">${o.invoiceNumber || o.InvoiceNumber || 'N/A'}</td>
                    <td style="color:#888; font-size:0.75rem;">${new Date(o.createdAt || o.CreatedAt).toLocaleTimeString('en-GB', {hour:'2-digit', minute:'2-digit', second:'2-digit'})}</td>
                    <td>${o.snapshotCustomerName || o.SnapshotCustomerName || 'Walk-in'}</td>
                    <td style="text-align:right; color:var(--bio-emerald); font-family:var(--font-data);">${(o.totalAmount || o.TotalAmount || 0).toLocaleString('en-US')} ₫</td>
                    <td style="color:#888;">${o.paymentMethod || o.PaymentMethod || 'Cash'}</td>
                    <td style="text-align:center; color:#888;">${o.itemCount || o.ItemCount || 0}</td>
                </tr>`).join('');
            }
            const totalRev = data.totalRevenue || data.TotalRevenue || 0;
            const totalOrd = data.totalOrders || data.TotalOrders || 0;
            document.getElementById('ordersTodaySummary').innerHTML = `
                <span>${totalOrd} orders today</span>
                <span style="color:var(--bio-emerald); font-family:var(--font-data);">Total: ${totalRev.toLocaleString('en-US')} ₫</span>`;
        }

        // ===================================================
        // DASHBOARD
        // ===================================================
        async function openDashboard() {
            openModal('modalDashboard');
            await loadDashboard();
        }

        async function loadDashboard() {
            const params = new URLSearchParams({ branchId: POS_STATE.branchId || 1 });
            if (POS_STATE.shiftId) params.append('shiftId', POS_STATE.shiftId);
            const res = await fetch(`/api/v1/POS/dashboard/summary?${params}`);
            if (!res.ok) return;
            const data = await res.json();
            const fmt = n => n ? n.toLocaleString('en-US') : '0';
            document.getElementById('kpiRevenue').textContent = fmt(data.todayRevenue || data.TodayRevenue);
            document.getElementById('kpiOrders').textContent = fmt(data.todayOrders || data.TodayOrders);
            document.getElementById('kpiAvg').textContent = fmt(data.avgOrderValue || data.AvgOrderValue);
            const prods = data.topProducts || data.TopProducts || [];
            document.getElementById('topProductsBody').innerHTML = prods.length ? prods.map((p, i) => `<tr>
                <td style="color:#555;">${i + 1}</td>
                <td>${p.productName || p.ProductName}</td>
                <td style="text-align:right; color:var(--holo-cyan);">${p.totalQty || p.TotalQty}</td>
                <td style="text-align:right; color:var(--bio-emerald); font-family:var(--font-data);">${(p.totalRevenue || p.TotalRevenue || 0).toLocaleString('en-US')} ₫</td>
            </tr>`).join('') : `<tr><td colspan="4" style="text-align:center; color:#333; padding:12px;">No sales data yet</td></tr>`;
        }

        // ===================================================
        // VIP CUSTOMER
        // ===================================================
        function openVip() {
            openModal('modalVip');
            renderVipList(catalogMeta.customers || catalogMeta.Customers || []);
        }
        function closeVip() { closeModal('modalVip'); }

        function renderVipList(customers) {
            const list = document.getElementById('vipList');
            if (!customers || customers.length === 0) {
                list.innerHTML = `<div style="padding:20px; text-align:center; color:#333; font-size:0.8rem;">No customers found</div>`;
                return;
            }
            list.innerHTML = customers.map(c => `
                <div class="vip-list-item" data-id="${c.customerId || c.CustomerId}" onclick="selectVipCustomer(${JSON.stringify(c).replace(/"/g, '&quot;')})">
                    <div class="vip-code">VIP-${String(c.customerId || c.CustomerId || 0).padStart(10, '0')}</div>
                    <div class="vip-name">${c.fullName || c.FullName || 'Unknown'}</div>
                    <div class="vip-phone">${c.phoneNumber || c.PhoneNumber || '--'}</div>
                </div>`).join('');
        }

        function filterVipList() {
            const q = document.getElementById('vipSearchInput').value.toLowerCase();
            const customers = catalogMeta.customers || catalogMeta.Customers || [];
            const filtered = customers.filter(c =>
                (c.fullName || c.FullName || '').toLowerCase().includes(q) ||
                (c.phoneNumber || c.PhoneNumber || '').includes(q) ||
                String(c.customerId || c.CustomerId || '').includes(q));
            renderVipList(filtered);
        }

        function selectVipCustomer(customer) {
            selectedVipCustomer = customer;
            document.querySelectorAll('.vip-list-item').forEach(el => el.classList.remove('selected'));
            const id = customer.customerId || customer.CustomerId;
            const el = document.querySelector(`.vip-list-item[data-id="${id}"]`);
            if (el) el.classList.add('selected');
            document.getElementById('btnSelectVip').disabled = false;

            // Show detail
            const pts = customer.rewardPoints || customer.RewardPoints || 0;
            document.getElementById('vipDetail').innerHTML = `
                <div class="vip-detail-row"><label>Customer ID</label><span>VIP-${String(id).padStart(10,'0')}</span></div>
                <div class="vip-detail-row"><label>Full Name</label><span>${customer.fullName || customer.FullName}</span></div>
                <div class="vip-detail-row"><label>Phone</label><span>${customer.phoneNumber || customer.PhoneNumber || '--'}</span></div>
                <div class="vip-detail-row"><label>Type</label><span>${customer.typeName || customer.TypeName || 'VIP'}</span></div>
                <div style="text-align:center; margin-top:12px;">
                    <div style="font-size:0.65rem; color:#555; text-transform:uppercase; letter-spacing:1px;">Reward Points</div>
                    <div class="reward-points">${pts.toLocaleString('en-US')}</div>
                </div>`;
        }

        function confirmVipSelection() {
            if (!selectedVipCustomer) return;
            const id = selectedVipCustomer.customerId || selectedVipCustomer.CustomerId;
            const name = selectedVipCustomer.fullName || selectedVipCustomer.FullName;
            POS_STATE.registers[POS_STATE.activeTab].customerId = id;
            POS_STATE.registers[POS_STATE.activeTab].customerName = name;
            document.getElementById('lblCustomer').textContent = name.toUpperCase();
            document.getElementById('payCustomerName').textContent = name;
            closeModal('modalVip');
        }

        function clearVipSelection() {
            selectedVipCustomer = null;
            POS_STATE.registers[POS_STATE.activeTab].customerId = null;
            POS_STATE.registers[POS_STATE.activeTab].customerName = 'Walk-in Customer';
            document.getElementById('lblCustomer').textContent = 'WALK-IN CUSTOMER';
            document.getElementById('payCustomerName').textContent = 'Walk-in Customer';
            document.querySelectorAll('.vip-list-item').forEach(el => el.classList.remove('selected'));
            document.getElementById('btnSelectVip').disabled = true;
            document.getElementById('vipDetail').innerHTML = `<div style="text-align:center; color:#333; padding:20px; font-size:0.8rem;">Select a customer to view details</div>`;
        }

        // ===================================================
        // HAMBURGER MENU
        // ===================================================
        document.getElementById('btnHamburger').addEventListener('click', () => {
            document.getElementById('sideMenu').classList.toggle('show');
            document.getElementById('sideMenuOverlay').classList.toggle('show');
        });
        function closeSideMenu() {
            document.getElementById('sideMenu').classList.remove('show');
            document.getElementById('sideMenuOverlay').classList.remove('show');
        }

        // ===================================================
        // MODAL HELPERS
        // ===================================================
        function openModal(id) { document.getElementById(id).classList.add('show'); }
        function closeModal(id) { document.getElementById(id).classList.remove('show'); }

        // ===================================================
        // TELEMETRY: CLOCK + REAL PING
        // ===================================================
        function startClock() {
            function tick() {
                const now = new Date();
                const pad = (n, w = 2) => String(n).padStart(w, '0');
                const ms = pad(now.getMilliseconds(), 3);
                const ts = `${now.getFullYear()}-${pad(now.getMonth()+1)}-${pad(now.getDate())} ${pad(now.getHours())}:${pad(now.getMinutes())}:${pad(now.getSeconds())}.${ms} UTC+7`;
                document.getElementById('footerClock').textContent = ts;
            }
            tick();
            setInterval(tick, 100);
        }

        async function startPingMonitor() {
            async function doPing() {
                const t0 = performance.now();
                try {
                    const res = await fetch('/api/v1/POS/health/ping', { cache: 'no-store' });
                    const t1 = performance.now();
                    const rtt = Math.round(t1 - t0);
                    document.getElementById('footerPing').textContent = `${rtt}ms`;
                    document.getElementById('footerPing').style.color = rtt < 10 ? 'var(--bio-emerald)' : rtt < 50 ? 'var(--amber-warn)' : 'var(--crimson-danger)';
                    if (res.ok) {
                        document.getElementById('statusLabel').textContent = 'ONLINE';
                        document.getElementById('statusLabel').style.color = 'var(--bio-emerald)';
                        document.getElementById('statusDot').className = 'status-dot';
                    }
                } catch (e) {
                    document.getElementById('statusLabel').textContent = 'OFFLINE';
                    document.getElementById('statusLabel').style.color = 'var(--crimson-danger)';
                    document.getElementById('statusDot').className = 'status-dot offline';
                    document.getElementById('footerPing').textContent = 'ERR';
                }
            }
            await doPing();
            setInterval(doPing, 5000);
        }

        // ===================================================
        // KEYBOARD SHORTCUTS
        // ===================================================
        window.addEventListener('keydown', e => {
            if (e.key === 'F1') { e.preventDefault(); document.getElementById('posSearchInput').focus(); }
            else if (e.key === 'F5') { e.preventDefault(); holdCurrentOrder(); }
            else if (e.key === 'F6') { e.preventDefault(); markShippingOrder(); }
            else if (e.key === 'F12') { e.preventDefault(); openPayment(); }
            else if (e.key === 'Escape') { closeSideMenu(); }
        });

        document.getElementById('posSearchInput').addEventListener('keydown', e => {
            if (e.key === 'Enter') { e.preventDefault(); executeSearch(); }
        });

        // ===================================================
        // BOOT
        // ===================================================
        window.addEventListener('DOMContentLoaded', () => {
            checkLocalSetup();
        });
    </script>
</body>
</html>
